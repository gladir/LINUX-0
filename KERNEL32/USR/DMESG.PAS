  @abstract(Target: LPC -3X)
  @description: /bin/dmesg : affiche le journal du noyau (syslog(2) ; -c vide le journal).
}

Program DMESG;

Const
  UsageW : Array[1..5] Of PChar =
    ('Usage : ', 'Usage: ', 'Aufruf: ', 'Uso: ', 'Uso: ');

Function PS(P : PChar) : String;
Var X : String;
Begin
  X := '';
  While P^ <> #0 Do
  Begin
    X := X + P^;
    Inc(P);
  End;
  PS := X;
End;

Function NumS(V : LongInt) : String;
Var S : String;
Begin
  Str(V, S);
  NumS := S;
End;

Procedure Usage(Const Syn : String);
Begin
  SysPut(2, PS(UsageW[SysLang]) + Syn + #10);
  SysExit(1);
End;

Procedure Warn(Const What : String);
Begin
  SysPut(2, 'dmesg: ' + What + ': ' + SysErrorText(SysErrno) + #10);
End;

Function BaseOf(Const P : String) : String;
Var K, L : LongInt;
Begin
  L := Length(P);
  While (L > 1) And (P[L] = '/') Do Dec(L);
  K := L;
  While (K > 0) And (P[K] <> '/') Do Dec(K);
  BaseOf := Copy(P, K + 1, L - K);
End;

Function IsDir(Const P : String) : Boolean;
Var St : TSysStat;
Begin
  IsDir := (SysStat(P, St) = 0) And ((St.Mode And $F000) = $4000);
End;

Var
  B : Array[0..32767] Of Char;
  N, Typ : LongInt;
  Clear : Boolean;
BEGIN
  Clear := (SysArgCount > 1) And (SysArgStr(1) = '-c');
  Typ := 3;
  If Clear Then Typ := 4;
  N := LnxRes(LnxSys3(103, Typ, LongInt(@B), 32768));
  If N < 0 Then
  Begin
    Warn('syslog');
    SysExit(1);
  End;
  If N > 0 Then SysWrite(1, B, N);
END.
