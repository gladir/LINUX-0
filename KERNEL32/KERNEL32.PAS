End;

{ syslog : lecture du journal du noyau (dmesg) }
Function SysSyslog(Typ, Buf, Len : LongInt) : LongInt;
Var I, N, Start : LongInt;
Begin
  Case Typ Of
    3, 4 :
      Begin
        If Len <= 0 Then
        Begin
          SysSyslog := -EINVAL;
          Exit;
        End;
        N := LogCount;
        Start := 0;
        If N > Len Then
        Begin
          Start := N - Len;
          N := Len;
        End;
        If Not EnsureUser(Buf, N, True) Then
        Begin
          SysSyslog := -EFAULT;
          Exit;
        End;
        For I := 0 To N - 1 Do Mem[0:Buf + I] := LogByte(Start + I);
        If Typ = 4 Then LogCount := 0;
        SysSyslog := N;
      End;
    5 : Begin LogCount := 0; SysSyslog := 0; End;
    9 : SysSyslog := LogCount;
    10 : SysSyslog := LogSize;
    0, 1, 6, 7, 8 : SysSyslog := 0;
  Else
    SysSyslog := -EINVAL;
  End;
End;

Procedure PowerOff;
Var N : LongInt;
Begin
  KLog('Extinction du systeme.');
  { ACPI : PM1a_CNT_BLK de la FADT, SLP_TYP de l'objet \_S5_ de la DSDT }
  If (AcpiPm1a <> 0) And (AcpiSlpTyp >= 0) Then
  Begin
    If (AcpiSmiCmd <> 0) And (AcpiEnable <> 0)
       And ((PortW[AcpiPm1a] And 1) = 0) Then
    Begin
      Port[AcpiSmiCmd] := AcpiEnable;
      N := 0;
      While ((PortW[AcpiPm1a] And 1) = 0) And (N < 1000000) Do Inc(N);
    End;
    KLog('ACPI : arret par PM1a ' + HexStr(AcpiPm1a, 4) + ' SLP_TYP '
        + IntStr(AcpiSlpTyp));
    PortW[AcpiPm1a] := (AcpiSlpTyp Shl 10) Or $2000;
    N := 0;
    While N < 1000000 Do Inc(N);
  End;
  If Pos(' noportoff', ' ' + CmdLine) > 0 Then CpuHalt;   { essais }
  Port[$604 + 1] := $20;
  PortW[$604] := $2000;
  PortW[$B004] := $2000;
  PortW[$4004] := $3400;
  KLog('Systeme arrete. Vous pouvez eteindre l''ordinateur.');
  CpuHalt;
End;

Procedure RebootCpu;
Var N : LongInt;
Begin
  KLog('Redemarrage du systeme.');
  N := 0;
  While ((Port[$64] And 2) <> 0) And (N < 100000) Do Inc(N);
  { registre de reinitialisation ACPI (FADT, E/S) }
  If AcpiResetAddr <> 0 Then
  Begin
    KLog('ACPI : reinitialisation par le port ' + HexStr(AcpiResetAddr, 4));
    Port[AcpiResetAddr] := AcpiResetVal;
  End;
  N := 0;
  While N < 1000000 Do Inc(N);
  Port[$CF9] := 2;                       { reinitialisation PCI (chipset) }
  Port[$CF9] := $E;
  N := 0;
  While N < 1000000 Do Inc(N);
  Port[$64] := $FE;
  { en dernier recours : triple faute }
  GdtPtr.Limit := 0;
  asm
    lidt GdtPtr
    int 3
  end;
  CpuHalt;
End;

Function SysReboot(M1, M2, Cmd, Arg : LongInt) : LongInt;
Begin
  If Cur^.Euid <> 0 Then
  Begin
    SysReboot := -EPERM;
    Exit;
  End;
  If M1 <> LongInt($FEE1DEAD) Then
  Begin
    SysReboot := -EINVAL;
    Exit;
  End;
  Case Cmd Of
    $01234567, LongInt($A1B2C3D4) :
      Begin
        VfsShutdown;
        RebootCpu;
      End;
    LongInt($CDEF0123) :
      Begin
        VfsShutdown;
        KLog('Systeme arrete.');
        CpuHalt;
      End;
    $4321FEDC :
      Begin
        VfsShutdown;
        PowerOff;
      End;
    LongInt($89ABCDEF), 0 : SysReboot := 0;
  Else
    SysReboot := -EINVAL;
  End;
End;

{ prctl : noms de processus }
Function SysPrctl(Opt, A2, A3, A4, A5 : LongInt) : LongInt;
Var I : LongInt;
Begin
  If Opt = 15 Then
  Begin
    If Not EnsureUser(A2, 16, False) Then
    Begin
      SysPrctl := -EFAULT;
      Exit;
    End;
    For I := 0 To 14 Do Cur^.Comm[I] := Mem[0:A2 + I];
    Cur^.Comm[15] := 0;
    SysPrctl := 0;
  End
  Else If Opt = 16 Then
  Begin
    If Not EnsureUser(A2, 16, True) Then
    Begin
      SysPrctl := -EFAULT;
      Exit;
    End;
    For I := 0 To 15 Do Mem[0:A2 + I] := Cur^.Comm[I];
    SysPrctl := 0;
  End
  Else If (Opt = 1) Or (Opt = 3) Or (Opt = 4) Then SysPrctl := 0
  Else SysPrctl := PrctlExt(Opt, A2, A3, A4, A5);
End;

Function SysSetThreadArea(UInfo : LongInt) : LongInt;
Var Entry, Base, Limit, Flags, Lo, Hi : LongInt;
Begin
  If Not EnsureUser(UInfo, 16, True) Then
  Begin
    SysSetThreadArea := -EFAULT;
    Exit;
  End;
  Entry := MemL[0:UInfo];
  Base := MemL[0:UInfo + 4];
  Limit := MemL[0:UInfo + 8];
  Flags := MemL[0:UInfo + 12];
  If Entry = -1 Then
  Begin
    Entry := 6;
    MemL[0:UInfo] := Entry;
  End;
  If (Entry < 6) Or (Entry > 8) Then
  Begin
    SysSetThreadArea := -EINVAL;
    Exit;
  End;
  Lo := (Base Shl 16) Or (Limit And $FFFF);
  Hi := (Base And LongInt($FF000000)) Or ((Base Shr 16) And $FF) Or ((Limit
      And $F0000)) Or $00C0F300;
  If (Flags And 1) = 0 Then Hi := Hi And Not $00400000;
  If (Flags And 16) = 0 Then Hi := Hi And Not $00800000;
  If (Flags And 128) <> 0 Then
  Begin
    Lo := 0; Hi := 0;
  End;
  Cur^.Tls[(Entry - 6) * 2] := Lo;
  Cur^.Tls[(Entry - 6) * 2 + 1] := Hi;
  LoadTls(Cur);
  SysSetThreadArea := 0;
End;

