Function SysMount(DevA, DirA, TypeA, Flags, Data : LongInt) : LongInt;
Var Dv, Dr, Tp : String; R : LongInt; Dm : PDentry;
Begin
  If Cur^.Euid <> 0 Then
  Begin
    SysMount := -EPERM;
    Exit;
  End;
  If (Flags And LongInt($FFFF0000)) = LongInt($C0ED0000) Then
    Flags := Flags And $FFFF;
  Dv := '';
  If DevA <> 0 Then
  Begin
    R := GetUserStr(DevA, Dv);
    If R < 0 Then
    Begin
      SysMount := R;
      Exit;
    End;
  End;
  R := GetUserStr(DirA, Dr);
  If R < 0 Then
  Begin
    SysMount := R;
    Exit;
  End;
  If (Flags And MS_REMOUNT) <> 0 Then
  Begin
    SysMount := VfsRemount(Dr, Flags);
    Exit;
  End;
  If (Flags And MS_BIND) <> 0 Then
  Begin
    SysMount := VfsBind(Dv, Dr);
    Exit;
  End;
  If (Flags And 8192) <> 0 Then
  Begin
    SysMount := VfsMoveMount(Dv, Dr);
    Exit;
  End;
  If TypeA = 0 Then
  Begin
    SysMount := -EINVAL;
    Exit;
  End;
  R := GetUserStr(TypeA, Tp);
  If R < 0 Then
  Begin
    SysMount := R;
    Exit;
  End;
  R := VfsMount(Dv, Dr, Tp, Flags And $FFFF, Data);
  { source inexistante : ENOENT (et non ENOTBLK) }
  If (R = -ENOTBLK) And (Dv <> '') Then
  Begin
    If PathWalk(Dv, True, Dm) = 0 Then DentryPut(LongInt(Dm))
    Else R := -ENOENT;
  End;
  SysMount := R;
End;

