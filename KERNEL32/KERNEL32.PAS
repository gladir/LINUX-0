{ ---- Entree INT 80h ---- }

Procedure DoSyscall(F : PFrame);
Var Nr, Fn, R, Sk : LongInt; Skip, Emu : Boolean;
Begin
  Nr := F^.Eax;
  F^.Err := Nr;
  Skip := False;
  If KDebug Then KLog('sys ' + IntStr(Nr) + ' pid ' + IntStr(Cur^.Pid) + ' ('
      + HexStr(F^.Ebx, 8) + ',' + HexStr(F^.Ecx, 8) + ',' + HexStr(F^.Edx, 8)
      + ')');
  Inc(SyscallCount);
  { ptrace : arret a l'entree de l'appel (PTRACE_SYSCALL / SYSEMU) }
  Emu := False;
  If (Cur^.PtSyscall <> 0) And (Cur^.Ptrace <> 0) Then
  Begin
    Emu := Cur^.PtSysemu <> 0;
    F^.Eax := -ENOSYS;
    PtSyscallStop(F, False);
    Nr := F^.Err;
    If (Nr < 0) Or Emu Then Skip := True;
  End;
  { seccomp }
  If (Cur^.SecMode <> 0) And (Not Skip) Then
  Begin
    Sk := SeccompCheck(F, Nr);
    If Sk = 1 Then Skip := True
    Else If Sk = 2 Then
    Begin
      Nr := F^.Err;
      If Nr < 0 Then Skip := True;
    End;
  End;
  If Skip Then R := F^.Eax
  Else If (Nr < 0) Or (Nr >= MaxSys) Then
    R := -ENOSYS
  Else
  Begin
    Fn := SysFn[Nr];
    If Fn = 0 Then R := -ENOSYS
    Else
      Case SysArgc[Nr] Of
        0 : R := Call0(Fn);
        1 : R := Call1(Fn, F^.Ebx);
        2 : R := Call2(Fn, F^.Ebx, F^.Ecx);
        3 : R := Call3(Fn, F^.Ebx, F^.Ecx, F^.Edx);
        4 : R := Call4(Fn, F^.Ebx, F^.Ecx, F^.Edx, F^.Esi);
        5 : R := Call5(Fn, F^.Ebx, F^.Ecx, F^.Edx, F^.Esi, F^.Edi);
      Else
        R := Call6(Fn, F^.Ebx, F^.Ecx, F^.Edx, F^.Esi, F^.Edi, F^.Ebp);
      End;
  End;
  { changements d'identifiants : mise a jour des capacites }
  If (Nr = 23) Or (Nr = 70) Or (Nr = 164) Or (Nr = 203) Or (Nr = 208)
     Or (Nr = 213) Then CapUidFix;
  F^.Eax := R;
  If Cur^.Ptrace <> 0 Then
  Begin
    If (R = 0) And ((Nr = 11) Or (Nr = 358)) And (Not Skip) Then PtExecHook;
    If (Cur^.PtSyscall <> 0) And (Not Emu) Then PtSyscallStop(F, True);
    If Cur^.PtStep <> 0 Then
    Begin
      SigEnqueue(Cur, SIGTRAP, 2, F^.Eip, 0, 0);
      ForceSig(Cur, SIGTRAP);
    End;
  End;
End;

{ ---- Exceptions ---- }

Function ExcSignal(Vec : LongInt) : LongInt;
Begin
  Case Vec Of
    0, 16, 19 : ExcSignal := SIGFPE;
    1, 3 : ExcSignal := SIGTRAP;
    6 : ExcSignal := SIGILL;
    17 : ExcSignal := SIGBUS;
  Else
    ExcSignal := SIGSEGV;
  End;
End;

Procedure DumpSwitches;
Var I, K : LongInt;
Begin
  KLog('--- dernieres commutations (de, vers, esp, etat+16*preempt) ---');
  For I := 15 DownTo 0 Do
  Begin
    K := ((SwTraceN - 1 - I) And 63) * 4;
    KLog('  ' + IntStr(SwTrace[K]) + ' -> ' + IntStr(SwTrace[K + 1]) + ' '
        + HexStr(SwTrace[K + 2], 8) + ' ' + IntStr(SwTrace[K + 3]));
  End;
  DumpTasks;
End;

Procedure KernelOops(F : PFrame; Const Why : String);
Begin
  LogToVc := True;
  KLog('');
  KLog('Oops : ' + Why + ' (pid ' + IntStr(Cur^.Pid) + ')');
  DumpFrame(F, ReadCr2);
  Backtrace(F^.Ebp);
  If PreemptOn Then DumpSwitches;
  KPanic('exception dans le noyau');
End;

Procedure DoException(F : PFrame);
Var V, Addr, R, Sig : LongInt; FromUser, Write : Boolean; Esp : LongInt;
Begin
  V := F^.Vec;
  FromUser := (F^.Cs And 3) = 3;
  If V = 14 Then
  Begin
    Addr := Cur^.Cr2;
    Write := (F^.Err And 2) <> 0;
    If FromUser Then Esp := F^.UserEsp Else Esp := 0;
    If (CurMm <> Nil) And ULt(Addr, UserTop) And ((F^.Err And 1 = 0)
        Or Write) Then
      R := MmFault(CurMm, Addr, Write, Esp)
    Else If (CurMm <> Nil) And ULt(Addr, UserTop) Then R := MmFault(CurMm,
        Addr, Write, Esp)
    Else R := 1;
    If KDebug Then KLog('pf pid=' + IntStr(Cur^.Pid) + ' addr=' + HexStr(Addr,
        8) + ' err=' + HexStr(F^.Err, 2) + ' eip=' + HexStr(F^.Eip, 8) + ' -> '
        + IntStr(R));
    If R = 0 Then Exit;
    If Not FromUser Then
      KernelOops(F, 'faute de page dans le noyau a l''adresse ' + HexStr(Addr,
          8));
    If R = 3 Then
    Begin
      KLog('pid ' + IntStr(Cur^.Pid) + ' : memoire insuffisante');
      ForceSig(Cur, SIGKILL);
      Exit;
    End;
    If R = 1 Then KLog('pid ' + IntStr(Cur^.Pid) + ' segfault a '
        + HexStr(Addr, 8) + ' ip ' + HexStr(F^.Eip, 8))
    Else KLog('pid ' + IntStr(Cur^.Pid) + ' violation de protection a '
        + HexStr(Addr, 8) + ' ip ' + HexStr(F^.Eip, 8));
    SigEnqueue(Cur, SIGSEGV, R, Addr, 0, 0);
    ForceSig(Cur, SIGSEGV);
    Exit;
  End;
  If V = 1 Then
  Begin
    PtDebugTrap(F);
    Exit;
  End;
  If Not FromUser Then KernelOops(F, 'exception ' + IntStr(V));
  If (V = 3) Or (V = 4) Then
  Begin
    SigEnqueue(Cur, SIGTRAP, $80, F^.Eip, 0, 0);
    ForceSig(Cur, SIGTRAP);
    Exit;
  End;
  If V = 16 Then
  Begin
    asm
      db 219,226
    end;
  End;
  If V <> 2 Then
  Begin
    KLog('pid ' + IntStr(Cur^.Pid) + ' : exception ' + IntStr(V) + ' ip '
        + HexStr(F^.Eip, 8));
    ForceSig(Cur, ExcSignal(V));
  End;
End;

Procedure DumpTasks;
Var I : LongInt;
Begin
  If BklOwner <> Nil Then
    KLog('--- taches (cur=' + IntStr(Cur^.Pid) + ', verrou noyau : pid '
        + IntStr(BklOwner^.Pid) + ') ---')
  Else KLog('--- taches (cur=' + IntStr(Cur^.Pid)
        + ', verrou noyau libre) ---');
  For I := 0 To MaxTasks - 1 Do
    If Tasks[I].State <> TsFree Then
      KLog('  pid ' + IntStr(Tasks[I].Pid) + ' etat ' + IntStr(Tasks[I].State)
          + ' chan ' +
           HexStr(Tasks[I].WaitChan, 8) + ' cnt ' + IntStr(Tasks[I].Counter)
          + ' cpu ' + IntStr(Tasks[I].OnCpu) + ' aff '
          + IntStr(Tasks[I].Affinity) + ' bkl ' + IntStr(Tasks[I].NeedBkl)
          + ' pre '
          + IntStr(Tasks[I].Preempted) + '/' + IntStr(Tasks[I].PreemptCount));
End;

{ Traitement d'une IRQ (apres l'accuse de reception) }
Procedure IrqBody(N : LongInt; FromUser : Boolean);
Begin
  If (N < 16) And (ModIrqFn[N] <> 0) Then Call0(ModIrqFn[N]);
  If NetPresent And (N = NicIrq) Then NicIrqHandler;
  Case N Of
    0 : Begin
          TimerTick(FromUser);
          If KDebug And (Jiffies Mod 500 = 0) Then DumpTasks;
        End;
    1 : KbdIrq;
    4 : SerialIrq;
    12 : MouseIrq;
  End;
End;

{ Traitements differes (noyau preemptible) : les IRQ survenues alors qu'une
  tache preemptee detient le verrou du noyau n'ont fait que compter le tick
  ou masquer la ligne ; elles sont traitees ici, par le detenteur du verrou
  qui le rend ou par la tache d'inactivite, avec IF masque }
Procedure RunBH;
Var Fl, Tp, Pi, K, N : LongInt;
Begin
  If (PendIrq = 0) And (TickPend = 0) Then Exit;
  Fl := SaveFlagsCli;
  While (PendIrq <> 0) Or (TickPend > 0) Do
  Begin
    Tp := AtomicXchg(LongInt(@TickPend), 0);
    Pi := AtomicXchg(LongInt(@PendIrq), 0);
    If Tp > 20 Then Tp := 20;
    For K := 1 To Tp Do TimerBottom;
    For N := 1 To 15 Do
      If (Pi And (1 Shl N)) <> 0 Then
      Begin
        IrqBody(N, False);
        IrqEnable(N);
      End;
  End;
  RestoreFlags(Fl);
End;

{ Partie de l'IRQ executee immediatement quand le traitement est differe }
Procedure IrqTop(N : LongInt; FromUser : Boolean);
Begin
  If N = 0 Then
  Begin
    Inc(Jiffies);
    IrqAck(0);
    AtomicAdd(LongInt(@TickPend), 1);
    TickUser := FromUser;
    TimerAccount(FromUser, True);
  End
  Else
  Begin
    IrqDefer(N);
    IrqAck(N);
    AtomicOr(LongInt(@PendIrq), 1 Shl N);
  End;
End;

Var
  IrqCnt : Array[0..15] Of LongInt;   { /proc/interrupts (partie 38) }

Procedure DoIrq(N : LongInt; FromUser : Boolean);
Begin
  If (N >= 0) And (N < 16) Then Inc(IrqCnt[N]);
  If N = 0 Then Inc(PCpu[0].NrTick);
  If PreemptOn Then
  Begin
    If (Cur <> IdleTask) And ((Not FromUser) Or (BklOwner <> Nil)) Then
    Begin
      IrqTop(N, FromUser);
      Exit;
    End;
    RunBH;
  End;
  IrqAck(N);
  IrqBody(N, FromUser);
End;

Procedure ReboutDummy;
Begin
End;

{ Retour en mode utilisateur, multiprocesseur : tant qu'il y a du travail
  (traitement differe des IRQ sur le BSP, reordonnancement, signaux), on
  prend le verrou noyau ; on le rend avant le retour. Le CPU courant peut
  changer a chaque reordonnancement. }
Function UserWorkPending(Mine : PTask) : Boolean;
Var Me : LongInt;
Begin
  Me := MyCpu;
  UserWorkPending := (PCpu[Me].Resched <> 0) Or CtrlAltDel
      Or ((Me = 0) And ((PendIrq <> 0) Or (TickPend > 0)))
      Or SigPendingUnblocked(Mine);
End;

Procedure ReturnToUserSmp(F : PFrame);
Var Mine : PTask;
Begin
  Mine := PCpu[MyCpu].Cur;
  Repeat
    asm
      cli
    end;
    If UserWorkPending(Mine) Then
    Begin
      If BklOwner <> Mine Then BklAcquireSmp(Mine);
      asm
        sti
      end;
      RunBH;
      If CtrlAltDel Then
      Begin
        CtrlAltDel := False;
        VfsShutdown;
        RebootCpu;
      End;
      If PCpu[MyCpu].Resched <> 0 Then ScheduleSmp;
      If SigPendingUnblocked(Mine) Then HandleSignals(F);
    End;
    If BklOwner = Mine Then BklReleaseSmp;
    asm
      cli
    end;
  Until Not UserWorkPending(Mine);
End;

{ Fin du traitement d'une entree depuis le mode utilisateur }
Procedure ReturnToUser(F : PFrame);
Begin
  If SmpRun Then
  Begin
    ReturnToUserSmp(F);
    Exit;
  End;
  If PreemptOn Then
  Begin
    If CtrlAltDel Then
    Begin
      BklAcquire;
      CtrlAltDel := False;
      VfsShutdown;
      RebootCpu;
    End;
    Repeat
      If NeedResched Then
      Begin
        BklRelease;
        Schedule;
      End;
      If SigPendingUnblocked(Cur) Then
      Begin
        BklAcquire;
        HandleSignals(F);
      End;
      BklRelease;
    Until (Not NeedResched) And (Not SigPendingUnblocked(Cur));
    asm
      cli
    end;
    Exit;
  End;
  If CtrlAltDel Then
  Begin
    CtrlAltDel := False;
    VfsShutdown;
    RebootCpu;
  End;
  If NeedResched Then Schedule;
  HandleSignals(F);
  While NeedResched Do
  Begin
    Schedule;
    HandleSignals(F);
  End;
End;

{ Preemption dans le noyau : retour d'IRQ vers du code noyau qui tourne
  avec IF = 1, sans section critique, en tenant le verrou du noyau }
Procedure KPreemptCheck(F : PFrame);
Begin
  { seulement si la tache est ordonnable : une tache qui a deja pris l'etat
    zombie, endormi ou arrete va ceder elle-meme (la preemption la
    retirerait de l'ordonnancement avant la fin de sa sortie : reveil du
    pere perdu) }
  If NeedResched And (Cur <> IdleTask) And (BklOwner = Cur)
     And (Cur^.State = TsRunnable)
     And (Cur^.PreemptCount = 0) And ((F^.Eflags And $200) <> 0) Then
  Begin
    Cur^.Preempted := 1;
    Inc(NrPreempts);
    Schedule;
    Cur^.Preempted := 0;
  End;
End;

{ ---- Interruptions et deroutements, multiprocesseur ---- }

Var
  IrqCntCpu : Array[0..255] Of LongInt;   { par CPU : /proc/interrupts }

{ Interruption inter-processeur : sans verrou noyau }
Procedure IpiTrap(V, Me : LongInt);
Begin
  Inc(PCpu[Me].NrIpi);
  Case V Of
    VecIpiResched : PCpu[Me].Resched := 1;
    VecIpiTlb :
      Begin
        FlushTlb;
        PCpu[Me].FlushReq := 0;
        Inc(PCpu[Me].NrFlush);
      End;
    VecIpiCall :
      Begin
        MemL[0:LapicVirt + $B0] := 0;
        asm
          cli
        @h:
          hlt
          jmp @h
        end;
      End;
  End;
  MemL[0:LapicVirt + $B0] := 0;
End;

{ Partie haute d'une IRQ (sans verrou) : accuse, comptage et, pour la
  minuterie, comptabilite de la tache du CPU ; le reste est differe }
Procedure DoIrqSmp(N : LongInt; FromUser : Boolean; Mine : PTask; Me : LongInt);
Begin
  Inc(IrqCntCpu[Me * 16 + N]);
  If N = 0 Then
  Begin
    If Me = 0 Then
    Begin
      Inc(Jiffies);
      AtomicAdd(LongInt(@TickPend), 1);
      TickUser := FromUser;
    End;
    IrqAck(0);
    If FromUser Then PCpu[Me].UserTick := 1 Else PCpu[Me].UserTick := 0;
    Inc(PCpu[Me].NrTick);
    TimerAccountT(Mine, FromUser, True);
  End
  Else
  Begin
    IrqDefer(N);
    IrqAck(N);
    AtomicOr(LongInt(@PendIrq), 1 Shl N);
  End;
End;

Var
  FastSysCount : LongInt;      { appels systeme servis sans verrou noyau }
  NoFastSys : Boolean;         { nofastsys : tout passe par le verrou noyau }

{ Appels systeme qui ne lisent que la tache appelante (identifiants) : servis
  sans prendre le verrou noyau, donc en parallele sur tous les CPU. Ordre
  des verrous (le premier se prend avant le suivant) : BklOwner >
  IoapLock ; ces appels n'en prennent aucun. Seule la tache de ce CPU est
  lue (aucun autre CPU ne la modifie sans verrou). Retourne Faux pour les
  autres appels. }
Function FastSyscall(T : PTask; Nr : LongInt; Var R : LongInt) : Boolean;
Begin
  FastSyscall := True;
  Case Nr Of
    20 : If T^.Ns[3] = 0 Then R := T^.Tgid Else R := T^.VTgid;
    224 : If T^.Ns[3] = 0 Then R := T^.Pid Else R := T^.VPid;
    24 : R := T^.Uid And $FFFF;
    49 : R := T^.Euid And $FFFF;
    47 : R := T^.Gid And $FFFF;
    50 : R := T^.Egid And $FFFF;
    199 : R := T^.Uid;
    201 : R := T^.Euid;
    200 : R := T^.Gid;
    202 : R := T^.Egid;
  Else
    FastSyscall := False;
  End;
End;

Procedure KTrapSmp(F : PFrame; V : LongInt; FromUser : Boolean);
Var Me, Rf : LongInt; Mine : PTask;
Begin
  Me := MyCpu;
  Mine := PCpu[Me].Cur;
  If V >= $F0 Then IpiTrap(V, Me)
  Else
  Begin
    If V = 14 Then Mine^.Cr2 := ReadCr2;
    If FromUser Then Mine^.Frame := LongInt(F);
    If FromUser And (V = VecSyscall) And (Not NoFastSys)
       And (Mine^.Ptrace = 0) And (Mine^.SecMode = 0)
       And FastSyscall(Mine, F^.Eax, Rf) Then
    Begin
      F^.Err := F^.Eax;
      F^.Eax := Rf;
      Inc(PCpu[Me].NrFast);
      ReturnToUserSmp(F);
      Exit;
    End;
    If FromUser And ((V = VecSyscall) Or (V < 32)) Then
    Begin
      BklAcquireSmp(Mine);
      asm
        sti
      end;
    End;
    If V = VecSyscall Then DoSyscall(F)
    Else If V < 32 Then DoException(F)
    Else If V < 48 Then DoIrqSmp(V - 32, FromUser, Mine, Me)
    Else KernelOops(F, 'vecteur inconnu');
  End;
  If FromUser Then ReturnToUserSmp(F);
End;

{ Point d'entree commun appele par le code genere (voir partie 4) }
Procedure KTrap(Fp : LongInt);
Var F : PFrame; V : LongInt; FromUser : Boolean;
Begin
  F := Pointer(Fp);
  V := F^.Vec;
  If V = VecSpurious Then Exit;
  FromUser := (F^.Cs And 3) = 3;
  If SmpRun Then
  Begin
    KTrapSmp(F, V, FromUser);
    Exit;
  End;
  { CR2 avant de rouvrir les interruptions (une preemption le changerait) }
  If V = 14 Then Cur^.Cr2 := ReadCr2;
  If FromUser Then Cur^.Frame := Fp
  Else If PreemptOn And (Cur <> IdleTask)
      And (Cur^.KStack + KStackSize - Fp > KStackMax) Then
    KStackMax := Cur^.KStack + KStackSize - Fp;
  If PreemptOn And FromUser And ((V = VecSyscall) Or (V < 32)) Then
  Begin
    BklAcquire;
    asm
      sti
    end;
  End;
  If V = VecSyscall Then DoSyscall(F)
  Else If V < 32 Then DoException(F)
  Else If V < 48 Then
  Begin
    DoIrq(V - 32, FromUser);
    If PreemptOn And (Not FromUser) Then KPreemptCheck(F);
  End
  Else KernelOops(F, 'vecteur inconnu');
  If FromUser Then ReturnToUser(F);
End;

{ Sauter dans le code de retour d'interruption avec le cadre Fp }
Procedure JumpToUser(Fp : LongInt);
Begin
  asm
    mov ecx,Fp
    mov eax,RetTrapEntry
    mov esp,ecx
    jmp eax
  end;
End;

