{ ---- rt_sigtimedwait, rt_sigqueueinfo ---- }

Function SigMaskFirst(T : PTask; Lo, Hi : LongInt) : LongInt;
Var I : LongInt;
Begin
  SigMaskFirst := 0;
  Lo := Lo And T^.Pend[0];
  Hi := Hi And T^.Pend[1];
  If (Lo = 0) And (Hi = 0) Then Exit;
  For I := 1 To 64 Do
    If ((I <= 32) And ((Lo And SigLoBit(I)) <> 0))
       Or ((I > 32) And ((Hi And SigHiBit(I)) <> 0)) Then
    Begin
      SigMaskFirst := I;
      Exit;
    End;
End;

{ Retirer le signal Sig en attente de T ; l'info est dans LastSigInfo }
Procedure SigTake(T : PTask; Sig : LongInt);
Begin
  If SigPopInfo(T, Sig) = 0 Then
  Begin
    T^.Pend[0] := T^.Pend[0] And Not SigLoBit(Sig);
    T^.Pend[1] := T^.Pend[1] And Not SigHiBit(Sig);
  End;
End;

Procedure PutSiginfo(Info : LongInt);
Begin
  MemFill(Info, 0, 128);
  MemL[0:Info] := LastSigInfo[0];
  MemL[0:Info + 4] := LastSigInfo[5];
  MemL[0:Info + 8] := LastSigInfo[1];
  MemL[0:Info + 12] := LastSigInfo[2];
  MemL[0:Info + 16] := LastSigInfo[3];
  MemL[0:Info + 20] := LastSigInfo[4];
End;

Function DoSigtimedwait(SetA, Info, Ts, Sz : LongInt; Wide : Boolean) : LongInt;
Var Lo, Hi, Sig, Ms, R, Dead, Left : LongInt;
Begin
  If Sz <> 8 Then
  Begin
    DoSigtimedwait := -EINVAL;
    Exit;
  End;
  If Not EnsureUser(SetA, 8, False) Then
  Begin
    DoSigtimedwait := -EFAULT;
    Exit;
  End;
  If (Info <> 0) And Not EnsureUser(Info, 128, True) Then
  Begin
    DoSigtimedwait := -EFAULT;
    Exit;
  End;
  Lo := MemL[0:SetA] And Not UnblockableLo;
  Hi := MemL[0:SetA + 4];
  R := TsToMs(Ts, Wide, Ms);
  If R <> 0 Then
  Begin
    DoSigtimedwait := R;
    Exit;
  End;
  Dead := 0;
  If Ms > 0 Then Dead := Jiffies + (Ms + 9) Div 10;
  While True Do
  Begin
    Sig := SigMaskFirst(Cur, Lo, Hi);
    If Sig <> 0 Then
    Begin
      SigTake(Cur, Sig);
      If Info <> 0 Then PutSiginfo(Info);
      DoSigtimedwait := Sig;
      Exit;
    End;
    If Ms = 0 Then
    Begin
      DoSigtimedwait := -EAGAIN;
      Exit;
    End;
    Left := 0;
    If Ms > 0 Then
    Begin
      Left := Dead - Jiffies;
      If Left <= 0 Then
      Begin
        DoSigtimedwait := -EAGAIN;
        Exit;
      End;
    End;
    Cur^.WaitLo := Lo; Cur^.WaitHi := Hi;
    R := SleepOn(LongInt(Cur) + 1, Left, True);
    Cur^.WaitLo := 0; Cur^.WaitHi := 0;
    If R = WakeTimeout Then
    Begin
      DoSigtimedwait := -EAGAIN;
      Exit;
    End;
    If (R = WakeSignal) And (SigMaskFirst(Cur, Lo, Hi) = 0) Then
    Begin
      DoSigtimedwait := -EINTR;
      Exit;
    End;
  End;
End;

Function SysRtSigtimedwait(SetA, Info, Ts, Sz : LongInt) : LongInt;
Begin
  SysRtSigtimedwait := DoSigtimedwait(SetA, Info, Ts, Sz, False);
End;

Function SysRtSigtimedwait64(SetA, Info, Ts, Sz : LongInt) : LongInt;
Begin
  SysRtSigtimedwait64 := DoSigtimedwait(SetA, Info, Ts, Sz, True);
End;

Function SigAllowed(T : PTask) : Boolean;
Begin
  SigAllowed := Capable(5) Or (Cur^.Euid = T^.Uid) Or (Cur^.Euid = T^.Suid)
      Or (Cur^.Uid = T^.Uid) Or (Cur^.Uid = T^.Suid);
End;

Function DoSigqueue(T : PTask; Sig, Info : LongInt) : LongInt;
Var Code, Val : LongInt;
Begin
  If (Sig < 0) Or (Sig > 64) Then
  Begin
    DoSigqueue := -EINVAL;
    Exit;
  End;
  If T = Nil Then
  Begin
    DoSigqueue := -ESRCH;
    Exit;
  End;
  If Not EnsureUser(Info, 128, False) Then
  Begin
    DoSigqueue := -EFAULT;
    Exit;
  End;
  Code := MemL[0:Info + 8];
  If (Code >= 0) And (T^.Tgid <> Cur^.Tgid) Then
  Begin
    DoSigqueue := -EPERM;
    Exit;
  End;
  If Not SigAllowed(T) Then
  Begin
    DoSigqueue := -EPERM;
    Exit;
  End;
  If Sig = 0 Then
  Begin
    DoSigqueue := 0;
    Exit;
  End;
  Val := MemL[0:Info + 20];
  If (Sig >= 32) And Not SigEnqueue(T, Sig, Code, Cur^.Pid, Cur^.Uid, Val) Then
  Begin
    DoSigqueue := -EAGAIN;
    Exit;
  End;
  If Sig < 32 Then SigEnqueue(T, Sig, Code, Cur^.Pid, Cur^.Uid, Val);
  SigNoDefault := True;
  SendSig(T, Sig);
  SigNoDefault := False;
  DoSigqueue := 0;
End;

Function ThreadLeader(Tgid : LongInt) : PTask;
Var I : LongInt;
Begin
  ThreadLeader := Nil;
  For I := 1 To MaxTasks - 1 Do
    If (Tasks[I].State <> TsFree) And (Tasks[I].Tgid = Tgid)
       And (Tasks[I].Pid = Tgid) Then ThreadLeader := @Tasks[I];
End;

Function SysRtSigqueueinfo(Tgid, Sig, Info : LongInt) : LongInt;
Begin
  SysRtSigqueueinfo := DoSigqueue(ThreadLeader(Tgid), Sig, Info);
End;

Function SysRtTgsigqueueinfo(Tgid, Tid, Sig, Info : LongInt) : LongInt;
Var T : PTask;
Begin
  T := PidTask(Tid);
  If (T <> Nil) And (T^.Tgid <> Tgid) Then T := Nil;
  SysRtTgsigqueueinfo := DoSigqueue(T, Sig, Info);
End;

{ ---- signalfd ---- }

Type
  PSigfd = ^TSigfd;
  TSigfd = Record
    Lo, Hi : LongInt;
  End;

Var
  SigfdOps : Array[0..15] Of LongInt;

Function SigfdRead(F : PFile; Buf, Cnt : LongInt) : LongInt;
Var S : PSigfd; Sig, N, R : LongInt;
Begin
  S := Pointer(F^.Priv);
  If Cnt < 128 Then
  Begin
    SigfdRead := -EINVAL;
    Exit;
  End;
  N := 0;
  While (Cnt - N * 128) >= 128 Do
  Begin
    Sig := SigMaskFirst(Cur, S^.Lo, S^.Hi);
    If Sig = 0 Then
    Begin
      If N > 0 Then Break;
      If (F^.Flags And O_NONBLOCK) <> 0 Then
      Begin
        SigfdRead := -EAGAIN;
        Exit;
      End;
      Cur^.WaitLo := S^.Lo; Cur^.WaitHi := S^.Hi;
      R := SleepOn(LongInt(Cur) + 1, 0, True);
      Cur^.WaitLo := 0; Cur^.WaitHi := 0;
      If R = WakeSignal Then
        If SigMaskFirst(Cur, S^.Lo, S^.Hi) = 0 Then
        Begin
          SigfdRead := -ERESTARTSYS;
          Exit;
        End;
      Continue;
    End;
    SigTake(Cur, Sig);
    R := Buf + N * 128;
    MemFill(R, 0, 128);
    MemL[0:R] := LastSigInfo[0];
    MemL[0:R + 4] := LastSigInfo[5];
    MemL[0:R + 8] := LastSigInfo[1];
    MemL[0:R + 12] := LastSigInfo[2];
    MemL[0:R + 16] := LastSigInfo[3];
    MemL[0:R + 44] := LastSigInfo[4];
    MemL[0:R + 48] := LastSigInfo[4];
    Inc(N);
  End;
  SigfdRead := N * 128;
End;

Function SigfdPoll(F : PFile; Ev : LongInt) : LongInt;
Var S : PSigfd;
Begin
  S := Pointer(F^.Priv);
  If SigMaskFirst(Cur, S^.Lo, S^.Hi) <> 0 Then SigfdPoll := POLLIN
  Else SigfdPoll := 0;
End;

Procedure SigfdRelease(F : PFile);
Begin
  KFree(F^.Priv);
End;

Function DoSignalfd(Fd, MaskA, Sz, Flags : LongInt) : LongInt;
Var S : PSigfd; F : PFile; Lo, Hi : LongInt;
Begin
  If (Flags And Not (O_NONBLOCK Or O_CLOEXEC)) <> 0 Then
  Begin
    DoSignalfd := -EINVAL;
    Exit;
  End;
  If Sz < 8 Then
  Begin
    DoSignalfd := -EINVAL;
    Exit;
  End;
  If Not EnsureUser(MaskA, 8, False) Then
  Begin
    DoSignalfd := -EFAULT;
    Exit;
  End;
  Lo := MemL[0:MaskA] And Not UnblockableLo;
  Hi := MemL[0:MaskA + 4];
  If Fd <> -1 Then
  Begin
    F := FdGet(Fd);
    If F = Nil Then
    Begin
      DoSignalfd := -EBADF;
      Exit;
    End;
    If F^.FOps <> LongInt(@SigfdOps[0]) Then
    Begin
      DoSignalfd := -EINVAL;
      Exit;
    End;
    S := Pointer(F^.Priv);
    S^.Lo := Lo; S^.Hi := Hi;
    DoSignalfd := Fd;
    Exit;
  End;
  S := Pointer(KMallocZ(SizeOf(TSigfd)));
  If S = Nil Then
  Begin
    DoSignalfd := -ENOMEM;
    Exit;
  End;
  S^.Lo := Lo; S^.Hi := Hi;
  F := AnonFile(LongInt(@SigfdOps[0]), LongInt(S), Flags And O_NONBLOCK);
  If F = Nil Then
  Begin
    KFree(LongInt(S));
    DoSignalfd := -ENOMEM;
    Exit;
  End;
  DoSignalfd := AnonFd(F, Flags);
End;

Function SysSignalfd(Fd, MaskA, Sz : LongInt) : LongInt;
Begin
  SysSignalfd := DoSignalfd(Fd, MaskA, Sz, 0);
End;

Function SysSignalfd4(Fd, MaskA, Sz, Flags : LongInt) : LongInt;
Begin
  SysSignalfd4 := DoSignalfd(Fd, MaskA, Sz, Flags);
End;

{ ---- Minuteries POSIX (timer_create ...) ---- }

Const
  MaxPTimers = 64;

Var
  PtUsed, PtTgid, PtTid, PtClk, PtSigno, PtVal, PtNotify, PtNext, PtInt,
  PtOver, PtArmed : Array[0..MaxPTimers - 1] Of LongInt;

Procedure PosixTimersExec;
Var I : LongInt;
Begin
  For I := 0 To MaxPTimers - 1 Do
    If (PtUsed[I] <> 0) And (PtTgid[I] = Cur^.Tgid) Then PtUsed[I] := 0;
End;

Procedure PosixTimersTick;
Var I, Late, Ov : LongInt; T : PTask;
Begin
  For I := 0 To MaxPTimers - 1 Do
    If (PtUsed[I] <> 0) And (PtArmed[I] <> 0)
       And (Jiffies - PtNext[I] >= 0) Then
    Begin
      If PtTid[I] <> 0 Then T := PidTask(PtTid[I])
      Else T := ThreadLeader(PtTgid[I]);
      If (T = Nil) Or (T^.State = TsZombie) Or (T^.Tgid <> PtTgid[I]) Then
      Begin
        PtUsed[I] := 0;
        Continue;
      End;
      Ov := 0;
      If PtInt[I] > 0 Then
      Begin
        Late := Jiffies - PtNext[I];
        Ov := Late Div PtInt[I];
        PtNext[I] := PtNext[I] + PtInt[I] * (Ov + 1);
      End
      Else PtArmed[I] := 0;
      PtOver[I] := Ov;
      If (PtNotify[I] <> 1) And (PtSigno[I] > 0) Then
      Begin
        SigEnqueue(T, PtSigno[I], -2, I, Ov, PtVal[I]);
        SigNoDefault := True;
        SendSig(T, PtSigno[I]);
        SigNoDefault := False;
      End;
    End;
End;

Function SysTimerCreate(Clk, Evp, IdA : LongInt) : LongInt;
Var I, Sg, Nt, Tid, Val : LongInt; T : PTask;
Begin
  If (Clk < 0) Or (Clk > 9) Then
  Begin
    SysTimerCreate := -EINVAL;
    Exit;
  End;
  If Not EnsureUser(IdA, 4, True) Then
  Begin
    SysTimerCreate := -EFAULT;
    Exit;
  End;
  I := 0;
  While (I < MaxPTimers) And (PtUsed[I] <> 0) Do Inc(I);
  If I >= MaxPTimers Then
  Begin
    SysTimerCreate := -EAGAIN;
    Exit;
  End;
  Sg := SIGALRM; Nt := 0; Tid := 0; Val := I;
  If Evp <> 0 Then
  Begin
    If Not EnsureUser(Evp, 16, False) Then
    Begin
      SysTimerCreate := -EFAULT;
      Exit;
    End;
    Val := MemL[0:Evp]; Sg := MemL[0:Evp + 4]; Nt := MemL[0:Evp + 8];
    Tid := MemL[0:Evp + 12];
    If (Nt <> 1) And ((Sg < 1) Or (Sg > 64)) Then
    Begin
      SysTimerCreate := -EINVAL;
      Exit;
    End;
    If (Nt <> 0) And (Nt <> 1) And (Nt <> 2) And (Nt <> 4) Then
    Begin
      SysTimerCreate := -EINVAL;
      Exit;
    End;
    If Nt = 4 Then
    Begin
      T := PidTask(Tid);
      If (T = Nil) Or (T^.Tgid <> Cur^.Tgid) Then
      Begin
        SysTimerCreate := -EINVAL;
        Exit;
      End;
    End
    Else Tid := 0;
  End;
  PtUsed[I] := 1; PtTgid[I] := Cur^.Tgid; PtTid[I] := Tid; PtClk[I] := Clk;
  PtSigno[I] := Sg; PtVal[I] := Val; PtNotify[I] := Nt; PtArmed[I] := 0;
  PtInt[I] := 0; PtOver[I] := 0;
  MemL[0:IdA] := I;
  SysTimerCreate := 0;
End;

Function PtCheck(Id : LongInt) : Boolean;
Begin
  PtCheck := (Id >= 0) And (Id < MaxPTimers) And (PtUsed[Id] <> 0)
      And (PtTgid[Id] = Cur^.Tgid);
End;

Function SecNsToTicks(Sec, Ns : LongInt) : LongInt;
Begin
  SecNsToTicks := Sec * HZ + (Ns + (1000000000 Div HZ) - 1)
      Div (1000000000 Div HZ);
End;

Procedure PtLeft(Id : LongInt; Var Sec, Ns : LongInt);
Var L : LongInt;
Begin
  Sec := 0; Ns := 0;
  If PtArmed[Id] = 0 Then Exit;
  L := PtNext[Id] - Jiffies;
  If L < 1 Then L := 1;
  Sec := L Div HZ;
  Ns := (L Mod HZ) * (1000000000 Div HZ);
End;

Function SysTimerSettime(Id, Flags, NewP, OldP : LongInt) : LongInt;
Var S, Ns, T, Sec, Nn, Now : LongInt;
Begin
  If Not PtCheck(Id) Then
  Begin
    SysTimerSettime := -EINVAL;
    Exit;
  End;
  If Not EnsureUser(NewP, 16, False) Then
  Begin
    SysTimerSettime := -EFAULT;
    Exit;
  End;
  If (OldP <> 0) And Not EnsureUser(OldP, 16, True) Then
  Begin
    SysTimerSettime := -EFAULT;
    Exit;
  End;
  If (MemL[0:NewP + 4] < 0) Or (MemL[0:NewP + 4] >= 1000000000)
     Or (MemL[0:NewP + 12] < 0) Or (MemL[0:NewP + 12] >= 1000000000)
     Or (MemL[0:NewP] < 0) Or (MemL[0:NewP + 8] < 0) Then
  Begin
    SysTimerSettime := -EINVAL;
    Exit;
  End;
  If OldP <> 0 Then
  Begin
    PtLeft(Id, Sec, Nn);
    MemL[0:OldP + 8] := Sec; MemL[0:OldP + 12] := Nn;
    MemL[0:OldP] := PtInt[Id] Div HZ;
    MemL[0:OldP + 4] := (PtInt[Id] Mod HZ) * (1000000000 Div HZ);
  End;
  S := MemL[0:NewP + 8]; Ns := MemL[0:NewP + 12];
  If (S = 0) And (Ns = 0) Then
  Begin
    PtArmed[Id] := 0;
    PtInt[Id] := 0;
    SysTimerSettime := 0;
    Exit;
  End;
  If (Flags And 1) <> 0 Then
  Begin
    If PtClk[Id] = 0 Then Now := XTime Else Now := Jiffies Div HZ;
    T := SecNsToTicks(S - Now, Ns - XUsec * 1000);
    If T < 1 Then T := 1;
  End
  Else
  Begin
    T := SecNsToTicks(S, Ns);
    If T < 1 Then T := 1;
  End;
  PtNext[Id] := Jiffies + T;
  PtInt[Id] := SecNsToTicks(MemL[0:NewP], MemL[0:NewP + 4]);
  PtArmed[Id] := 1;
  SysTimerSettime := 0;
End;

Function SysTimerGettime(Id, CurP : LongInt) : LongInt;
Var Sec, Ns : LongInt;
Begin
  If Not PtCheck(Id) Then
  Begin
    SysTimerGettime := -EINVAL;
    Exit;
  End;
  If Not EnsureUser(CurP, 16, True) Then
  Begin
    SysTimerGettime := -EFAULT;
    Exit;
  End;
  PtLeft(Id, Sec, Ns);
  MemL[0:CurP + 8] := Sec; MemL[0:CurP + 12] := Ns;
  MemL[0:CurP] := PtInt[Id] Div HZ;
  MemL[0:CurP + 4] := (PtInt[Id] Mod HZ) * (1000000000 Div HZ);
  SysTimerGettime := 0;
End;

Function SysTimerGetoverrun(Id : LongInt) : LongInt;
Begin
  If PtCheck(Id) Then SysTimerGetoverrun := PtOver[Id] Else
    SysTimerGetoverrun := -EINVAL;
End;

Function SysTimerDelete(Id : LongInt) : LongInt;
Begin
  If Not PtCheck(Id) Then
  Begin
    SysTimerDelete := -EINVAL;
    Exit;
  End;
  PtUsed[Id] := 0; PtArmed[Id] := 0;
  SysTimerDelete := 0;
End;

Function SysTimerSettime64(Id, Flags, NewP, OldP : LongInt) : LongInt;
Var S, R : LongInt;
Begin
  S := Scratch(32);
  If (S = 0) Or Not EnsureUser(NewP, 32, False) Then
  Begin
    SysTimerSettime64 := -EFAULT;
    Exit;
  End;
  Ts64To32(NewP, S);
  Ts64To32(NewP + 16, S + 8);
  R := SysTimerSettime(Id, Flags, S, S + 16);
  If (R = 0) And (OldP <> 0) And EnsureUser(OldP, 32, True) Then
  Begin
    Ts32To64(S + 16, OldP);
    Ts32To64(S + 24, OldP + 16);
  End;
  SysTimerSettime64 := R;
End;

Function SysTimerGettime64(Id, CurP : LongInt) : LongInt;
Var S, R : LongInt;
Begin
  S := Scratch(16);
  If (S = 0) Or Not EnsureUser(CurP, 32, True) Then
  Begin
    SysTimerGettime64 := -EFAULT;
    Exit;
  End;
  R := SysTimerGettime(Id, S);
  If R = 0 Then
  Begin
    Ts32To64(S, CurP);
    Ts32To64(S + 8, CurP + 16);
  End;
  SysTimerGettime64 := R;
End;

{ ---- pidfd ---- }

Function PidfdPoll(F : PFile; Ev : LongInt) : LongInt;
Var T : PTask;
Begin
  T := PidTask(F^.Priv);
  If (T = Nil) Or (T^.State = TsZombie) Or (T^.State = TsFree) Then
    PidfdPoll := POLLIN
  Else PidfdPoll := 0;
End;

Function SysPidfdOpen(Pid, Flags : LongInt) : LongInt;
Var T : PTask; F : PFile;
Begin
  If (Flags And Not O_NONBLOCK) <> 0 Then
  Begin
    SysPidfdOpen := -EINVAL;
    Exit;
  End;
  If Cur^.Ns[3] <> 0 Then T := VisFind(Pid, False) Else T := PidTask(Pid);
  If (Pid <= 0) Or (T = Nil) Then
  Begin
    If Pid <= 0 Then SysPidfdOpen := -EINVAL Else SysPidfdOpen := -ESRCH;
    Exit;
  End;
  If T^.Tgid <> T^.Pid Then
  Begin
    SysPidfdOpen := -EINVAL;
    Exit;
  End;
  F := AnonFile(LongInt(@PidfdOps[0]), Pid, Flags);
  If F = Nil Then
  Begin
    SysPidfdOpen := -ENOMEM;
    Exit;
  End;
  SysPidfdOpen := AnonFd(F, O_CLOEXEC);
End;

Function SysPidfdSendSignal(Pfd, Sig, Info, Flags : LongInt) : LongInt;
Var F : PFile; T : PTask;
Begin
  If Flags <> 0 Then
  Begin
    SysPidfdSendSignal := -EINVAL;
    Exit;
  End;
  F := FdGet(Pfd);
  If F = Nil Then
  Begin
    SysPidfdSendSignal := -EBADF;
    Exit;
  End;
  If F^.FOps <> LongInt(@PidfdOps[0]) Then
  Begin
    SysPidfdSendSignal := -EBADF;
    Exit;
  End;
  T := PidTask(F^.Priv);
  If T = Nil Then
  Begin
    SysPidfdSendSignal := -ESRCH;
    Exit;
  End;
  { un zombie non encore recolte accepte le signal (comme Linux) : rien a
    livrer }
  If T^.State = TsZombie Then
  Begin
    If SigAllowed(T) Then SysPidfdSendSignal := 0
    Else SysPidfdSendSignal := -EPERM;
    Exit;
  End;
  If Info <> 0 Then
  Begin
    SysPidfdSendSignal := DoSigqueue(T, Sig, Info);
    Exit;
  End;
  If Not SigAllowed(T) Then
  Begin
    SysPidfdSendSignal := -EPERM;
    Exit;
  End;
  If Sig <> 0 Then SendSig(T, Sig);
  SysPidfdSendSignal := 0;
End;

{ ---- Verrous de fichiers : flock, fcntl POSIX, OFD ---- }

Const
  MaxLocks = 256;
  LkEofLo = -1;                   { fin de fichier : 2^63 - 1 }
  LkEofHi = $7FFFFFFF;

Var
  LkUsed, LkIno, LkOwner, LkKind, LkType, LkStart, LkEnd, LkPid,
  LkStartH, LkEndH : Array[0..MaxLocks - 1] Of LongInt;

Function LkClass(K : LongInt) : LongInt;
Begin
  If K = 0 Then LkClass := 0 Else LkClass := 1;
End;

{ Verrou en conflit avec (Ino, Kind, Owner, Type, [S, E] 64 bits) ; -1 si
  aucun }
Function LkConflict(Ino, Kind, Owner, Typ, SL, SH, EL, EH : LongInt)
    : LongInt;
Var I : LongInt;
Begin
  LkConflict := -1;
  For I := 0 To MaxLocks - 1 Do
    If (LkUsed[I] <> 0) And (LkIno[I] = Ino)
       And (LkClass(LkKind[I]) = LkClass(Kind))
       And ((LkOwner[I] <> Owner) Or (LkKind[I] <> Kind))
       And ((LkType[I] = 1) Or (Typ = 1))
       And U64Le(LkStart[I], LkStartH[I], EL, EH)
       And U64Le(SL, SH, LkEnd[I], LkEndH[I]) Then
    Begin
      LkConflict := I;
      Exit;
    End;
End;

Function LkNew : LongInt;
Var I : LongInt;
Begin
  For I := 0 To MaxLocks - 1 Do
    If LkUsed[I] = 0 Then
    Begin
      LkUsed[I] := 1;
      LkNew := I;
      Exit;
    End;
  LkNew := -1;
End;

{ Retirer [S, E] des verrous du proprietaire (decoupe les verrous) }
Function LkClear(Ino, Kind, Owner, SL, SH, EL, EH : LongInt) : Boolean;
Var I, J, OL, OH : LongInt;
Begin
  LkClear := True;
  For I := 0 To MaxLocks - 1 Do
    If (LkUsed[I] <> 0) And (LkIno[I] = Ino) And (LkKind[I] = Kind)
       And (LkOwner[I] = Owner)
       And U64Le(LkStart[I], LkStartH[I], EL, EH)
       And U64Le(SL, SH, LkEnd[I], LkEndH[I]) Then
    Begin
      OL := LkEnd[I]; OH := LkEndH[I];
      If U64Lt(LkStart[I], LkStartH[I], SL, SH)
         And U64Lt(EL, EH, OL, OH) Then
      Begin
        J := LkNew;
        If J < 0 Then
        Begin
          LkClear := False;
          Exit;
        End;
        LkIno[J] := Ino; LkKind[J] := Kind; LkOwner[J] := Owner;
        LkType[J] := LkType[I]; LkPid[J] := LkPid[I];
        LkStart[J] := EL; LkStartH[J] := EH;
        U64AddU(LkStart[J], LkStartH[J], 1);
        LkEnd[J] := OL; LkEndH[J] := OH;
        LkEnd[I] := SL; LkEndH[I] := SH;
        U64Sub(LkEnd[I], LkEndH[I], 1, 0);
      End
      Else If U64Lt(LkStart[I], LkStartH[I], SL, SH) Then
      Begin
        LkEnd[I] := SL; LkEndH[I] := SH;
        U64Sub(LkEnd[I], LkEndH[I], 1, 0);
      End
      Else If U64Lt(EL, EH, OL, OH) Then
      Begin
        LkStart[I] := EL; LkStartH[I] := EH;
        U64AddU(LkStart[I], LkStartH[I], 1);
      End
      Else LkUsed[I] := 0;
    End;
End;

Function LkSet(Ino, Kind, Owner, Pid, Typ, SL, SH, EL, EH : LongInt;
    Wait : Boolean) : LongInt;
Var C, J : LongInt;
Begin
  If Typ = 2 Then
  Begin
    LkClear(Ino, Kind, Owner, SL, SH, EL, EH);
    WakeUp(LongInt(@LkUsed[0]));
    LkSet := 0;
    Exit;
  End;
  While True Do
  Begin
    C := LkConflict(Ino, Kind, Owner, Typ, SL, SH, EL, EH);
    If C < 0 Then Break;
    If Not Wait Then
    Begin
      LkSet := -EAGAIN;
      Exit;
    End;
    If SleepOn(LongInt(@LkUsed[0]), 0, True) = WakeSignal Then
    Begin
      LkSet := -ERESTARTSYS;
      Exit;
    End;
  End;
  If Not LkClear(Ino, Kind, Owner, SL, SH, EL, EH) Then
  Begin
    LkSet := -ENOLCK;
    Exit;
  End;
  J := LkNew;
  If J < 0 Then
  Begin
    LkSet := -ENOLCK;
    Exit;
  End;
  LkIno[J] := Ino; LkKind[J] := Kind; LkOwner[J] := Owner; LkType[J] := Typ;
  LkStart[J] := SL; LkStartH[J] := SH; LkEnd[J] := EL; LkEndH[J] := EH;
  LkPid[J] := Pid;
  WakeUp(LongInt(@LkUsed[0]));
  LkSet := 0;
End;

Procedure LocksFileReleased(F : LongInt);
Var I : LongInt; Any : Boolean;
Begin
  Any := False;
  For I := 0 To MaxLocks - 1 Do
    If (LkUsed[I] <> 0) And (LkOwner[I] = F) And (LkKind[I] <> 1) Then
    Begin
      LkUsed[I] := 0;
      Any := True;
    End;
  If Any Then WakeUp(LongInt(@LkUsed[0]));
End;

Procedure LocksPosixClose(Tgid, Ino : LongInt);
Var I : LongInt; Any : Boolean;
Begin
  Any := False;
  For I := 0 To MaxLocks - 1 Do
    If (LkUsed[I] <> 0) And (LkKind[I] = 1) And (LkOwner[I] = Tgid)
       And (LkIno[I] = Ino) Then
    Begin
      LkUsed[I] := 0;
      Any := True;
    End;
  If Any Then WakeUp(LongInt(@LkUsed[0]));
End;

Procedure LocksProcExit(Tgid : LongInt);
Var I : LongInt; Any : Boolean;
Begin
  Any := False;
  For I := 0 To MaxLocks - 1 Do
    If (LkUsed[I] <> 0) And (LkKind[I] = 1) And (LkOwner[I] = Tgid) Then
    Begin
      LkUsed[I] := 0;
      Any := True;
    End;
  If Any Then WakeUp(LongInt(@LkUsed[0]));
End;

Function SysFlock(Fd, Op : LongInt) : LongInt;
Var F : PFile; Typ : LongInt;
Begin
  F := FdGet(Fd);
  If F = Nil Then
  Begin
    SysFlock := -EBADF;
    Exit;
  End;
  Case Op And 3 Of
    1 : Typ := 0;
    2 : Typ := 1;
  Else
    Typ := 2;
  End;
  If (Op And 8) <> 0 Then Typ := 2
  Else If (Op And 3) = 0 Then
  Begin
    SysFlock := -EINVAL;
    Exit;
  End;
  SysFlock := LkSet(LongInt(F^.Inode), 0, LongInt(F), Cur^.Tgid, Typ, 0, 0,
      LkEofLo, LkEofHi, (Op And 4) = 0);
End;

{ fcntl : F_GETLK/SETLK/SETLKW (16 octets), F_GETLK64... (24 octets), OFD }
Function DoFcntlLock(F : PFile; Cmd, Arg : LongInt) : LongInt;
Var Wide, Ofd, Wait, Get : Boolean; Typ, Wh, C, Kind, Owner, Ino, Sz,
    SL, SH, LL, LH, EL, EH : LongInt;
Begin
  Wide := (Cmd = 12) Or (Cmd = 13) Or (Cmd = 14) Or (Cmd >= 36);
  Ofd := Cmd >= 36;
  Get := (Cmd = 5) Or (Cmd = 12) Or (Cmd = 36);
  Wait := (Cmd = 7) Or (Cmd = 14) Or (Cmd = 38);
  If Cmd >= 36 Then
  Begin
    Get := Cmd = 36;
    Wait := Cmd = 38;
  End;
  If Wide Then Sz := 24 Else Sz := 16;
  If Not EnsureUser(Arg, Sz, True) Then
  Begin
    DoFcntlLock := -EFAULT;
    Exit;
  End;
  Typ := MemW[0:Arg]; Wh := MemW[0:Arg + 2];
  If Wide Then
  Begin
    SL := MemL[0:Arg + 4]; SH := MemL[0:Arg + 8];
    LL := MemL[0:Arg + 12]; LH := MemL[0:Arg + 16];
  End
  Else
  Begin
    SL := MemL[0:Arg + 4];
    If SL < 0 Then SH := -1 Else SH := 0;
    LL := MemL[0:Arg + 8];
    If LL < 0 Then LH := -1 Else LH := 0;
  End;
  If (Typ > 2) Then
  Begin
    DoFcntlLock := -EINVAL;
    Exit;
  End;
  If Ofd And (MemL[0:Arg + Sz - 4] <> 0) Then
  Begin
    DoFcntlLock := -EINVAL;
    Exit;
  End;
  Case Wh Of
    0 : ;
    1 : U64Add(SL, SH, F^.Pos, F^.PosHi);
    2 : U64Add(SL, SH, F^.Inode^.Size, F^.Inode^.SizeHi);
  Else
    Begin
      DoFcntlLock := -EINVAL;
      Exit;
    End;
  End;
  If (LL = 0) And (LH = 0) Then
  Begin
    EL := LkEofLo; EH := LkEofHi;
  End
  Else If LH >= 0 Then
  Begin
    EL := SL; EH := SH;
    U64Add(EL, EH, LL, LH);
    U64Sub(EL, EH, 1, 0);
  End
  Else
  Begin
    EL := SL; EH := SH;
    U64Sub(EL, EH, 1, 0);
    U64Add(SL, SH, LL, LH);
  End;
  If (SH < 0) Or (EH < 0) Then
  Begin
    DoFcntlLock := -EINVAL;
    Exit;
  End;
  If Ofd Then Kind := 2 Else Kind := 1;
  If Ofd Then Owner := LongInt(F) Else Owner := Cur^.Tgid;
  Ino := LongInt(F^.Inode);
  If Get Then
  Begin
    If Typ = 2 Then
    Begin
      DoFcntlLock := -EINVAL;
      Exit;
    End;
    C := LkConflict(Ino, Kind, Owner, Typ, SL, SH, EL, EH);
    If C < 0 Then MemW[0:Arg] := 2
    Else
    Begin
      MemW[0:Arg] := LkType[C];
      MemW[0:Arg + 2] := 0;
      If LkEndH[C] = LkEofHi Then
      Begin
        LL := 0; LH := 0;
      End
      Else
      Begin
        LL := LkEnd[C]; LH := LkEndH[C];
        U64Sub(LL, LH, LkStart[C], LkStartH[C]);
        U64AddU(LL, LH, 1);
      End;
      If Wide Then
      Begin
        MemL[0:Arg + 4] := LkStart[C];
        MemL[0:Arg + 8] := LkStartH[C];
        MemL[0:Arg + 12] := LL;
        MemL[0:Arg + 16] := LH;
        If LkKind[C] = 2 Then MemL[0:Arg + 20] := -1
        Else MemL[0:Arg + 20] := LkPid[C];
      End
      Else
      Begin
        MemL[0:Arg + 4] := LkStart[C];
        MemL[0:Arg + 8] := LL;
        If LkKind[C] = 2 Then MemL[0:Arg + 12] := -1
        Else MemL[0:Arg + 12] := LkPid[C];
      End;
    End;
    DoFcntlLock := 0;
    Exit;
  End;
  If (Typ = 0) And ((F^.Flags And O_ACCMODE) = O_WRONLY) Then
  Begin
    DoFcntlLock := -EBADF;
    Exit;
  End;
  If (Typ = 1) And ((F^.Flags And O_ACCMODE) = O_RDONLY) Then
  Begin
    DoFcntlLock := -EBADF;
    Exit;
  End;
  DoFcntlLock := LkSet(Ino, Kind, Owner, Cur^.Tgid, Typ, SL, SH, EL, EH, Wait);
End;

{ ---- Enregistrement ---- }

Procedure InitSignalsRt;
Begin
  MemFill(LongInt(@SigfdOps[0]), 0, SizeOf(SigfdOps));
  SigfdOps[FoRead] := LongInt(@SigfdRead);
  SigfdOps[FoPoll] := LongInt(@SigfdPoll);
  SigfdOps[FoRelease] := LongInt(@SigfdRelease);
  MemFill(LongInt(@PidfdOps[0]), 0, SizeOf(PidfdOps));
  PidfdOps[FoPoll] := LongInt(@PidfdPoll);
  SysReg(177, LongInt(@SysRtSigtimedwait), 4);
  SysReg(421, LongInt(@SysRtSigtimedwait64), 4);
  SysReg(178, LongInt(@SysRtSigqueueinfo), 3);
  SysReg(335, LongInt(@SysRtTgsigqueueinfo), 4);
  SysReg(321, LongInt(@SysSignalfd), 3);
  SysReg(327, LongInt(@SysSignalfd4), 4);
  SysReg(259, LongInt(@SysTimerCreate), 3);
  SysReg(260, LongInt(@SysTimerSettime), 4);
  SysReg(261, LongInt(@SysTimerGettime), 2);
  SysReg(262, LongInt(@SysTimerGetoverrun), 1);
  SysReg(263, LongInt(@SysTimerDelete), 1);
  SysReg(409, LongInt(@SysTimerSettime64), 4);
  SysReg(408, LongInt(@SysTimerGettime64), 2);
  SysReg(434, LongInt(@SysPidfdOpen), 2);
  SysReg(424, LongInt(@SysPidfdSendSignal), 4);
  SysReg(143, LongInt(@SysFlock), 2);
End;

{ ==================================================================== }
{ Partie 30 - IPC SysV (memoire partagee, semaphores, files de messages) }
{ ==================================================================== }
{ (placee apres la partie 29) }

Const
  MaxIpc = 64;
  IPC_CREAT = $200; IPC_EXCL = $400; IPC_NOWAIT = $800;
  EIDRM = 43; ENOMSG = 42; ETIMEDOUT = 110;

Type
  PPerm = ^TPerm;
  TPerm = Record
    Used, Key, Uid, Gid, Cuid, Cgid, Mode, Seq, Ns : LongInt;
  End;

Var
  IpcSeq : LongInt;
  ShmP, SemP, MsgP : Array[0..MaxIpc - 1] Of TPerm;
  { memoire partagee }
  ShmSize, ShmPages, ShmNpg, ShmOrder, ShmNatt, ShmAt, ShmDt, ShmCt, ShmCpid,
  ShmLpid, ShmRm : Array[0..MaxIpc - 1] Of LongInt;
  { semaphores }
  SemN, SemVal, SemOt, SemCt : Array[0..MaxIpc - 1] Of LongInt;
  { messages }
  MsgHead, MsgTail, MsgCnt, MsgBytes, MsgQb, MsgSt, MsgRt, MsgCt, MsgLspid,
  MsgLrpid : Array[0..MaxIpc - 1] Of LongInt;
  { annulations SEM_UNDO }
  UnUsed, UnTgid, UnId, UnNum, UnAdj : Array[0..255] Of LongInt;

Function IpcMake(Seq, Idx : LongInt) : LongInt;
Begin
  IpcMake := Seq * MaxIpc + Idx;
End;

Function IpcCheckId(P : LongInt; Id : LongInt) : LongInt;
Var Idx : LongInt; Pm : PPerm;
Begin
  If Id < 0 Then
  Begin
    IpcCheckId := -1;
    Exit;
  End;
  Idx := Id Mod MaxIpc;
  Pm := Pointer(P + Idx * SizeOf(TPerm));
  If (Pm^.Used = 0) Or (Pm^.Seq <> Id Div MaxIpc)
     Or (Pm^.Ns <> Cur^.Ns[2]) Then IpcCheckId := -1
  Else IpcCheckId := Idx;
End;

{ Droits d'acces : Need = 4 (lecture) ou 2 (ecriture) }
Function IpcAllowed(Pm : PPerm; Need : LongInt) : Boolean;
Var M : LongInt;
Begin
  If Capable(15) Then
  Begin
    IpcAllowed := True;
    Exit;
  End;
  If (Cur^.Euid = Pm^.Uid) Or (Cur^.Euid = Pm^.Cuid) Then M := (Pm^.Mode Shr 6)
  Else If (Cur^.Egid = Pm^.Gid) Or (Cur^.Egid = Pm^.Cgid) Then
    M := (Pm^.Mode Shr 3)
  Else M := Pm^.Mode;
  IpcAllowed := (M And Need) = Need;
End;

Procedure IpcInit(Pm : PPerm; Key, Flg : LongInt);
Begin
  Inc(IpcSeq);
  If IpcSeq > 30000 Then IpcSeq := 1;
  Pm^.Used := 1; Pm^.Key := Key; Pm^.Uid := Cur^.Euid; Pm^.Cuid := Cur^.Euid;
  Pm^.Gid := Cur^.Egid; Pm^.Cgid := Cur^.Egid; Pm^.Mode := Flg And $1FF;
  Pm^.Seq := IpcSeq;
  Pm^.Ns := Cur^.Ns[2];
End;

Procedure PermOut(Dst : LongInt; Pm : PPerm);
Begin
  MemFill(Dst, 0, 36);
  MemL[0:Dst] := Pm^.Key; MemL[0:Dst + 4] := Pm^.Uid;
  MemL[0:Dst + 8] := Pm^.Gid; MemL[0:Dst + 12] := Pm^.Cuid;
  MemL[0:Dst + 16] := Pm^.Cgid; MemW[0:Dst + 20] := Pm^.Mode;
  MemW[0:Dst + 24] := Pm^.Seq;
End;

{ IPC_SET : uid, gid, mode d'un ipc64_perm utilisateur }
Function PermSet(Src : LongInt; Pm : PPerm) : LongInt;
Begin
  If Not (Capable(15) Or (Cur^.Euid = Pm^.Uid) Or (Cur^.Euid = Pm^.Cuid)) Then
  Begin
    PermSet := -EPERM;
    Exit;
  End;
  Pm^.Uid := MemL[0:Src + 4]; Pm^.Gid := MemL[0:Src + 8];
  Pm^.Mode := MemW[0:Src + 20] And $1FF;
  PermSet := 0;
End;

Function IpcOwner(Pm : PPerm) : Boolean;
Begin
  IpcOwner := Capable(15) Or (Cur^.Euid = Pm^.Uid) Or (Cur^.Euid = Pm^.Cuid);
End;

{ ---- Memoire partagee ---- }

Procedure ShmFree(I : LongInt);
Var K : LongInt;
Begin
  For K := 0 To ShmNpg[I] - 1 Do
    If MemL[0:ShmPages[I] + K * 4] <> 0 Then
      FreePages(MemL[0:ShmPages[I] + K * 4], 0);
  FreePages(ShmPages[I], ShmOrder[I]);
  ShmP[I].Used := 0;
End;

Procedure ShmVmaGet(Seg : LongInt);
Begin
  Inc(ShmNatt[Seg]);
End;

Procedure ShmVmaDrop(Seg : LongInt);
Begin
  If (Seg < 0) Or (Seg >= MaxIpc) Or (ShmP[Seg].Used = 0) Then Exit;
  If ShmNatt[Seg] > 0 Then Dec(ShmNatt[Seg]);
  ShmDt[Seg] := XTime;
  ShmLpid[Seg] := Cur^.Tgid;
  If (ShmNatt[Seg] = 0) And (ShmRm[Seg] <> 0) Then ShmFree(Seg);
End;

Function ShmFrame(Seg, Idx : LongInt) : LongInt;
Begin
  ShmFrame := 0;
  If (Seg < 0) Or (Seg >= MaxIpc) Or (ShmP[Seg].Used = 0) Then Exit;
  If (Idx < 0) Or (Idx >= ShmNpg[Seg]) Then Exit;
  ShmFrame := MemL[0:ShmPages[Seg] + Idx * 4];
End;

Function DoShmget(Key, Size, Flg : LongInt) : LongInt;
Var I, K, Free, Np, Ord_ : LongInt; Pg : LongInt;
Begin
  Free := -1;
  If Key <> 0 Then
    For I := 0 To MaxIpc - 1 Do
      If (ShmP[I].Used <> 0) And (ShmP[I].Key = Key) And (ShmRm[I] = 0)
         And (ShmP[I].Ns = Cur^.Ns[2]) Then
      Begin
        If ((Flg And IPC_CREAT) <> 0) And ((Flg And IPC_EXCL) <> 0) Then
        Begin
          DoShmget := -EEXIST;
          Exit;
        End;
        If Not IpcAllowed(@ShmP[I], (Flg Shr 6) And 6) Then
        Begin
          DoShmget := -EACCES;
          Exit;
        End;
        If Size > ShmSize[I] Then
        Begin
          DoShmget := -EINVAL;
          Exit;
        End;
        DoShmget := IpcMake(ShmP[I].Seq, I);
        Exit;
      End;
  If (Key <> 0) And ((Flg And IPC_CREAT) = 0) Then
  Begin
    DoShmget := -ENOENT;
    Exit;
  End;
  If (Size <= 0) Or (Size > 16 * 1024 * 1024) Then
  Begin
    DoShmget := -EINVAL;
    Exit;
  End;
  For I := 0 To MaxIpc - 1 Do
    If ShmP[I].Used = 0 Then
    Begin
      Free := I;
      Break;
    End;
  If Free < 0 Then
  Begin
    DoShmget := -ENOSPC;
    Exit;
  End;
  Np := (Size + 4095) Shr 12;
  Ord_ := OrderFor(Np * 4);
  Pg := AllocPages(Ord_);
  If Pg = 0 Then
  Begin
    DoShmget := -ENOMEM;
    Exit;
  End;
  MemFill(Pg, 0, PageSize Shl Ord_);
  For K := 0 To Np - 1 Do
  Begin
    I := AllocZeroPage;
    If I = 0 Then
    Begin
      ShmPages[Free] := Pg; ShmNpg[Free] := Np; ShmOrder[Free] := Ord_;
      ShmFree(Free);
      DoShmget := -ENOMEM;
      Exit;
    End;
    MemL[0:Pg + K * 4] := I;
  End;
  IpcInit(@ShmP[Free], Key, Flg);
  ShmSize[Free] := Size; ShmPages[Free] := Pg; ShmNpg[Free] := Np;
  ShmOrder[Free] := Ord_; ShmNatt[Free] := 0; ShmRm[Free] := 0;
  ShmAt[Free] := 0; ShmDt[Free] := 0; ShmCt[Free] := XTime;
  ShmCpid[Free] := Cur^.Tgid; ShmLpid[Free] := 0;
  DoShmget := IpcMake(ShmP[Free].Seq, Free);
End;

Function DoShmat(Id, Addr, Flg : LongInt; Var Res : LongInt) : LongInt;
Var I, Prot, Mf, A, R : LongInt; V : PVma;
Begin
  I := IpcCheckId(LongInt(@ShmP[0]), Id);
  If I < 0 Then
  Begin
    DoShmat := -EINVAL;
    Exit;
  End;
  If (Flg And $1000) <> 0 Then Prot := PROT_READ
  Else Prot := PROT_READ Or PROT_WRITE;
  If (Flg And $8000) <> 0 Then Prot := Prot Or PROT_EXEC;
  If Not IpcAllowed(@ShmP[I], 4 Or (2 * Ord((Flg And $1000) = 0))) Then
  Begin
    DoShmat := -EACCES;
    Exit;
  End;
  Mf := MAP_SHARED;
  A := Addr;
  If A <> 0 Then
  Begin
    If (Flg And $4000) <> 0 Then A := A And Not $FFF;
    If (A And $FFF) <> 0 Then
    Begin
      DoShmat := -EINVAL;
      Exit;
    End;
    Mf := Mf Or MAP_FIXED;
  End;
  R := MmMap(Cur^.Mm, A, ShmNpg[I] Shl 12, Prot, Mf, 0, 0, 0);
  If (R < 0) And (R > -4096) Then
  Begin
    DoShmat := R;
    Exit;
  End;
  V := FindVma(Cur^.Mm, R);
  If V = Nil Then
  Begin
    DoShmat := -ENOMEM;
    Exit;
  End;
  V^.Flags := V^.Flags Or VmShm;
  V^.Off := I;
  V^.FLen := 0;
  Inc(ShmNatt[I]);
  ShmAt[I] := XTime;
  ShmLpid[I] := Cur^.Tgid;
  Res := R;
  DoShmat := 0;
End;

Function DoShmdt(Addr : LongInt) : LongInt;
Var V : PVma;
Begin
  V := FindVma(Cur^.Mm, Addr);
  If (V = Nil) Or (V^.Start <> Addr) Or ((V^.Flags And VmShm) = 0) Then
  Begin
    DoShmdt := -EINVAL;
    Exit;
  End;
  DoShmdt := MmUnmap(Cur^.Mm, V^.Start, V^.Fin);
End;

Function DoShmctl(Id, Cmd, Buf : LongInt) : LongInt;
Var I, R : LongInt;
Begin
  Cmd := Cmd And $FF;
  If Cmd = 3 Then
  Begin
    { IPC_INFO : struct shminfo64 }
    If Not EnsureUser(Buf, 40, True) Then
    Begin
      DoShmctl := -EFAULT;
      Exit;
    End;
    MemFill(Buf, 0, 40);
    MemL[0:Buf] := 16 * 1024 * 1024; MemL[0:Buf + 4] := 1;
    MemL[0:Buf + 8] := 16 * 1024 * 1024; MemL[0:Buf + 12] := MaxIpc;
    MemL[0:Buf + 16] := 4096;
    DoShmctl := MaxIpc - 1;
    Exit;
  End;
  If Cmd = 14 Then
  Begin
    { SHM_INFO : struct shm_info }
    If Not EnsureUser(Buf, 24, True) Then
    Begin
      DoShmctl := -EFAULT;
      Exit;
    End;
    MemFill(Buf, 0, 24);
    For I := 0 To MaxIpc - 1 Do
      If ShmP[I].Used <> 0 Then
      Begin
        MemAdd(Buf, 1);
        MemAdd(Buf + 4, ShmNpg[I]);
      End;
    DoShmctl := MaxIpc - 1;
    Exit;
  End;
  I := IpcCheckId(LongInt(@ShmP[0]), Id);
  If I < 0 Then
  Begin
    DoShmctl := -EINVAL;
    Exit;
  End;
  Case Cmd Of
    0 : Begin
          If Not IpcOwner(@ShmP[I]) Then
          Begin
            DoShmctl := -EPERM;
            Exit;
          End;
          ShmRm[I] := 1;
          ShmP[I].Key := 0;
          If ShmNatt[I] = 0 Then ShmFree(I);
          DoShmctl := 0;
        End;
    1 : Begin
          If Not EnsureUser(Buf, 84, False) Then
          Begin
            DoShmctl := -EFAULT;
            Exit;
          End;
          R := PermSet(Buf, @ShmP[I]);
          If R = 0 Then ShmCt[I] := XTime;
          DoShmctl := R;
        End;
    2, 13 :
        Begin
          If Not IpcAllowed(@ShmP[I], 4) Then
          Begin
            DoShmctl := -EACCES;
            Exit;
          End;
          If Not EnsureUser(Buf, 84, True) Then
          Begin
            DoShmctl := -EFAULT;
            Exit;
          End;
          MemFill(Buf, 0, 84);
          PermOut(Buf, @ShmP[I]);
          MemL[0:Buf + 36] := ShmSize[I]; MemL[0:Buf + 40] := ShmAt[I];
          MemL[0:Buf + 48] := ShmDt[I]; MemL[0:Buf + 56] := ShmCt[I];
          MemL[0:Buf + 64] := ShmCpid[I]; MemL[0:Buf + 68] := ShmLpid[I];
          MemL[0:Buf + 72] := ShmNatt[I];
          If Cmd = 13 Then DoShmctl := IpcMake(ShmP[I].Seq, I)
          Else DoShmctl := 0;
        End;
    11, 12 : DoShmctl := 0;
  Else
    DoShmctl := -EINVAL;
  End;
End;

{ ---- Semaphores ---- }

Procedure SemUndoExit(Tgid : LongInt);
Var K, I, Id, V : LongInt;
Begin
  For K := 0 To 255 Do
    If (UnUsed[K] <> 0) And (UnTgid[K] = Tgid) Then
    Begin
      UnUsed[K] := 0;
      I := UnId[K] Mod MaxIpc;
      If (SemP[I].Used <> 0) And (SemP[I].Seq = UnId[K] Div MaxIpc)
         And (UnNum[K] < SemN[I]) Then
      Begin
        V := MemL[0:SemVal[I] + UnNum[K] * 16] + UnAdj[K];
        If V < 0 Then V := 0;
        If V > 32767 Then V := 32767;
        MemL[0:SemVal[I] + UnNum[K] * 16] := V;
        WakeUp(LongInt(@SemN[I]) + I * 4);
      End;
    End;
  Id := 0;
End;

Function DoSemget(Key, N, Flg : LongInt) : LongInt;
Var I, Free : LongInt;
Begin
  Free := -1;
  If Key <> 0 Then
    For I := 0 To MaxIpc - 1 Do
      If (SemP[I].Used <> 0) And (SemP[I].Key = Key)
         And (SemP[I].Ns = Cur^.Ns[2]) Then
      Begin
        If ((Flg And IPC_CREAT) <> 0) And ((Flg And IPC_EXCL) <> 0) Then
        Begin
          DoSemget := -EEXIST;
          Exit;
        End;
        If Not IpcAllowed(@SemP[I], (Flg Shr 6) And 6) Then
        Begin
          DoSemget := -EACCES;
          Exit;
        End;
        If (N > SemN[I]) Then
        Begin
          DoSemget := -EINVAL;
          Exit;
        End;
        DoSemget := IpcMake(SemP[I].Seq, I);
        Exit;
      End;
  If (Key <> 0) And ((Flg And IPC_CREAT) = 0) Then
  Begin
    DoSemget := -ENOENT;
    Exit;
  End;
  If (N <= 0) Or (N > 250) Then
  Begin
    DoSemget := -EINVAL;
    Exit;
  End;
  For I := 0 To MaxIpc - 1 Do
    If SemP[I].Used = 0 Then
    Begin
      Free := I;
      Break;
    End;
  If Free < 0 Then
  Begin
    DoSemget := -ENOSPC;
    Exit;
  End;
  SemVal[Free] := KMallocZ(N * 16);
  If SemVal[Free] = 0 Then
  Begin
    DoSemget := -ENOMEM;
    Exit;
  End;
  IpcInit(@SemP[Free], Key, Flg);
  SemN[Free] := N; SemOt[Free] := 0; SemCt[Free] := XTime;
  DoSemget := IpcMake(SemP[Free].Seq, Free);
End;

Procedure SemDestroy(I : LongInt);
Begin
  KFree(SemVal[I]);
  SemP[I].Used := 0;
  WakeUp(LongInt(@SemN[0]) + I * 4);
End;

Function SemAdjust(Id, Num, Adj : LongInt) : LongInt;
Var K, F : LongInt;
Begin
  SemAdjust := 0;
  F := -1;
  For K := 0 To 255 Do
  Begin
    If (UnUsed[K] <> 0) And (UnTgid[K] = Cur^.Tgid) And (UnId[K] = Id)
       And (UnNum[K] = Num) Then
    Begin
      UnAdj[K] := UnAdj[K] - Adj;
      Exit;
    End;
    If (UnUsed[K] = 0) And (F < 0) Then F := K;
  End;
  If F < 0 Then
  Begin
    SemAdjust := -ENOSPC;
    Exit;
  End;
  UnUsed[F] := 1; UnTgid[F] := Cur^.Tgid; UnId[F] := Id; UnNum[F] := Num;
  UnAdj[F] := -Adj;
End;

Function DoSemop(Id, Sops, Nsops, Tmo : LongInt) : LongInt;
Var I, K, Op, Num, Flg, V, Need, R, Dead, Left : LongInt; Alter, Undo : Boolean;
    Tmp : Array[0..249] Of LongInt;
Begin
  If (Nsops <= 0) Or (Nsops > 500) Then
  Begin
    DoSemop := -EINVAL;
    Exit;
  End;
  I := IpcCheckId(LongInt(@SemP[0]), Id);
  If I < 0 Then
  Begin
    DoSemop := -EINVAL;
    Exit;
  End;
  If Not EnsureUser(Sops, Nsops * 6, False) Then
  Begin
    DoSemop := -EFAULT;
    Exit;
  End;
  Alter := False;
  Undo := False;
  For K := 0 To Nsops - 1 Do
  Begin
    Num := MemW[0:Sops + K * 6];
    If Num >= SemN[I] Then
    Begin
      DoSemop := -EFBIG;
      Exit;
    End;
    If MemW[0:Sops + K * 6 + 2] <> 0 Then Alter := True;
  End;
  If Not IpcAllowed(@SemP[I], 4 Or (2 * Ord(Alter))) Then
  Begin
    DoSemop := -EACCES;
    Exit;
  End;
  Dead := 0;
  If Tmo > 0 Then Dead := Jiffies + Tmo;
  While True Do
  Begin
    { essai : appliquer sur une copie }
    For K := 0 To SemN[I] - 1 Do Tmp[K] := MemL[0:SemVal[I] + K * 16];
    Need := 0;
    For K := 0 To Nsops - 1 Do
    Begin
      Num := MemW[0:Sops + K * 6];
      Op := MemW[0:Sops + K * 6 + 2];
      If Op > 32767 Then Op := Op - 65536;
      Flg := MemW[0:Sops + K * 6 + 4];
      If Op > 0 Then
      Begin
        Tmp[Num] := Tmp[Num] + Op;
        If Tmp[Num] > 32767 Then
        Begin
          DoSemop := -ERANGE;
          Exit;
        End;
      End
      Else If Op < 0 Then
      Begin
        If Tmp[Num] + Op < 0 Then
        Begin
          Need := 1;
          Break;
        End;
        Tmp[Num] := Tmp[Num] + Op;
      End
      Else If Tmp[Num] <> 0 Then
      Begin
        Need := 2;
        Break;
      End;
    End;
    If Need = 0 Then
    Begin
      For K := 0 To Nsops - 1 Do
      Begin
        Num := MemW[0:Sops + K * 6];
        Op := MemW[0:Sops + K * 6 + 2];
        If Op > 32767 Then Op := Op - 65536;
        Flg := MemW[0:Sops + K * 6 + 4];
        If (Flg And $1000) <> 0 Then SemAdjust(Id, Num, Op);
        MemL[0:SemVal[I] + Num * 16 + 4] := Cur^.Tgid;
      End;
      For K := 0 To SemN[I] - 1 Do MemL[0:SemVal[I] + K * 16] := Tmp[K];
      SemOt[I] := XTime;
      WakeUp(LongInt(@SemN[0]) + I * 4);
      DoSemop := 0;
      Exit;
    End;
    If (Flg And IPC_NOWAIT) <> 0 Then
    Begin
      DoSemop := -EAGAIN;
      Exit;
    End;
    Left := 0;
    If Tmo > 0 Then
    Begin
      Left := Dead - Jiffies;
      If Left <= 0 Then
      Begin
        DoSemop := -EAGAIN;
        Exit;
      End;
    End;
    If Need = 1 Then MemAdd(SemVal[I] + Num * 16 + 8, 1)
    Else MemAdd(SemVal[I] + Num * 16 + 12, 1);
    R := SleepOn(LongInt(@SemN[0]) + I * 4, Left, True);
    If (SemP[I].Used <> 0) And (SemP[I].Seq = Id Div MaxIpc) Then
    Begin
      If Need = 1 Then MemAdd(SemVal[I] + Num * 16 + 8, -1)
      Else MemAdd(SemVal[I] + Num * 16 + 12, -1);
    End
    Else
    Begin
      DoSemop := -EIDRM;
      Exit;
    End;
    If R = WakeSignal Then
    Begin
      DoSemop := -ERESTARTSYS;
      Exit;
    End;
    If R = WakeTimeout Then
    Begin
      DoSemop := -EAGAIN;
      Exit;
    End;
  End;
  Undo := False;
End;

Function DoSemctl(Id, Num, Cmd, Arg : LongInt) : LongInt;
Var I, K, V : LongInt;
Begin
  Cmd := Cmd And $FF;
  If Cmd = 3 Then
  Begin
    If Not EnsureUser(Arg, 40, True) Then
    Begin
      DoSemctl := -EFAULT;
      Exit;
    End;
    MemFill(Arg, 0, 40);
    MemL[0:Arg] := 32000; MemL[0:Arg + 4] := MaxIpc * 250;
    MemL[0:Arg + 8] := 32;
    MemL[0:Arg + 12] := 32; MemL[0:Arg + 16] := 500; MemL[0:Arg + 20] := 250;
    MemL[0:Arg + 24] := 32767;
    DoSemctl := MaxIpc - 1;
    Exit;
  End;
  I := IpcCheckId(LongInt(@SemP[0]), Id);
  If I < 0 Then
  Begin
    DoSemctl := -EINVAL;
    Exit;
  End;
  Case Cmd Of
    0 : Begin
          If Not IpcOwner(@SemP[I]) Then
          Begin
            DoSemctl := -EPERM;
            Exit;
          End;
          For K := 0 To 255 Do
            If (UnUsed[K] <> 0) And (UnId[K] = Id) Then UnUsed[K] := 0;
          SemDestroy(I);
          DoSemctl := 0;
        End;
    1 : Begin
          If Not EnsureUser(Arg, 64, False) Then
          Begin
            DoSemctl := -EFAULT;
            Exit;
          End;
          DoSemctl := PermSet(Arg, @SemP[I]);
          SemCt[I] := XTime;
        End;
    2, 18 :
        Begin
          If Not IpcAllowed(@SemP[I], 4) Then
          Begin
            DoSemctl := -EACCES;
            Exit;
          End;
          If Not EnsureUser(Arg, 64, True) Then
          Begin
            DoSemctl := -EFAULT;
            Exit;
          End;
          MemFill(Arg, 0, 64);
          PermOut(Arg, @SemP[I]);
          MemL[0:Arg + 36] := SemOt[I]; MemL[0:Arg + 48] := SemCt[I];
          MemL[0:Arg + 56] := SemN[I];
          If Cmd = 18 Then DoSemctl := IpcMake(SemP[I].Seq, I)
          Else DoSemctl := 0;
        End;
    11, 12, 14, 15 :
        Begin
          If (Num < 0) Or (Num >= SemN[I]) Then
          Begin
            DoSemctl := -EINVAL;
            Exit;
          End;
          If Not IpcAllowed(@SemP[I], 4) Then
          Begin
            DoSemctl := -EACCES;
            Exit;
          End;
          Case Cmd Of
            11 : DoSemctl := MemL[0:SemVal[I] + Num * 16 + 4];
            12 : DoSemctl := MemL[0:SemVal[I] + Num * 16];
            14 : DoSemctl := MemL[0:SemVal[I] + Num * 16 + 8];
          Else
            DoSemctl := MemL[0:SemVal[I] + Num * 16 + 12];
          End;
        End;
    13 : Begin
           If Not IpcAllowed(@SemP[I], 4) Then
           Begin
             DoSemctl := -EACCES;
             Exit;
           End;
           If Not EnsureUser(Arg, SemN[I] * 2, True) Then
           Begin
             DoSemctl := -EFAULT;
             Exit;
           End;
           For K := 0 To SemN[I] - 1 Do
             MemW[0:Arg + K * 2] := MemL[0:SemVal[I] + K * 16];
           DoSemctl := 0;
         End;
    16 : Begin
           If (Num < 0) Or (Num >= SemN[I]) Or (Arg < 0) Or (Arg > 32767) Then
           Begin
             If (Arg < 0) Or (Arg > 32767) Then DoSemctl := -ERANGE
             Else DoSemctl := -EINVAL;
             Exit;
           End;
           If Not IpcAllowed(@SemP[I], 2) Then
           Begin
             DoSemctl := -EACCES;
             Exit;
           End;
           MemL[0:SemVal[I] + Num * 16] := Arg;
           SemCt[I] := XTime;
           For K := 0 To 255 Do
             If (UnUsed[K] <> 0) And (UnId[K] = Id) And (UnNum[K] = Num) Then
               UnUsed[K] := 0;
           WakeUp(LongInt(@SemN[0]) + I * 4);
           DoSemctl := 0;
         End;
    17 : Begin
           If Not IpcAllowed(@SemP[I], 2) Then
           Begin
             DoSemctl := -EACCES;
             Exit;
           End;
           If Not EnsureUser(Arg, SemN[I] * 2, False) Then
           Begin
             DoSemctl := -EFAULT;
             Exit;
           End;
           For K := 0 To SemN[I] - 1 Do
           Begin
             V := MemW[0:Arg + K * 2];
             If V > 32767 Then
             Begin
               DoSemctl := -ERANGE;
               Exit;
             End;
           End;
           For K := 0 To SemN[I] - 1 Do
             MemL[0:SemVal[I] + K * 16] := MemW[0:Arg + K * 2];
           SemCt[I] := XTime;
           For K := 0 To 255 Do
             If (UnUsed[K] <> 0) And (UnId[K] = Id) Then UnUsed[K] := 0;
           WakeUp(LongInt(@SemN[0]) + I * 4);
           DoSemctl := 0;
         End;
  Else
    DoSemctl := -EINVAL;
  End;
End;

{ ---- Files de messages ---- }

Function DoMsgget(Key, Flg : LongInt) : LongInt;
Var I, Free : LongInt;
Begin
  Free := -1;
  If Key <> 0 Then
    For I := 0 To MaxIpc - 1 Do
      If (MsgP[I].Used <> 0) And (MsgP[I].Key = Key)
         And (MsgP[I].Ns = Cur^.Ns[2]) Then
      Begin
        If ((Flg And IPC_CREAT) <> 0) And ((Flg And IPC_EXCL) <> 0) Then
        Begin
          DoMsgget := -EEXIST;
          Exit;
        End;
        If Not IpcAllowed(@MsgP[I], (Flg Shr 6) And 6) Then
        Begin
          DoMsgget := -EACCES;
          Exit;
        End;
        DoMsgget := IpcMake(MsgP[I].Seq, I);
        Exit;
      End;
  If (Key <> 0) And ((Flg And IPC_CREAT) = 0) Then
  Begin
    DoMsgget := -ENOENT;
    Exit;
  End;
  For I := 0 To MaxIpc - 1 Do
    If MsgP[I].Used = 0 Then
    Begin
      Free := I;
      Break;
    End;
  If Free < 0 Then
  Begin
    DoMsgget := -ENOSPC;
    Exit;
  End;
  IpcInit(@MsgP[Free], Key, Flg);
  MsgHead[Free] := 0; MsgTail[Free] := 0; MsgCnt[Free] := 0;
  MsgBytes[Free] := 0; MsgQb[Free] := 16384; MsgSt[Free] := 0;
  MsgRt[Free] := 0; MsgCt[Free] := XTime; MsgLspid[Free] := 0;
  MsgLrpid[Free] := 0;
  DoMsgget := IpcMake(MsgP[Free].Seq, Free);
End;

{ Noeud : +0 suivant, +4 type, +8 taille, +12 donnees }
Procedure MsgDestroy(I : LongInt);
Var N, Nx : LongInt;
Begin
  N := MsgHead[I];
  While N <> 0 Do
  Begin
    Nx := MemL[0:N];
    KFree(N);
    N := Nx;
  End;
  MsgP[I].Used := 0;
  WakeUp(LongInt(@MsgHead[0]) + I * 4);
  WakeUp(LongInt(@MsgTail[0]) + I * 4);
End;

Function DoMsgsnd(Id, Ubuf, Sz, Flg : LongInt) : LongInt;
Var I, Typ, N, R : LongInt;
Begin
  I := IpcCheckId(LongInt(@MsgP[0]), Id);
  If I < 0 Then
  Begin
    DoMsgsnd := -EINVAL;
    Exit;
  End;
  If (Sz < 0) Or (Sz > MsgQb[I]) Then
  Begin
    DoMsgsnd := -EINVAL;
    Exit;
  End;
  If Not EnsureUser(Ubuf, 4 + Sz, False) Then
  Begin
    DoMsgsnd := -EFAULT;
    Exit;
  End;
  Typ := MemL[0:Ubuf];
  If Typ < 1 Then
  Begin
    DoMsgsnd := -EINVAL;
    Exit;
  End;
  If Not IpcAllowed(@MsgP[I], 2) Then
  Begin
    DoMsgsnd := -EACCES;
    Exit;
  End;
  While MsgBytes[I] + Sz > MsgQb[I] Do
  Begin
    If (Flg And IPC_NOWAIT) <> 0 Then
    Begin
      DoMsgsnd := -EAGAIN;
      Exit;
    End;
    R := SleepOn(LongInt(@MsgTail[0]) + I * 4, 0, True);
    If (MsgP[I].Used = 0) Or (MsgP[I].Seq <> Id Div MaxIpc) Then
    Begin
      DoMsgsnd := -EIDRM;
      Exit;
    End;
    If R = WakeSignal Then
    Begin
      DoMsgsnd := -ERESTARTSYS;
      Exit;
    End;
  End;
  N := KMalloc(Sz + 12);
  If N = 0 Then
  Begin
    DoMsgsnd := -ENOMEM;
    Exit;
  End;
  MemL[0:N] := 0; MemL[0:N + 4] := Typ; MemL[0:N + 8] := Sz;
  MemCopy(N + 12, Ubuf + 4, Sz);
  If MsgTail[I] = 0 Then MsgHead[I] := N Else MemL[0:MsgTail[I]] := N;
  MsgTail[I] := N;
  Inc(MsgCnt[I]);
  MsgBytes[I] := MsgBytes[I] + Sz;
  MsgSt[I] := XTime; MsgLspid[I] := Cur^.Tgid;
  WakeUp(LongInt(@MsgHead[0]) + I * 4);
  DoMsgsnd := 0;
End;

Function DoMsgrcv(Id, Ubuf, Sz, Typ, Flg : LongInt) : LongInt;
Var I, N, Pr, Best, BestPr, R, L, Ty : LongInt;
Begin
  I := IpcCheckId(LongInt(@MsgP[0]), Id);
  If I < 0 Then
  Begin
    DoMsgrcv := -EINVAL;
    Exit;
  End;
  If Sz < 0 Then
  Begin
    DoMsgrcv := -EINVAL;
    Exit;
  End;
  If Not EnsureUser(Ubuf, 4 + Sz, True) Then
  Begin
    DoMsgrcv := -EFAULT;
    Exit;
  End;
  If Not IpcAllowed(@MsgP[I], 4) Then
  Begin
    DoMsgrcv := -EACCES;
    Exit;
  End;
  While True Do
  Begin
    Best := 0; Pr := 0; BestPr := 0;
    N := MsgHead[I];
    While N <> 0 Do
    Begin
      Ty := MemL[0:N + 4];
      If Typ = 0 Then Best := N
      Else If Typ > 0 Then
      Begin
        If ((Flg And $2000) = 0) And (Ty = Typ) Then Best := N
        Else If ((Flg And $2000) <> 0) And (Ty <> Typ) Then Best := N;
      End
      Else If (Ty <= -Typ) And ((Best = 0) Or (Ty < BestPr)) Then
      Begin
        Best := N;
        BestPr := Ty;
        N := MemL[0:N];
        Continue;
      End;
      If (Best <> 0) And (Typ >= 0) Then Break;
      N := MemL[0:N];
    End;
    If Best <> 0 Then
    Begin
      L := MemL[0:Best + 8];
      If (L > Sz) And ((Flg And $1000) = 0) Then
      Begin
        DoMsgrcv := -E2BIG;
        Exit;
      End;
      If L > Sz Then L := Sz;
      MemL[0:Ubuf] := MemL[0:Best + 4];
      MemCopy(Ubuf + 4, Best + 12, L);
      { retirer le noeud }
      If MsgHead[I] = Best Then
      Begin
        MsgHead[I] := MemL[0:Best];
        If MsgHead[I] = 0 Then MsgTail[I] := 0;
      End
      Else
      Begin
        N := MsgHead[I];
        While (N <> 0) And (MemL[0:N] <> Best) Do N := MemL[0:N];
        If N <> 0 Then
        Begin
          MemL[0:N] := MemL[0:Best];
          If MsgTail[I] = Best Then MsgTail[I] := N;
        End;
      End;
      Dec(MsgCnt[I]);
      MsgBytes[I] := MsgBytes[I] - MemL[0:Best + 8];
      KFree(Best);
      MsgRt[I] := XTime; MsgLrpid[I] := Cur^.Tgid;
      WakeUp(LongInt(@MsgTail[0]) + I * 4);
      DoMsgrcv := L;
      Exit;
    End;
    If (Flg And IPC_NOWAIT) <> 0 Then
    Begin
      DoMsgrcv := -ENOMSG;
      Exit;
    End;
    R := SleepOn(LongInt(@MsgHead[0]) + I * 4, 0, True);
    If (MsgP[I].Used = 0) Or (MsgP[I].Seq <> Id Div MaxIpc) Then
    Begin
      DoMsgrcv := -EIDRM;
      Exit;
    End;
    If R = WakeSignal Then
    Begin
      DoMsgrcv := -ERESTARTSYS;
      Exit;
    End;
  End;
End;

Function DoMsgctl(Id, Cmd, Buf : LongInt) : LongInt;
Var I, R : LongInt;
Begin
  Cmd := Cmd And $FF;
  If Cmd = 3 Then
  Begin
    If Not EnsureUser(Buf, 32, True) Then
    Begin
      DoMsgctl := -EFAULT;
      Exit;
    End;
    MemFill(Buf, 0, 32);
    MemL[0:Buf] := 16384; MemL[0:Buf + 4] := 8192; MemL[0:Buf + 8] := 16384;
    MemL[0:Buf + 12] := MaxIpc;
    DoMsgctl := MaxIpc - 1;
    Exit;
  End;
  I := IpcCheckId(LongInt(@MsgP[0]), Id);
  If I < 0 Then
  Begin
    DoMsgctl := -EINVAL;
    Exit;
  End;
  Case Cmd Of
    0 : Begin
          If Not IpcOwner(@MsgP[I]) Then
          Begin
            DoMsgctl := -EPERM;
            Exit;
          End;
          MsgDestroy(I);
          DoMsgctl := 0;
        End;
    1 : Begin
          If Not EnsureUser(Buf, 92, False) Then
          Begin
            DoMsgctl := -EFAULT;
            Exit;
          End;
          If (MemL[0:Buf + 72] > MsgQb[I]) And Not Capable(16) Then
          Begin
            DoMsgctl := -EPERM;
            Exit;
          End;
          R := PermSet(Buf, @MsgP[I]);
          If R = 0 Then
          Begin
            MsgQb[I] := MemL[0:Buf + 72];
            MsgCt[I] := XTime;
          End;
          DoMsgctl := R;
        End;
    2, 12 :
        Begin
          If Not IpcAllowed(@MsgP[I], 4) Then
          Begin
            DoMsgctl := -EACCES;
            Exit;
          End;
          If Not EnsureUser(Buf, 92, True) Then
          Begin
            DoMsgctl := -EFAULT;
            Exit;
          End;
          MemFill(Buf, 0, 92);
          PermOut(Buf, @MsgP[I]);
          MemL[0:Buf + 40] := MsgSt[I]; MemL[0:Buf + 48] := MsgRt[I];
          MemL[0:Buf + 56] := MsgCt[I]; MemL[0:Buf + 64] := MsgBytes[I];
          MemL[0:Buf + 68] := MsgCnt[I]; MemL[0:Buf + 72] := MsgQb[I];
          MemL[0:Buf + 76] := MsgLspid[I]; MemL[0:Buf + 80] := MsgLrpid[I];
          If Cmd = 12 Then DoMsgctl := IpcMake(MsgP[I].Seq, I)
          Else DoMsgctl := 0;
        End;
  Else
    DoMsgctl := -EINVAL;
  End;
End;

{ ---- Points d'entree : appels directs et ipc(2) ---- }

Function SysShmget(K, Sz, F : LongInt) : LongInt;
Begin
  SysShmget := DoShmget(K, Sz, F);
End;

Function SysShmat(Id, Addr, F : LongInt) : LongInt;
Var R, E : LongInt;
Begin
  E := DoShmat(Id, Addr, F, R);
  If E <> 0 Then SysShmat := E Else SysShmat := R;
End;

Function SysShmdt(A : LongInt) : LongInt;
Begin
  SysShmdt := DoShmdt(A);
End;

Function SysShmctl(Id, C, B : LongInt) : LongInt;
Begin
  SysShmctl := DoShmctl(Id, C, B);
End;

Function SysSemget(K, N, F : LongInt) : LongInt;
Begin
  SysSemget := DoSemget(K, N, F);
End;

Function SysSemctl(Id, Num, Cmd, Arg : LongInt) : LongInt;
Begin
  SysSemctl := DoSemctl(Id, Num, Cmd, Arg);
End;

Function SysSemtimedop(Id, Sops, N, Ts : LongInt) : LongInt;
Var Ms, R : LongInt;
Begin
  R := TsToMs(Ts, False, Ms);
  If R <> 0 Then
  Begin
    SysSemtimedop := R;
    Exit;
  End;
  If Ms < 0 Then Ms := 0 Else Ms := (Ms + 9) Div 10;
  SysSemtimedop := DoSemop(Id, Sops, N, Ms);
End;

Function SysSemtimedop64(Id, Sops, N, Ts : LongInt) : LongInt;
Var S : LongInt;
Begin
  If Ts <> 0 Then
  Begin
    S := Scratch(8);
    If (S = 0) Or Not EnsureUser(Ts, 16, False) Then
    Begin
      SysSemtimedop64 := -EFAULT;
      Exit;
    End;
    Ts64To32(Ts, S);
    Ts := S;
  End;
  SysSemtimedop64 := SysSemtimedop(Id, Sops, N, Ts);
End;

Function SysSemop(Id, Sops, N : LongInt) : LongInt;
Begin
  SysSemop := DoSemop(Id, Sops, N, 0);
End;

Function SysMsgget(K, F : LongInt) : LongInt;
Begin
  SysMsgget := DoMsgget(K, F);
End;

Function SysMsgsnd(Id, P, Sz, F : LongInt) : LongInt;
Begin
  SysMsgsnd := DoMsgsnd(Id, P, Sz, F);
End;

Function SysMsgrcv(Id, P, Sz, Ty, F : LongInt) : LongInt;
Begin
  SysMsgrcv := DoMsgrcv(Id, P, Sz, Ty, F);
End;

Function SysMsgctl(Id, C, B : LongInt) : LongInt;
Begin
  SysMsgctl := DoMsgctl(Id, C, B);
End;

{ ipc(2) : call, first, second, third, ptr, fifth }
Function SysIpc(Call, First, Second, Third, Ptr, Fifth : LongInt) : LongInt;
Var Ver, R, E, Arg : LongInt;
Begin
  Ver := (Call Shr 16) And $FFFF;
  Call := Call And $FFFF;
  Case Call Of
    1 : SysIpc := DoSemop(First, Ptr, Second, 0);
    2 : SysIpc := DoSemget(First, Second, Third);
    3 : Begin
          Arg := 0;
          If Ptr <> 0 Then
          Begin
            If Not EnsureUser(Ptr, 4, False) Then
            Begin
              SysIpc := -EFAULT;
              Exit;
            End;
            Arg := MemL[0:Ptr];
          End;
          SysIpc := DoSemctl(First, Second, Third, Arg);
        End;
    4 : SysIpc := SysSemtimedop(First, Ptr, Second, Fifth);
    11 : SysIpc := DoMsgsnd(First, Ptr, Second, Third);
    12 : Begin
           If Ver = 0 Then
           Begin
             If Not EnsureUser(Ptr, 8, False) Then
             Begin
               SysIpc := -EFAULT;
               Exit;
             End;
             SysIpc := DoMsgrcv(First, MemL[0:Ptr], Second, MemL[0:Ptr + 4],
                 Third);
           End
           Else SysIpc := DoMsgrcv(First, Ptr, Second, Fifth, Third);
         End;
    13 : SysIpc := DoMsgget(First, Second);
    14 : SysIpc := DoMsgctl(First, Second, Ptr);
    21 : Begin
           E := DoShmat(First, Ptr, Second, R);
           If E <> 0 Then SysIpc := E
           Else If Ver = 1 Then SysIpc := R
           Else
           Begin
             If PutUserL(Third, R) < 0 Then SysIpc := -EFAULT
             Else SysIpc := 0;
           End;
         End;
    22 : SysIpc := DoShmdt(Ptr);
    23 : SysIpc := DoShmget(First, Second, Third);
    24 : SysIpc := DoShmctl(First, Second, Ptr);
  Else
    SysIpc := -ENOSYS;
  End;
End;

Procedure InitIpc;
Begin
  SysReg(117, LongInt(@SysIpc), 6);
  SysReg(393, LongInt(@SysSemget), 3);
  SysReg(394, LongInt(@SysSemctl), 4);
  SysReg(395, LongInt(@SysShmget), 3);
  SysReg(396, LongInt(@SysShmctl), 3);
  SysReg(397, LongInt(@SysShmat), 3);
  SysReg(398, LongInt(@SysShmdt), 1);
  SysReg(399, LongInt(@SysMsgget), 2);
  SysReg(400, LongInt(@SysMsgsnd), 4);
  SysReg(401, LongInt(@SysMsgrcv), 5);
  SysReg(402, LongInt(@SysMsgctl), 3);
  SysReg(420, LongInt(@SysSemtimedop64), 4);
  SysReg(392, LongInt(@SysSemtimedop), 4);
  End;

