Function SysReadlink(PathA, Buf, Size : LongInt) : LongInt;
Var P, T : String; D : PDentry; R, N : LongInt;
Begin
  R := GetUserStr(PathA, P);
  If R < 0 Then
  Begin
    SysReadlink := R;
    Exit;
  End;
  If Size <= 0 Then
  Begin
    SysReadlink := -EINVAL;
    Exit;
  End;
  R := PathWalk(P, False, D);
  If R <> 0 Then
  Begin
    SysReadlink := R;
    Exit;
  End;
  If (D^.Inode^.Mode And S_IFMT) <> S_IFLNK Then
  Begin
    DentryPut(LongInt(D));
    SysReadlink := -EINVAL;
    Exit;
  End;
  R := ReadLinkTarget(D^.Inode, T);
  DentryPut(LongInt(D));
  If R <> 0 Then
  Begin
    SysReadlink := R;
    Exit;
  End;
  N := Length(T);
  If N > Size Then N := Size;
  If Not EnsureUser(Buf, N, True) Then
  Begin
    SysReadlink := -EFAULT;
    Exit;
  End;
  MemCopy(Buf, LongInt(@T) + 1, N);
  SysReadlink := N;
End;

