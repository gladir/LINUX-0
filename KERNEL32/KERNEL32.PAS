{ Interpretation de "#!" : modifie le tampon d'arguments ; retourne -errno ou
  0 et le chemin de l'interpreteur dans Interp }
Function ExecScript(Ino : PInode; Const Path : String;
    Var Interp : String) : LongInt;
Var Buf : Array[0..127] Of Byte; N, I, J : LongInt; Line, Arg : String;
Begin
  N := InodeReadAt(LongInt(Ino), LongInt(@Buf[0]), 0, 127);
  If N < 3 Then
  Begin
    ExecScript := -ENOEXEC;
    Exit;
  End;
  Line := '';
  I := 2;
  While (I < N) And (Buf[I] <> 10) Do
  Begin
    Line := Line + Chr(Buf[I]);
    Inc(I);
  End;
  While (Length(Line) > 0) And ((Line[1] = ' ') Or (Line[1] = #9))
      Do Delete(Line, 1, 1);
  While (Length(Line) > 0) And ((Line[Length(Line)] = ' ')
      Or (Line[Length(Line)] = #9) Or (Line[Length(Line)] = #13))
      Do Delete(Line, Length(Line), 1);
  If Line = '' Then
  Begin
    ExecScript := -ENOEXEC;
    Exit;
  End;
  J := 1;
  While (J <= Length(Line)) And (Line[J] <> ' ') And (Line[J] <> #9) Do Inc(J);
  Interp := Copy(Line, 1, J - 1);
  Arg := Copy(Line, J + 1, 255);
  While (Length(Arg) > 0) And ((Arg[1] = ' ') Or (Arg[1] = #9)) Do Delete(Arg,
      1, 1);
  ExDropFirst;
  If Not ExPrepend(Path) Then
  Begin
    ExecScript := -E2BIG;
    Exit;
  End;
  If Arg <> '' Then
    If Not ExPrepend(Arg) Then
    Begin
      ExecScript := -E2BIG;
      Exit;
    End;
  If Not ExPrepend(Interp) Then
  Begin
    ExecScript := -E2BIG;
    Exit;
  End;
  ExecScript := 0;
End;

{ Projeter les segments PT_LOAD du fichier I (en-tetes de programme en
  Ph) a l'adresse Bias + p_vaddr. Retourne la fin du dernier segment (tas),
  l'adresse des en-tetes en memoire (HdrAddr) et les bornes du code et des
  donnees. Appele apres le point de non retour : un echec tue le processus }
Procedure ExMapSegs(I : PInode; Ph, Phnum, Phoff, Bias : LongInt; Mm : PMm;
    Var BrkOut, HdrAddr, StartCode, EndCode, StartData, EndData : LongInt);
Var K, PType, POff, PVaddr, PFilesz, PMemsz, PFlags, Prot, Start, Fin,
    FileEnd, BssEnd, FirstLoad : LongInt; V : PVma;
Begin
  BrkOut := 0;
  HdrAddr := 0;
  FirstLoad := 1;
  StartCode := 0; EndCode := 0; StartData := 0; EndData := 0;
  For K := 0 To Phnum - 1 Do
  Begin
    PType := MemL[0:Ph + K * 32];
    POff := MemL[0:Ph + K * 32 + 4];
    PVaddr := MemL[0:Ph + K * 32 + 8] + Bias;
    PFilesz := MemL[0:Ph + K * 32 + 16];
    PMemsz := MemL[0:Ph + K * 32 + 20];
    PFlags := MemL[0:Ph + K * 32 + 24];
    If PType = 1 Then
    Begin
      Prot := 0;
      If (PFlags And 4) <> 0 Then Prot := Prot Or PROT_READ;
      If (PFlags And 2) <> 0 Then Prot := Prot Or PROT_WRITE;
      If (PFlags And 1) <> 0 Then Prot := Prot Or PROT_EXEC;
      Start := PageDown(PVaddr);
      FileEnd := PVaddr + PFilesz;
      BssEnd := PVaddr + PMemsz;
      If PFilesz > 0 Then
      Begin
        Fin := PageUp(FileEnd);
        V := VmaNew(Start, Fin, Prot, MAP_PRIVATE);
        If V = Nil Then DieBySignal(SIGKILL, False);
        V^.Ino := InodeRef(LongInt(I));
        V^.Off := POff - (PVaddr - Start);
        V^.FLen := PFilesz + (PVaddr - Start);
        VmaInsert(Mm, V);
      End
      Else Fin := Start;
      If PageUp(BssEnd) > Fin Then
      Begin
        V := VmaNew(Fin, PageUp(BssEnd), Prot, MAP_PRIVATE Or MAP_ANONYMOUS);
        If V = Nil Then DieBySignal(SIGKILL, False);
        VmaInsert(Mm, V);
      End;
      If FirstLoad <> 0 Then
      Begin
        HdrAddr := PVaddr - POff + Phoff;
        FirstLoad := 0;
      End;
      If (PFlags And 1) <> 0 Then
      Begin
        StartCode := PVaddr; EndCode := FileEnd;
      End
      Else
      Begin
        If StartData = 0 Then StartData := PVaddr;
        EndData := FileEnd;
      End;
      If PageUp(BssEnd) > BrkOut Then BrkOut := PageUp(BssEnd);
    End;
  End;
End;

{ Charger le programme Path dans un nouvel espace d'adressage (les arguments
  sont dans ExArgs). Retourne 0 ou -errno. Au-dela du point de non retour,
  un echec tue le processus. }
Function ExecLoad(Const Path : String; Depth : LongInt) : LongInt;
Var D : PDentry; I : PInode; R, N, K, Phoff, Phnum, Phent, Entry, Etype,
    Machine : LongInt;
    Hdr : Array[0..63] Of Byte; Ph : LongInt; NewMm, OldMm : PMm; PType, POff,
        PVaddr, PFilesz,
    PMemsz, PFlags, Prot, Start, Fin, FileEnd, BssEnd, Brk, HdrAddr, Sp,
        Interp2 : LongInt;
    FirstLoad, Secure : LongInt; Fr : PFrame; Intp : String; Nm : String;
        V : PVma;
    EndCode, StartCode, StartData, EndData : LongInt; Perm : LongInt;
    Bias, IBias, IBrk, IHdr, ISc, IEc, ISd, IEd, MainEntry, IPh, IPhnum,
    ISpan, IMin, IMax, IEntry : LongInt;
    IntpPath : String; IDent : PDentry; IIno : PInode;
    IHdrB : Array[0..63] Of Byte;
Begin
  If Depth > 4 Then
  Begin
    ExecLoad := -ELOOP;
    Exit;
  End;
  R := PathWalk(Path, True, D);
  If R <> 0 Then
  Begin
    ExecLoad := R;
    Exit;
  End;
  I := D^.Inode;
  If (I^.Mode And S_IFMT) <> S_IFREG Then
  Begin
    DentryPut(LongInt(D));
    If IsDir(I) Then ExecLoad := -EACCES Else ExecLoad := -EACCES;
    Exit;
  End;
  R := InodePerm(I, MAY_EXEC);
  If (R = 0) And ((I^.Mode And $49) = 0) Then R := -EACCES;
  If R <> 0 Then
  Begin
    DentryPut(LongInt(D));
    ExecLoad := R;
    Exit;
  End;
  MemFill(LongInt(@Hdr[0]), 0, 64);
  N := InodeReadAt(LongInt(I), LongInt(@Hdr[0]), 0, 52);
  If N < 4 Then
  Begin
    DentryPut(LongInt(D));
    ExecLoad := -ENOEXEC;
    Exit;
  End;
  If (Hdr[0] = Ord('#')) And (Hdr[1] = Ord('!')) Then
  Begin
    R := ExecScript(I, Path, Intp);
    DentryPut(LongInt(D));
    If R <> 0 Then
    Begin
      ExecLoad := R;
      Exit;
    End;
    ExecLoad := ExecLoad(Intp, Depth + 1);
    Exit;
  End;
  If (N < 52) Or (MemL[0:LongInt(@Hdr[0])] <> $464C457F) Or (Hdr[4] <> 1)
      Or (Hdr[5] <> 1) Then
  Begin
    DentryPut(LongInt(D));
    ExecLoad := -ENOEXEC;
    Exit;
  End;
  Etype := MemW[0:LongInt(@Hdr[0]) + 16];
  Machine := MemW[0:LongInt(@Hdr[0]) + 18];
  Entry := MemL[0:LongInt(@Hdr[0]) + 24];
  Phoff := MemL[0:LongInt(@Hdr[0]) + 28];
  Phent := MemW[0:LongInt(@Hdr[0]) + 42];
  Phnum := MemW[0:LongInt(@Hdr[0]) + 44];
  If ((Etype <> 2) And (Etype <> 3)) Or (Machine <> 3) Or (Phent <> 32)
      Or (Phnum = 0) Or (Phnum > 64) Then
  Begin
    DentryPut(LongInt(D));
    ExecLoad := -ENOEXEC;
    Exit;
  End;
  Ph := KMalloc(Phnum * 32);
  If Ph = 0 Then
  Begin
    DentryPut(LongInt(D));
    ExecLoad := -ENOMEM;
    Exit;
  End;
  If InodeReadAt(LongInt(I), Ph, Phoff, Phnum * 32) <> Phnum * 32 Then
  Begin
    KFree(Ph);
    DentryPut(LongInt(D));
    ExecLoad := -ENOEXEC;
    Exit;
  End;
  { verifier les segments avant le point de non retour }
  For K := 0 To Phnum - 1 Do
  Begin
    PType := MemL[0:Ph + K * 32];
    If PType = 1 Then
    Begin
      PVaddr := MemL[0:Ph + K * 32 + 8];
      PFilesz := MemL[0:Ph + K * 32 + 16];
      PMemsz := MemL[0:Ph + K * 32 + 20];
      If Etype = 3 Then PVaddr := PVaddr + $08048000;
      If (PFilesz > PMemsz) Or ULt(UserTop - StackReserve, PVaddr + PMemsz)
          Or ULt(PVaddr + PMemsz, PVaddr) Or
         (PVaddr < 4096) Then
      Begin
        KFree(Ph);
        DentryPut(LongInt(D));
        ExecLoad := -ENOEXEC;
        Exit;
      End;
    End;
  End;
  { biais des executables PIE (ET_DYN) et interpreteur (PT_INTERP) }
  Bias := 0;
  If Etype = 3 Then Bias := $08048000;
  IntpPath := '';
  IIno := Nil; IDent := Nil; IPh := 0; IPhnum := 0; IEntry := 0;
  For K := 0 To Phnum - 1 Do
    If MemL[0:Ph + K * 32] = 3 Then
    Begin
      POff := MemL[0:Ph + K * 32 + 4];
      PFilesz := MemL[0:Ph + K * 32 + 16];
      If (PFilesz > 1) And (PFilesz < 256) Then
      Begin
        MemFill(LongInt(@IHdrB[0]), 0, 64);
        N := InodeReadAt(LongInt(I), LongInt(@IHdrB[0]), POff, PFilesz);
        If N = PFilesz Then
          For R := 0 To PFilesz - 2 Do IntpPath := IntpPath + Chr(IHdrB[R]);
        MemFill(LongInt(@IHdrB[0]), 0, 64);
      End;
    End;
  If IntpPath <> '' Then
  Begin
    R := PathWalk(IntpPath, True, IDent);
    If R <> 0 Then
    Begin
      KFree(Ph);
      DentryPut(LongInt(D));
      ExecLoad := R;
      Exit;
    End;
    IIno := IDent^.Inode;
    If ((IIno^.Mode And S_IFMT) <> S_IFREG)
       Or (InodeReadAt(LongInt(IIno), LongInt(@IHdrB[0]), 0, 52) <> 52)
       Or (MemL[0:LongInt(@IHdrB[0])] <> $464C457F) Or (IHdrB[4] <> 1)
       Or (MemW[0:LongInt(@IHdrB[0]) + 16] <> 3)
       Or (MemW[0:LongInt(@IHdrB[0]) + 18] <> 3)
       Or (MemW[0:LongInt(@IHdrB[0]) + 42] <> 32)
       Or (MemW[0:LongInt(@IHdrB[0]) + 44] = 0)
       Or (MemW[0:LongInt(@IHdrB[0]) + 44] > 64) Then
    Begin
      DentryPut(LongInt(IDent));
      KFree(Ph);
      DentryPut(LongInt(D));
      ExecLoad := -ELIBBAD;
      Exit;
    End;
    IPhnum := MemW[0:LongInt(@IHdrB[0]) + 44];
    IEntry := MemL[0:LongInt(@IHdrB[0]) + 24];
    IPh := KMalloc(IPhnum * 32);
    If (IPh = 0) Or (InodeReadAt(LongInt(IIno), IPh,
        MemL[0:LongInt(@IHdrB[0]) + 28], IPhnum * 32) <> IPhnum * 32) Then
    Begin
      If IPh <> 0 Then KFree(IPh);
      DentryPut(LongInt(IDent));
      KFree(Ph);
      DentryPut(LongInt(D));
      ExecLoad := -ELIBBAD;
      Exit;
    End;
    { etendue de l'interpreteur }
    IMin := -1; IMax := 0;
    For K := 0 To IPhnum - 1 Do
      If MemL[0:IPh + K * 32] = 1 Then
      Begin
        PVaddr := MemL[0:IPh + K * 32 + 8];
        PMemsz := MemL[0:IPh + K * 32 + 20];
        If (IMin = -1) Or ULt(PVaddr, IMin) Then IMin := PVaddr;
        If ULt(IMax, PVaddr + PMemsz) Then IMax := PVaddr + PMemsz;
      End;
    If IMin = -1 Then IMin := 0;
    IMin := PageDown(IMin);
    ISpan := PageUp(IMax) - IMin;
  End;
  NewMm := MmNew;
  If NewMm = Nil Then
  Begin
    If IIno <> Nil Then
    Begin
      KFree(IPh);
      DentryPut(LongInt(IDent));
    End;
    KFree(Ph);
    DentryPut(LongInt(D));
    ExecLoad := -ENOMEM;
    Exit;
  End;
  { ---- point de non retour : changer d'espace d'adressage ---- }
  OldMm := Cur^.Mm;
  Cur^.Mm := NewMm;
  CurMm := NewMm;
  WriteCr3(NewMm^.PgdPhys);
  NoteMm(NewMm);
  If OldMm <> Nil Then MmRelease(OldMm);
  ExecResetState;
  ExMapSegs(I, Ph, Phnum, Phoff, Bias, NewMm, Brk, HdrAddr, StartCode,
      EndCode, StartData, EndData);
  MainEntry := Entry + Bias;
  ExAtBase := 0;
  If IIno <> Nil Then
  Begin
    IBias := FindFreeArea(NewMm, ISpan);
    If IBias = 0 Then DieBySignal(SIGKILL, False);
    IBias := IBias - IMin;
    ExMapSegs(IIno, IPh, IPhnum, MemL[0:LongInt(@IHdrB[0]) + 28], IBias,
        NewMm, IBrk, IHdr, ISc, IEc, ISd, IEd);
    KFree(IPh);
    DentryPut(LongInt(IDent));
    ExAtBase := IBias;
    Entry := IBias + IEntry;
  End
  Else Entry := MainEntry;
  KFree(Ph);
  NewMm^.StartCode := StartCode; NewMm^.EndCode := EndCode;
  NewMm^.StartData := StartData; NewMm^.EndData := EndData;
  NewMm^.StartBrk := Brk; NewMm^.Brk := Brk;
  NewMm^.DataLimit := 0;
  NewMm^.StackLimit := Cur^.RlimCur[RLIM_STACK];
  { setuid / setgid }
  Secure := 0;
  If (Cur^.NoNewPrivs = 0) And ((Cur^.Ptrace = 0) Or (Cur^.Tracer = Nil)
     Or (Cur^.Tracer^.Euid = 0)) Then
  Begin
    If (I^.Mode And S_ISUID) <> 0 Then
    Begin
      Cur^.Euid := I^.Uid; Cur^.Fsuid := I^.Uid; Secure := 1;
    End;
    If (I^.Mode And S_ISGID) <> 0 Then
    Begin
      Cur^.Egid := I^.Gid; Cur^.Fsgid := I^.Gid; Secure := 1;
    End;
  End;
  Cur^.Suid := Cur^.Euid; Cur^.Sgid := Cur^.Egid;
  CapExecFix;
  PosixTimersExec;
  { nom du processus }
  Nm := Path;
  K := Length(Nm);
  While (K > 0) And (Nm[K] <> '/') Do Dec(K);
  Nm := Copy(Nm, K + 1, 15);
  For K := 0 To 15 Do Cur^.Comm[K] := 0;
  For K := 1 To Length(Nm) Do Cur^.Comm[K - 1] := Ord(Nm[K]);
  Intp := DentryPath(D);
  Cur^.ExeLen := Length(Intp);
  If Cur^.ExeLen > 127 Then Cur^.ExeLen := 127;
  For K := 1 To Cur^.ExeLen Do Cur^.ExeBuf[K - 1] := Ord(Intp[K]);
  DentryPut(LongInt(D));
  Sp := ExecSetupStack(NewMm, MainEntry, HdrAddr, Phnum, Phent,
      Secure);
  If (Sp < 0) And (Sp > -4096) Then DieBySignal(SIGKILL, False);
  { retour en mode utilisateur au point d'entree }
  Fr := Pointer(Cur^.Frame);
  MemFill(LongInt(Fr), 0, SizeOf(TFrame));
  Fr^.Ds := SelUData; Fr^.Es := SelUData; Fr^.Ss := SelUData;
      Fr^.Cs := SelUCode;
  Fr^.Eip := Entry;
  Fr^.UserEsp := Sp;
  Fr^.Eflags := $202;
  Fr^.Vec := VecSyscall;
  ExecLoad := 0;
End;

{ execve(Path, Argv, Envp) : adresses utilisateur }
Function DoExecve(PathAddr, Argv, Envp : LongInt) : LongInt;
Var Path : String; R : LongInt;
Begin
  R := GetUserStr(PathAddr, Path);
  If R < 0 Then
  Begin
    DoExecve := R;
    Exit;
  End;
  If Path = '' Then
  Begin
    DoExecve := -ENOENT;
    Exit;
  End;
  ExArgs := KMalloc(ArgMax);
  If ExArgs = 0 Then
  Begin
    DoExecve := -ENOMEM;
    Exit;
  End;
  ExUsed := 0; ExArgc := 0; ExEnvc := 0;
  R := ExCollect(Argv, ExArgc);
  If R = 0 Then R := ExCollect(Envp, ExEnvc);
  If R <> 0 Then
  Begin
    KFree(ExArgs);
    DoExecve := R;
    Exit;
  End;
  If ExArgc = 0 Then
  Begin
    { argv vide : donner au moins argv[0] }
    ExPrepend(Path);
  End;
  ExPath := Path;
  R := ExecLoad(Path, 0);
  KFree(ExArgs);
  ExArgs := 0;
  DoExecve := R;
End;

{ execve depuis le noyau (init) : le tampon est prepare par l'appelant }
Function KernelExecve(Const Path : String; Const Args : String;
    Const Env : String) : LongInt;
Var R : LongInt;
Begin
  ExArgs := KMalloc(ArgMax);
  If ExArgs = 0 Then
  Begin
    KernelExecve := -ENOMEM;
    Exit;
  End;
  ExUsed := 0; ExArgc := 0; ExEnvc := 0;
  ExAdd(Args);
  ExArgc := 1;
  ExAdd(Env);
  ExEnvc := 1;
  ExPath := Path;
  R := ExecLoad(Path, 0);
  KFree(ExArgs);
  ExArgs := 0;
  KernelExecve := R;
End;

{ ==================================================================== }
{ Partie 19 - Sockets : AF_UNIX, AF_INET en bouclage, ICMP echo       }
{ ==================================================================== }
{ (placee avant la partie 16 : les appels systeme de sockets y sont) }

{ Couche de sockets du noyau. AF_UNIX : flux (SOCK_STREAM) et datagrammes
  (SOCK_DGRAM), socketpair, bind sur un chemin (noeud S_IFSOCK du systeme de
  fichiers) ou nom abstrait, listen/accept/connect, SCM_RIGHTS, SO_PEERCRED.
  AF_INET : bouclage seulement (127.0.0.0/8) : UDP, TCP simplifie (le flux
  passe par les memes tampons que AF_UNIX : pas de segments, de fenetre ni de
  retransmission), sockets ICMP (echo repondu par le noyau : ping local).
  Les attentes passent par SleepOn/WakeUp sur l'adresse de la socket. }

Const
  AF_UNIX = 1; AF_INET = 2; AF_NETLINK = 16; AF_PACKET = 17;
  SOCK_STREAM = 1; SOCK_DGRAM = 2; SOCK_RAW = 3;
  SOCK_NONBLOCK = $800; SOCK_CLOEXEC = $80000;
  EADDRINUSE = 98; ECONNREFUSED = 111; ENOTCONN = 107; EISCONN = 106;
  EPROTONOSUPPORT = 93; EOPNOTSUPP = 95; ENETUNREACH = 101;
  ECONNRESET = 104; EINPROGRESS = 115; EDESTADDRREQ = 89; EMSGSIZE = 90;
  EPROTOTYPE = 91; ENOPROTOOPT = 92; EADDRNOTAVAIL = 99; ENOBUFS = 105;
  ESOCKTNOSUPPORT_ = 94; ETIMEDOUT = 110; EHOSTUNREACH_ = 113; EALREADY_ = 114;
  TcpClosed = 0; TcpListen = 1; TcpSynSent = 2; TcpSynRcvd = 3; TcpEstab = 4;
  TcpFinWait1 = 5; TcpFinWait2 = 6; TcpCloseWait = 7; TcpLastAck = 8;
  TcpClosing = 9; TcpTimeWait = 10;
  TF_FIN = 1; TF_SYN = 2; TF_RST = 4; TF_PSH = 8; TF_ACK = 16;
  MaxSocks    = 128;
  SockBufSz   = 16384;
  SockQMax    = 64;            { datagrammes en attente au plus }
  SsFree = 0; SsUnconn = 1; SsListen = 2; SsConn = 3;
  MSG_PEEK = 2; MSG_DONTWAIT = $40; MSG_TRUNC = $20; MSG_NOSIGNAL = $4000;
  IPPROTO_ICMP = 1; IPPROTO_TCP = 6; IPPROTO_UDP = 17;

Type
  PMsg = ^TMsg;
  TMsg = Record
    Next        : PMsg;
    Len, Data   : LongInt;
    SrcAddr, SrcPort : LongInt;      { source AF_INET }
    SrcKeyLen   : LongInt;
    SrcKey      : Array[0..107] Of Byte;  { source AF_UNIX }
    NFds        : LongInt;
    Fds         : Array[0..7] Of LongInt; { PFile (SCM_RIGHTS) }
    CredPid     : LongInt;
  End;

  PSock = ^TSock;
  TSock = Record
    State, Family, Typ, Proto, Flags : LongInt;
    Peer        : PSock;            { flux et socketpair : l'autre bout }
    Closed, PeerGone, ShutRd, ShutWr, PeerWrDone : LongInt;
    Buf, BHead, BLen : LongInt;     { anneau d'octets (flux) }
    QHead, QTail : PMsg;            { datagrammes en attente }
    QCount      : LongInt;
    FdHead      : PMsg;             { SCM_RIGHTS en attente (flux) }
    Backlog     : Array[0..15] Of PSock;
    NBacklog, MaxBacklog : LongInt;
    KeyLen      : LongInt;          { nom AF_UNIX lie }
    Key         : Array[0..107] Of Byte;
    UIno        : PInode;           { inode du noeud lie (chemin) }
    LAddr, LPort, RAddr, RPort : LongInt;   { AF_INET (ordre hote) }
    HasDest     : LongInt;
    DestKeyLen  : LongInt;
    DestKey     : Array[0..107] Of Byte;
    Err, Reuse  : LongInt;
    CPid, CUid, CGid : LongInt;
    Bound       : LongInt;
    IcmpId      : LongInt;
    { TCP reseau (connexions hors bouclage) }
    Net, TState, SndUna, SndNxt, RcvNxt, SndWnd, Iss : LongInt;
    SBuf, SHead, SLen, RtoAt, Retries : LongInt;
    FinQueued, FinSent, FinAcked : LongInt;
    Parent      : PSock;
    Ino         : LongInt;          { numero d'inode (/proc/net) }
  End;

Var
  Socks       : Array[0..MaxSocks - 1] Of TSock;
  NicIp, NicMask, NicGw : LongInt;   { interface eth0 (ordre hote) }
  SockFOps    : Array[0..15] Of LongInt;
  NextPort    : LongInt;

{ ---- Gestion des sockets ---- }

{ Fonctions de la pile reseau (partie 22) }
Procedure TcpOutput(S : PSock); Forward;
Procedure TcpAckNow(S : PSock); Forward;
Function UdpOutput(Sp, Dst, Dp, Buf, Len : LongInt) : LongInt; Forward;
Function TcpConnectStart(S : PSock) : LongInt; Forward;
Function NetIcmpSend(S : PSock; Buf, Cnt, Dst : LongInt) : LongInt; Forward;
Procedure TcpClose(S : PSock); Forward;
Procedure TcpShutWr(S : PSock); Forward;
Function NetStreamWrite(S : PSock; Buf, Cnt, Flags : LongInt) : LongInt;
    Forward;
Function NetIoctl(Cmd, Arg : LongInt) : LongInt; Forward;
Function NlSend(S : PSock; Buf, Cnt : LongInt) : LongInt; Forward;
Function PktSend(S : PSock; Buf, Cnt, Dest, DestLen : LongInt) : LongInt;
    Forward;

Function SockNew(Fam, Typ, Proto : LongInt) : PSock;
Var I : LongInt; S : PSock;
Begin
  SockNew := Nil;
  For I := 0 To MaxSocks - 1 Do
    If Socks[I].State = SsFree Then
    Begin
      S := @Socks[I];
      MemFill(LongInt(S), 0, SizeOf(TSock));
      S^.State := SsUnconn;
      S^.Family := Fam; S^.Typ := Typ; S^.Proto := Proto;
      S^.CPid := Cur^.Tgid; S^.CUid := Cur^.Euid; S^.CGid := Cur^.Egid;
      SockNew := S;
      Exit;
    End;
End;

Function SockAllocBuf(S : PSock) : Boolean;
Begin
  If S^.Buf = 0 Then S^.Buf := AllocPages(OrderFor(SockBufSz));
  SockAllocBuf := S^.Buf <> 0;
End;

Procedure MsgFree(M : PMsg);
Var I : LongInt;
Begin
  If M^.Data <> 0 Then KFree(M^.Data);
  For I := 0 To M^.NFds - 1 Do FilePut(M^.Fds[I]);
  KFree(LongInt(M));
End;

Procedure SockRelease(S : PSock);
Var M, N : PMsg;
Begin
  If S^.Buf <> 0 Then FreePages(S^.Buf, OrderFor(SockBufSz));
  M := S^.QHead;
  While M <> Nil Do
  Begin
    N := M^.Next;
    MsgFree(M);
    M := N;
  End;
  M := S^.FdHead;
  While M <> Nil Do
  Begin
    N := M^.Next;
    MsgFree(M);
    M := N;
  End;
  If S^.UIno <> Nil Then InodePut(LongInt(S^.UIno));
  S^.State := SsFree;
End;

{ Fermeture par le dernier descripteur : une socket dont le pair est encore
  ouvert reste "fermee" en memoire jusqu'a la fermeture du pair }
Procedure SockClose(S : PSock);
Var P : PSock; I, N : LongInt; Bl : Array[0..15] Of PSock;
Begin
  If (S^.Net <> 0) Or ((S^.Family = AF_INET) And (S^.Typ = SOCK_STREAM)
      And (S^.State = SsListen)) Then
  Begin
    N := S^.NBacklog;
    For I := 0 To N - 1 Do Bl[I] := S^.Backlog[I];
    S^.NBacklog := 0;
    For I := 0 To N - 1 Do SockClose(Bl[I]);
    TcpClose(S);
    If (S^.State = SsListen) Then
    Begin
      If S^.Buf <> 0 Then FreePages(S^.Buf, OrderFor(SockBufSz));
      S^.Buf := 0;
      SockRelease(S);
    End;
    Exit;
  End;
  S^.Closed := 1;
  N := S^.NBacklog;
  For I := 0 To N - 1 Do Bl[I] := S^.Backlog[I];
  S^.NBacklog := 0;
  For I := 0 To N - 1 Do SockClose(Bl[I]);
  P := S^.Peer;
  If P = Nil Then SockRelease(S)
  Else
  Begin
    P^.PeerGone := 1;
    WakeUp(LongInt(P));
    If P^.Closed <> 0 Then
    Begin
      SockRelease(P);
      SockRelease(S);
    End;
  End;
End;

{ ---- Fichier d'une socket ---- }

Function SockFile(S : PSock; Fl : LongInt) : PFile;
Var I : PInode; D : PDentry; F : PFile;
Begin
  SockFile := Nil;
  I := NewInode(PipeSb, S_IFSOCK Or $1FF);
  If I = Nil Then Exit;
  I^.Nlink := 0;
  D := DentryNew(Nil, '', I, PipeSb);
  If D = Nil Then
  Begin
    InodePut(LongInt(I));
    Exit;
  End;
  F := FileNew(D, O_RDWR Or (Fl And O_NONBLOCK));
  If F = Nil Then
  Begin
    DentryPut(LongInt(D));
    Exit;
  End;
  F^.FOps := LongInt(@SockFOps[0]);
  F^.Priv := LongInt(S);
  S^.Ino := I^.Ino;
  SockFile := F;
End;

Function SockOf(F : PFile) : PSock;
Begin
  If (F = Nil) Or (F^.FOps <> LongInt(@SockFOps[0])) Then SockOf := Nil
  Else SockOf := Pointer(F^.Priv);
End;

{ ---- Adresses ---- }

Function Ntohs(V : LongInt) : LongInt;
Begin
  Ntohs := ((V And $FF) Shl 8) Or ((V Shr 8) And $FF);
End;

Function Ntohl(V : LongInt) : LongInt;
Begin
  Ntohl := ((V And $FF) Shl 24) Or ((V And $FF00) Shl 8)
      Or ((V Shr 8) And $FF00) Or ((V Shr 24) And $FF);
End;

{ L'adresse (ordre hote) est-elle locale ? 0.0.0.0 et 127.x.x.x }
Function IsLocalAddr(A : LongInt) : Boolean;
Begin
  IsLocalAddr := (A = 0) Or (((A Shr 24) And $FF) = 127)
      Or ((A = NicIp) And (NicIp <> 0));
End;

{ sockaddr_un : cle (chemin ou #0 + nom abstrait) ; faux si invalide }
Function GetUnKey(Addr, Len, Key : LongInt; Var KLen : LongInt) : LongInt;
Var I, N : LongInt;
Begin
  GetUnKey := -EINVAL;
  KLen := 0;
  If (Len < 3) Or (Len > 110) Then Exit;
  If Not EnsureUser(Addr, Len, False) Then
  Begin
    GetUnKey := -EFAULT;
    Exit;
  End;
  If MemW[0:Addr] <> AF_UNIX Then Exit;
  N := Len - 2;
  If Mem[0:Addr + 2] <> 0 Then
  Begin
    { chemin : jusqu'au premier zero }
    I := 0;
    While (I < N) And (Mem[0:Addr + 2 + I] <> 0) Do Inc(I);
    N := I;
  End;
  If N > 107 Then N := 107;
  For I := 0 To N - 1 Do Mem[0:Key + I] := Mem[0:Addr + 2 + I];
  KLen := N;
  GetUnKey := 0;
End;

Function KeyEq(A, LA, B, LB : LongInt) : Boolean;
Begin
  KeyEq := (LA = LB) And (MemCmp(A, B, LA) = 0);
End;

{ Ecrire une adresse de socket : Fam, cle ou (addr, port) ; Lp = pointeur
  sur la longueur (entree : taille du tampon, sortie : taille reelle) }
Procedure PutSockAddr(Fam, Key, KLen, Addr, Port, Buf, Lp : LongInt);
Var Max, N, I : LongInt; Tmp : Array[0..127] Of Byte;
Begin
  If (Buf = 0) Or (Lp = 0) Then Exit;
  If Not EnsureUser(Lp, 4, True) Then Exit;
  Max := MemL[0:Lp];
  MemFill(LongInt(@Tmp[0]), 0, 128);
  Tmp[0] := Fam And $FF; Tmp[1] := 0;
  If Fam = AF_PACKET Then
  Begin
    Tmp[2] := (Addr Shr 8) And $FF; Tmp[3] := Addr And $FF;
    MemL[0:LongInt(@Tmp[4])] := Port;
    Tmp[8] := 1;
    N := 20;
  End
  Else If Fam = AF_NETLINK Then
  Begin
    MemL[0:LongInt(@Tmp[4])] := Port;
    MemL[0:LongInt(@Tmp[8])] := Addr;
    N := 12;
  End
  Else If Fam = AF_UNIX Then
  Begin
    For I := 0 To KLen - 1 Do Tmp[2 + I] := Mem[0:Key + I];
    N := 2 + KLen;
    If (KLen > 0) And (Mem[0:Key] <> 0) Then Inc(N);
  End
  Else
  Begin
    Tmp[2] := (Port Shr 8) And $FF; Tmp[3] := Port And $FF;
    Tmp[4] := (Addr Shr 24) And $FF; Tmp[5] := (Addr Shr 16) And $FF;
    Tmp[6] := (Addr Shr 8) And $FF; Tmp[7] := Addr And $FF;
    N := 16;
  End;
  If Max < 0 Then Max := 0;
  If Max > N Then I := N Else I := Max;
  If Not EnsureUser(Buf, I, True) Then Exit;
  MemCopy(Buf, LongInt(@Tmp[0]), I);
  MemL[0:Lp] := N;
End;

{ ---- Recherche de sockets ---- }

Function UnFind(Key, KLen, Typ : LongInt; Const Path : String;
    Var Err : LongInt) : PSock;
Var I : LongInt; D : PDentry; Ino : PInode; R : LongInt;
Begin
  UnFind := Nil;
  Err := -ECONNREFUSED;
  If (KLen > 0) And (Mem[0:Key] = 0) Then
  Begin
    For I := 0 To MaxSocks - 1 Do
      If (Socks[I].State <> SsFree) And (Socks[I].Family = AF_UNIX)
         And (Socks[I].Typ = Typ) And (Socks[I].Bound <> 0)
         And (Socks[I].UIno = Nil) And (Socks[I].Closed = 0)
         And KeyEq(LongInt(@Socks[I].Key[0]), Socks[I].KeyLen, Key, KLen) Then
      Begin
        UnFind := @Socks[I];
        Exit;
      End;
    Exit;
  End;
  R := PathWalk(Path, True, D);
  If R <> 0 Then
  Begin
    Err := R;
    Exit;
  End;
  Ino := D^.Inode;
  DentryPut(LongInt(D));
  If (Ino^.Mode And S_IFMT) <> S_IFSOCK Then Exit;
  For I := 0 To MaxSocks - 1 Do
    If (Socks[I].State <> SsFree) And (Socks[I].Family = AF_UNIX)
       And (Socks[I].Typ = Typ) And (Socks[I].UIno = Ino)
       And (Socks[I].Closed = 0) Then
    Begin
      UnFind := @Socks[I];
      Exit;
    End;
End;

Function InFind(Typ, Port, Listening : LongInt) : PSock;
Var I : LongInt;
Begin
  InFind := Nil;
  For I := 0 To MaxSocks - 1 Do
    If (Socks[I].State <> SsFree) And (Socks[I].Family = AF_INET)
       And (Socks[I].Typ = Typ) And (Socks[I].LPort = Port)
       And (Socks[I].Bound <> 0) And (Socks[I].Closed = 0) Then
      If (Listening = 0) Or (Socks[I].State = SsListen) Then
      Begin
        InFind := @Socks[I];
        Exit;
      End;
End;

Function PortFree(Typ, Port : LongInt) : Boolean;
Begin
  PortFree := InFind(Typ, Port, 0) = Nil;
End;

Function AutoPort(Typ : LongInt) : LongInt;
Var N : LongInt;
Begin
  AutoPort := 0;
  For N := 0 To 28000 Do
  Begin
    Inc(NextPort);
    If NextPort > 60999 Then NextPort := 32768;
    If PortFree(Typ, NextPort) Then
    Begin
      AutoPort := NextPort;
      Exit;
    End;
  End;
End;

{ ---- Envoi et reception d'octets (flux) ---- }

Function StreamWrite(S : PSock; Buf, Cnt : LongInt; Flags : LongInt) : LongInt;
Var P : PSock; Done, N, Tail, Chunk : LongInt;
Begin
  If S^.Net <> 0 Then
  Begin
    StreamWrite := NetStreamWrite(S, Buf, Cnt, Flags);
    Exit;
  End;
  P := S^.Peer;
  If (S^.State <> SsConn) Or (P = Nil) Then
  Begin
    StreamWrite := -ENOTCONN;
    Exit;
  End;
  Done := 0;
  While Done < Cnt Do
  Begin
    If (S^.ShutWr <> 0) Or (S^.PeerGone <> 0) Or (P^.ShutRd <> 0) Then
    Begin
      If (Flags And MSG_NOSIGNAL) = 0 Then SendSig(Cur, SIGPIPE);
      If Done > 0 Then StreamWrite := Done Else StreamWrite := -EPIPE;
      Exit;
    End;
    N := SockBufSz - P^.BLen;
    If N > Cnt - Done Then N := Cnt - Done;
    If N <= 0 Then
    Begin
      If ((S^.Flags Or Flags) And (O_NONBLOCK Or MSG_DONTWAIT)) <> 0 Then
      Begin
        If Done > 0 Then StreamWrite := Done Else StreamWrite := -EAGAIN;
        Exit;
      End;
      If SleepOn(LongInt(P), 0, True) = WakeSignal Then
      Begin
        If Done > 0 Then StreamWrite := Done Else StreamWrite := -ERESTARTSYS;
        Exit;
      End;
    End
    Else
    Begin
      Tail := (P^.BHead + P^.BLen) Mod SockBufSz;
      Chunk := N;
      If Chunk > SockBufSz - Tail Then Chunk := SockBufSz - Tail;
      MemCopy(P^.Buf + Tail, Buf + Done, Chunk);
      If N > Chunk Then MemCopy(P^.Buf, Buf + Done + Chunk, N - Chunk);
      Inc(P^.BLen, N);
      Done := Done + N;
      WakeUp(LongInt(P));
    End;
  End;
  StreamWrite := Done;
End;

Function StreamRead(S : PSock; Buf, Cnt : LongInt; Flags : LongInt) : LongInt;
Var N, First, Chunk, Before : LongInt;
Begin
  If (S^.Net <> 0) And (S^.Err <> 0) And (S^.BLen = 0) Then
  Begin
    StreamRead := -S^.Err;
    S^.Err := 0;
    Exit;
  End;
  If S^.State <> SsConn Then
  Begin
    StreamRead := -ENOTCONN;
    Exit;
  End;
  While S^.BLen = 0 Do
  Begin
    If (S^.PeerGone <> 0) Or (S^.PeerWrDone <> 0) Or (S^.ShutRd <> 0)
        Or ((S^.Peer = Nil) And (S^.Net = 0)) Then
    Begin
      StreamRead := 0;
      Exit;
    End;
    If ((S^.Flags Or Flags) And (O_NONBLOCK Or MSG_DONTWAIT)) <> 0 Then
    Begin
      StreamRead := -EAGAIN;
      Exit;
    End;
    If SleepOn(LongInt(S), 0, True) = WakeSignal Then
    Begin
      StreamRead := -ERESTARTSYS;
      Exit;
    End;
  End;
  N := Cnt;
  If N > S^.BLen Then N := S^.BLen;
  First := SockBufSz - S^.BHead;
  Chunk := N;
  If Chunk > First Then Chunk := First;
  MemCopy(Buf, S^.Buf + S^.BHead, Chunk);
  If N > Chunk Then MemCopy(Buf + Chunk, S^.Buf, N - Chunk);
  If (Flags And MSG_PEEK) = 0 Then
  Begin
    Before := S^.BLen;
    S^.BHead := (S^.BHead + N) Mod SockBufSz;
    Dec(S^.BLen, N);
    WakeUp(LongInt(S));
    If (S^.Net <> 0) And (Before * 2 > SockBufSz) And (S^.TState <> TcpClosed)
       Then TcpAckNow(S);
  End;
  StreamRead := N;
End;

{ ---- Datagrammes ---- }

Function MsgAdd(D : PSock; Buf, Cnt : LongInt) : PMsg;
Var M : PMsg;
Begin
  MsgAdd := Nil;
  If D^.QCount >= SockQMax Then Exit;
  M := Pointer(KMallocZ(SizeOf(TMsg)));
  If M = Nil Then Exit;
  If Cnt > 0 Then
  Begin
    M^.Data := KMalloc(Cnt);
    If M^.Data = 0 Then
    Begin
      KFree(LongInt(M));
      Exit;
    End;
    MemCopy(M^.Data, Buf, Cnt);
  End;
  M^.Len := Cnt;
  M^.CredPid := Cur^.Tgid;
  If D^.QTail = Nil Then D^.QHead := M Else D^.QTail^.Next := M;
  D^.QTail := M;
  Inc(D^.QCount);
  WakeUp(LongInt(D));
  MsgAdd := M;
End;

{ Retirer le premier datagramme ; Peek : le laisser }
Function DgramRecv(S : PSock; Buf, Cnt, Flags : LongInt;
    Var Src : PMsg) : LongInt;
Var M : PMsg; N : LongInt;
Begin
  Src := Nil;
  While S^.QHead = Nil Do
  Begin
    If S^.PeerGone <> 0 Then
    Begin
      DgramRecv := 0;
      Exit;
    End;
    If ((S^.Flags Or Flags) And (O_NONBLOCK Or MSG_DONTWAIT)) <> 0 Then
    Begin
      DgramRecv := -EAGAIN;
      Exit;
    End;
    If SleepOn(LongInt(S), 0, True) = WakeSignal Then
    Begin
      DgramRecv := -ERESTARTSYS;
      Exit;
    End;
  End;
  M := S^.QHead;
  N := M^.Len;
  If N > Cnt Then N := Cnt;
  If N > 0 Then MemCopy(Buf, M^.Data, N);
  Src := M;
  If (Flags And MSG_PEEK) = 0 Then
  Begin
    S^.QHead := M^.Next;
    If S^.QHead = Nil Then S^.QTail := Nil;
    Dec(S^.QCount);
  End
  Else Src := Nil;
  DgramRecv := N;
End;

{ ---- Operations : creation, adresses, connexion ---- }

Function SockKeyStr(Key, KLen : LongInt) : String;
Var S : String; I : LongInt;
Begin
  S := '';
  For I := 0 To KLen - 1 Do S := S + Chr(Mem[0:Key + I]);
  SockKeyStr := S;
End;

Function SockNewFd(S : PSock; Typ : LongInt) : LongInt;
Var F : PFile; R : LongInt;
Begin
  F := SockFile(S, Typ);
  If F = Nil Then
  Begin
    SockClose(S);
    SockNewFd := -ENFILE;
    Exit;
  End;
  R := FdInstall(F, 0, (Typ And SOCK_CLOEXEC) <> 0);
  If R < 0 Then
  Begin
    FilePut(LongInt(F));
    SockClose(S);
    SockNewFd := R;
    Exit;
  End;
  SockNewFd := R;
End;

Function SysSocket(Fam, Typ, Proto : LongInt) : LongInt;
Var S : PSock; T : LongInt;
Begin
  T := Typ And $F;
  If Fam = AF_NETLINK Then
  Begin
    If (T <> SOCK_DGRAM) And (T <> SOCK_RAW) Then
    Begin
      SysSocket := -ESOCKTNOSUPPORT_;
      Exit;
    End;
    If Proto <> 0 Then
    Begin
      SysSocket := -EPROTONOSUPPORT;
      Exit;
    End;
    S := SockNew(AF_NETLINK, SOCK_DGRAM, 0);
    If S = Nil Then
    Begin
      SysSocket := -ENOBUFS;
      Exit;
    End;
    S^.Flags := Typ And O_NONBLOCK;
    SysSocket := SockNewFd(S, Typ);
    Exit;
  End;
  If Fam = AF_PACKET Then
  Begin
    If Cur^.Euid <> 0 Then
    Begin
      SysSocket := -EPERM;
      Exit;
    End;
    If (T <> SOCK_DGRAM) And (T <> SOCK_RAW) Then
    Begin
      SysSocket := -ESOCKTNOSUPPORT_;
      Exit;
    End;
    S := SockNew(AF_PACKET, T,
        ((Proto And $FF) Shl 8) Or ((Proto Shr 8) And $FF));
    If S = Nil Then
    Begin
      SysSocket := -ENOBUFS;
      Exit;
    End;
    S^.Flags := Typ And O_NONBLOCK;
    SysSocket := SockNewFd(S, Typ);
    Exit;
  End;
  If (Fam <> AF_UNIX) And (Fam <> AF_INET) Then
  Begin
    SysSocket := -EAFNOSUPPORT;
    Exit;
  End;
  If Fam = AF_UNIX Then
  Begin
    If (T <> SOCK_STREAM) And (T <> SOCK_DGRAM) Then
    Begin
      SysSocket := -ESOCKTNOSUPPORT_;
      Exit;
    End;
    If Proto <> 0 Then
    Begin
      SysSocket := -EPROTONOSUPPORT;
      Exit;
    End;
  End
  Else
  Begin
    If T = SOCK_STREAM Then
    Begin
      If (Proto <> 0) And (Proto <> IPPROTO_TCP) Then
      Begin
        SysSocket := -EPROTONOSUPPORT;
        Exit;
      End;
      Proto := IPPROTO_TCP;
    End
    Else If T = SOCK_DGRAM Then
    Begin
      If (Proto <> 0) And (Proto <> IPPROTO_UDP)
         And (Proto <> IPPROTO_ICMP) Then
      Begin
        SysSocket := -EPROTONOSUPPORT;
        Exit;
      End;
      If Proto = 0 Then Proto := IPPROTO_UDP;
    End
    Else If T = SOCK_RAW Then
    Begin
      If (Proto <> IPPROTO_ICMP) And (Proto <> 255) Then
      Begin
        SysSocket := -EPROTONOSUPPORT;
        Exit;
      End;
      If Cur^.Euid <> 0 Then
      Begin
        SysSocket := -EPERM;
        Exit;
      End;
    End
    Else
    Begin
      SysSocket := -ESOCKTNOSUPPORT_;
      Exit;
    End;
  End;
  S := SockNew(Fam, T, Proto);
  If S = Nil Then
  Begin
    SysSocket := -ENOBUFS;
    Exit;
  End;
  S^.Flags := Typ And O_NONBLOCK;
  If (T = SOCK_STREAM) And (Fam = AF_UNIX) Then S^.Flags := S^.Flags;
  SysSocket := SockNewFd(S, Typ);
End;

Function SysSocketpair(Fam, Typ, Proto, Sv : LongInt) : LongInt;
Var A, B : PSock; T, Fa, Fb : LongInt;
Begin
  T := Typ And $F;
  If Fam <> AF_UNIX Then
  Begin
    SysSocketpair := -EOPNOTSUPP;
    Exit;
  End;
  If (T <> SOCK_STREAM) And (T <> SOCK_DGRAM) Then
  Begin
    SysSocketpair := -ESOCKTNOSUPPORT_;
    Exit;
  End;
  If Not EnsureUser(Sv, 8, True) Then
  Begin
    SysSocketpair := -EFAULT;
    Exit;
  End;
  A := SockNew(AF_UNIX, T, 0);
  If A = Nil Then
  Begin
    SysSocketpair := -ENOBUFS;
    Exit;
  End;
  B := SockNew(AF_UNIX, T, 0);
  If B = Nil Then
  Begin
    A^.State := SsFree;
    SysSocketpair := -ENOBUFS;
    Exit;
  End;
  A^.Flags := Typ And O_NONBLOCK; B^.Flags := A^.Flags;
  If T = SOCK_STREAM Then
  Begin
    If (Not SockAllocBuf(A)) Or (Not SockAllocBuf(B)) Then
    Begin
      SockRelease(A); SockRelease(B);
      SysSocketpair := -ENOMEM;
      Exit;
    End;
  End;
  A^.Peer := B; B^.Peer := A;
  A^.State := SsConn; B^.State := SsConn;
  Fa := SockNewFd(A, Typ);
  If Fa < 0 Then
  Begin
    SockClose(B);
    SysSocketpair := Fa;
    Exit;
  End;
  Fb := SockNewFd(B, Typ);
  If Fb < 0 Then
  Begin
    FdClose(Fa);
    SysSocketpair := Fb;
    Exit;
  End;
  MemL[0:Sv] := Fa;
  MemL[0:Sv + 4] := Fb;
  SysSocketpair := 0;
End;

Function SockGet(Fd : LongInt; Var Err : LongInt) : PSock;
Var F : PFile; S : PSock;
Begin
  F := FdGet(Fd);
  If F = Nil Then
  Begin
    Err := -EBADF;
    SockGet := Nil;
    Exit;
  End;
  S := SockOf(F);
  If S = Nil Then Err := -ENOTSOCK Else Err := 0;
  SockGet := S;
End;

Function SysBind(Fd, Addr, Len : LongInt) : LongInt;
Var S : PSock; E, KLen, Port, A, R : LongInt; Path : String; D : PDentry;
    Key : Array[0..107] Of Byte;
Begin
  S := SockGet(Fd, E);
  If S = Nil Then
  Begin
    SysBind := E;
    Exit;
  End;
  If S^.Bound <> 0 Then
  Begin
    SysBind := -EINVAL;
    Exit;
  End;
  If S^.Family = AF_PACKET Then
  Begin
    If (Len < 12) Or (Not EnsureUser(Addr, 12, False))
       Or (MemW[0:Addr] <> AF_PACKET) Then
    Begin
      SysBind := -EINVAL;
      Exit;
    End;
    If (MemL[0:Addr + 4] <> 0) And (MemL[0:Addr + 4] <> 2) And
       (MemL[0:Addr + 4] <> 1) Then
    Begin
      SysBind := -ENODEV;
      Exit;
    End;
    S^.LPort := MemL[0:Addr + 4];
    If (Mem[0:Addr + 2] Shl 8 Or Mem[0:Addr + 3]) <> 0 Then
      S^.Proto := (Mem[0:Addr + 2] Shl 8) Or Mem[0:Addr + 3];
    S^.Bound := 1;
    SysBind := 0;
    Exit;
  End;
  If S^.Family = AF_NETLINK Then
  Begin
    If (Len < 12) Or (Not EnsureUser(Addr, 12, False))
       Or (MemW[0:Addr] <> AF_NETLINK) Then
    Begin
      SysBind := -EINVAL;
      Exit;
    End;
    S^.LPort := MemL[0:Addr + 4];
    If S^.LPort = 0 Then S^.LPort := Cur^.Tgid;
    S^.LAddr := MemL[0:Addr + 8];
    S^.Bound := 1;
    SysBind := 0;
    Exit;
  End;
  If S^.Family = AF_UNIX Then
  Begin
    R := GetUnKey(Addr, Len, LongInt(@Key[0]), KLen);
    If R <> 0 Then
    Begin
      SysBind := R;
      Exit;
    End;
    If KLen = 0 Then
    Begin
      SysBind := -EINVAL;
      Exit;
    End;
    If Key[0] <> 0 Then
    Begin
      Path := SockKeyStr(LongInt(@Key[0]), KLen);
      R := VfsCreateNode(Path, S_IFSOCK Or $1FF, 0, False);
      If R = -EEXIST Then R := -EADDRINUSE;
      If R <> 0 Then
      Begin
        SysBind := R;
        Exit;
      End;
      If PathWalk(Path, False, D) <> 0 Then
      Begin
        SysBind := -ENOENT;
        Exit;
      End;
      S^.UIno := D^.Inode;
      InodeRef(LongInt(D^.Inode));
      DentryPut(LongInt(D));
    End
    Else If UnFind(LongInt(@Key[0]), KLen, S^.Typ, '', R) <> Nil Then
    Begin
      SysBind := -EADDRINUSE;
      Exit;
    End;
    MemCopy(LongInt(@S^.Key[0]), LongInt(@Key[0]), KLen);
    S^.KeyLen := KLen;
    S^.Bound := 1;
    SysBind := 0;
    Exit;
  End;
  { AF_INET }
  If (Len < 8) Or (Not EnsureUser(Addr, 8, False)) Then
  Begin
    SysBind := -EINVAL;
    Exit;
  End;
  If MemW[0:Addr] <> AF_INET Then
  Begin
    SysBind := -EAFNOSUPPORT;
    Exit;
  End;
  Port := Ntohs(MemW[0:Addr + 2]);
  A := Ntohl(MemL[0:Addr + 4]);
  If Not IsLocalAddr(A) Then
  Begin
    SysBind := -EADDRNOTAVAIL;
    Exit;
  End;
  If S^.Proto = IPPROTO_ICMP Then
  Begin
    S^.LAddr := A;
    S^.Bound := 1;
    SysBind := 0;
    Exit;
  End;
  If Port = 0 Then Port := AutoPort(S^.Typ)
  Else
  Begin
    If (Port < 1024) And (Cur^.Euid <> 0) Then
    Begin
      SysBind := -EACCES;
      Exit;
    End;
    If Not PortFree(S^.Typ, Port) Then
    Begin
      SysBind := -EADDRINUSE;
      Exit;
    End;
  End;
  S^.LAddr := A;
  S^.LPort := Port;
  S^.Bound := 1;
  SysBind := 0;
End;

Function SysListen(Fd, Backlog : LongInt) : LongInt;
Var S : PSock; E : LongInt;
Begin
  S := SockGet(Fd, E);
  If S = Nil Then
  Begin
    SysListen := E;
    Exit;
  End;
  If S^.Typ <> SOCK_STREAM Then
  Begin
    SysListen := -EOPNOTSUPP;
    Exit;
  End;
  If (S^.State <> SsUnconn) And (S^.State <> SsListen) Then
  Begin
    SysListen := -EINVAL;
    Exit;
  End;
  If S^.Bound = 0 Then
  Begin
    If S^.Family = AF_UNIX Then
    Begin
      SysListen := -EINVAL;
      Exit;
    End;
    S^.LPort := AutoPort(SOCK_STREAM);
    S^.Bound := 1;
  End;
  If Backlog < 1 Then Backlog := 1;
  If Backlog > 16 Then Backlog := 16;
  S^.MaxBacklog := Backlog;
  S^.State := SsListen;
  SysListen := 0;
End;

{ Connexion d'un flux : cree la socket serveur et la met en attente }
Function StreamConnect(S, L : PSock) : LongInt;
Var X : PSock;
Begin
  If L^.NBacklog >= L^.MaxBacklog Then
  Begin
    StreamConnect := -ECONNREFUSED;
    Exit;
  End;
  X := SockNew(L^.Family, SOCK_STREAM, L^.Proto);
  If X = Nil Then
  Begin
    StreamConnect := -ENOBUFS;
    Exit;
  End;
  If (Not SockAllocBuf(S)) Or (Not SockAllocBuf(X)) Then
  Begin
    SockRelease(X);
    StreamConnect := -ENOMEM;
    Exit;
  End;
  X^.Bound := L^.Bound; X^.KeyLen := L^.KeyLen;
  MemCopy(LongInt(@X^.Key[0]), LongInt(@L^.Key[0]), L^.KeyLen);
  X^.LAddr := L^.LAddr; X^.LPort := L^.LPort;
  X^.RAddr := S^.LAddr; X^.RPort := S^.LPort;
  S^.RAddr := X^.LAddr; S^.RPort := X^.LPort;
  X^.CPid := L^.CPid; X^.CUid := L^.CUid; X^.CGid := L^.CGid;
  X^.Peer := S; S^.Peer := X;
  X^.State := SsConn; S^.State := SsConn;
  L^.Backlog[L^.NBacklog] := X;
  Inc(L^.NBacklog);
  WakeUp(LongInt(L));
  StreamConnect := 0;
End;

Function SysConnect(Fd, Addr, Len : LongInt) : LongInt;
Var S, L : PSock; E, KLen, Port, A, R : LongInt; Path : String;
    Key : Array[0..107] Of Byte;
Begin
  S := SockGet(Fd, E);
  If S = Nil Then
  Begin
    SysConnect := E;
    Exit;
  End;
  If S^.Family = AF_NETLINK Then
  Begin
    SysConnect := 0;
    Exit;
  End;
  If S^.Family = AF_UNIX Then
  Begin
    R := GetUnKey(Addr, Len, LongInt(@Key[0]), KLen);
    If R <> 0 Then
    Begin
      SysConnect := R;
      Exit;
    End;
    If KLen = 0 Then
    Begin
      SysConnect := -EINVAL;
      Exit;
    End;
    If Key[0] = 0 Then Path := ''
    Else Path := SockKeyStr(LongInt(@Key[0]), KLen);
    If S^.Typ = SOCK_STREAM Then
    Begin
      If S^.State = SsConn Then
      Begin
        SysConnect := -EISCONN;
        Exit;
      End;
      If S^.State = SsListen Then
      Begin
        SysConnect := -EINVAL;
        Exit;
      End;
      L := UnFind(LongInt(@Key[0]), KLen, SOCK_STREAM, Path, R);
      If (L = Nil) Or (L^.State <> SsListen) Then
      Begin
        If (L = Nil) And (R <> -ECONNREFUSED) Then SysConnect := R
        Else SysConnect := -ECONNREFUSED;
        Exit;
      End;
      SysConnect := StreamConnect(S, L);
      Exit;
    End;
    { datagrammes : destination par defaut }
    L := UnFind(LongInt(@Key[0]), KLen, SOCK_DGRAM, Path, R);
    If L = Nil Then
    Begin
      SysConnect := R;
      Exit;
    End;
    S^.HasDest := 1;
    S^.DestKeyLen := KLen;
    MemCopy(LongInt(@S^.DestKey[0]), LongInt(@Key[0]), KLen);
    SysConnect := 0;
    Exit;
  End;
  { AF_INET }
  If (Len < 8) Or (Not EnsureUser(Addr, 8, False)) Then
  Begin
    SysConnect := -EINVAL;
    Exit;
  End;
  If MemW[0:Addr] <> AF_INET Then
  Begin
    SysConnect := -EAFNOSUPPORT;
    Exit;
  End;
  Port := Ntohs(MemW[0:Addr + 2]);
  A := Ntohl(MemL[0:Addr + 4]);
  If A = 0 Then A := $7F000001;
  If (Not IsLocalAddr(A)) And (S^.Typ = SOCK_STREAM) Then
  Begin
    If S^.State = SsConn Then
    Begin
      SysConnect := -EISCONN;
      Exit;
    End;
    If S^.TState = TcpSynSent Then
    Begin
      SysConnect := -EALREADY_;
      Exit;
    End;
    S^.RAddr := A; S^.RPort := Port;
    R := TcpConnectStart(S);
    If R <> 0 Then
    Begin
      SysConnect := R;
      Exit;
    End;
    If (S^.Flags And O_NONBLOCK) <> 0 Then
    Begin
      SysConnect := -EINPROGRESS;
      Exit;
    End;
    While S^.TState = TcpSynSent Do
      If SleepOn(LongInt(S), 0, True) = WakeSignal Then
      Begin
        SysConnect := -ERESTARTSYS;
        Exit;
      End;
    If S^.TState = TcpEstab Then SysConnect := 0
    Else
    Begin
      R := S^.Err;
      S^.Err := 0;
      If R = 0 Then R := ECONNREFUSED;
      SysConnect := -R;
    End;
    Exit;
  End;
  If (Not IsLocalAddr(A)) And (S^.Typ = SOCK_DGRAM) Then
  Begin
    S^.RAddr := A; S^.RPort := Port; S^.HasDest := 1;
    If (S^.Bound = 0) And (S^.Proto <> IPPROTO_ICMP) Then
    Begin
      S^.LPort := AutoPort(SOCK_DGRAM);
      S^.Bound := 1;
    End;
    SysConnect := 0;
    Exit;
  End;
  If Not IsLocalAddr(A) Then
  Begin
    SysConnect := -ENETUNREACH;
    Exit;
  End;
  If S^.Proto = IPPROTO_ICMP Then
  Begin
    S^.RAddr := A;
    S^.HasDest := 1;
    SysConnect := 0;
    Exit;
  End;
  If S^.Bound = 0 Then
  Begin
    S^.LPort := AutoPort(S^.Typ);
    S^.Bound := 1;
  End;
  If S^.Typ = SOCK_DGRAM Then
  Begin
    S^.RAddr := A; S^.RPort := Port; S^.HasDest := 1;
    SysConnect := 0;
    Exit;
  End;
  If S^.State = SsConn Then
  Begin
    SysConnect := -EISCONN;
    Exit;
  End;
  L := InFind(SOCK_STREAM, Port, 1);
  If L = Nil Then
  Begin
    SysConnect := -ECONNREFUSED;
    Exit;
  End;
  S^.LAddr := $7F000001;
  R := StreamConnect(S, L);
  If R = 0 Then S^.RAddr := A;
  SysConnect := R;
End;

Function SysAccept4(Fd, Addr, Lp, Flags : LongInt) : LongInt;
Var S, X : PSock; E, I : LongInt;
Begin
  S := SockGet(Fd, E);
  If S = Nil Then
  Begin
    SysAccept4 := E;
    Exit;
  End;
  If S^.State <> SsListen Then
  Begin
    SysAccept4 := -EINVAL;
    Exit;
  End;
  While S^.NBacklog = 0 Do
  Begin
    If (FdGet(Fd)^.Flags And O_NONBLOCK) <> 0 Then
    Begin
      SysAccept4 := -EAGAIN;
      Exit;
    End;
    If SleepOn(LongInt(S), 0, True) = WakeSignal Then
    Begin
      SysAccept4 := -ERESTARTSYS;
      Exit;
    End;
  End;
  X := S^.Backlog[0];
  For I := 1 To S^.NBacklog - 1 Do S^.Backlog[I - 1] := S^.Backlog[I];
  Dec(S^.NBacklog);
  X^.Flags := Flags And O_NONBLOCK;
  If X^.Peer <> Nil Then
    PutSockAddr(X^.Family, LongInt(@X^.Peer^.Key[0]), X^.Peer^.KeyLen,
        X^.RAddr, X^.RPort, Addr, Lp)
  Else PutSockAddr(X^.Family, LongInt(@X^.Key[0]), 0, X^.RAddr, X^.RPort,
      Addr, Lp);
  SysAccept4 := SockNewFd(X, Flags);
End;

Function SysAccept(Fd, Addr, Lp : LongInt) : LongInt;
Begin
  SysAccept := SysAccept4(Fd, Addr, Lp, 0);
End;

Function SysGetsockname(Fd, Addr, Lp : LongInt) : LongInt;
Var S : PSock; E, A : LongInt;
Begin
  S := SockGet(Fd, E);
  If S = Nil Then
  Begin
    SysGetsockname := E;
    Exit;
  End;
  A := S^.LAddr;
  If (A = 0) And (S^.State = SsConn) Then A := $7F000001;
  If S^.Family = AF_PACKET Then A := S^.Proto;
  PutSockAddr(S^.Family, LongInt(@S^.Key[0]), S^.KeyLen, A, S^.LPort, Addr,
      Lp);
  SysGetsockname := 0;
End;

Function SysGetpeername(Fd, Addr, Lp : LongInt) : LongInt;
Var S : PSock; E : LongInt;
Begin
  S := SockGet(Fd, E);
  If S = Nil Then
  Begin
    SysGetpeername := E;
    Exit;
  End;
  If (S^.State <> SsConn) And (S^.HasDest = 0) Then
  Begin
    SysGetpeername := -ENOTCONN;
    Exit;
  End;
  If (S^.Family = AF_UNIX) And (S^.Peer <> Nil) Then
    PutSockAddr(AF_UNIX, LongInt(@S^.Peer^.Key[0]), S^.Peer^.KeyLen, 0, 0,
        Addr, Lp)
  Else If S^.Family = AF_UNIX Then
    PutSockAddr(AF_UNIX, LongInt(@S^.DestKey[0]), S^.DestKeyLen, 0, 0, Addr,
        Lp)
  Else PutSockAddr(AF_INET, LongInt(@S^.Key[0]), 0, S^.RAddr, S^.RPort, Addr,
      Lp);
  SysGetpeername := 0;
End;

Function SysShutdown(Fd, How : LongInt) : LongInt;
Var S : PSock; E : LongInt;
Begin
  S := SockGet(Fd, E);
  If S = Nil Then
  Begin
    SysShutdown := E;
    Exit;
  End;
  If (How < 0) Or (How > 2) Then
  Begin
    SysShutdown := -EINVAL;
    Exit;
  End;
  If (S^.State <> SsConn) And (S^.Typ = SOCK_STREAM) Then
  Begin
    SysShutdown := -ENOTCONN;
    Exit;
  End;
  If (How = 0) Or (How = 2) Then S^.ShutRd := 1;
  If (How = 1) Or (How = 2) Then
  Begin
    S^.ShutWr := 1;
    If S^.Net <> 0 Then TcpShutWr(S);
    If S^.Peer <> Nil Then
    Begin
      S^.Peer^.PeerWrDone := 1;
      WakeUp(LongInt(S^.Peer));
    End;
  End;
  WakeUp(LongInt(S));
  SysShutdown := 0;
End;

{ ---- Envoi et reception ---- }

Function IcmpCsum(Buf, Len : LongInt) : LongInt;
Var Sum, I : LongInt;
Begin
  Sum := 0;
  I := 0;
  While I + 1 < Len Do
  Begin
    Sum := Sum + (Mem[0:Buf + I] Shl 8) + Mem[0:Buf + I + 1];
    I := I + 2;
  End;
  If I < Len Then Sum := Sum + (Mem[0:Buf + I] Shl 8);
  While (Sum Shr 16) <> 0 Do Sum := (Sum And $FFFF) + (Sum Shr 16);
  IcmpCsum := (Not Sum) And $FFFF;
End;

{ Echo ICMP (type 8) emis par S : le noyau repond (type 0) dans la file de S }
Function IcmpSend(S : PSock; Buf, Cnt, DstAddr : LongInt) : LongInt;
Var M : PMsg; Tmp, Hdr, Tot : LongInt;
Begin
  IcmpSend := Cnt;
  If Cnt < 8 Then
  Begin
    IcmpSend := -EINVAL;
    Exit;
  End;
  If Mem[0:Buf] <> 8 Then Exit;               { seul l'echo recoit une reponse }
  If DstAddr = 0 Then DstAddr := $7F000001;
  If S^.Typ = SOCK_RAW Then Hdr := 20 Else Hdr := 0;
  Tot := Hdr + Cnt;
  Tmp := KMalloc(Tot);
  If Tmp = 0 Then
  Begin
    IcmpSend := -ENOMEM;
    Exit;
  End;
  If Hdr > 0 Then
  Begin
    MemFill(Tmp, 0, 20);
    Mem[0:Tmp] := $45;
    Mem[0:Tmp + 2] := (Tot Shr 8) And $FF; Mem[0:Tmp + 3] := Tot And $FF;
    Mem[0:Tmp + 8] := 64; Mem[0:Tmp + 9] := 1;
    Mem[0:Tmp + 12] := (DstAddr Shr 24) And $FF;
    Mem[0:Tmp + 13] := (DstAddr Shr 16) And $FF;
    Mem[0:Tmp + 14] := (DstAddr Shr 8) And $FF;
    Mem[0:Tmp + 15] := DstAddr And $FF;
    Mem[0:Tmp + 16] := 127; Mem[0:Tmp + 17] := 0; Mem[0:Tmp + 18] := 0;
    Mem[0:Tmp + 19] := 1;
    MemW[0:Tmp + 10] := Ntohs(IcmpCsum(Tmp, 20));
  End;
  MemCopy(Tmp + Hdr, Buf, Cnt);
  Mem[0:Tmp + Hdr] := 0;                      { echo reply }
  MemW[0:Tmp + Hdr + 2] := 0;
  MemW[0:Tmp + Hdr + 2] := Ntohs(IcmpCsum(Tmp + Hdr, Cnt));
  M := MsgAdd(S, Tmp, Tot);
  KFree(Tmp);
  If M <> Nil Then
  Begin
    M^.SrcAddr := DstAddr;
    M^.SrcPort := 0;
  End;
End;

{ Datagramme AF_UNIX vers la socket D }
Function UnDgramPut(S, D : PSock; Buf, Cnt : LongInt; Fds : PMsg) : LongInt;
Var M : PMsg; I : LongInt;
Begin
  While D^.QCount >= SockQMax Do
  Begin
    If (S^.Flags And O_NONBLOCK) <> 0 Then
    Begin
      UnDgramPut := -EAGAIN;
      Exit;
    End;
    If SleepOn(LongInt(D), 0, True) = WakeSignal Then
    Begin
      UnDgramPut := -ERESTARTSYS;
      Exit;
    End;
    If D^.State = SsFree Then
    Begin
      UnDgramPut := -ECONNREFUSED;
      Exit;
    End;
  End;
  M := MsgAdd(D, Buf, Cnt);
  If M = Nil Then
  Begin
    UnDgramPut := -ENOBUFS;
    Exit;
  End;
  If S^.Bound <> 0 Then
  Begin
    M^.SrcKeyLen := S^.KeyLen;
    MemCopy(LongInt(@M^.SrcKey[0]), LongInt(@S^.Key[0]), S^.KeyLen);
  End;
  If Fds <> Nil Then
  Begin
    M^.NFds := Fds^.NFds;
    For I := 0 To Fds^.NFds - 1 Do M^.Fds[I] := Fds^.Fds[I];
    Fds^.NFds := 0;
  End;
  UnDgramPut := Cnt;
End;

{ Envoi general : Dest/DestLen = adresse (0 : destination par defaut) }
Function SockSend(S : PSock; Buf, Cnt, Flags, Dest, DestLen : LongInt;
    Fds : PMsg) : LongInt;
Var D : PSock; R, KLen, Port, A, I : LongInt; Path : String; M : PMsg;
    Key : Array[0..107] Of Byte;
Begin
  If S^.Family = AF_NETLINK Then
  Begin
    SockSend := NlSend(S, Buf, Cnt);
    Exit;
  End;
  If S^.Family = AF_PACKET Then
  Begin
    SockSend := PktSend(S, Buf, Cnt, Dest, DestLen);
    Exit;
  End;
  If (S^.Typ = SOCK_RAW) And (S^.Proto = 255) Then
  Begin
    SockSend := -EOPNOTSUPP;
    Exit;
  End;
  If S^.Typ = SOCK_STREAM Then
  Begin
    If S^.State <> SsConn Then
    Begin
      SockSend := -ENOTCONN;
      Exit;
    End;
    If (Fds <> Nil) And (Fds^.NFds > 0) And (S^.Peer <> Nil) Then
    Begin
      M := Pointer(KMallocZ(SizeOf(TMsg)));
      If M <> Nil Then
      Begin
        M^.NFds := Fds^.NFds;
        For I := 0 To M^.NFds - 1 Do M^.Fds[I] := Fds^.Fds[I];
        Fds^.NFds := 0;
        If S^.Peer^.FdHead = Nil Then S^.Peer^.FdHead := M
        Else
        Begin
          D := S^.Peer;
          M^.Next := D^.FdHead;
          D^.FdHead := M;
        End;
      End;
    End;
    SockSend := StreamWrite(S, Buf, Cnt, Flags);
    Exit;
  End;
  If S^.Family = AF_UNIX Then
  Begin
    If Cnt > 65536 Then
    Begin
      SockSend := -EMSGSIZE;
      Exit;
    End;
    If S^.Peer <> Nil Then
    Begin
      SockSend := UnDgramPut(S, S^.Peer, Buf, Cnt, Fds);
      Exit;
    End;
    If Dest <> 0 Then
    Begin
      R := GetUnKey(Dest, DestLen, LongInt(@Key[0]), KLen);
      If R <> 0 Then
      Begin
        SockSend := R;
        Exit;
      End;
    End
    Else If S^.HasDest <> 0 Then
    Begin
      KLen := S^.DestKeyLen;
      MemCopy(LongInt(@Key[0]), LongInt(@S^.DestKey[0]), KLen);
    End
    Else
    Begin
      SockSend := -EDESTADDRREQ;
      Exit;
    End;
    If (KLen > 0) And (Key[0] <> 0) Then
      Path := SockKeyStr(LongInt(@Key[0]), KLen)
    Else Path := '';
    D := UnFind(LongInt(@Key[0]), KLen, SOCK_DGRAM, Path, R);
    If D = Nil Then
    Begin
      If R = -ECONNREFUSED Then SockSend := -ECONNREFUSED Else SockSend := R;
      Exit;
    End;
    SockSend := UnDgramPut(S, D, Buf, Cnt, Fds);
    Exit;
  End;
  { AF_INET : adresse de destination }
  A := S^.RAddr; Port := S^.RPort;
  If Dest <> 0 Then
  Begin
    If (DestLen < 8) Or (Not EnsureUser(Dest, 8, False)) Then
    Begin
      SockSend := -EINVAL;
      Exit;
    End;
    If MemW[0:Dest] <> AF_INET Then
    Begin
      SockSend := -EAFNOSUPPORT;
      Exit;
    End;
    Port := Ntohs(MemW[0:Dest + 2]);
    A := Ntohl(MemL[0:Dest + 4]);
  End
  Else If S^.HasDest = 0 Then
  Begin
    SockSend := -EDESTADDRREQ;
    Exit;
  End;
  If A = 0 Then A := $7F000001;
  If Not IsLocalAddr(A) Then
  Begin
    If S^.Proto = IPPROTO_ICMP Then
    Begin
      SockSend := NetIcmpSend(S, Buf, Cnt, A);
      Exit;
    End;
    If S^.Bound = 0 Then
    Begin
      S^.LPort := AutoPort(SOCK_DGRAM);
      S^.Bound := 1;
    End;
    R := UdpOutput(S^.LPort, A, Port, Buf, Cnt);
    If R = 0 Then SockSend := Cnt Else SockSend := R;
    Exit;
  End;
  If S^.Proto = IPPROTO_ICMP Then
  Begin
    SockSend := IcmpSend(S, Buf, Cnt, A);
    Exit;
  End;
  If Cnt > 65507 Then
  Begin
    SockSend := -EMSGSIZE;
    Exit;
  End;
  If S^.Bound = 0 Then
  Begin
    S^.LPort := AutoPort(SOCK_DGRAM);
    S^.Bound := 1;
  End;
  D := InFind(SOCK_DGRAM, Port, 0);
  If D = Nil Then
  Begin
    If Dest = 0 Then S^.Err := ECONNREFUSED;
    SockSend := Cnt;
    Exit;
  End;
  M := MsgAdd(D, Buf, Cnt);
  If M = Nil Then
  Begin
    SockSend := Cnt;                  { file pleine : paquet perdu }
    Exit;
  End;
  M^.SrcAddr := $7F000001;
  M^.SrcPort := S^.LPort;
  SockSend := Cnt;
End;

{ Reception generale ; Src recoit le datagramme source (a liberer) }
Function SockRecv(S : PSock; Buf, Cnt, Flags : LongInt;
    Var Src : PMsg) : LongInt;
Var R : LongInt;
Begin
  Src := Nil;
  If S^.Typ = SOCK_STREAM Then
  Begin
    If S^.State = SsListen Then
    Begin
      SockRecv := -EINVAL;
      Exit;
    End;
    SockRecv := StreamRead(S, Buf, Cnt, Flags);
    Exit;
  End;
  R := DgramRecv(S, Buf, Cnt, Flags, Src);
  If R >= 0 Then WakeUp(LongInt(S));
  SockRecv := R;
End;

Procedure PutMsgSource(S : PSock; M : PMsg; Addr, Lp : LongInt);
Var N2 : LongInt;
Begin
  If M = Nil Then
  Begin
    If S^.Typ = SOCK_STREAM Then
    Begin
      If S^.Peer <> Nil Then
        PutSockAddr(S^.Family, LongInt(@S^.Peer^.Key[0]), S^.Peer^.KeyLen,
            S^.RAddr, S^.RPort, Addr, Lp)
      Else PutSockAddr(S^.Family, LongInt(@S^.Key[0]), 0, S^.RAddr, S^.RPort,
          Addr, Lp);
    End
    Else If Lp <> 0 Then
      If EnsureUser(Lp, 4, True) Then MemL[0:Lp] := 0;
    Exit;
  End;
  If S^.Family = AF_PACKET Then
  Begin
    If (Addr <> 0) And (Lp <> 0) And EnsureUser(Lp, 4, True) Then
    Begin
      N2 := MemL[0:Lp];
      If N2 > 20 Then N2 := 20;
      If N2 < 0 Then N2 := 0;
      If EnsureUser(Addr, N2, True) Then
      Begin
        MemCopy(Addr, LongInt(@M^.SrcKey[0]), N2);
        MemL[0:Lp] := 20;
      End;
    End;
  End
  Else If S^.Family = AF_NETLINK Then
    PutSockAddr(AF_NETLINK, 0, 0, 0, 0, Addr, Lp)
  Else If S^.Family = AF_UNIX Then
    PutSockAddr(AF_UNIX, LongInt(@M^.SrcKey[0]), M^.SrcKeyLen, 0, 0, Addr, Lp)
  Else PutSockAddr(AF_INET, LongInt(@M^.SrcKey[0]), 0, M^.SrcAddr, M^.SrcPort,
      Addr, Lp);
End;

Function SysSendto(Fd, Buf, Cnt, Flags, Dest, DestLen : LongInt) : LongInt;
Var S : PSock; E, R, Tmp : LongInt;
Begin
  S := SockGet(Fd, E);
  If S = Nil Then
  Begin
    SysSendto := E;
    Exit;
  End;
  If Cnt < 0 Then
  Begin
    SysSendto := -EINVAL;
    Exit;
  End;
  If Not EnsureUser(Buf, Cnt, False) Then
  Begin
    SysSendto := -EFAULT;
    Exit;
  End;
  If (Cnt > 0) And (S^.Typ <> SOCK_STREAM) Then
  Begin
    Tmp := KMalloc(Cnt);
    If Tmp = 0 Then
    Begin
      SysSendto := -ENOMEM;
      Exit;
    End;
    MemCopy(Tmp, Buf, Cnt);
    R := SockSend(S, Tmp, Cnt, Flags, Dest, DestLen, Nil);
    KFree(Tmp);
    SysSendto := R;
    Exit;
  End;
  SysSendto := SockSend(S, Buf, Cnt, Flags, Dest, DestLen, Nil);
End;

Function SysSend(Fd, Buf, Cnt, Flags : LongInt) : LongInt;
Begin
  SysSend := SysSendto(Fd, Buf, Cnt, Flags, 0, 0);
End;

Function SysRecvfrom(Fd, Buf, Cnt, Flags, Addr, Lp : LongInt) : LongInt;
Var S : PSock; E, R : LongInt; M : PMsg;
Begin
  S := SockGet(Fd, E);
  If S = Nil Then
  Begin
    SysRecvfrom := E;
    Exit;
  End;
  If (Cnt < 0) Or (Not EnsureUser(Buf, Cnt, True)) Then
  Begin
    SysRecvfrom := -EFAULT;
    Exit;
  End;
  R := SockRecv(S, Buf, Cnt, Flags, M);
  If R >= 0 Then
  Begin
    PutMsgSource(S, M, Addr, Lp);
    If M <> Nil Then MsgFree(M);
  End;
  SysRecvfrom := R;
End;

Function SysRecv(Fd, Buf, Cnt, Flags : LongInt) : LongInt;
Begin
  SysRecv := SysRecvfrom(Fd, Buf, Cnt, Flags, 0, 0);
End;

{ sendmsg : nom, iov, SCM_RIGHTS }
Function SysSendmsg(Fd, Msgh, Flags : LongInt) : LongInt;
Var S : PSock; E, R, Name, NameLen, Iov, IovLen, Ctl, CtlLen, I, Tot, Tmp,
    P, N, Cl, Lv, Ty, K, Fdn : LongInt; Fds : PMsg; F : PFile;
Begin
  S := SockGet(Fd, E);
  If S = Nil Then
  Begin
    SysSendmsg := E;
    Exit;
  End;
  If Not EnsureUser(Msgh, 28, False) Then
  Begin
    SysSendmsg := -EFAULT;
    Exit;
  End;
  Name := MemL[0:Msgh]; NameLen := MemL[0:Msgh + 4];
  Iov := MemL[0:Msgh + 8]; IovLen := MemL[0:Msgh + 12];
  Ctl := MemL[0:Msgh + 16]; CtlLen := MemL[0:Msgh + 20];
  If (IovLen < 0) Or (IovLen > 64)
     Or (Not EnsureUser(Iov, IovLen * 8, False)) Then
  Begin
    SysSendmsg := -EINVAL;
    Exit;
  End;
  Tot := 0;
  For I := 0 To IovLen - 1 Do Tot := Tot + MemL[0:Iov + I * 8 + 4];
  If (Tot < 0) Or (Tot > 262144) Then
  Begin
    SysSendmsg := -EMSGSIZE;
    Exit;
  End;
  Tmp := KMalloc(Tot + 1);
  If Tmp = 0 Then
  Begin
    SysSendmsg := -ENOMEM;
    Exit;
  End;
  P := 0;
  For I := 0 To IovLen - 1 Do
  Begin
    N := MemL[0:Iov + I * 8 + 4];
    If N > 0 Then
    Begin
      If Not EnsureUser(MemL[0:Iov + I * 8], N, False) Then
      Begin
        KFree(Tmp);
        SysSendmsg := -EFAULT;
        Exit;
      End;
      MemCopy(Tmp + P, MemL[0:Iov + I * 8], N);
      P := P + N;
    End;
  End;
  Fds := Nil;
  If (Ctl <> 0) And (CtlLen >= 12) And EnsureUser(Ctl, CtlLen, False) Then
  Begin
    Fds := Pointer(KMallocZ(SizeOf(TMsg)));
    P := 0;
    While (Fds <> Nil) And (P + 12 <= CtlLen) Do
    Begin
      Cl := MemL[0:Ctl + P]; Lv := MemL[0:Ctl + P + 4];
      Ty := MemL[0:Ctl + P + 8];
      If (Cl < 12) Or (P + Cl > CtlLen) Then Break;
      If (Lv = 1) And (Ty = 1) Then
      Begin
        K := (Cl - 12) Div 4;
        For I := 0 To K - 1 Do
        Begin
          Fdn := MemL[0:Ctl + P + 12 + I * 4];
          F := FdGet(Fdn);
          If (F = Nil) Or (Fds^.NFds >= 8) Then
          Begin
            For R := 0 To Fds^.NFds - 1 Do FilePut(Fds^.Fds[R]);
            KFree(LongInt(Fds));
            KFree(Tmp);
            If F = Nil Then SysSendmsg := -EBADF Else SysSendmsg := -EINVAL;
            Exit;
          End;
          FileGet(LongInt(F));
          Fds^.Fds[Fds^.NFds] := LongInt(F);
          Inc(Fds^.NFds);
        End;
      End;
      P := P + ((Cl + 3) And Not 3);
    End;
  End;
  R := SockSend(S, Tmp, Tot, Flags, Name, NameLen, Fds);
  KFree(Tmp);
  If Fds <> Nil Then
  Begin
    For I := 0 To Fds^.NFds - 1 Do FilePut(Fds^.Fds[I]);
    KFree(LongInt(Fds));
  End;
  SysSendmsg := R;
End;

Function SysRecvmsg(Fd, Msgh, Flags : LongInt) : LongInt;
Var S : PSock; E, R, Name, NameLen, Iov, IovLen, Ctl, CtlLen, I, Tot, Tmp,
    P, N, K, Nf, Cl, Fdn : LongInt; M : PMsg; Fl : LongInt; F : PFile;
Begin
  S := SockGet(Fd, E);
  If S = Nil Then
  Begin
    SysRecvmsg := E;
    Exit;
  End;
  If Not EnsureUser(Msgh, 28, True) Then
  Begin
    SysRecvmsg := -EFAULT;
    Exit;
  End;
  Name := MemL[0:Msgh]; Iov := MemL[0:Msgh + 8]; IovLen := MemL[0:Msgh + 12];
  Ctl := MemL[0:Msgh + 16]; CtlLen := MemL[0:Msgh + 20];
  If (IovLen < 0) Or (IovLen > 64)
     Or (Not EnsureUser(Iov, IovLen * 8, False)) Then
  Begin
    SysRecvmsg := -EINVAL;
    Exit;
  End;
  Tot := 0;
  For I := 0 To IovLen - 1 Do Tot := Tot + MemL[0:Iov + I * 8 + 4];
  If (Tot < 0) Or (Tot > 262144) Then Tot := 262144;
  Tmp := KMalloc(Tot + 1);
  If Tmp = 0 Then
  Begin
    SysRecvmsg := -ENOMEM;
    Exit;
  End;
  R := SockRecv(S, Tmp, Tot, Flags, M);
  If R < 0 Then
  Begin
    KFree(Tmp);
    SysRecvmsg := R;
    Exit;
  End;
  P := 0;
  For I := 0 To IovLen - 1 Do
  Begin
    N := MemL[0:Iov + I * 8 + 4];
    If N > R - P Then N := R - P;
    If N > 0 Then
    Begin
      If Not EnsureUser(MemL[0:Iov + I * 8], N, True) Then Break;
      MemCopy(MemL[0:Iov + I * 8], Tmp + P, N);
      P := P + N;
    End;
  End;
  KFree(Tmp);
  Fl := 0;
  If (S^.Typ <> SOCK_STREAM) And (M <> Nil) And (M^.Len > R) Then
    Fl := Fl Or MSG_TRUNC;
  If Name <> 0 Then
  Begin
    MemL[0:Msgh + 4] := NameLen;
    PutMsgSource(S, M, Name, Msgh + 4);
  End;
  { descripteurs recus (SCM_RIGHTS) }
  If S^.Typ = SOCK_STREAM Then
  Begin
    M := S^.FdHead;
    If M <> Nil Then S^.FdHead := M^.Next;
  End;
  Nf := 0;
  If (M <> Nil) And (M^.NFds > 0) Then
  Begin
    Cl := 12 + 4 * M^.NFds;
    If (Ctl <> 0) And (CtlLen >= Cl) And EnsureUser(Ctl, Cl, True) Then
    Begin
      MemL[0:Ctl] := Cl; MemL[0:Ctl + 4] := 1; MemL[0:Ctl + 8] := 1;
      For K := 0 To M^.NFds - 1 Do
      Begin
        F := Pointer(M^.Fds[K]);
        Fdn := FdInstall(F, 0, (Flags And $40000000) <> 0);
        If Fdn >= 0 Then
        Begin
          MemL[0:Ctl + 12 + Nf * 4] := Fdn;
          Inc(Nf);
        End
        Else FilePut(M^.Fds[K]);
      End;
      M^.NFds := 0;
      Cl := 12 + 4 * Nf;
      MemL[0:Ctl] := Cl;
      MemL[0:Msgh + 20] := (Cl + 3) And Not 3;
    End
    Else
    Begin
      Fl := Fl Or $8;                  { MSG_CTRUNC }
      MemL[0:Msgh + 20] := 0;
    End;
  End
  Else If Ctl <> 0 Then MemL[0:Msgh + 20] := 0;
  If M <> Nil Then MsgFree(M);
  MemL[0:Msgh + 24] := Fl;
  SysRecvmsg := R;
End;

{ ---- Options ---- }

Function SysSetsockopt(Fd, Level, Opt, Val, Len : LongInt) : LongInt;
Var S : PSock; E : LongInt;
Begin
  S := SockGet(Fd, E);
  If S = Nil Then
  Begin
    SysSetsockopt := E;
    Exit;
  End;
  If (Level = 0) And ((Opt = 64) Or (Opt = 65)) And (S^.Family = AF_INET)
     And (S^.Typ = SOCK_RAW) Then
  Begin
    SysSetsockopt := NfSetsockopt(Opt, Val, Len);
    Exit;
  End;
  If (Level = 1) And (Opt = 2) And (Len >= 4) And EnsureUser(Val, 4, False) Then
    S^.Reuse := MemL[0:Val];
  SysSetsockopt := 0;
End;

Function SysGetsockopt(Fd, Level, Opt, Val, Lp : LongInt) : LongInt;
Var S : PSock; E, V, N : LongInt;
Begin
  S := SockGet(Fd, E);
  If S = Nil Then
  Begin
    SysGetsockopt := E;
    Exit;
  End;
  If (Val = 0) Or (Lp = 0) Or (Not EnsureUser(Lp, 4, True)) Then
  Begin
    SysGetsockopt := -EFAULT;
    Exit;
  End;
  N := MemL[0:Lp];
  V := 0;
  If (Level = 0) And (Opt >= 64) And (Opt <= 67) And (S^.Family = AF_INET)
     And (S^.Typ = SOCK_RAW) Then
  Begin
    SysGetsockopt := NfGetsockopt(Opt, Val, N);
    Exit;
  End;
  If Level = 1 Then
  Begin
    Case Opt Of
      2 : V := S^.Reuse;
      3 : V := S^.Typ;
      4 :
        Begin
          V := S^.Err;
          S^.Err := 0;
        End;
      7, 8 : V := 65536;
      30 : If S^.State = SsListen Then V := 1;
      38 : V := S^.Proto;
      39 : V := S^.Family;
      17 :
        Begin
          If (S^.Peer <> Nil) Then
          Begin
            If Not EnsureUser(Val, 12, True) Then
            Begin
              SysGetsockopt := -EFAULT;
              Exit;
            End;
            MemL[0:Val] := S^.Peer^.CPid; MemL[0:Val + 4] := S^.Peer^.CUid;
            MemL[0:Val + 8] := S^.Peer^.CGid;
            MemL[0:Lp] := 12;
            SysGetsockopt := 0;
            Exit;
          End;
          If Not EnsureUser(Val, 12, True) Then
          Begin
            SysGetsockopt := -EFAULT;
            Exit;
          End;
          MemL[0:Val] := S^.CPid; MemL[0:Val + 4] := S^.CUid;
          MemL[0:Val + 8] := S^.CGid;
          MemL[0:Lp] := 12;
          SysGetsockopt := 0;
          Exit;
        End;
    End;
  End;
  If N >= 4 Then
  Begin
    If Not EnsureUser(Val, 4, True) Then
    Begin
      SysGetsockopt := -EFAULT;
      Exit;
    End;
    MemL[0:Val] := V;
    MemL[0:Lp] := 4;
  End;
  SysGetsockopt := 0;
End;

{ socketcall : Args = tableau de 32 bits }
Function SysSocketcall(Cn, Args : LongInt) : LongInt;
Var A : Array[0..5] Of LongInt; I : LongInt;
Begin
  If (Cn < 1) Or (Cn > 18) Then
  Begin
    SysSocketcall := -EINVAL;
    Exit;
  End;
  If Not EnsureUser(Args, 24, False) Then
  Begin
    SysSocketcall := -EFAULT;
    Exit;
  End;
  For I := 0 To 5 Do A[I] := MemL[0:Args + I * 4];
  Case Cn Of
    1 : SysSocketcall := SysSocket(A[0], A[1], A[2]);
    2 : SysSocketcall := SysBind(A[0], A[1], A[2]);
    3 : SysSocketcall := SysConnect(A[0], A[1], A[2]);
    4 : SysSocketcall := SysListen(A[0], A[1]);
    5 : SysSocketcall := SysAccept(A[0], A[1], A[2]);
    6 : SysSocketcall := SysGetsockname(A[0], A[1], A[2]);
    7 : SysSocketcall := SysGetpeername(A[0], A[1], A[2]);
    8 : SysSocketcall := SysSocketpair(A[0], A[1], A[2], A[3]);
    9 : SysSocketcall := SysSend(A[0], A[1], A[2], A[3]);
    10 : SysSocketcall := SysRecv(A[0], A[1], A[2], A[3]);
    11 : SysSocketcall := SysSendto(A[0], A[1], A[2], A[3], A[4], A[5]);
    12 : SysSocketcall := SysRecvfrom(A[0], A[1], A[2], A[3], A[4], A[5]);
    13 : SysSocketcall := SysShutdown(A[0], A[1]);
    14 : SysSocketcall := SysSetsockopt(A[0], A[1], A[2], A[3], A[4]);
    15 : SysSocketcall := SysGetsockopt(A[0], A[1], A[2], A[3], A[4]);
    16 : SysSocketcall := SysSendmsg(A[0], A[1], A[2]);
    17 : SysSocketcall := SysRecvmsg(A[0], A[1], A[2]);
    18 : SysSocketcall := SysAccept4(A[0], A[1], A[2], A[3]);
  Else
    SysSocketcall := -EINVAL;
  End;
End;

{ ---- Operations de fichier ---- }

Function SockFRead(F : PFile; Buf, Cnt : LongInt) : LongInt;
Var S : PSock; M : PMsg; R : LongInt;
Begin
  S := SockOf(F);
  If (F^.Flags And O_NONBLOCK) <> 0 Then S^.Flags := S^.Flags Or O_NONBLOCK
  Else S^.Flags := S^.Flags And Not O_NONBLOCK;
  R := SockRecv(S, Buf, Cnt, 0, M);
  If M <> Nil Then MsgFree(M);
  SockFRead := R;
End;

Function SockFWrite(F : PFile; Buf, Cnt : LongInt) : LongInt;
Var S : PSock;
Begin
  S := SockOf(F);
  If (F^.Flags And O_NONBLOCK) <> 0 Then S^.Flags := S^.Flags Or O_NONBLOCK
  Else S^.Flags := S^.Flags And Not O_NONBLOCK;
  SockFWrite := SockSend(S, Buf, Cnt, 0, 0, 0, Nil);
End;

Function SockFPoll(F : PFile; Ev : LongInt) : LongInt;
Var S : PSock; R : LongInt;
Begin
  S := SockOf(F);
  R := 0;
  If S^.State = SsListen Then
  Begin
    If S^.NBacklog > 0 Then R := POLLIN;
    SockFPoll := R;
    Exit;
  End;
  If (S^.Net <> 0) And (S^.Typ = SOCK_STREAM) Then
  Begin
    If S^.BLen > 0 Then R := R Or POLLIN;
    If (S^.PeerWrDone <> 0) Or (S^.PeerGone <> 0) Then R := R Or POLLIN;
    If (S^.PeerGone <> 0) Or (S^.TState = TcpClosed) Then R := R Or POLLHUP;
    If (S^.State = SsConn) And (S^.SLen < SockBufSz) Then R := R Or POLLOUT;
    If S^.Err <> 0 Then R := R Or POLLERR;
    SockFPoll := R;
    Exit;
  End;
  If S^.Typ = SOCK_STREAM Then
  Begin
    If S^.State = SsConn Then
    Begin
      If (S^.BLen > 0) Or (S^.PeerGone <> 0) Or (S^.PeerWrDone <> 0) Then
        R := R Or POLLIN;
      If (S^.PeerGone <> 0) And (S^.BLen = 0) Then R := R Or POLLHUP;
      If (S^.Peer <> Nil) And (S^.Peer^.BLen < SockBufSz) Then
        R := R Or POLLOUT;
      If (S^.PeerGone <> 0) Then R := R Or POLLOUT;
    End
    Else R := POLLOUT Or POLLHUP;
  End
  Else
  Begin
    If S^.QHead <> Nil Then R := R Or POLLIN;
    R := R Or POLLOUT;
  End;
  If S^.Err <> 0 Then R := R Or POLLERR;
  SockFPoll := R;
End;

Function SockFIoctl(F : PFile; Cmd, Arg : LongInt) : LongInt;
Var S : PSock;
Begin
  S := SockOf(F);
  Case Cmd Of
    $541B :                                      { FIONREAD }
      Begin
        If S^.Typ = SOCK_STREAM Then SockFIoctl := PutUserL(Arg, S^.BLen)
        Else If S^.QHead <> Nil Then SockFIoctl := PutUserL(Arg, S^.QHead^.Len)
        Else SockFIoctl := PutUserL(Arg, 0);
      End;
  Else
    SockFIoctl := NetIoctl(Cmd, Arg);
  End;
End;

Procedure SockFRelease(F : PFile);
Var S : PSock;
Begin
  S := SockOf(F);
  If S <> Nil Then SockClose(S);
End;

Procedure InitSockets;
Var I : LongInt;
Begin
  For I := 0 To MaxSocks - 1 Do Socks[I].State := SsFree;
  NextPort := 32767;
  MemFill(LongInt(@SockFOps[0]), 0, SizeOf(SockFOps));
  SockFOps[FoRead] := LongInt(@SockFRead);
  SockFOps[FoWrite] := LongInt(@SockFWrite);
  SockFOps[FoPoll] := LongInt(@SockFPoll);
  SockFOps[FoIoctl] := LongInt(@SockFIoctl);
  SockFOps[FoRelease] := LongInt(@SockFRelease);
End;

{ ==================================================================== }
{ Partie 22 - Reseau : PCI, RTL8139, Ethernet, ARP, IPv4, ICMP, UDP    }
{ ==================================================================== }
{ (placee avant la partie 16, apres les sockets) }

{ Pilote RTL8139 (QEMU : -nic user,model=rtl8139 ou -device rtl8139),
  pile minimale : trames Ethernet, ARP (cache de 8 entrees), IPv4 sans
  fragmentation, ICMP (reponse a l'echo, echo pour les sockets ICMP), UDP.
  Les trames recues sont traitees dans le gestionnaire d'interruption ou
  par NetPoll (jamais d'attente dans le noyau pendant le traitement). }

Const
  RtlRxSize   = 8192;
  NetMtu      = 1500;
  EtherIp     = $0800;
  EtherArp    = $0806;
  MaxArp      = 8;

Var
  NicIo       : LongInt;           { base des ports du RTL8139 }
  NicIrq      : LongInt;
  NicMac      : Array[0..5] Of Byte;
  NicRx       : LongInt;           { tampon de reception (adresse noyau) }
  NicTx       : LongInt;           { 4 tampons d'emission de 2 Ko }
  NicRxOfs    : LongInt;
  NicTxCur    : LongInt;
  NicUp       : Boolean;
  ArpIp       : Array[0..MaxArp - 1] Of LongInt;
  ArpMac      : Array[0..MaxArp * 6 - 1] Of Byte;
  ArpAge      : Array[0..MaxArp - 1] Of LongInt;
  IpId        : LongInt;

{ ---- PCI ---- }

Procedure OutL(P, V : LongInt);
Begin
  asm
    mov edx,P
    mov eax,V
    out dx,eax
  end;
End;

Function InL(P : LongInt) : LongInt;
Var R : LongInt;
Begin
  asm
    mov edx,P
    in eax,dx
    mov R,eax
  end;
  InL := R;
End;

Function PciRead(Bus, Dev, Fn, Reg : LongInt) : LongInt;
Begin
  OutL($CF8, LongInt($80000000) Or (Bus Shl 16) Or (Dev Shl 11)
      Or (Fn Shl 8) Or (Reg And $FC));
  PciRead := InL($CFC);
End;

Procedure PciWrite(Bus, Dev, Fn, Reg, V : LongInt);
Begin
  OutL($CF8, LongInt($80000000) Or (Bus Shl 16) Or (Dev Shl 11)
      Or (Fn Shl 8) Or (Reg And $FC));
  OutL($CFC, V);
End;

{ ---- Octets reseau ---- }

Function Be16(A : LongInt) : LongInt;
Begin
  Be16 := (Mem[0:A] Shl 8) Or Mem[0:A + 1];
End;

Function Be32(A : LongInt) : LongInt;
Begin
  Be32 := (Mem[0:A] Shl 24) Or (Mem[0:A + 1] Shl 16) Or (Mem[0:A + 2] Shl 8)
      Or Mem[0:A + 3];
End;

Procedure PutBe16(A, V : LongInt);
Begin
  Mem[0:A] := (V Shr 8) And $FF;
  Mem[0:A + 1] := V And $FF;
End;

Procedure PutBe32(A, V : LongInt);
Begin
  Mem[0:A] := (V Shr 24) And $FF;
  Mem[0:A + 1] := (V Shr 16) And $FF;
  Mem[0:A + 2] := (V Shr 8) And $FF;
  Mem[0:A + 3] := V And $FF;
End;

{ Somme de controle Internet (complement a un) sur Len octets, avec une
  valeur initiale Init (pseudo-en-tete) ; resultat final non complemente
  si Fold = False }
Function NetSum(A, Len, Init : LongInt) : LongInt;
Var Sum, I : LongInt;
Begin
  Sum := Init;
  I := 0;
  While I + 1 < Len Do
  Begin
    Sum := Sum + (Mem[0:A + I] Shl 8) + Mem[0:A + I + 1];
    I := I + 2;
  End;
  If I < Len Then Sum := Sum + (Mem[0:A + I] Shl 8);
  While (Sum Shr 16) <> 0 Do Sum := (Sum And $FFFF) + (Sum Shr 16);
  NetSum := Sum;
End;

Function NetCsum(A, Len : LongInt) : LongInt;
Begin
  NetCsum := (Not NetSum(A, Len, 0)) And $FFFF;
End;

{ ---- Pilote RTL8139 ---- }

{ ---- AF_PACKET (partie 39) : copies des trames recues et emises ---- }

Var
  PktSkip : PSock;                 { emetteur d'une trame brute (pas de copie) }
  PktBuf : Array[0..1599] Of Byte;

{ Remet une copie de la trame aux sockets AF_PACKET concernees. PktType :
  0 pour nous, 1 diffusion, 2 multicast, 3 autre destinataire, 4 emise }
Procedure PktTap(Frame, Len, PktType : LongInt; Skip : PSock);
Var I, Et, Ifx : LongInt; S : PSock; M : PMsg;
Begin
  If Len < 14 Then Exit;
  Et := (Mem[0:Frame + 12] Shl 8) Or Mem[0:Frame + 13];
  For I := 0 To MaxSocks - 1 Do
  Begin
    S := @Socks[I];
    If (S^.State = SsFree) Or (S^.Family <> AF_PACKET) Or (S = Skip) Then
      Continue;
    If (S^.Proto <> 3) And (S^.Proto <> Et) Then Continue;
    If (S^.LPort <> 0) And (S^.LPort <> 2) Then Continue;
    If S^.Typ = SOCK_RAW Then M := MsgAdd(S, Frame, Len)
    Else M := MsgAdd(S, Frame + 14, Len - 14);
    If M = Nil Then Continue;
    MemFill(LongInt(@M^.SrcKey[0]), 0, 20);
    M^.SrcKey[0] := AF_PACKET;
    M^.SrcKey[2] := (Et Shr 8) And $FF; M^.SrcKey[3] := Et And $FF;
    M^.SrcKey[4] := 2;
    M^.SrcKey[8] := 1;
    M^.SrcKey[10] := PktType;
    M^.SrcKey[11] := 6;
    MemCopy(LongInt(@M^.SrcKey[12]), Frame + 6, 6);
    M^.SrcKeyLen := 20;
  End;
End;

{ ---- virtio-net (interface PCI "legacy", ports d'E/S) : partie 39 ---- }
{ Carte "virtio-net-pci" de QEMU (identifiant 1AF4:1000). Files 0 (reception)
  et 1 (emission), sans attribut (pas de somme de controle ni de
  segmentation deleguees : entete de 10 octets nul). La reception
  utilise 64 tampons de 2 Ko recycles par la partie differee de l'IRQ ;
  l'emission 8 tampons. }

Const
  VnQMax = 1024; VnNRx = 64; VnNTx = 8;

Var
  NicKind : LongInt;      { 0 aucune, 1 RTL8139, 2 virtio, 3 e1000, 4 PCnet }
  VIo, VnRxBuf, VnTxBuf, VnRxLast, VnTxLast, VnTxFree : LongInt;
  VnQ, VnQSz, VnAvailOfs, VnUsedOfs : Array[0..1] Of LongInt;

{ Prepare la file Q : memoire contigue (descripteurs, anneau disponible,
  anneau utilise aligne sur 4 Ko) donnee au peripherique par son numero
  de page }
Function VnQueueSetup(Q : LongInt) : Boolean;
Var Sz, Avail, Used, Bytes, Order, Mem : LongInt;
Begin
  VnQueueSetup := False;
  PortW[VIo + 14] := Q;
  Sz := PortW[VIo + 12];
  If (Sz = 0) Or (Sz > VnQMax) Then Exit;
  Avail := 16 * Sz;
  Used := (Avail + 6 + 2 * Sz + 4095) And Not 4095;
  Bytes := Used + 6 + 8 * Sz;
  Order := 0;
  While (4096 Shl Order) < Bytes Do Inc(Order);
  Mem := AllocPages(Order);
  If Mem = 0 Then Exit;
  MemFill(Mem, 0, 4096 Shl Order);
  VnQ[Q] := Mem;
  VnQSz[Q] := Sz;
  VnAvailOfs[Q] := Avail;
  VnUsedOfs[Q] := Used;
  OutL(VIo + 8, V2P(Mem) Shr 12);
  VnQueueSetup := True;
End;

{ Recupere les tampons d'emission rendus par le peripherique }
Procedure VnTxReclaim;
Var Used, Id : LongInt;
Begin
  Used := VnQ[1] + VnUsedOfs[1];
  While VnTxLast <> MemW[0:Used + 2] Do
  Begin
    Id := MemL[0:Used + 4 + (VnTxLast Mod VnQSz[1]) * 8];
    If (Id >= 0) And (Id < VnNTx) Then VnTxFree := VnTxFree Or (1 Shl Id);
    VnTxLast := (VnTxLast + 1) And $FFFF;
  End;
End;

Function VnSend(Frame, Len : LongInt) : LongInt;
Var Id, N, Buf, Av, D : LongInt;
Begin
  VnSend := -ENODEV;
  If NicKind <> 2 Then Exit;
  If Len > 1514 Then
  Begin
    VnSend := -EMSGSIZE;
    Exit;
  End;
  Id := -1;
  N := 0;
  While (Id < 0) And (N < 200000) Do
  Begin
    VnTxReclaim;
    For D := 0 To VnNTx - 1 Do
      If (Id < 0) And ((VnTxFree And (1 Shl D)) <> 0) Then Id := D;
    Inc(N);
  End;
  If Id < 0 Then
  Begin
    VnSend := -ENOBUFS;
    Exit;
  End;
  VnTxFree := VnTxFree And Not (1 Shl Id);
  Buf := VnTxBuf + Id * 2048;
  MemFill(Buf, 0, 10);
  If Len < 60 Then
  Begin
    MemFill(Buf + 10, 0, 60);
    MemCopy(Buf + 10, Frame, Len);
    Len := 60;
  End
  Else MemCopy(Buf + 10, Frame, Len);
  D := VnQ[1] + 16 * Id;
  MemL[0:D] := V2P(Buf);
  MemL[0:D + 4] := 0;
  MemL[0:D + 8] := Len + 10;
  MemL[0:D + 12] := 0;
  Av := VnQ[1] + VnAvailOfs[1];
  MemW[0:Av + 4 + (MemW[0:Av + 2] Mod VnQSz[1]) * 2] := Id;
  MemW[0:Av + 2] := (MemW[0:Av + 2] + 1) And $FFFF;
  PortW[VIo + 16] := 1;
  Inc(NetTxPkts);
  NetTxBytes := NetTxBytes + Len;
  VnSend := 0;
End;

{ Reception : traite les trames rendues, remet les tampons, recupere
  l'emission }
Procedure VnPoll;
Var Used, Idx, Id, Len, Av, Sz : LongInt;
Begin
  Sz := VnQSz[0];
  Used := VnQ[0] + VnUsedOfs[0];
  While VnRxLast <> MemW[0:Used + 2] Do
  Begin
    Idx := VnRxLast Mod Sz;
    Id := MemL[0:Used + 4 + Idx * 8];
    Len := MemL[0:Used + 8 + Idx * 8];
    If (Id >= 0) And (Id < VnNRx) And (Len >= 10 + 14) And (Len <= 2048) Then
    Begin
      Inc(NetRxPkts);
      NetRxBytes := NetRxBytes + Len - 10;
      NetInput(VnRxBuf + Id * 2048 + 10, Len - 10);
    End
    Else Inc(NetRxErr);
    Av := VnQ[0] + VnAvailOfs[0];
    MemW[0:Av + 4 + (MemW[0:Av + 2] Mod Sz) * 2] := Id;
    MemW[0:Av + 2] := (MemW[0:Av + 2] + 1) And $FFFF;
    VnRxLast := (VnRxLast + 1) And $FFFF;
  End;
  PortW[VIo + 16] := 0;
  VnTxReclaim;
End;

{ Initialise la carte trouvee a l'emplacement PCI Dev (bus 0) }
Function VnInit(Dev : LongInt) : Boolean;
Var Bar, Cmd, I, D, Av : LongInt;
Begin
  VnInit := False;
  Bar := PciRead(0, Dev, 0, $10);
  If (Bar And 1) = 0 Then Exit;
  VIo := Bar And $FFFC;
  Cmd := PciRead(0, Dev, 0, 4);
  PciWrite(0, Dev, 0, 4, Cmd Or 5);
  NicIrq := PciRead(0, Dev, 0, $3C) And $FF;
  Port[VIo + 18] := 0;
  Port[VIo + 18] := 1;
  Port[VIo + 18] := 3;
  OutL(VIo + 4, InL(VIo) And $20);            { seulement l'adresse MAC }
  If Not VnQueueSetup(0) Then Exit;
  If Not VnQueueSetup(1) Then Exit;
  VnRxBuf := AllocPages(5);
  VnTxBuf := AllocPages(2);
  If (VnRxBuf = 0) Or (VnTxBuf = 0) Then Exit;
  MemFill(VnRxBuf, 0, 2048 * VnNRx);
  MemFill(VnTxBuf, 0, 2048 * VnNTx);
  Av := VnQ[0] + VnAvailOfs[0];
  For I := 0 To VnNRx - 1 Do
  Begin
    D := VnQ[0] + 16 * I;
    MemL[0:D] := V2P(VnRxBuf + I * 2048);
    MemL[0:D + 4] := 0;
    MemL[0:D + 8] := 2048;
    MemW[0:D + 12] := 2;                         { ecriture par la carte }
    MemW[0:D + 14] := 0;
    MemW[0:Av + 4 + I * 2] := I;
  End;
  MemW[0:Av + 2] := VnNRx;
  VnRxLast := 0;
  VnTxLast := 0;
  VnTxFree := (1 Shl VnNTx) - 1;
  For I := 0 To 5 Do NicMac[I] := Port[VIo + 20 + I];
  Port[VIo + 18] := 7;                           { DRIVER_OK }
  PortW[VIo + 16] := 0;
  NicIo := VIo;
  NicKind := 2;
  VnInit := True;
End;

{ ---- virtio-blk (interface PCI "legacy" ; disque "vda", 5e disque) ---- }
{ Disque virtio-blk de QEMU (1AF4:1001, `-drive if=virtio`) : une file, une
  requete a la fois (entete, tampon, octet d'etat), attente par scrutation du
  anneau "utilise" sous le verrou noyau (interruptions de la carte
  supprimees : drapeau NO_INTERRUPT de l'anneau, ISR lu apres chaque
  requete). Partitions MBR comme les disques IDE (disque d'index 4,
  majeur 253, 16 mineurs). }

Var
  VbIo, VbQ, VbQSz, VbAvailOfs, VbUsedOfs, VbLast, VbReq : LongInt;

Function VblkRW(Lba, Count, Buf : LongInt; Write : Boolean) : LongInt;
Var Chunk, Done, N, Used, Av, Hdr, D : LongInt;
Begin
  VblkRW := -EIO;
  If VbReq = 0 Then Exit;
  Done := 0;
  Hdr := VbReq;
  Used := VbQ + VbUsedOfs;
  Av := VbQ + VbAvailOfs;
  While Done < Count Do
  Begin
    Chunk := Count - Done;
    If Chunk > 128 Then Chunk := 128;
    MemL[0:Hdr] := Ord(Write);
    MemL[0:Hdr + 4] := 0;
    MemL[0:Hdr + 8] := Lba + Done;
    MemL[0:Hdr + 12] := 0;
    Mem[0:Hdr + 16] := $FF;
    D := VbQ;
    MemL[0:D] := V2P(Hdr);
    MemL[0:D + 4] := 0;
    MemL[0:D + 8] := 16;
    MemW[0:D + 12] := 1;
    MemW[0:D + 14] := 1;
    D := VbQ + 16;
    MemL[0:D] := V2P(Buf + Done * 512);
    MemL[0:D + 4] := 0;
    MemL[0:D + 8] := Chunk * 512;
    If Write Then MemW[0:D + 12] := 1 Else MemW[0:D + 12] := 3;
    MemW[0:D + 14] := 2;
    D := VbQ + 32;
    MemL[0:D] := V2P(Hdr + 16);
    MemL[0:D + 4] := 0;
    MemL[0:D + 8] := 1;
    MemW[0:D + 12] := 2;
    MemW[0:D + 14] := 0;
    MemW[0:Av + 4 + (MemW[0:Av + 2] Mod VbQSz) * 2] := 0;
    MemW[0:Av + 2] := (MemW[0:Av + 2] + 1) And $FFFF;
    PortW[VbIo + 16] := 0;
    N := 0;
    While (MemW[0:Used + 2] = VbLast) And (N < 100000000) Do
    Begin
      CpuPause;
      Inc(N);
    End;
    If MemW[0:Used + 2] = VbLast Then Exit;
    VbLast := (VbLast + 1) And $FFFF;
    N := Port[VbIo + 19];
    If Mem[0:Hdr + 16] <> 0 Then Exit;
    Done := Done + Chunk;
  End;
  VblkRW := 0;
End;

Function VblkProbe : Boolean;
Var Dev, Bar, Cmd, Sz, Avail, Used, Bytes, Order, Mem0, W : LongInt;
Begin
  VblkProbe := False;
  For Dev := 0 To 31 Do
    If PciRead(0, Dev, 0, 0) = LongInt($10011AF4) Then
    Begin
      Bar := PciRead(0, Dev, 0, $10);
      If (Bar And 1) = 0 Then Continue;
      VbIo := Bar And $FFFC;
      Cmd := PciRead(0, Dev, 0, 4);
      PciWrite(0, Dev, 0, 4, Cmd Or 5);
      Port[VbIo + 18] := 0;
      Port[VbIo + 18] := 1;
      Port[VbIo + 18] := 3;
      OutL(VbIo + 4, 0);
      PortW[VbIo + 14] := 0;
      Sz := PortW[VbIo + 12];
      If (Sz < 4) Or (Sz > 1024) Then Continue;
      Avail := 16 * Sz;
      Used := (Avail + 6 + 2 * Sz + 4095) And Not 4095;
      Bytes := Used + 6 + 8 * Sz;
      Order := 0;
      While (4096 Shl Order) < Bytes Do Inc(Order);
      Mem0 := AllocPages(Order);
      VbReq := AllocPages(0);
      If (Mem0 = 0) Or (VbReq = 0) Then Continue;
      MemFill(Mem0, 0, 4096 Shl Order);
      MemFill(VbReq, 0, 4096);
      VbQ := Mem0; VbQSz := Sz; VbAvailOfs := Avail; VbUsedOfs := Used;
      VbLast := 0;
      MemW[0:Mem0 + Avail] := 1;                  { pas d'interruption }
      OutL(VbIo + 8, V2P(Mem0) Shr 12);
      Port[VbIo + 18] := 7;
      DiskSectors[4] := InL(VbIo + 20);
      If DiskSectors[4] <= 0 Then Continue;
      For W := 0 To 39 Do DiskModel[160 + W] := 32;
      DiskModel[160] := 118; DiskModel[161] := 105; DiskModel[162] := 114;
      DiskModel[163] := 116; DiskModel[164] := 105; DiskModel[165] := 111;
      DiskPresent[4] := True;
      DiskAtapi[4] := False;
      PartStart[64] := 0;
      PartSize[64] := DiskSectors[4];
      VblkProbe := True;
      Exit;
    End;
End;

{ ---- AHCI / SATA (partie 39) : disques "sdX" et lecteurs "srN" ---- }
{ Controleur de classe 01:06:01 (ICH9 de QEMU, defaut de VirtualBox) : le
  BAR 5 (ABAR) est mappe en FAC00000h, interruptions coupees, une commande a
  la fois (emplacement 0) par DMA, attente par scrutation sous le verrou
  noyau. Disque ATA : IDENTIFY, READ/WRITE DMA EXT (LBA 48 bits) ; lecteur
  ATAPI (signature EB140101h) : paquets SCSI par DMA. Les ports trouves
  occupent les emplacements de disque 5 a 8. }

Const
  AhPde = 1003;                    { FAC00000h }

Var
  AhHba, AhNr : LongInt;
  AhPort, AhMem, AhKind : Array[0..8] Of LongInt;
      { par emplacement 5..8 : numero de port, memoire, 1 sd / 2 sr, rang }

Function AhR(Off : LongInt) : LongInt;
Begin
  AhR := MemL[0:AhHba + Off];
End;

Procedure AhW(Off, V : LongInt);
Begin
  MemL[0:AhHba + Off] := V;
End;

{ Arrete le moteur de commandes du port (ST, FRE) }
Procedure AhStop(Pb : LongInt);
Var N : LongInt;
Begin
  AhW(Pb + $18, AhR(Pb + $18) And Not 1);
  N := 0;
  While ((AhR(Pb + $18) And $8000) <> 0) And (N < 500000) Do Inc(N);
  AhW(Pb + $18, AhR(Pb + $18) And Not $10);
  N := 0;
  While ((AhR(Pb + $18) And $4000) <> 0) And (N < 500000) Do Inc(N);
End;

{ Execute une commande ; Fis : adresse de la FIS (20 octets), Cdb : paquet
  ATAPI (0 : aucun), Buf/Len : tampon de donnees (DMA) ; Wr : ecriture.
  Retourne 0 ou -EIO }
Function AhCmd(Sl : LongInt; Fis, Cdb, Buf, Len : LongInt; Wr : Boolean)
    : LongInt;
Var Pb, Cl, Ct, N, Tf : LongInt;
Begin
  AhCmd := -EIO;
  Pb := $100 + AhPort[Sl] * $80;
  Cl := AhMem[Sl];
  Ct := Cl + 2048;
  MemFill(Ct, 0, 256);
  MemCopy(Ct, Fis, 20);
  If Cdb <> 0 Then MemCopy(Ct + $40, Cdb, 12);
  If Len > 0 Then
  Begin
    MemL[0:Ct + $80] := V2P(Buf);
    MemL[0:Ct + $84] := 0;
    MemL[0:Ct + $8C] := Len - 1;
  End;
  { en-tete de commande 0 : CFL = 5 mots, A, W, PRDTL }
  MemL[0:Cl] := 5;
  If Cdb <> 0 Then MemL[0:Cl] := MemL[0:Cl] Or $20;
  If Wr Then MemL[0:Cl] := MemL[0:Cl] Or $40;
  If Len > 0 Then MemL[0:Cl] := MemL[0:Cl] Or (1 Shl 16);
  MemL[0:Cl + 4] := 0;
  MemL[0:Cl + 8] := V2P(Ct);
  MemL[0:Cl + 12] := 0;
  N := 0;
  While ((AhR(Pb + $20) And $88) <> 0) And (N < 2000000) Do Inc(N);
  If N >= 2000000 Then Exit;
  AhW(Pb + $10, -1);                     { acquitter PxIS }
  AhW(Pb + $30, -1);                     { PxSERR }
  AhW(Pb + $38, 1);                      { PxCI : emplacement 0 }
  N := 0;
  While ((AhR(Pb + $38) And 1) <> 0) And ((AhR(Pb + $10) And $40000000) = 0)
        And (N < 50000000) Do
    Inc(N);
  Tf := AhR(Pb + $20);
  If ((AhR(Pb + $10) And $40000000) <> 0) Or ((AhR(Pb + $38) And 1) <> 0)
     Or ((Tf And $01) <> 0) Then Exit;
  AhCmd := 0;
End;

{ FIS hote vers peripherique : commande ATA C, LBA48, nombre de secteurs }
Procedure AhFis(Fis, C, Lba, Cnt, Feat : LongInt);
Begin
  MemFill(Fis, 0, 20);
  Mem[0:Fis] := $27; Mem[0:Fis + 1] := $80;
  Mem[0:Fis + 2] := C; Mem[0:Fis + 3] := Feat;
  Mem[0:Fis + 4] := Lba And $FF; Mem[0:Fis + 5] := (Lba Shr 8) And $FF;
  Mem[0:Fis + 6] := (Lba Shr 16) And $FF; Mem[0:Fis + 7] := $40;
  Mem[0:Fis + 8] := (Lba Shr 24) And $FF;
  Mem[0:Fis + 12] := Cnt And $FF; Mem[0:Fis + 13] := (Cnt Shr 8) And $FF;
End;

{ Lecture / ecriture de secteurs de 512 octets du disque ATA (emplacement D) }
Function AhciRW(D, Lba, Count, Buf : LongInt; Write : Boolean) : LongInt;
Var Fis : Array[0..23] Of Byte; Ch, Done, R : LongInt;
Begin
  AhciRW := -EIO;
  If (D < 5) Or (D > 8) Or (AhKind[D] <> 1) Then Exit;
  Done := 0;
  While Done < Count Do
  Begin
    Ch := Count - Done;
    If Ch > 256 Then Ch := 256;
    If Write Then AhFis(LongInt(@Fis[0]), $35, Lba + Done, Ch, 0)
    Else AhFis(LongInt(@Fis[0]), $25, Lba + Done, Ch, 0);
    R := AhCmd(D, LongInt(@Fis[0]), 0, Buf + Done * 512, Ch * 512, Write);
    If R <> 0 Then
    Begin
      AhciRW := R;
      Exit;
    End;
    Done := Done + Ch;
  End;
  AhciRW := 0;
End;

{ Paquet ATAPI : retourne le nombre d'octets demandes ou -EIO }
Function AhciPacket(D, Cdb, Buf, Len : LongInt) : LongInt;
Var Fis : Array[0..23] Of Byte; R : LongInt;
Begin
  AhciPacket := -EIO;
  If (D < 5) Or (D > 8) Or (AhKind[D] <> 2) Then Exit;
  AhFis(LongInt(@Fis[0]), $A0, 0, 0, 1);
  Mem[0:LongInt(@Fis[0]) + 7] := 0;
  Fis[5] := Len And $FF; Fis[6] := (Len Shr 8) And $FF;
  R := AhCmd(D, LongInt(@Fis[0]), Cdb, Buf, Len, False);
  If R = 0 Then AhciPacket := Len;
End;

{ Initialise le port Pn : memoire, moteur, puis detection du peripherique ;
  retourne 0 (rien), 1 (disque ATA) ou 2 (ATAPI) }
Function AhPortInit(Sl, Pn : LongInt) : LongInt;
Var Pb, Mm, N, Sig, W, I, Fis : LongInt; Id : Array[0..255] Of Word;
    Fb : Array[0..23] Of Byte;
Begin
  AhPortInit := 0;
  Pb := $100 + Pn * $80;
  If (AhR(Pb + $28) And $F) <> 3 Then Exit;       { pas de liaison }
  AhStop(Pb);
  Mm := AllocPages(1);
  If Mm = 0 Then Exit;
  MemFill(Mm, 0, 8192);
  AhPort[Sl] := Pn;
  AhMem[Sl] := Mm;
  AhW(Pb, V2P(Mm));                               { liste de commandes }
  AhW(Pb + 4, 0);
  AhW(Pb + 8, V2P(Mm + 1024));                    { FIS recues }
  AhW(Pb + $C, 0);
  AhW(Pb + $14, 0);                               { pas d'interruption }
  AhW(Pb + $30, -1);
  AhW(Pb + $10, -1);
  AhW(Pb + $18, AhR(Pb + $18) Or $10);            { FRE }
  AhW(Pb + $18, AhR(Pb + $18) Or 1);              { ST }
  N := 0;
  While ((AhR(Pb + $20) And $88) <> 0) And (N < 5000000) Do Inc(N);
  Sig := AhR(Pb + $24);
  Fis := LongInt(@Fb[0]);
  If Sig = LongInt($EB140101) Then
  Begin
    AhKind[Sl] := 2;
    AhPortInit := 2;
    Exit;
  End;
  AhKind[Sl] := 1;
  AhFis(Fis, $EC, 0, 0, 0);
  Mem[0:Fis + 7] := 0;
  If AhCmd(Sl, Fis, 0, LongInt(@Id[0]), 512, False) <> 0 Then
  Begin
    AhKind[Sl] := 0;
    Exit;
  End;
  If (Id[83] And $400) <> 0 Then W := Id[100] Or (Id[101] Shl 16)
  Else W := Id[60] Or (Id[61] Shl 16);
  If (W <= 0) Or (((Id[83] And $400) <> 0) And ((Id[102] <> 0)
     Or (Id[103] <> 0))) Then W := $7FFFFFFF;
  DiskSectors[Sl] := W;
  For I := 0 To 19 Do
  Begin
    DiskModel[Sl * 40 + I * 2] := Id[27 + I] Shr 8;
    DiskModel[Sl * 40 + I * 2 + 1] := Id[27 + I] And $FF;
  End;
  AhPortInit := 1;
End;

{ Cherche un controleur AHCI, enregistre ses disques et lecteurs ; retourne
  le nombre de peripheriques }
Function AhciProbe : LongInt;
Var Dev, Cls, Bar, Cmd, Pt, I, Pi, Pn, Sl, R, Ns, Nr : LongInt;
Begin
  AhciProbe := 0;
  AhNr := 0;
  Ns := 0; Nr := 0;
  For Dev := 0 To 31 Do
  Begin
    Cls := PciRead(0, Dev, 0, 8) Shr 8;
    If Cls <> $010601 Then Continue;
    Bar := PciRead(0, Dev, 0, $24) And LongInt($FFFFFFF0);
    If Bar = 0 Then Continue;
    Cmd := PciRead(0, Dev, 0, 4);
    PciWrite(0, Dev, 0, 4, Cmd Or 6);             { memoire + maitre du bus }
    Pt := AllocZeroPage;
    If Pt = 0 Then Continue;
    For I := 0 To 7 Do MemL[0:Pt + I * 4] := (Bar And LongInt($FFFFF000))
        + I * 4096 Or $13;
    MemL[0:MasterPd + AhPde * 4] := V2P(Pt) Or $13;
    FlushTlb;
    AhHba := LongInt(AhPde Shl 22) + (Bar And $FFF);
    AhW(4, AhR(4) Or LongInt($80000000));         { GHC.AE }
    AhW(4, AhR(4) And Not 2);                     { interruptions coupees }
    Pi := AhR($C);
    Sl := 5;
    For Pn := 0 To 31 Do
      If ((Pi Shr Pn) And 1) <> 0 Then
      Begin
        If Sl > 8 Then Break;
        R := AhPortInit(Sl, Pn);
        If R <> 0 Then
        Begin
          If R = 1 Then
          Begin
            AhIdx[Sl] := Ns;
            Inc(Ns);
            DiskAtapi[Sl] := False;
          End
          Else
          Begin
            AhIdx[Sl] := Nr;
            Inc(Nr);
            DiskAtapi[Sl] := True;
          End;
          DiskPresent[Sl] := True;
          If R = 2 Then
          Begin
            CdCache[Sl] := -1;
            If CdBuf = 0 Then CdBuf := AllocPages(0);
            DiskSectors[Sl] := AtapiCapacity(Sl) * 4;
            If DiskSectors[Sl] <= 0 Then DiskSectors[Sl] := 0;
          End;
          PartStart[Sl * 16] := 0;
          PartSize[Sl * 16] := DiskSectors[Sl];
          Inc(Sl);
          Inc(AhNr);
        End;
      End;
    If AhNr > 0 Then Break;
  End;
  AhciProbe := AhNr;
End;

{ ---- Intel e1000 (82540EM : carte par defaut de VirtualBox et de QEMU
  -device e1000), partie 39 ---- }
{ Registres en memoire (BAR 0, 128 Ko mappes en FB000000h). 32 descripteurs de
  reception de 2 Ko recycles par la partie differee de l'IRQ, 8 d'emission ;
  somme de controle et segmentation non deleguees. }

Const
  EgPde = 1004;                    { FB000000h }
  EgNRx = 32; EgNTx = 8;

Var
  EgVirt, EgRxD, EgTxD, EgRxB, EgTxB, EgRxCur, EgTxCur : LongInt;

Function EgR(Off : LongInt) : LongInt;
Begin
  EgR := MemL[0:EgVirt + Off];
End;

Procedure EgW(Off, V : LongInt);
Begin
  MemL[0:EgVirt + Off] := V;
End;

Function EgSend(Frame, Len : LongInt) : LongInt;
Var D, N : LongInt;
Begin
  EgSend := -ENODEV;
  If NicKind <> 3 Then Exit;
  If Len > 1514 Then
  Begin
    EgSend := -EMSGSIZE;
    Exit;
  End;
  D := EgTxD + EgTxCur * 16;
  N := 0;
  While ((Mem[0:D + 12] And 1) = 0) And (Mem[0:D + 11] <> 0) And (N < 200000)
    Do Inc(N);
  If Len < 60 Then
  Begin
    MemFill(EgTxB + EgTxCur * 2048, 0, 60);
    MemCopy(EgTxB + EgTxCur * 2048, Frame, Len);
    Len := 60;
  End
  Else MemCopy(EgTxB + EgTxCur * 2048, Frame, Len);
  MemL[0:D] := V2P(EgTxB + EgTxCur * 2048);
  MemL[0:D + 4] := 0;
  MemW[0:D + 8] := Len;
  Mem[0:D + 10] := 0;
  Mem[0:D + 11] := $0B;                     { EOP, IFCS, RS }
  Mem[0:D + 12] := 0;
  EgTxCur := (EgTxCur + 1) Mod EgNTx;
  EgW($3818, EgTxCur);                      { TDT }
  Inc(NetTxPkts);
  NetTxBytes := NetTxBytes + Len;
  EgSend := 0;
End;

Procedure EgPoll;
Var D, L : LongInt;
Begin
  While (Mem[0:EgRxD + EgRxCur * 16 + 12] And 1) <> 0 Do
  Begin
    D := EgRxD + EgRxCur * 16;
    L := MemW[0:D + 8];
    If ((Mem[0:D + 12] And 2) <> 0) And (L >= 14) And (L <= 2048)
       And (Mem[0:D + 13] = 0) Then
    Begin
      Inc(NetRxPkts);
      NetRxBytes := NetRxBytes + L;
      NetInput(EgRxB + EgRxCur * 2048, L);
    End
    Else Inc(NetRxErr);
    Mem[0:D + 12] := 0;
    EgW($2818, EgRxCur);                    { RDT : rendre le descripteur }
    EgRxCur := (EgRxCur + 1) Mod EgNRx;
  End;
End;

Function EgInit(Dev : LongInt) : Boolean;
Var Bar, Cmd, I, Pt, Ral, Rah : LongInt;
Begin
  EgInit := False;
  Bar := PciRead(0, Dev, 0, $10) And LongInt($FFFFFFF0);
  If Bar = 0 Then Exit;
  Cmd := PciRead(0, Dev, 0, 4);
  PciWrite(0, Dev, 0, 4, Cmd Or 6);
  NicIrq := PciRead(0, Dev, 0, $3C) And $FF;
  Pt := AllocZeroPage;
  If Pt = 0 Then Exit;
  For I := 0 To 31 Do
    MemL[0:Pt + I * 4] := ((Bar And LongInt($FFFFF000)) + I * 4096) Or $13;
  MemL[0:MasterPd + EgPde * 4] := V2P(Pt) Or $13;
  FlushTlb;
  EgVirt := LongInt(EgPde Shl 22) + (Bar And $FFF);
  EgW($D8, -1);                             { IMC : plus d'interruption }
  EgW($0, EgR($0) Or $4000000);             { CTRL.RST }
  I := 0;
  While ((EgR($0) And $4000000) <> 0) And (I < 1000000) Do Inc(I);
  EgW($D8, -1);
  EgW($0, (EgR($0) Or $40 Or $20) And Not $80000000); { SLU, ASDE }
  Ral := EgR($5400); Rah := EgR($5404);
  NicMac[0] := Ral And $FF; NicMac[1] := (Ral Shr 8) And $FF;
  NicMac[2] := (Ral Shr 16) And $FF; NicMac[3] := (Ral Shr 24) And $FF;
  NicMac[4] := Rah And $FF; NicMac[5] := (Rah Shr 8) And $FF;
  EgRxD := AllocZeroPage;
  EgTxD := AllocZeroPage;
  EgRxB := AllocPages(4);
  EgTxB := AllocPages(2);
  If (EgRxD = 0) Or (EgTxD = 0) Or (EgRxB = 0) Or (EgTxB = 0) Then Exit;
  For I := 0 To 127 Do EgW($5200 + I * 4, 0);       { MTA }
  For I := 0 To EgNRx - 1 Do
  Begin
    MemL[0:EgRxD + I * 16] := V2P(EgRxB + I * 2048);
    MemL[0:EgRxD + I * 16 + 4] := 0;
  End;
  EgW($2800, V2P(EgRxD)); EgW($2804, 0); EgW($2808, EgNRx * 16);
  EgW($2810, 0); EgW($2818, EgNRx - 1);
  EgRxCur := 0;
  EgW($3800, V2P(EgTxD)); EgW($3804, 0); EgW($3808, EgNTx * 16);
  EgW($3810, 0); EgW($3818, 0);
  EgTxCur := 0;
  EgW($410, $0060200A);                     { TIPG }
  EgW($400, $0004010A);                     { TCTL : EN, PSP, CT, COLD }
  EgW($100, $04008002);                     { RCTL : EN, BAM, SECRC, 2 Ko }
  EgW($D0, $80 Or $40 Or $10 Or $4);        { IMS : RXT0, RXO, RXDMT0, LSC }
  NicIo := Bar And $FFFFFFF0;
  NicKind := 3;
  EgInit := True;
End;

{ ---- AMD PCnet (79C970A, PCI 1022:2000 : VirtualBox, qemu -device pcnet) ----
  Mode 32 bits (DWIO, SWSTYLE 2), 32 descripteurs de reception, 8 d'emission,
  une page : bloc d'initialisation en 0, anneau RX en 256, anneau TX en 1024 }

Const
  PcNRx = 32; PcNTx = 8;

Var
  PcPg, PcRxB, PcTxB, PcRxCur, PcTxCur : LongInt;

Procedure PcWCsr(N, V : LongInt);
Begin
  OutL(NicIo + $14, N);
  OutL(NicIo + $10, V);
End;

Function PcRCsr(N : LongInt) : LongInt;
Begin
  OutL(NicIo + $14, N);
  PcRCsr := InL(NicIo + $10) And $FFFF;
End;

Procedure PcWBcr(N, V : LongInt);
Begin
  OutL(NicIo + $14, N);
  OutL(NicIo + $1C, V);
End;

Function PcSend(Frame, Len : LongInt) : LongInt;
Var D, N : LongInt;
Begin
  PcSend := -ENODEV;
  If NicKind <> 4 Then Exit;
  If Len > 1514 Then
  Begin
    PcSend := -EMSGSIZE;
    Exit;
  End;
  D := PcPg + 1024 + PcTxCur * 16;
  N := 0;
  While ((Mem[0:D + 7] And $80) <> 0) And (N < 200000) Do Inc(N);
  If Len < 60 Then
  Begin
    MemFill(PcTxB + PcTxCur * 2048, 0, 60);
    MemCopy(PcTxB + PcTxCur * 2048, Frame, Len);
    Len := 60;
  End
  Else MemCopy(PcTxB + PcTxCur * 2048, Frame, Len);
  MemL[0:D] := V2P(PcTxB + PcTxCur * 2048);
  MemW[0:D + 4] := $F000 Or ((-Len) And $FFF);
  MemL[0:D + 8] := 0;
  MemW[0:D + 6] := $8300;                   { OWN, STP, ENP }
  PcTxCur := (PcTxCur + 1) Mod PcNTx;
  PcWCsr(0, $48);                           { TDMD, IENA }
  Inc(NetTxPkts);
  NetTxBytes := NetTxBytes + Len;
  PcSend := 0;
End;

Procedure PcPoll;
Var D, L, St : LongInt;
Begin
  D := PcPg + 256 + PcRxCur * 16;
  While (MemW[0:D + 6] And $8000) = 0 Do
  Begin
    St := MemW[0:D + 6];
    L := (MemL[0:D + 8] And $FFF) - 4;
    If ((St And $4000) = 0) And ((St And $300) = $300) And (L >= 14)
       And (L <= 2048) Then
    Begin
      Inc(NetRxPkts);
      NetRxBytes := NetRxBytes + L;
      NetInput(PcRxB + PcRxCur * 2048, L);
    End
    Else Inc(NetRxErr);
    MemW[0:D + 4] := $F000 Or ((-2048) And $FFF);
    MemW[0:D + 6] := $8000;
    PcRxCur := (PcRxCur + 1) Mod PcNRx;
    D := PcPg + 256 + PcRxCur * 16;
  End;
End;

Procedure PcIrq;
Var C : LongInt;
Begin
  C := PcRCsr(0);
  PcWCsr(0, (C And $7F00) Or $40);          { acquitter, garder IENA }
  If (C And $400) <> 0 Then PcPoll;
End;

Function PcInit(Dev : LongInt) : Boolean;
Var Bar, Cmd, I, N, Ib : LongInt;
Begin
  PcInit := False;
  Bar := PciRead(0, Dev, 0, $10);
  If (Bar And 1) = 0 Then Exit;
  NicIo := Bar And $FFFC;
  Cmd := PciRead(0, Dev, 0, 4);
  PciWrite(0, Dev, 0, 4, Cmd Or 5);         { E/S + maitre du bus }
  NicIrq := PciRead(0, Dev, 0, $3C) And $FF;
  PcPg := AllocZeroPage;
  PcRxB := AllocPages(4);
  PcTxB := AllocPages(2);
  If (PcPg = 0) Or (PcRxB = 0) Or (PcTxB = 0) Then Exit;
  For I := 0 To 5 Do NicMac[I] := Port[NicIo + I];   { APROM, mode 16 bits }
  N := PortW[NicIo + $14];                  { RESET (mode 16 bits) }
  OutL(NicIo + $10, 0);                     { passage en mode 32 bits }
  PcWBcr(20, 2);                            { SWSTYLE 2 }
  PcWBcr(2, 2);                             { ASEL }
  Ib := PcPg;
  MemW[0:Ib] := 0;                          { MODE }
  MemW[0:Ib + 2] := (5 Shl 4) Or (3 Shl 12);   { 32 RX, 8 TX }
  For I := 0 To 5 Do Mem[0:Ib + 4 + I] := NicMac[I];
  MemL[0:Ib + 12] := 0; MemL[0:Ib + 16] := 0;
  MemL[0:Ib + 20] := V2P(PcPg + 256);
  MemL[0:Ib + 24] := V2P(PcPg + 1024);
  For I := 0 To PcNRx - 1 Do
  Begin
    MemL[0:PcPg + 256 + I * 16] := V2P(PcRxB + I * 2048);
    MemW[0:PcPg + 256 + I * 16 + 4] := $F000 Or ((-2048) And $FFF);
    MemW[0:PcPg + 256 + I * 16 + 6] := $8000;
  End;
  PcRxCur := 0;
  PcTxCur := 0;
  PcWCsr(1, V2P(Ib) And $FFFF);
  PcWCsr(2, (V2P(Ib) Shr 16) And $FFFF);
  PcWCsr(3, 0);
  PcWCsr(4, $0915);
  PcWCsr(0, 1);                             { INIT }
  N := 0;
  While ((PcRCsr(0) And $100) = 0) And (N < 100000) Do Inc(N);
  If N >= 100000 Then Exit;
  PcWCsr(0, $142);                          { STRT, IENA, acquitter IDON }
  NicKind := 4;
  PcInit := True;
End;

{ Emettre une trame de Len octets (deja complete) ; 0 ou -errno }
Function NicSend(Frame, Len : LongInt) : LongInt;
Var Cur_, N, Orig : LongInt;
Begin
  NicSend := -ENODEV;
  Orig := Len;
  If NicKind = 2 Then
  Begin
    N := VnSend(Frame, Len);
    NicSend := N;
    If N = 0 Then PktTap(Frame, Orig, 4, PktSkip);
    Exit;
  End;
  If NicKind = 4 Then
  Begin
    N := PcSend(Frame, Len);
    NicSend := N;
    If N = 0 Then PktTap(Frame, Orig, 4, PktSkip);
    Exit;
  End;
  If NicKind = 3 Then
  Begin
    N := EgSend(Frame, Len);
    NicSend := N;
    If N = 0 Then PktTap(Frame, Orig, 4, PktSkip);
    Exit;
  End;
  If Not NetPresent Then Exit;
  If Len > 1514 Then
  Begin
    NicSend := -EMSGSIZE;
    Exit;
  End;
  Cur_ := NicTxCur;
  N := 0;
  While ((InL(NicIo + $10 + Cur_ * 4) And $2000) = 0)
      And ((InL(NicIo + $10 + Cur_ * 4) And $1FFF) <> 0) And (N < 100000) Do
    Inc(N);
  If Len < 60 Then
  Begin
    MemFill(NicTx + Cur_ * 2048, 0, 60);
    MemCopy(NicTx + Cur_ * 2048, Frame, Len);
    Len := 60;
  End
  Else MemCopy(NicTx + Cur_ * 2048, Frame, Len);
  OutL(NicIo + $20 + Cur_ * 4, V2P(NicTx + Cur_ * 2048));
  OutL(NicIo + $10 + Cur_ * 4, Len);
  NicTxCur := (Cur_ + 1) And 3;
  Inc(NetTxPkts);
  NetTxBytes := NetTxBytes + Len;
  NicSend := 0;
  PktTap(Frame, Orig, 4, PktSkip);
End;

{ Emission sur une socket AF_PACKET : SOCK_RAW (trame complete) ou
  SOCK_DGRAM (en-tete Ethernet ajoute d'apres sockaddr_ll) ; Buf est une
  copie dans le noyau, Dest une adresse utilisateur }
Function PktSend(S : PSock; Buf, Cnt, Dest, DestLen : LongInt) : LongInt;
Var Ifx, Et, R, I : LongInt;
Begin
  Ifx := S^.LPort;
  Et := S^.Proto;
  If Dest <> 0 Then
  Begin
    If (DestLen < 12) Or (Not EnsureUser(Dest, 12, False))
       Or (MemW[0:Dest] <> AF_PACKET) Then
    Begin
      PktSend := -EINVAL;
      Exit;
    End;
    If MemL[0:Dest + 4] <> 0 Then Ifx := MemL[0:Dest + 4];
    If (Mem[0:Dest + 2] Shl 8 Or Mem[0:Dest + 3]) <> 0 Then
      Et := (Mem[0:Dest + 2] Shl 8) Or Mem[0:Dest + 3];
  End;
  If (Ifx <> 0) And (Ifx <> 2) Then
  Begin
    If Ifx = 1 Then PktSend := -EOPNOTSUPP Else PktSend := -ENODEV;
    Exit;
  End;
  If Not (NetPresent And NicUp) Then
  Begin
    PktSend := -100;
    Exit;
  End;
  If S^.Typ = SOCK_RAW Then
  Begin
    If (Cnt < 14) Or (Cnt > 1514) Then
    Begin
      PktSend := -EMSGSIZE;
      Exit;
    End;
    PktSkip := S;
    R := NicSend(Buf, Cnt);
    PktSkip := Nil;
  End
  Else
  Begin
    If Dest = 0 Then
    Begin
      PktSend := -EDESTADDRREQ;
      Exit;
    End;
    If Cnt > NetMtu Then
    Begin
      PktSend := -EMSGSIZE;
      Exit;
    End;
    If (DestLen < 20) Or (Not EnsureUser(Dest, 20, False))
       Or (Mem[0:Dest + 11] < 6) Then
    Begin
      PktSend := -EINVAL;
      Exit;
    End;
    MemCopy(LongInt(@PktBuf[0]), Dest + 12, 6);
    MemCopy(LongInt(@PktBuf[6]), LongInt(@NicMac[0]), 6);
    PktBuf[12] := (Et Shr 8) And $FF;
    PktBuf[13] := Et And $FF;
    MemCopy(LongInt(@PktBuf[14]), Buf, Cnt);
    PktSkip := S;
    R := NicSend(LongInt(@PktBuf[0]), Cnt + 14);
    PktSkip := Nil;
  End;
  If R < 0 Then PktSend := R Else PktSend := Cnt;
End;


Procedure NetInput(Frame, Len : LongInt); Forward;

{ Traiter les trames recues (interruption ou tick) }
Procedure NicPoll;
Var Hdr, Status, Len, Ofs, Frame : LongInt;
Begin
  If Not NetPresent Then Exit;
  While (Port[NicIo + $37] And 1) = 0 Do
  Begin
    Ofs := NicRxOfs;
    Hdr := NicRx + Ofs;
    Status := MemW[0:Hdr];
    Len := MemW[0:Hdr + 2];
    If ((Status And 1) = 0) Or (Len < 18) Or (Len > 1600) Then
    Begin
      { tampon incoherent : tout reinitialiser }
      Inc(NetRxErr);
      Port[NicIo + $37] := $04;           { RE=0 }
      Port[NicIo + $37] := $0C;
      NicRxOfs := 0;
      OutL(NicIo + $30, V2P(NicRx));
      PortW[NicIo + $38] := $FFF0;
      Exit;
    End;
    Frame := Hdr + 4;
    Inc(NetRxPkts);
    NetRxBytes := NetRxBytes + Len - 4;
    NetInput(Frame, Len - 4);
    NicRxOfs := (Ofs + Len + 4 + 3) And Not 3;
    NicRxOfs := NicRxOfs Mod RtlRxSize;
    PortW[NicIo + $38] := (NicRxOfs - 16) And $FFFF;
  End;
End;

Procedure NicIrqHandler;
Var Isr : LongInt;
Begin
  If Not NetPresent Then Exit;
  If NicKind = 2 Then
  Begin
    If Port[VIo + 19] <> 0 Then VnPoll;
    Exit;
  End;
  If NicKind = 4 Then
  Begin
    PcIrq;
    Exit;
  End;
  If NicKind = 3 Then
  Begin
    Isr := EgR($C0);                       { ICR : lecture = acquittement }
    If Isr <> 0 Then EgPoll;
    Exit;
  End;
  Isr := PortW[NicIo + $3E];
  PortW[NicIo + $3E] := Isr;            { acquitter }
  If (Isr And $FFFF) <> 0 Then NicPoll;
End;

Procedure NicInit;
Var Dev, V, Bar, Cmd, I, N : LongInt;
Begin
  NetPresent := False;
  For Dev := 0 To 31 Do
  Begin
    V := PciRead(0, Dev, 0, 0);
    If V = LongInt($813910EC) Then
    Begin
      Bar := PciRead(0, Dev, 0, $10);
      If (Bar And 1) = 0 Then Continue;
      NicIo := Bar And $FFFC;
      Cmd := PciRead(0, Dev, 0, 4);
      PciWrite(0, Dev, 0, 4, Cmd Or 5);       { E/S + maitre du bus }
      NicIrq := PciRead(0, Dev, 0, $3C) And $FF;
      NicRx := AllocPages(2);                 { 16 Ko contigus }
      NicTx := AllocPages(1);                 { 8 Ko }
      If (NicRx = 0) Or (NicTx = 0) Then Exit;
      MemFill(NicRx, 0, 16384);
      MemFill(NicTx, 0, 8192);
      Port[NicIo + $52] := 0;                 { alimentation }
      Port[NicIo + $37] := $10;               { reinitialisation }
      N := 0;
      While ((Port[NicIo + $37] And $10) <> 0) And (N < 1000000) Do Inc(N);
      For I := 0 To 5 Do NicMac[I] := Port[NicIo + I];
      OutL(NicIo + $30, V2P(NicRx));
      NicRxOfs := 0;
      NicTxCur := 0;
      PortW[NicIo + $3C] := $0005;            { ROK + TOK }
      OutL(NicIo + $44, $0000008F);        { tout recu + WRAP }
      OutL(NicIo + $40, $03000700);        { TCR : DMA 2048, IFG normal }
      Port[NicIo + $37] := $0C;               { RE + TE }
      PortW[NicIo + $38] := $FFF0;
      NetPresent := True;
      NicUp := True;
      NicKind := 1;
      Exit;
    End;
  End;
  { e1000 82540EM / 82545EM / 82543GC }
  For Dev := 0 To 31 Do
  Begin
    V := PciRead(0, Dev, 0, 0);
    If (V = LongInt($100E8086)) Or (V = LongInt($100F8086))
       Or (V = LongInt($10048086)) Then
      If EgInit(Dev) Then
      Begin
        NetPresent := True;
        NicUp := True;
        Exit;
      End;
  End;
  { virtio-net (QEMU : -nic user,model=virtio-net-pci) }
  For Dev := 0 To 31 Do
    If PciRead(0, Dev, 0, 0) = LongInt($10001AF4) Then
      If VnInit(Dev) Then
      Begin
        NetPresent := True;
        NicUp := True;
        Exit;
      End;
  { AMD PCnet (VirtualBox, qemu model=pcnet) }
  For Dev := 0 To 31 Do
    If PciRead(0, Dev, 0, 0) = LongInt($20001022) Then
      If PcInit(Dev) Then
      Begin
        NetPresent := True;
        NicUp := True;
        Exit;
      End;
End;

{ ---- ARP ---- }

Function ArpFind(Ip : LongInt) : LongInt;
Var I : LongInt;
Begin
  ArpFind := -1;
  For I := 0 To MaxArp - 1 Do
    If (ArpIp[I] = Ip) And (ArpAge[I] <> 0) Then
    Begin
      ArpFind := I;
      Exit;
    End;
End;

Procedure ArpLearn(Ip, MacAddr : LongInt);
Var I, K : LongInt;
Begin
  If Ip = 0 Then Exit;
  K := ArpFind(Ip);
  If K < 0 Then
  Begin
    K := 0;
    For I := 0 To MaxArp - 1 Do
      If (ArpAge[I] = 0) Then
      Begin
        K := I;
        Break;
      End
      Else If ArpAge[I] - ArpAge[K] < 0 Then K := I;
    ArpIp[K] := Ip;
  End;
  MemCopy(LongInt(@ArpMac[K * 6]), MacAddr, 6);
  ArpAge[K] := Jiffies Or 1;
End;

Procedure ArpSendRequest(Ip : LongInt);
Var F : Array[0..59] Of Byte; A : LongInt;
Begin
  MemFill(LongInt(@F[0]), 0, 60);
  A := LongInt(@F[0]);
  MemFill(A, $FF, 6);
  MemCopy(A + 6, LongInt(@NicMac[0]), 6);
  PutBe16(A + 12, EtherArp);
  PutBe16(A + 14, 1); PutBe16(A + 16, EtherIp);
  Mem[0:A + 18] := 6; Mem[0:A + 19] := 4;
  PutBe16(A + 20, 1);                       { requete }
  MemCopy(A + 22, LongInt(@NicMac[0]), 6);
  PutBe32(A + 28, NicIp);
  PutBe32(A + 38, Ip);
  NicSend(A, 60);
End;

Procedure ArpInput(A, Len : LongInt);
Var Op, SpaIp : LongInt; F : Array[0..59] Of Byte; R : LongInt;
Begin
  If Len < 42 Then Exit;
  Op := Be16(A + 20);
  SpaIp := Be32(A + 28);
  ArpLearn(SpaIp, A + 22);
  If (Op = 1) And (Be32(A + 38) = NicIp) And (NicIp <> 0) Then
  Begin
    R := LongInt(@F[0]);
    MemFill(R, 0, 60);
    MemCopy(R, A + 6, 6);
    MemCopy(R + 6, LongInt(@NicMac[0]), 6);
    PutBe16(R + 12, EtherArp);
    PutBe16(R + 14, 1); PutBe16(R + 16, EtherIp);
    Mem[0:R + 18] := 6; Mem[0:R + 19] := 4;
    PutBe16(R + 20, 2);                     { reponse }
    MemCopy(R + 22, LongInt(@NicMac[0]), 6);
    PutBe32(R + 28, NicIp);
    MemCopy(R + 32, A + 22, 6);
    PutBe32(R + 38, SpaIp);
    NicSend(R, 60);
  End;
End;

{ Adresse materielle du prochain saut vers Dst ; resolution ARP avec
  attente si Wait (contexte d'appel systeme) ; 0 ou -errno }
Function NetResolve(Dst : LongInt; Wait : Boolean; Mac : LongInt) : LongInt;
Var Hop, K, T : LongInt;
Begin
  If ((Dst Or Not NicMask) = -1) Or (Dst = -1) Then
  Begin
    MemFill(Mac, $FF, 6);
    NetResolve := 0;
    Exit;
  End;
  If ((Dst Xor NicIp) And NicMask) = 0 Then Hop := Dst
  Else If NicGw <> 0 Then Hop := NicGw
  Else
  Begin
    NetResolve := -ENETUNREACH;
    Exit;
  End;
  K := ArpFind(Hop);
  If K >= 0 Then
  Begin
    MemCopy(Mac, LongInt(@ArpMac[K * 6]), 6);
    NetResolve := 0;
    Exit;
  End;
  ArpSendRequest(Hop);
  If Not Wait Then
  Begin
    NetResolve := -EAGAIN;
    Exit;
  End;
  For T := 1 To 300 Do
  Begin
    SleepTicks(1);
    NicPoll;
    K := ArpFind(Hop);
    If K >= 0 Then
    Begin
      MemCopy(Mac, LongInt(@ArpMac[K * 6]), 6);
      NetResolve := 0;
      Exit;
    End;
    If (T Mod 100) = 0 Then ArpSendRequest(Hop);
  End;
  NetResolve := -EHOSTUNREACH_;
End;

{ ---- IPv4 ---- }

{ Emettre un paquet IP (charge utile deja en Pay, Plen octets) vers Dst ;
  Wait : attente ARP autorisee }
{ ---- netfilter minimal (partie 39) : table "filter" de l'ABI iptables ---- }
{ Une table, trois chaines (INPUT, FORWARD, OUTPUT : points d'accroche
  NF_INET_LOCAL_IN 1, FORWARD 2, LOCAL_OUT 3), cibles standard ACCEPT et DROP
  (valeurs -2 et -1), correspondances ip (adresses et masques, interface,
  protocole, inversions), tcp et udp (intervalles de ports) ; compteurs par
  regle. Interface : setsockopt/getsockopt(SOL_IP, IPT_SO_*) sur une socket
  AF_INET SOCK_RAW IPPROTO_RAW (root) : GET_INFO 64, GET_ENTRIES 65,
  SET_REPLACE 64, SET_ADD_COUNTERS 65. Applique aux paquets IP de eth0 : INPUT
  a la reception (NetInput), OUTPUT a l'emission de IpOutput (pas aux trames
  AF_PACKET, ni au bouclage local). Pas de chaines utilisateur, de NAT, de
  suivi de connexions, de REJECT/LOG. }

Const
  NfMaxSz = 16384;
  NfEntHdr = 112;
  CtMax = 64;
  CtLife = 30000;                { 5 minutes en ticks }

Var
  NfBlob : Array[0..NfMaxSz - 1] Of Byte;
  NfSize, NfNum, NfValid, NfRules : LongInt;
  NfHook, NfUnder : Array[0..4] Of LongInt;
  NfDrops : LongInt;
  NtBlob : Array[0..NfMaxSz - 1] Of Byte;
  NtSize, NtNum, NtValid, NtRules : LongInt;
  NtHook, NtUnder : Array[0..4] Of LongInt;
  NfInN, NfOutN : String;     { interfaces d'entree et de sortie du paquet }
  { suivi de connexions : n-uplet d'origine O, n-uplet de reponse R (apres
    traduction) ; ports ou identifiant d'echo pour ICMP }
  CtUsed, CtProto, CtOs, CtOd, CtOsp, CtOdp, CtRs, CtRd, CtRsp, CtRdp,
    CtAge, CtDn, CtSn : Array[0..CtMax - 1] Of LongInt;
  CtCount, CtCur, CtCurDir, NatData : LongInt;

Function IpOutput(Dst, Proto, Pay, Plen : LongInt; Wait : Boolean)
    : LongInt; Forward;
Function SrcFor(Dst : LongInt) : LongInt; Forward;

{ Politiques par defaut : filter (INPUT, FORWARD, OUTPUT) et nat
  (PREROUTING, INPUT, OUTPUT, POSTROUTING) }
Procedure NfDefault;
Var I, P : LongInt;
Begin
  MemFill(LongInt(@NfBlob[0]), 0, 456);
  For I := 0 To 2 Do
  Begin
    P := LongInt(@NfBlob[0]) + I * 152;
    MemW[0:P + 88] := NfEntHdr;              { target_offset }
    MemW[0:P + 90] := 152;                   { next_offset }
    MemW[0:P + NfEntHdr] := 40;              { cible standard }
    MemL[0:P + NfEntHdr + 32] := -2;         { ACCEPT }
    NfHook[I + 1] := I * 152;
    NfUnder[I + 1] := I * 152;
  End;
  NfNum := 3; NfSize := 456; NfValid := $E; NfRules := 0;
  MemFill(LongInt(@NtBlob[0]), 0, 608);
  For I := 0 To 3 Do
  Begin
    P := LongInt(@NtBlob[0]) + I * 152;
    MemW[0:P + 88] := NfEntHdr;
    MemW[0:P + 90] := 152;
    MemW[0:P + NfEntHdr] := 40;
    MemL[0:P + NfEntHdr + 32] := -2;
  End;
  NtHook[0] := 0; NtHook[1] := 152; NtHook[3] := 304; NtHook[4] := 456;
  NtUnder[0] := 0; NtUnder[1] := 152; NtUnder[3] := 304; NtUnder[4] := 456;
  NtNum := 4; NtSize := 608; NtValid := $1B; NtRules := 0;
  CtCount := 0; CtCur := -1;
End;

{ Nom de cible a K (en-tete xt_entry_target) : "SNAT", "DNAT", "MASQUERADE",
  "REDIRECT", "REJECT", "LOG", "ERROR" ou vide ; renvoie un code }
Function NfTgtKind(K : LongInt) : LongInt;
Var A, B, C : LongInt;
Begin
  A := Mem[0:K + 2]; B := Mem[0:K + 3]; C := Mem[0:K + 4];
  NfTgtKind := -1;
  If A = 0 Then NfTgtKind := 0
  Else If (A = 83) And (B = 78) And (C = 65) Then NfTgtKind := 1
  Else If (A = 68) And (B = 78) And (C = 65) Then NfTgtKind := 2
  Else If (A = 77) And (B = 65) And (C = 83) Then NfTgtKind := 3
  Else If (A = 82) And (B = 69) And (C = 68) Then NfTgtKind := 4
  Else If (A = 82) And (B = 69) And (C = 74) Then NfTgtKind := 5
  Else If (A = 76) And (B = 79) And (C = 71) Then NfTgtKind := 6
  Else If (A = 69) And (B = 82) And (C = 82) Then NfTgtKind := 7;
End;

{ Verifie un tableau d'entrees de la table Tab (0 filter, 1 nat) ;
  0 ou -errno }
Function NfCheck(E, Size, Num, Tab : LongInt) : LongInt;
Var Off, N, Nx, To_, Mo, Ms, K, Tk : LongInt;
Begin
  NfCheck := -EINVAL;
  Off := 0; N := 0;
  While Off < Size Do
  Begin
    If Off + NfEntHdr + 8 > Size Then Exit;
    Nx := MemW[0:E + Off + 90];
    To_ := MemW[0:E + Off + 88];
    If (Nx < NfEntHdr + 8) Or (Off + Nx > Size) Or (To_ < NfEntHdr)
       Or (To_ + 8 > Nx) Or ((Nx And 7) <> 0) Then Exit;
    { correspondances }
    Mo := NfEntHdr;
    While Mo < To_ Do
    Begin
      Ms := MemW[0:E + Off + Mo];
      If (Ms < 32) Or (Mo + Ms > To_) Or ((Ms And 7) <> 0) Then Exit;
      K := E + Off + Mo + 2;
      If Not (((Mem[0:K] = 116) And (Mem[0:K + 1] = 99) And (Mem[0:K + 2] = 112)
              And (Mem[0:K + 3] = 0)) Or ((Mem[0:K] = 117)
              And (Mem[0:K + 1] = 100) And (Mem[0:K + 2] = 112)
              And (Mem[0:K + 3] = 0))) Then
      Begin
        NfCheck := -ENOENT;
        Exit;
      End;
      Mo := Mo + Ms;
    End;
    { cible : standard, ERROR (fin de table) ; filter : REJECT, LOG ;
      nat : SNAT, DNAT, MASQUERADE, REDIRECT }
    Tk := NfTgtKind(E + Off + To_);
    If (Tk < 0) Or ((Tab = 0) And (Tk >= 1) And (Tk <= 4))
       Or ((Tab = 1) And ((Tk = 5) Or (Tk = 6))) Then
    Begin
      NfCheck := -ENOENT;
      Exit;
    End;
    If (Tk >= 1) And (Tk <= 4) And (MemW[0:E + Off + To_] < 32 + 20) Then Exit;
    Off := Off + Nx;
    Inc(N);
  End;
  If (Off <> Size) Or (N <> Num) Then Exit;
  NfCheck := 0;
End;

{ Interface : Pat et Msk (16 octets), Nm : interface du paquet ('' : aucune) }
Function NfIfMatch(Pat, Msk : LongInt; Const Nm : String) : Boolean;
Var I, C : LongInt;
Begin
  NfIfMatch := True;
  For I := 0 To 15 Do
  Begin
    If I < Length(Nm) Then C := Ord(Nm[I + 1]) Else C := 0;
    If ((C Xor Mem[0:Pat + I]) And Mem[0:Msk + I]) <> 0 Then
    Begin
      NfIfMatch := False;
      Exit;
    End;
  End;
End;

Function NfAddrOk(RAddr, RMask, Pkt, Inv : LongInt) : Boolean;
Var Eq : Boolean;
Begin
  Eq := ((Be32(RAddr) Xor Pkt) And Be32(RMask)) = 0;
  If Inv <> 0 Then Eq := Not Eq;
  NfAddrOk := Eq;
End;

{ La regle R (entree ipt_entry) s'applique-t-elle au paquet ? }
Function NfMatch(R, Len, Pr, Hl, Sa, Da, Sp, Dp : LongInt) : Boolean;
Var Tg, Mo, Ms, K, Mt, Inv, V : LongInt; M, Eq : Boolean;
Begin
  Tg := MemW[0:R + 88];
  Inv := Mem[0:R + 83];
  M := NfAddrOk(R, R + 8, Sa, Inv And 8)
      And NfAddrOk(R + 4, R + 12, Da, Inv And $10);
  If M Then
  Begin
    Eq := NfIfMatch(R + 16, R + 48, NfInN);
    If (Inv And 1) <> 0 Then Eq := Not Eq;
    M := Eq;
  End;
  If M Then
  Begin
    Eq := NfIfMatch(R + 32, R + 64, NfOutN);
    If (Inv And 2) <> 0 Then Eq := Not Eq;
    M := Eq;
  End;
  If M And (MemW[0:R + 80] <> 0) Then
  Begin
    Eq := MemW[0:R + 80] = Pr;
    If (Inv And $40) <> 0 Then Eq := Not Eq;
    M := Eq;
  End;
  Mo := NfEntHdr;
  While M And (Mo < Tg) Do
  Begin
    Ms := MemW[0:R + Mo];
    K := R + Mo + 32;
    Mt := Mem[0:R + Mo + 2];                 { 't' ou 'u' }
    If ((Mt = 116) And (Pr <> 6)) Or ((Mt = 117) And (Pr <> 17))
       Or (Len < Hl + 4) Then M := False
    Else
    Begin
      If Mt = 116 Then V := Mem[0:K + 11] Else V := Mem[0:K + 8];
      Eq := (Sp >= MemW[0:K]) And (Sp <= MemW[0:K + 2]);
      If (V And 1) <> 0 Then Eq := Not Eq;
      If Not Eq Then M := False;
      Eq := (Dp >= MemW[0:K + 4]) And (Dp <= MemW[0:K + 6]);
      If (V And 2) <> 0 Then Eq := Not Eq;
      If Not Eq Then M := False;
    End;
    Mo := Mo + Ms;
  End;
  NfMatch := M;
End;

Function NfDotted(A : LongInt) : String;
Begin
  NfDotted := IntStr((A Shr 24) And 255) + '.' + IntStr((A Shr 16) And 255)
      + '.' + IntStr((A Shr 8) And 255) + '.' + IntStr(A And 255);
End;

{ Prefixe de LOG : chaine terminee par un zero (30 octets au plus) }
Function NfPrefix(A : LongInt) : String;
Var I : LongInt; S : String;
Begin
  S := '';
  I := 0;
  While (I < 30) And (Mem[0:A + I] <> 0) Do
  Begin
    S := S + Chr(Mem[0:A + I]);
    Inc(I);
  End;
  NfPrefix := S;
End;

{ Message d'erreur ICMP (Typ, Code) en reponse au paquet IP a Ip ; pas de
  reponse a une erreur ICMP ni a une diffusion }
Procedure IcmpError(Typ, Code, Ip : LongInt);
Var P, Hl, Src : LongInt;
Begin
  Hl := (Mem[0:Ip] And 15) * 4;
  Src := Be32(Ip + 12);
  If (Src = 0) Or (Src = -1) Or ((Src Shr 28) = 14) Or ((Src Shr 28) = 15) Then
    Exit;
  If (Mem[0:Ip + 9] = 1) And (Mem[0:Ip + Hl] <> 8) And (Mem[0:Ip + Hl] <> 0)
    Then Exit;
  P := KMalloc(8 + Hl + 8);
  If P = 0 Then Exit;
  MemFill(P, 0, 8);
  Mem[0:P] := Typ;
  Mem[0:P + 1] := Code;
  MemCopy(P + 8, Ip, Hl + 8);
  PutBe16(P + 2, NetCsum(P, 8 + Hl + 8));
  IpOutput(Src, 1, P, 8 + Hl + 8, False);
  KFree(P);
End;

{ Evalue la chaine Hook de la table filter pour le paquet IP a l'adresse
  Ip (Len octets) ; NfInN et NfOutN donnent les interfaces. Vrai :
  accepter, Faux : jeter (DROP ou REJECT) }
Function NfEval(Hook, Ip, Len : LongInt; Out : Boolean) : Boolean;
Var Off, R, Pr, Hl, K, Sp, Dp, Sa, Da, Nx, Tg, V, Tk, Cd : LongInt;
    Done : Boolean;
Begin
  NfEval := True;
  If (NfRules = 0) Or (Hook < 1) Or (Hook > 3) Then Exit;
  Pr := Mem[0:Ip + 9];
  Hl := (Mem[0:Ip] And 15) * 4;
  Sa := Be32(Ip + 12);
  Da := Be32(Ip + 16);
  Sp := 0; Dp := 0;
  If (Len >= Hl + 4) And ((Pr = 6) Or (Pr = 17)) Then
  Begin
    Sp := (Mem[0:Ip + Hl] Shl 8) Or Mem[0:Ip + Hl + 1];
    Dp := (Mem[0:Ip + Hl + 2] Shl 8) Or Mem[0:Ip + Hl + 3];
  End;
  Off := NfHook[Hook];
  Done := False;
  While (Not Done) And (Off >= 0) And (Off < NfSize) Do
  Begin
    R := LongInt(@NfBlob[0]) + Off;
    Nx := MemW[0:R + 90];
    Tg := MemW[0:R + 88];
    If NfMatch(R, Len, Pr, Hl, Sa, Da, Sp, Dp) Then
    Begin
      K := R + Tg;
      MemL[0:R + 96] := MemL[0:R + 96] + 1;
      MemL[0:R + 104] := MemL[0:R + 104] + Len;
      Tk := NfTgtKind(K);
      If Tk = 0 Then
      Begin
        V := MemL[0:K + 32];
        If V = -1 Then
        Begin
          NfEval := False;
          Inc(NfDrops);
          Done := True;
        End
        Else If V = -2 Then Done := True;
      End
      Else If Tk = 6 Then                       { LOG : on continue }
        KLog(NfPrefix(K + 34) + ' IN=' + NfInN + ' OUT=' + NfOutN + ' SRC='
            + NfDotted(Sa) + ' DST=' + NfDotted(Da) + ' PROTO=' + IntStr(Pr))
      Else If Tk = 5 Then                       { REJECT }
      Begin
        NfEval := False;
        Inc(NfDrops);
        Done := True;
        Case MemL[0:K + 32] Of
          0 : Cd := 0;
          1 : Cd := 1;
          2 : Cd := 2;
          5 : Cd := 9;
          6 : Cd := 10;
          8 : Cd := 13;
        Else
          Cd := 3;
        End;
        IcmpError(3, Cd, Ip);
      End;
    End;
    Off := Off + Nx;
    If Nx = 0 Then Done := True;
  End;
End;

{ ---- suivi de connexions et NAT (table nat) ---- }

Function CtFind(Pr, S, D, Sp, Dp : LongInt; Var Dir : LongInt) : LongInt;
Var I : LongInt;
Begin
  CtFind := -1;
  For I := 0 To CtMax - 1 Do
    If CtUsed[I] <> 0 Then
    Begin
      If Jiffies - CtAge[I] > CtLife Then
      Begin
        CtUsed[I] := 0;
        Dec(CtCount);
      End
      Else If CtProto[I] = Pr Then
      Begin
        If (CtOs[I] = S) And (CtOd[I] = D) And (CtOsp[I] = Sp)
           And (CtOdp[I] = Dp) Then
        Begin
          Dir := 0;
          CtFind := I;
          Exit;
        End;
        If (CtRs[I] = S) And (CtRd[I] = D) And (CtRsp[I] = Sp)
           And (CtRdp[I] = Dp) Then
        Begin
          Dir := 1;
          CtFind := I;
          Exit;
        End;
      End;
    End;
End;

Function CtNew(Pr, S, D, Sp, Dp : LongInt) : LongInt;
Var I, K : LongInt;
Begin
  K := 0;
  For I := 0 To CtMax - 1 Do
    If CtUsed[I] = 0 Then
    Begin
      K := I;
      Break;
    End
    Else If Jiffies - CtAge[I] > Jiffies - CtAge[K] Then K := I;
  If CtUsed[K] = 0 Then Inc(CtCount);
  CtUsed[K] := 1; CtProto[K] := Pr;
  CtOs[K] := S; CtOd[K] := D; CtOsp[K] := Sp; CtOdp[K] := Dp;
  CtRs[K] := D; CtRd[K] := S; CtRsp[K] := Dp; CtRdp[K] := Sp;
  CtAge[K] := Jiffies; CtDn[K] := 0; CtSn[K] := 0;
  CtNew := K;
End;

{ Premiere regle de la table nat qui s'applique pour le point d'accroche
  Hook ; code de la cible (1 SNAT, 2 DNAT, 3 MASQUERADE, 4 REDIRECT), 0 si
  aucune ; NatData : donnees de la cible (nf_nat_ipv4_multi_range_compat :
  rangesize, flags, min_ip, max_ip, min, max) }
Function NatMatch(Hook, Ip, Len : LongInt) : LongInt;
Var Off, R, Pr, Hl, K, Sp, Dp, Tk : LongInt; Done : Boolean;
Begin
  NatMatch := 0;
  If (NtRules = 0) Or (Hook < 0) Or (Hook > 4) Then Exit;
  Pr := Mem[0:Ip + 9];
  Hl := (Mem[0:Ip] And 15) * 4;
  Sp := 0; Dp := 0;
  If (Len >= Hl + 4) And ((Pr = 6) Or (Pr = 17)) Then
  Begin
    Sp := (Mem[0:Ip + Hl] Shl 8) Or Mem[0:Ip + Hl + 1];
    Dp := (Mem[0:Ip + Hl + 2] Shl 8) Or Mem[0:Ip + Hl + 3];
  End;
  Off := NtHook[Hook];
  Done := False;
  While (Not Done) And (Off >= 0) And (Off < NtSize) Do
  Begin
    R := LongInt(@NtBlob[0]) + Off;
    If NfMatch(R, Len, Pr, Hl, Be32(Ip + 12), Be32(Ip + 16), Sp, Dp) Then
    Begin
      K := R + MemW[0:R + 88];
      MemL[0:R + 96] := MemL[0:R + 96] + 1;
      MemL[0:R + 104] := MemL[0:R + 104] + Len;
      Tk := NfTgtKind(K);
      If (Tk >= 1) And (Tk <= 4) Then
      Begin
        NatData := K + 32;
        NatMatch := Tk;
        Done := True;
      End
      Else If (Tk = 0) And (MemL[0:K + 32] = -2) Then Done := True;
    End;
    If MemW[0:R + 90] = 0 Then Done := True;
    Off := Off + MemW[0:R + 90];
  End;
End;

{ Sommes de controle apres modification d'adresses ou de ports }
Procedure CtFixSums(Ip : LongInt);
Var Hl, Pr, T, Tl, Sum : LongInt; Pse : Array[0..11] Of Byte;
Begin
  Hl := (Mem[0:Ip] And 15) * 4;
  PutBe16(Ip + 10, 0);
  PutBe16(Ip + 10, NetCsum(Ip, Hl));
  Pr := Mem[0:Ip + 9];
  Tl := Be16(Ip + 2) - Hl;
  If Tl < 8 Then Exit;
  If (Pr = 17) And (Be16(Ip + Hl + 6) = 0) Then Exit;
  If Pr = 6 Then T := 16 Else If Pr = 17 Then T := 6 Else T := 2;
  PutBe16(Ip + Hl + T, 0);
  If Pr = 1 Then
  Begin
    PutBe16(Ip + Hl + 2, NetCsum(Ip + Hl, Tl));
    Exit;
  End;
  PutBe32(LongInt(@Pse[0]), Be32(Ip + 12));
  PutBe32(LongInt(@Pse[4]), Be32(Ip + 16));
  Pse[8] := 0; Pse[9] := Pr; PutBe16(LongInt(@Pse[10]), Tl);
  Sum := (Not NetSum(Ip + Hl, Tl, NetSum(LongInt(@Pse[0]), 12, 0))) And $FFFF;
  If (Pr = 17) And (Sum = 0) Then Sum := $FFFF;
  PutBe16(Ip + Hl + T, Sum);
End;

{ Remplace l'adresse (Off 12 : source, 16 : destination) et le port }
Procedure CtSet(Ip, Off, Addr, Port : LongInt);
Var Hl, Pr : LongInt;
Begin
  Hl := (Mem[0:Ip] And 15) * 4;
  Pr := Mem[0:Ip + 9];
  PutBe32(Ip + Off, Addr);
  If (Pr = 6) Or (Pr = 17) Then PutBe16(Ip + Hl + (Off - 12) Div 2, Port)
  Else If Pr = 1 Then PutBe16(Ip + Hl + 4, Port);
  CtFixSums(Ip);
End;

{ Port de reponse libre pour la traduction de la source }
Function CtFreePort(I, Pr, A, P : LongInt) : LongInt;
Var K, Dir, T : LongInt;
Begin
  T := P;
  K := 0;
  While (K < 4000) And (CtFind(Pr, CtRs[I], A, CtRsp[I], T, Dir) >= 0) Do
  Begin
    T := 32768 + (T + 1 + K) Mod 28000;
    Inc(K);
  End;
  CtFreePort := T;
End;

{ Traduction d'adresses : Hook 0 (PREROUTING) et 3 (OUTPUT) traduisent la
  destination, 4 (POSTROUTING) la source. Un paquet de reponse est remis en
  etat d'origine. Les nouvelles connexions sont creees en 0 et 3 ; l'entree
  du paquet courant est gardee dans CtCur entre 0/3 et 4. }
Procedure NatHook(Hook, Ip, Len : LongInt);
Var Pr, Hl, S, D, Sp, Dp, I, Dir, Tg, NewA, NewP, Fl : LongInt;
Begin
  If (Hook = 0) Or (Hook = 3) Then CtCur := -1;
  If (NtRules = 0) And (CtCount = 0) Then Exit;
  Pr := Mem[0:Ip + 9];
  Hl := (Mem[0:Ip] And 15) * 4;
  If (Be16(Ip + 6) And $3FFF) <> 0 Then Exit;
  S := Be32(Ip + 12);
  D := Be32(Ip + 16);
  If ((Pr = 6) Or (Pr = 17)) And (Len >= Hl + 8) Then
  Begin
    Sp := Be16(Ip + Hl);
    Dp := Be16(Ip + Hl + 2);
  End
  Else If (Pr = 1) And (Len >= Hl + 8)
          And ((Mem[0:Ip + Hl] = 8) Or (Mem[0:Ip + Hl] = 0)) Then
  Begin
    Sp := Be16(Ip + Hl + 4);
    Dp := Sp;
  End
  Else Exit;
  If (Hook = 4) Or (Hook = 1) Then
  Begin
    I := CtCur;
    Dir := CtCurDir;
    If I < 0 Then Exit;
  End
  Else
  Begin
    I := CtFind(Pr, S, D, Sp, Dp, Dir);
    If (I < 0) And (NtRules > 0) Then
    Begin
      I := CtNew(Pr, S, D, Sp, Dp);
      Dir := 0;
      Tg := NatMatch(Hook, Ip, Len);
      If (Tg = 2) Or (Tg = 4) Then
      Begin
        Fl := MemL[0:NatData + 4];
        If Tg = 4 Then NewA := SrcFor(S)
        Else If (Fl And 1) <> 0 Then NewA := Be32(NatData + 8)
        Else NewA := D;
        If (Fl And 2) <> 0 Then NewP := Be16(NatData + 16) Else NewP := Dp;
        CtRs[I] := NewA;
        CtRsp[I] := NewP;
        CtDn[I] := 1;
      End;
    End;
    If I < 0 Then Exit;
    CtCur := I;
    CtCurDir := Dir;
  End;
  CtAge[I] := Jiffies;
  If (Hook = 0) Or (Hook = 3) Then
  Begin
    If Dir = 0 Then
    Begin
      NewA := CtRs[I]; NewP := CtRsp[I];
    End
    Else
    Begin
      NewA := CtOs[I]; NewP := CtOsp[I];
    End;
    If (NewA <> D) Or (NewP <> Dp) Then CtSet(Ip, 16, NewA, NewP);
  End
  Else
  Begin
    S := Be32(Ip + 12);
    If (Hook = 4) And (Dir = 0) And (CtSn[I] = 0) Then
    Begin
      CtSn[I] := 1;
      Tg := NatMatch(4, Ip, Len);
      If (Tg = 1) Or (Tg = 3) Then
      Begin
        Fl := MemL[0:NatData + 4];
        If (Tg = 1) And ((Fl And 1) <> 0) Then NewA := Be32(NatData + 8)
        Else If Tg = 3 Then NewA := SrcFor(D)
        Else NewA := S;
        If (Fl And 2) <> 0 Then NewP := Be16(NatData + 16) Else NewP := Sp;
        NewP := CtFreePort(I, Pr, NewA, NewP);
        CtRd[I] := NewA;
        CtRdp[I] := NewP;
      End;
    End;
    If Dir = 0 Then
    Begin
      NewA := CtRd[I]; NewP := CtRdp[I];
    End
    Else
    Begin
      NewA := CtOd[I]; NewP := CtOdp[I];
    End;
    If (NewA <> S) Or (NewP <> Sp) Then CtSet(Ip, 12, NewA, NewP);
  End;
End;

{ Compte les regles utilisateur (entrees hors politiques et ERROR) }
Function NfCountRules(Tab : LongInt) : LongInt;
Var Off, N, E, I, Un, Sz, Base, Vd : LongInt;
Begin
  N := 0; Off := 0;
  If Tab = 0 Then
  Begin
    Sz := NfSize; Base := LongInt(@NfBlob[0]); Vd := NfValid;
  End
  Else
  Begin
    Sz := NtSize; Base := LongInt(@NtBlob[0]); Vd := NtValid;
  End;
  While Off < Sz Do
  Begin
    E := Base + Off;
    Un := 0;
    For I := 0 To 4 Do
      If ((Vd Shr I) And 1) <> 0 Then
        If ((Tab = 0) And (NfUnder[I] = Off))
           Or ((Tab = 1) And (NtUnder[I] = Off)) Then Un := 1;
    If (Un = 0) And (NfTgtKind(E + MemW[0:E + 88]) <> 7) Then Inc(N);
    Off := Off + MemW[0:E + 90];
  End;
  NfCountRules := N;
End;

{ Table nommee a Val : 0 filter, 1 nat, -1 inconnue }
Function NfTabOf(Val : LongInt) : LongInt;
Begin
  NfTabOf := -1;
  If (Mem[0:Val] = 102) And (Mem[0:Val + 1] = 105) And (Mem[0:Val + 2] = 108)
     And (Mem[0:Val + 3] = 116) And (Mem[0:Val + 4] = 101)
     And (Mem[0:Val + 5] = 114) And (Mem[0:Val + 6] = 0) Then NfTabOf := 0
  Else If (Mem[0:Val] = 110) And (Mem[0:Val + 1] = 97)
     And (Mem[0:Val + 2] = 116) And (Mem[0:Val + 3] = 0) Then NfTabOf := 1;
End;

{ setsockopt(SOL_IP) : SET_REPLACE (64), SET_ADD_COUNTERS (65, ignore) }
Function NfSetsockopt(Opt, Val, Len : LongInt) : LongInt;
Var Sz, Num, I, R, Tab : LongInt;
Begin
  If Cur^.Euid <> 0 Then
  Begin
    NfSetsockopt := -EPERM;
    Exit;
  End;
  If Opt = 65 Then
  Begin
    NfSetsockopt := 0;
    Exit;
  End;
  If (Opt <> 64) Or (Len < 92) Or (Not EnsureUser(Val, Len, False)) Then
  Begin
    NfSetsockopt := -EINVAL;
    Exit;
  End;
  Tab := NfTabOf(Val);
  If Tab < 0 Then
  Begin
    NfSetsockopt := -ENOENT;                    { tables filter et nat }
    Exit;
  End;
  Num := MemL[0:Val + 36];
  Sz := MemL[0:Val + 40];
  If (Sz <= 0) Or (Sz > NfMaxSz) Or (Len < 92 + Sz) Or (Num <= 0) Then
  Begin
    NfSetsockopt := -EINVAL;
    Exit;
  End;
  R := NfCheck(Val + 92, Sz, Num, Tab);
  If R <> 0 Then
  Begin
    NfSetsockopt := R;
    Exit;
  End;
  If Tab = 0 Then
  Begin
    MemCopy(LongInt(@NfBlob[0]), Val + 92, Sz);
    NfSize := Sz; NfNum := Num; NfValid := MemL[0:Val + 32];
    For I := 0 To 4 Do
    Begin
      NfHook[I] := MemL[0:Val + 44 + I * 4];
      NfUnder[I] := MemL[0:Val + 64 + I * 4];
    End;
    NfRules := NfCountRules(0);
  End
  Else
  Begin
    MemCopy(LongInt(@NtBlob[0]), Val + 92, Sz);
    NtSize := Sz; NtNum := Num; NtValid := MemL[0:Val + 32];
    For I := 0 To 4 Do
    Begin
      NtHook[I] := MemL[0:Val + 44 + I * 4];
      NtUnder[I] := MemL[0:Val + 64 + I * 4];
    End;
    NtRules := NfCountRules(1);
  End;
  NfSetsockopt := 0;
End;

{ getsockopt(SOL_IP) : GET_INFO (64), GET_ENTRIES (65), revisions (66, 67) }
Function NfGetsockopt(Opt, Val, Len : LongInt) : LongInt;
Var I, Want, Tab : LongInt;
Begin
  NfGetsockopt := -EINVAL;
  If Cur^.Euid <> 0 Then
  Begin
    NfGetsockopt := -EPERM;
    Exit;
  End;
  If (Opt = 66) Or (Opt = 67) Then
  Begin
    If (Len >= 30) And EnsureUser(Val, 30, True) Then
    Begin
      Mem[0:Val + 29] := 0;                     { revision 0 }
      NfGetsockopt := 0;
    End;
    Exit;
  End;
  If Opt = 64 Then
  Begin
    If (Len < 84) Or Not EnsureUser(Val, 84, True) Then Exit;
    Tab := NfTabOf(Val);
    If Tab < 0 Then
    Begin
      NfGetsockopt := -ENOENT;
      Exit;
    End;
    If Tab = 0 Then
    Begin
      MemL[0:Val + 32] := NfValid;
      For I := 0 To 4 Do
      Begin
        MemL[0:Val + 36 + I * 4] := NfHook[I];
        MemL[0:Val + 56 + I * 4] := NfUnder[I];
      End;
      MemL[0:Val + 76] := NfNum;
      MemL[0:Val + 80] := NfSize;
    End
    Else
    Begin
      MemL[0:Val + 32] := NtValid;
      For I := 0 To 4 Do
      Begin
        MemL[0:Val + 36 + I * 4] := NtHook[I];
        MemL[0:Val + 56 + I * 4] := NtUnder[I];
      End;
      MemL[0:Val + 76] := NtNum;
      MemL[0:Val + 80] := NtSize;
    End;
    NfGetsockopt := 0;
    Exit;
  End;
  If Opt = 65 Then
  Begin
    If (Len < 36) Or Not EnsureUser(Val, Len, True) Then Exit;
    Tab := NfTabOf(Val);
    If Tab < 0 Then
    Begin
      NfGetsockopt := -ENOENT;
      Exit;
    End;
    Want := MemL[0:Val + 32];
    If Tab = 0 Then
    Begin
      If (Want <> NfSize) Or (Len < 36 + NfSize) Then Exit;
      MemCopy(Val + 36, LongInt(@NfBlob[0]), NfSize);
    End
    Else
    Begin
      If (Want <> NtSize) Or (Len < 36 + NtSize) Then Exit;
      MemCopy(Val + 36, LongInt(@NtBlob[0]), NtSize);
    End;
    NfGetsockopt := 0;
  End;
End;

{ ---- tun/tap (/dev/net/tun), routage et retransmission IPv4 (D7-3) ----
  Interfaces : 0 = eth0 (carte), k + 1 = tun/tap numero k (2 au plus).
  tap : trames Ethernet (ARP compris) lues et ecrites par le programme ;
  tun : paquets IP seuls (un en-tete Ethernet est ajoute et retire).
  Le noyau route d'apres les sous-reseaux des interfaces (sur le lien) puis
  passe par la passerelle d'eth0 ; net.ipv4.ip_forward autorise la
  retransmission d'une interface a l'autre (chaine FORWARD de netfilter). }

Const
  TunMax = 2; TunQMax = 16;

Var
  SyIpForward : LongInt;
  TunUsed, TunMode, TunPi, TunIp, TunMask, TunUp, TunQH,
    TunQN, TunTxPk, TunRxPk : Array[0..TunMax - 1] Of LongInt;
  TunNm : Array[0..TunMax * 16 - 1] Of Byte;
  TunMac : Array[0..TunMax * 6 - 1] Of Byte;
  TunQ, TunQL : Array[0..TunMax * TunQMax - 1] Of LongInt;
  TunWchan : LongInt;
  TunFOps : Array[0..15] Of LongInt;

Procedure NetInputIf(Ifc, Frame, Len : LongInt); Forward;

Function IfName(Ifc : LongInt) : String;
Var I, K : LongInt; S : String;
Begin
  S := '';
  If Ifc = 0 Then S := 'eth0'
  Else
  Begin
    K := (Ifc - 1) * 16;
    I := 0;
    While (I < 16) And (TunNm[K + I] <> 0) Do
    Begin
      S := S + Chr(TunNm[K + I]);
      Inc(I);
    End;
  End;
  IfName := S;
End;

{ Interface qui porte Dst : tun/tap dont le sous-reseau contient Dst, sinon
  eth0 ; -1 si rien }
Function RouteIf(Dst : LongInt) : LongInt;
Var K, R : LongInt;
Begin
  R := -1;
  For K := 0 To TunMax - 1 Do
    If (TunUsed[K] <> 0) And (TunUp[K] <> 0) And (TunMask[K] <> 0)
       And (((Dst Xor TunIp[K]) And TunMask[K]) = 0) And (R < 0) Then
      R := K + 1;
  If (R < 0) And NicUp And NetPresent Then R := 0;
  RouteIf := R;
End;

{ Adresse source d'un paquet emis vers Dst }
Function SrcFor(Dst : LongInt) : LongInt;
Var R : LongInt;
Begin
  R := RouteIf(Dst);
  If R > 0 Then SrcFor := TunIp[R - 1] Else SrcFor := NicIp;
End;

{ Le paquet est-il pour nous (adresse d'une interface ou diffusion) ? }
Function IpIsLocal(Dst : LongInt) : Boolean;
Var K : LongInt; R : Boolean;
Begin
  R := (Dst = -1) Or (NicIp = 0) Or (Dst = NicIp)
      Or ((Dst Or Not NicMask) = -1);
  For K := 0 To TunMax - 1 Do
    If (TunUsed[K] <> 0) And (TunUp[K] <> 0) And (TunIp[K] <> 0) Then
      If (Dst = TunIp[K]) Or ((Dst Or Not TunMask[K]) = -1) Then R := True;
  IpIsLocal := R;
End;

Procedure TunQueue(K, Frame, Len : LongInt);
Var P, Ix : LongInt;
Begin
  If TunQN[K] >= TunQMax Then Exit;
  P := KMalloc(Len);
  If P = 0 Then Exit;
  MemCopy(P, Frame, Len);
  Ix := K * TunQMax + (TunQH[K] + TunQN[K]) Mod TunQMax;
  TunQ[Ix] := P;
  TunQL[Ix] := Len;
  TunQN[K] := TunQN[K] + 1;
  TunTxPk[K] := TunTxPk[K] + 1;
  WakeUp(LongInt(@TunWchan));
End;

Procedure TunArpFrame(K, Op, DstMac, DstIp : LongInt);
Var F : Array[0..59] Of Byte; A : LongInt;
Begin
  A := LongInt(@F[0]);
  MemFill(A, 0, 60);
  If Op = 1 Then MemFill(A, $FF, 6) Else MemCopy(A, DstMac, 6);
  MemCopy(A + 6, LongInt(@TunMac[K * 6]), 6);
  PutBe16(A + 12, EtherArp);
  PutBe16(A + 14, 1); PutBe16(A + 16, EtherIp);
  Mem[0:A + 18] := 6; Mem[0:A + 19] := 4;
  PutBe16(A + 20, Op);
  MemCopy(A + 22, LongInt(@TunMac[K * 6]), 6);
  PutBe32(A + 28, TunIp[K]);
  If Op = 2 Then MemCopy(A + 32, DstMac, 6);
  PutBe32(A + 38, DstIp);
  TunQueue(K, A, 60);
End;

Procedure TunArpInput(K, A, Len : LongInt);
Begin
  If Len < 42 Then Exit;
  ArpLearn(Be32(A + 28), A + 22);
  If (Be16(A + 20) = 1) And (Be32(A + 38) = TunIp[K]) And (TunIp[K] <> 0) Then
    TunArpFrame(K, 2, A + 22, Be32(A + 28));
End;

Function TunResolve(K, Dst : LongInt; Wait : Boolean; Mac : LongInt) : LongInt;
Var I, T : LongInt;
Begin
  TunResolve := 0;
  If TunMode[K] = 2 Then
  Begin
    MemCopy(Mac, LongInt(@TunMac[K * 6]), 6);
    Exit;
  End;
  If (Dst Or Not TunMask[K]) = -1 Then
  Begin
    MemFill(Mac, $FF, 6);
    Exit;
  End;
  I := ArpFind(Dst);
  If I >= 0 Then
  Begin
    MemCopy(Mac, LongInt(@ArpMac[I * 6]), 6);
    Exit;
  End;
  TunArpFrame(K, 1, 0, Dst);
  If Not Wait Then
  Begin
    TunResolve := -EAGAIN;
    Exit;
  End;
  For T := 1 To 100 Do
  Begin
    SleepTicks(1);
    I := ArpFind(Dst);
    If I >= 0 Then
    Begin
      MemCopy(Mac, LongInt(@ArpMac[I * 6]), 6);
      Exit;
    End;
  End;
  TunResolve := -EHOSTUNREACH_;
End;

{ Retransmet la trame Ethernet Frame (paquet IP de Tot octets) recue sur
  InIf vers l'interface qui porte sa destination }
Procedure ForwardIp(InIf, Frame, Tot : LongInt);
Var Dst, Ifc, R, Ttl : LongInt; Mac : Array[0..5] Of Byte;
Begin
  If SyIpForward = 0 Then Exit;
  Ttl := Mem[0:Frame + 22];
  If Ttl <= 1 Then
  Begin
    IcmpError(11, 0, Frame + 14);               { TTL expire en transit }
    Exit;
  End;
  Dst := Be32(Frame + 30);
  Ifc := RouteIf(Dst);
  If Ifc < 0 Then
  Begin
    IcmpError(3, 0, Frame + 14);
    Exit;
  End;
  NfInN := IfName(InIf);
  NfOutN := IfName(Ifc);
  If Not NfEval(2, Frame + 14, Tot, False) Then Exit;
  If Ifc = 0 Then R := NetResolve(Dst, False, LongInt(@Mac[0]))
  Else R := TunResolve(Ifc - 1, Dst, False, LongInt(@Mac[0]));
  If R <> 0 Then Exit;
  Mem[0:Frame + 22] := Ttl - 1;
  PutBe16(Frame + 24, 0);
  PutBe16(Frame + 24, NetCsum(Frame + 14, (Mem[0:Frame + 14] And 15) * 4));
  NatHook(4, Frame + 14, Tot);                  { POSTROUTING }
  MemCopy(Frame, LongInt(@Mac[0]), 6);
  If Ifc = 0 Then
  Begin
    MemCopy(Frame + 6, LongInt(@NicMac[0]), 6);
    NicSend(Frame, 14 + Tot);
  End
  Else
  Begin
    MemCopy(Frame + 6, LongInt(@TunMac[(Ifc - 1) * 6]), 6);
    TunQueue(Ifc - 1, Frame, 14 + Tot);
  End;
End;

{ ---- /dev/net/tun ---- }

Function TunOpen(I : PInode; F : PFile) : LongInt;
Begin
  F^.Priv := 0;
  TunOpen := 0;
End;

Procedure TunFreeQ(K : LongInt);
Var Ix : LongInt;
Begin
  While TunQN[K] > 0 Do
  Begin
    Ix := K * TunQMax + TunQH[K];
    KFree(TunQ[Ix]);
    TunQH[K] := (TunQH[K] + 1) Mod TunQMax;
    TunQN[K] := TunQN[K] - 1;
  End;
End;

Procedure TunRelease(F : PFile);
Var K : LongInt;
Begin
  K := F^.Priv - 1;
  If (K < 0) Or (K >= TunMax) Then Exit;
  TunFreeQ(K);
  TunUsed[K] := 0;
  TunUp[K] := 0;
  TunIp[K] := 0;
  TunMask[K] := 0;
  F^.Priv := 0;
End;

{ TUNSETIFF : ifreq {nom[16], drapeaux} ; nom vide ou "tap%d"/"tun%d" }
Function TunSetIff(F : PFile; Arg : LongInt) : LongInt;
Var Fl, K, I, N : LongInt; Pre : String;
Begin
  TunSetIff := -EINVAL;
  If Not EnsureUser(Arg, 40, True) Then
  Begin
    TunSetIff := -EFAULT;
    Exit;
  End;
  If Not Capable(12) Then
  Begin
    TunSetIff := -EPERM;
    Exit;
  End;
  If F^.Priv <> 0 Then
  Begin
    TunSetIff := -EBUSY;
    Exit;
  End;
  Fl := MemW[0:Arg + 16];
  If ((Fl And 3) <> 1) And ((Fl And 3) <> 2) Then Exit;
  If (Fl And 3) = 2 Then Pre := 'tap' Else Pre := 'tun';
  K := -1;
  For I := 0 To TunMax - 1 Do
    If (TunUsed[I] = 0) And (K < 0) Then K := I;
  If K < 0 Then
  Begin
    TunSetIff := -EBUSY;
    Exit;
  End;
  MemFill(LongInt(@TunNm[K * 16]), 0, 16);
  { le nom demande est ignore s'il est vide ou un modele ; sinon il est
    garde (15 caracteres) }
  N := 0;
  While (N < 15) And (Mem[0:Arg + N] <> 0) And (Mem[0:Arg + N] <> 37) Do
  Begin
    TunNm[K * 16 + N] := Mem[0:Arg + N];
    Inc(N);
  End;
  If (N = 0) Or (Mem[0:Arg + N] = 37) Then
  Begin
    MemFill(LongInt(@TunNm[K * 16]), 0, 16);
    For I := 1 To 3 Do TunNm[K * 16 + I - 1] := Ord(Pre[I]);
    TunNm[K * 16 + 3] := 48 + K;
  End;
  For I := 0 To TunMax - 1 Do
    If (I <> K) And (TunUsed[I] <> 0) Then
      If MemCmp(LongInt(@TunNm[K * 16]), LongInt(@TunNm[I * 16]), 16) = 0 Then
      Begin
        MemFill(LongInt(@TunNm[K * 16]), 0, 16);
        TunSetIff := -EBUSY;
        Exit;
      End;
  MemFill(Arg, 0, 16);
  MemCopy(Arg, LongInt(@TunNm[K * 16]), 16);
  TunUsed[K] := 1;
  If (Fl And 3) = 2 Then TunMode[K] := 1 Else TunMode[K] := 2;
  If (Fl And $1000) <> 0 Then TunPi[K] := 0 Else TunPi[K] := 1;
  TunUp[K] := 0; TunIp[K] := 0; TunMask[K] := 0;
  TunQH[K] := 0; TunQN[K] := 0;
  Mem[0:LongInt(@TunMac[K * 6])] := $FE;
  Mem[0:LongInt(@TunMac[K * 6]) + 1] := 0;
  Mem[0:LongInt(@TunMac[K * 6]) + 2] := 0;
  Mem[0:LongInt(@TunMac[K * 6]) + 3] := 0;
  Mem[0:LongInt(@TunMac[K * 6]) + 4] := 1;
  Mem[0:LongInt(@TunMac[K * 6]) + 5] := K + 1;
  F^.Priv := K + 1;
  TunSetIff := 0;
End;

Function TunIoctl(F : PFile; Cmd, Arg : LongInt) : LongInt;
Var K : LongInt;
Begin
  TunIoctl := -ENOTTY;
  K := F^.Priv - 1;
  Case Cmd Of
    $400454CA : TunIoctl := TunSetIff(F, Arg);              { TUNSETIFF }
    $800454D2 :                                             { TUNGETIFF }
      Begin
        If (K < 0) Or Not EnsureUser(Arg, 40, True) Then
        Begin
          TunIoctl := -EBADF;
          Exit;
        End;
        MemFill(Arg, 0, 40);
        MemCopy(Arg, LongInt(@TunNm[K * 16]), 16);
        MemW[0:Arg + 16] := TunMode[K] Or (1 - TunPi[K]) * $1000;
        TunIoctl := 0;
      End;
    $400454CB, $400454CC, $400454CD, $400454D0, $400454D3 : TunIoctl := 0;
  End;
End;

Function TunRead(F : PFile; Buf, Cnt : LongInt) : LongInt;
Var K, Ix, P, L, Sk, Off, N, Et : LongInt;
Begin
  K := F^.Priv - 1;
  If (K < 0) Or (K >= TunMax) Then
  Begin
    TunRead := -EBADF;
    Exit;
  End;
  While TunQN[K] = 0 Do
  Begin
    If (F^.Flags And O_NONBLOCK) <> 0 Then
    Begin
      TunRead := -EAGAIN;
      Exit;
    End;
    If SleepOn(LongInt(@TunWchan), 0, True) = WakeSignal Then
    Begin
      TunRead := -ERESTARTSYS;
      Exit;
    End;
  End;
  If Not EnsureUser(Buf, Cnt, True) Then
  Begin
    TunRead := -EFAULT;
    Exit;
  End;
  Ix := K * TunQMax + TunQH[K];
  P := TunQ[Ix];
  L := TunQL[Ix];
  Et := Be16(P + 12);
  If TunMode[K] = 2 Then Sk := 14 Else Sk := 0;
  Off := 0;
  If TunPi[K] <> 0 Then
  Begin
    If Cnt < 4 Then
    Begin
      TunRead := -EINVAL;
      Exit;
    End;
    MemW[0:Buf] := 0;
    Mem[0:Buf + 2] := (Et Shr 8) And $FF;
    Mem[0:Buf + 3] := Et And $FF;
    Off := 4;
  End;
  N := L - Sk;
  If N > Cnt - Off Then N := Cnt - Off;
  MemCopy(Buf + Off, P + Sk, N);
  KFree(P);
  TunQH[K] := (TunQH[K] + 1) Mod TunQMax;
  TunQN[K] := TunQN[K] - 1;
  TunRead := N + Off;
End;

Function TunWrite(F : PFile; Buf, Cnt : LongInt) : LongInt;
Var K, Off, Len, P, Tot : LongInt;
Begin
  K := F^.Priv - 1;
  If (K < 0) Or (K >= TunMax) Then
  Begin
    TunWrite := -EBADF;
    Exit;
  End;
  If Not EnsureUser(Buf, Cnt, False) Then
  Begin
    TunWrite := -EFAULT;
    Exit;
  End;
  Off := 0;
  If TunPi[K] <> 0 Then Off := 4;
  Len := Cnt - Off;
  If (Len < 20) Or (Len > 1514) Then
  Begin
    TunWrite := -EINVAL;
    Exit;
  End;
  P := KMalloc(Len + 14);
  If P = 0 Then
  Begin
    TunWrite := -ENOMEM;
    Exit;
  End;
  If TunMode[K] = 1 Then
  Begin
    MemCopy(P, Buf + Off, Len);
    Tot := Len;
  End
  Else
  Begin
    If (Mem[0:Buf + Off] Shr 4) <> 4 Then
    Begin
      KFree(P);
      TunWrite := Cnt;
      Exit;
    End;
    MemCopy(P, LongInt(@TunMac[K * 6]), 6);
    MemFill(P + 6, 0, 6);
    Mem[0:P + 11] := $77;
    PutBe16(P + 12, EtherIp);
    MemCopy(P + 14, Buf + Off, Len);
    Tot := Len + 14;
  End;
  TunRxPk[K] := TunRxPk[K] + 1;
  If TunUp[K] <> 0 Then NetInputIf(K + 1, P, Tot);
  KFree(P);
  TunWrite := Cnt;
End;

Function TunPoll(F : PFile; Ev : LongInt) : LongInt;
Var K : LongInt;
Begin
  K := F^.Priv - 1;
  TunPoll := POLLOUT;
  If (K >= 0) And (K < TunMax) Then
    If TunQN[K] > 0 Then TunPoll := POLLIN Or POLLOUT;
End;

Function MiscTunOps : LongInt;
Begin
  MiscTunOps := LongInt(@TunFOps[0]);
End;

Procedure TunInit;
Begin
  MemFill(LongInt(@TunFOps[0]), 0, SizeOf(TunFOps));
  TunFOps[FoRead] := LongInt(@TunRead);
  TunFOps[FoWrite] := LongInt(@TunWrite);
  TunFOps[FoIoctl] := LongInt(@TunIoctl);
  TunFOps[FoPoll] := LongInt(@TunPoll);
  TunFOps[FoOpen] := LongInt(@TunOpen);
  TunFOps[FoRelease] := LongInt(@TunRelease);
End;

Function IpOutput(Dst, Proto, Pay, Plen : LongInt; Wait : Boolean) : LongInt;
Var F, R, Ifc : LongInt; Mac : Array[0..5] Of Byte;
Begin
  Ifc := RouteIf(Dst);
  If Ifc < 0 Then
  Begin
    IpOutput := -ENETUNREACH;
    Exit;
  End;
  If Plen + 20 > NetMtu Then
  Begin
    IpOutput := -EMSGSIZE;
    Exit;
  End;
  F := KMalloc(14 + 20 + Plen);
  If F = 0 Then
  Begin
    IpOutput := -ENOMEM;
    Exit;
  End;
  PutBe16(F + 12, EtherIp);
  Mem[0:F + 14] := $45; Mem[0:F + 15] := 0;
  PutBe16(F + 16, 20 + Plen);
  Inc(IpId);
  PutBe16(F + 18, IpId And $FFFF);
  PutBe16(F + 20, $4000);                   { DF }
  If (SysIpTtl >= 1) And (SysIpTtl <= 255) Then Mem[0:F + 22] := SysIpTtl
  Else Mem[0:F + 22] := 64;
  Mem[0:F + 23] := Proto;
  PutBe16(F + 24, 0);
  If Ifc = 0 Then PutBe32(F + 26, NicIp)
  Else PutBe32(F + 26, TunIp[Ifc - 1]);
  PutBe32(F + 30, Dst);
  PutBe16(F + 24, NetCsum(F + 14, 20));
  MemCopy(F + 34, Pay, Plen);
  NfInN := '';
  NfOutN := IfName(Ifc);
  NatHook(3, F + 14, 20 + Plen);                       { OUTPUT : nat }
  If Be32(F + 30) <> Dst Then
  Begin
    Dst := Be32(F + 30);
    Ifc := RouteIf(Dst);
    If Ifc < 0 Then
    Begin
      KFree(F);
      IpOutput := -ENETUNREACH;
      Exit;
    End;
    NfOutN := IfName(Ifc);
  End;
  If Not NfEval(3, F + 14, 20 + Plen, True) Then       { OUTPUT : filter }
  Begin
    KFree(F);
    IpOutput := 0;
    Exit;
  End;
  NatHook(4, F + 14, 20 + Plen);                       { POSTROUTING }
  Dst := Be32(F + 30);
  If Ifc = 0 Then R := NetResolve(Dst, Wait, LongInt(@Mac[0]))
  Else R := TunResolve(Ifc - 1, Dst, Wait, LongInt(@Mac[0]));
  If R <> 0 Then
  Begin
    KFree(F);
    IpOutput := R;
    Exit;
  End;
  MemCopy(F, LongInt(@Mac[0]), 6);
  If Ifc = 0 Then MemCopy(F + 6, LongInt(@NicMac[0]), 6)
  Else MemCopy(F + 6, LongInt(@TunMac[(Ifc - 1) * 6]), 6);
  If Ifc = 0 Then IpOutput := NicSend(F, 34 + Plen)
  Else
  Begin
    TunQueue(Ifc - 1, F, 34 + Plen);
    IpOutput := 0;
  End;
  KFree(F);
End;

{ ---- ICMP ---- }

Procedure IcmpInput(Src, A, Len : LongInt; IpHdr : LongInt);
Var R, I : LongInt; S : PSock; M : PMsg; Tot : LongInt;
Begin
  If Len < 8 Then Exit;
  If NetCsum(A, Len) <> 0 Then Exit;
  If (Mem[0:A] = 8) And (SyIcmpIgnoreAll <> 0) Then Exit;
  If Mem[0:A] = 8 Then
  Begin
    { echo : repondre }
    R := KMalloc(Len);
    If R = 0 Then Exit;
    MemCopy(R, A, Len);
    Mem[0:R] := 0;
    PutBe16(R + 2, 0);
    PutBe16(R + 2, NetCsum(R, Len));
    IpOutput(Src, 1, R, Len, False);
    KFree(R);
    Exit;
  End;
  { les autres messages vont aux sockets ICMP }
  For I := 0 To MaxSocks - 1 Do
  Begin
    S := @Socks[I];
    If (S^.State <> SsFree) And (S^.Family = AF_INET)
       And (S^.Proto = IPPROTO_ICMP) And (S^.Closed = 0) Then
    Begin
      If S^.Typ = SOCK_RAW Then
      Begin
        Tot := 20 + Len;
        R := KMalloc(Tot);
        If R <> 0 Then
        Begin
          MemCopy(R, IpHdr, 20);
          MemCopy(R + 20, A, Len);
          M := MsgAdd(S, R, Tot);
          If M <> Nil Then
          Begin
            M^.SrcAddr := Src;
            M^.SrcPort := 0;
          End;
          KFree(R);
        End;
      End
      Else If (Mem[0:A] = 0) And (S^.IcmpId = Be16(A + 4)) Then
      Begin
        M := MsgAdd(S, A, Len);
        If M <> Nil Then
        Begin
          M^.SrcAddr := Src;
          M^.SrcPort := 0;
        End;
      End;
    End;
  End;
End;

{ ---- UDP ---- }

Procedure UdpInput(Src, Dst, A, Len : LongInt);
Var Sp, Dp, UL, Sum : LongInt; S : PSock; M : PMsg; Pse : Array[0..11] Of Byte;
Begin
  If Len < 8 Then Exit;
  Sp := Be16(A); Dp := Be16(A + 2); UL := Be16(A + 4);
  If (UL < 8) Or (UL > Len) Then Exit;
  If Be16(A + 6) <> 0 Then
  Begin
    PutBe32(LongInt(@Pse[0]), Src); PutBe32(LongInt(@Pse[4]), Dst);
    Mem[0:LongInt(@Pse[8])] := 0; Mem[0:LongInt(@Pse[9])] := 17;
    PutBe16(LongInt(@Pse[10]), UL);
    Sum := NetSum(A, UL, NetSum(LongInt(@Pse[0]), 12, 0));
    If Sum <> $FFFF Then Exit;
  End;
  S := InFind(SOCK_DGRAM, Dp, 0);
  If (S = Nil) Or (S^.Proto <> IPPROTO_UDP) Then Exit;
  M := MsgAdd(S, A + 8, UL - 8);
  If M <> Nil Then
  Begin
    M^.SrcAddr := Src;
    M^.SrcPort := Sp;
  End;
End;

{ Envoyer un datagramme UDP vers un hote distant ; Wait : contexte appel }
Function UdpOutput(Sp, Dst, Dp, Buf, Len : LongInt) : LongInt;
Var P, Sum, R : LongInt; Pse : Array[0..11] Of Byte;
Begin
  If Len > NetMtu - 28 Then
  Begin
    UdpOutput := -EMSGSIZE;
    Exit;
  End;
  P := KMalloc(8 + Len);
  If P = 0 Then
  Begin
    UdpOutput := -ENOMEM;
    Exit;
  End;
  PutBe16(P, Sp); PutBe16(P + 2, Dp); PutBe16(P + 4, 8 + Len);
  PutBe16(P + 6, 0);
  MemCopy(P + 8, Buf, Len);
  PutBe32(LongInt(@Pse[0]), SrcFor(Dst)); PutBe32(LongInt(@Pse[4]), Dst);
  Pse[8] := 0; Pse[9] := 17;
  PutBe16(LongInt(@Pse[10]), 8 + Len);
  Sum := (Not NetSum(P, 8 + Len, NetSum(LongInt(@Pse[0]), 12, 0))) And $FFFF;
  If Sum = 0 Then Sum := $FFFF;
  PutBe16(P + 6, Sum);
  R := IpOutput(Dst, 17, P, 8 + Len, True);
  KFree(P);
  UdpOutput := R;
End;

Procedure TcpInput(Src, Dst, A, Len : LongInt); Forward;

{ ---- Entree des trames ---- }

Procedure NetInputIf(Ifc, Frame, Len : LongInt);
Var Et, Ihl, Tot, Proto, Src, Dst, Pay, Plen, Pt : LongInt;
Begin
  If Len < 14 Then Exit;
  If (Mem[0:Frame] And 1) = 0 Then Pt := 0
  Else If (Be32(Frame) = -1) And (Be16(Frame + 4) = $FFFF) Then Pt := 1
  Else Pt := 2;
  If Ifc = 0 Then PktTap(Frame, Len, Pt, Nil);
  Et := Be16(Frame + 12);
  If Et = EtherArp Then
  Begin
    If Ifc = 0 Then ArpInput(Frame, Len) Else TunArpInput(Ifc - 1, Frame, Len);
    Exit;
  End;
  If Et <> EtherIp Then Exit;
  If Len < 34 Then Exit;
  If (Mem[0:Frame + 14] Shr 4) <> 4 Then Exit;
  Ihl := (Mem[0:Frame + 14] And 15) * 4;
  Tot := Be16(Frame + 16);
  If (Ihl < 20) Or (Tot < Ihl) Or (Tot > Len - 14) Then Exit;
  If NetCsum(Frame + 14, Ihl) <> 0 Then Exit;
  If (Be16(Frame + 20) And $3FFF) <> 0 Then Exit;       { fragments : non }
  Proto := Mem[0:Frame + 23];
  Src := Be32(Frame + 26);
  Dst := Be32(Frame + 30);
  ArpLearn(Src, Frame + 6);
  NfInN := IfName(Ifc);
  NfOutN := '';
  NatHook(0, Frame + 14, Tot);                          { PREROUTING }
  Dst := Be32(Frame + 30);
  If Not IpIsLocal(Dst) Then
  Begin
    ForwardIp(Ifc, Frame, Tot);
    Exit;
  End;
  NfInN := IfName(Ifc);
  NfOutN := '';
  If Not NfEval(1, Frame + 14, Tot, False) Then Exit;   { INPUT }
  NatHook(1, Frame + 14, Tot);          { reponses a une connexion locale }
  Src := Be32(Frame + 26);
  Pay := Frame + 14 + Ihl;
  Plen := Tot - Ihl;
  Case Proto Of
    1 : IcmpInput(Src, Pay, Plen, Frame + 14);
    6 : TcpInput(Src, Dst, Pay, Plen);
    17 : UdpInput(Src, Dst, Pay, Plen);
  End;
End;

Procedure NetInput(Frame, Len : LongInt);
Begin
  NetInputIf(0, Frame, Len);
End;

{ ---- TCP (connexions reelles vers le reseau) ---- }

Const
  TcpMss = 1400;
  TcpRto = 100;                  { 1 s en ticks }

{ Envoyer un segment TCP de S : Flags, numero de sequence, donnees }
Function TcpSeg(S : PSock; Flags, Seq, Data, Len : LongInt;
    Wait : Boolean) : LongInt;
Var P, Hl, Sum, Win : LongInt; Pse : Array[0..11] Of Byte; R : LongInt;
Begin
  Hl := 20;
  If (Flags And TF_SYN) <> 0 Then Hl := 24;
  P := KMalloc(Hl + Len);
  If P = 0 Then
  Begin
    TcpSeg := -ENOMEM;
    Exit;
  End;
  MemFill(P, 0, Hl);
  PutBe16(P, S^.LPort); PutBe16(P + 2, S^.RPort);
  PutBe32(P + 4, Seq);
  If (Flags And TF_ACK) <> 0 Then PutBe32(P + 8, S^.RcvNxt);
  Mem[0:P + 12] := (Hl Div 4) Shl 4;
  Mem[0:P + 13] := Flags;
  Win := SockBufSz - S^.BLen;
  If Win < 0 Then Win := 0;
  PutBe16(P + 14, Win);
  If Hl = 24 Then
  Begin
    Mem[0:P + 20] := 2; Mem[0:P + 21] := 4;
    PutBe16(P + 22, TcpMss);
  End;
  If Len > 0 Then MemCopy(P + Hl, Data, Len);
  PutBe32(LongInt(@Pse[0]), SrcFor(S^.RAddr));
  PutBe32(LongInt(@Pse[4]), S^.RAddr);
  Pse[8] := 0; Pse[9] := 6;
  PutBe16(LongInt(@Pse[10]), Hl + Len);
  Sum := (Not NetSum(P, Hl + Len, NetSum(LongInt(@Pse[0]), 12, 0))) And $FFFF;
  PutBe16(P + 16, Sum);
  R := IpOutput(S^.RAddr, 6, P, Hl + Len, Wait);
  KFree(P);
  TcpSeg := R;
End;

Procedure TcpWake(S : PSock);
Begin
  WakeUp(LongInt(S));
End;

{ Reponse RST a un segment sans connexion }
Procedure TcpReset(Src, Dst, A, Len : LongInt);
Var P, Sum, Fl, Seq, Ack : LongInt; Pse : Array[0..11] Of Byte;
Begin
  Fl := Mem[0:A + 13];
  If (Fl And TF_RST) <> 0 Then Exit;
  P := KMalloc(20);
  If P = 0 Then Exit;
  MemFill(P, 0, 20);
  PutBe16(P, Be16(A + 2)); PutBe16(P + 2, Be16(A));
  If (Fl And TF_ACK) <> 0 Then
  Begin
    Seq := Be32(A + 8);
    PutBe32(P + 4, Seq);
    Mem[0:P + 13] := TF_RST;
  End
  Else
  Begin
    Ack := Be32(A + 4) + (Len - ((Mem[0:A + 12] Shr 4) * 4));
    If (Fl And TF_SYN) <> 0 Then Inc(Ack);
    PutBe32(P + 8, Ack);
    Mem[0:P + 13] := TF_RST Or TF_ACK;
  End;
  Mem[0:P + 12] := $50;
  PutBe32(LongInt(@Pse[0]), Dst); PutBe32(LongInt(@Pse[4]), Src);
  Pse[8] := 0; Pse[9] := 6; PutBe16(LongInt(@Pse[10]), 20);
  Sum := (Not NetSum(P, 20, NetSum(LongInt(@Pse[0]), 12, 0))) And $FFFF;
  PutBe16(P + 16, Sum);
  IpOutput(Src, 6, P, 20, False);
  KFree(P);
End;

Function TcpFind(Src, Dst, Sp, Dp : LongInt) : PSock;
Var I : LongInt; S : PSock;
Begin
  TcpFind := Nil;
  For I := 0 To MaxSocks - 1 Do
  Begin
    S := @Socks[I];
    If (S^.State <> SsFree) And (S^.Net <> 0) And (S^.TState <> TcpClosed)
       And (S^.LPort = Dp) And (S^.RPort = Sp) And (S^.RAddr = Src) Then
    Begin
      TcpFind := S;
      Exit;
    End;
  End;
End;

{ Envoyer les donnees (et le FIN) que la fenetre permet }
Procedure TcpOutput(S : PSock);
Var Out, Unsent, Win, N, Ofs, Tail, First, Fl : LongInt; Tmp : LongInt;
Begin
  If (S^.TState <> TcpEstab) And (S^.TState <> TcpCloseWait)
     And (S^.TState <> TcpFinWait1) And (S^.TState <> TcpLastAck)
     And (S^.TState <> TcpClosing) Then Exit;
  While True Do
  Begin
    Out := S^.SndNxt - S^.SndUna;
    If S^.FinSent <> 0 Then Dec(Out);
    Unsent := S^.SLen - Out;
    If S^.FinSent <> 0 Then Exit;
    Win := S^.SndWnd - Out;
    If Win < 0 Then Win := 0;
    If (Unsent > 0) And (Win = 0) And (Out = 0) Then Win := 1;   { sonde }
    If (Unsent <= 0) Or (Win <= 0) Then Break;
    N := Unsent;
    If N > Win Then N := Win;
    If N > TcpMss Then N := TcpMss;
    Ofs := (S^.SHead + Out) Mod SockBufSz;
    First := SockBufSz - Ofs;
    If N <= First Then
      TcpSeg(S, TF_ACK Or TF_PSH, S^.SndNxt, S^.SBuf + Ofs, N, False)
    Else
    Begin
      Tmp := KMalloc(N);
      If Tmp = 0 Then Break;
      MemCopy(Tmp, S^.SBuf + Ofs, First);
      MemCopy(Tmp + First, S^.SBuf, N - First);
      TcpSeg(S, TF_ACK Or TF_PSH, S^.SndNxt, Tmp, N, False);
      KFree(Tmp);
    End;
    S^.SndNxt := S^.SndNxt + N;
    If S^.RtoAt = 0 Then S^.RtoAt := Jiffies + (TcpRto Shl S^.Retries);
  End;
  Out := S^.SndNxt - S^.SndUna;
  If (S^.FinQueued <> 0) And (S^.FinSent = 0) And (S^.SLen = Out) Then
  Begin
    TcpSeg(S, TF_FIN Or TF_ACK, S^.SndNxt, 0, 0, False);
    S^.FinSent := 1;
    Inc(S^.SndNxt);
    If S^.RtoAt = 0 Then S^.RtoAt := Jiffies + (TcpRto Shl S^.Retries);
    If S^.TState = TcpEstab Then S^.TState := TcpFinWait1
    Else If S^.TState = TcpCloseWait Then S^.TState := TcpLastAck;
  End;
  Fl := 0;
End;

Procedure TcpAckNow(S : PSock);
Begin
  TcpSeg(S, TF_ACK, S^.SndNxt, 0, 0, False);
End;

{ Libere une socket TCP reseau terminee (fermee par l'application) }
Procedure TcpFreeIfDone(S : PSock);
Begin
  If (S^.Closed <> 0) And (S^.TState = TcpClosed) And (S^.Net <> 0) Then
  Begin
    If S^.SBuf <> 0 Then FreePages(S^.SBuf, OrderFor(SockBufSz));
    S^.SBuf := 0;
    SockRelease(S);
  End;
End;

Procedure TcpInput(Src, Dst, A, Len : LongInt);
Var Sp, Dp, Seq, Ack, Fl, Win, Hl, Dl, Data, I, N, Free, Acked, Tail : LongInt;
    S, L, X : PSock; Pse : Array[0..11] Of Byte; Sum : LongInt;
Begin
  If Len < 20 Then Exit;
  PutBe32(LongInt(@Pse[0]), Src); PutBe32(LongInt(@Pse[4]), Dst);
  Pse[8] := 0; Pse[9] := 6; PutBe16(LongInt(@Pse[10]), Len);
  If NetSum(A, Len, NetSum(LongInt(@Pse[0]), 12, 0)) <> $FFFF Then Exit;
  Sp := Be16(A); Dp := Be16(A + 2);
  Seq := Be32(A + 4); Ack := Be32(A + 8);
  Hl := (Mem[0:A + 12] Shr 4) * 4;
  Fl := Mem[0:A + 13];
  Win := Be16(A + 14);
  If (Hl < 20) Or (Hl > Len) Then Exit;
  Dl := Len - Hl;
  Data := A + Hl;
  S := TcpFind(Src, Dst, Sp, Dp);
  If S = Nil Then
  Begin
    { nouvelle connexion vers un port en ecoute ? }
    If ((Fl And TF_SYN) <> 0) And ((Fl And (TF_ACK Or TF_RST)) = 0) Then
    Begin
      L := InFind(SOCK_STREAM, Dp, 1);
      If (L <> Nil) And (L^.NBacklog < L^.MaxBacklog) Then
      Begin
        X := SockNew(AF_INET, SOCK_STREAM, IPPROTO_TCP);
        If X <> Nil Then
        Begin
          If SockAllocBuf(X) Then X^.SBuf := AllocPages(OrderFor(SockBufSz));
          If X^.SBuf = 0 Then
          Begin
            SockRelease(X);
            Exit;
          End;
          X^.Net := 1; X^.Bound := 1;
          X^.LAddr := Dst; X^.LPort := Dp; X^.RAddr := Src; X^.RPort := Sp;
          X^.Parent := L;
          X^.TState := TcpSynRcvd;
          X^.RcvNxt := Seq + 1;
          X^.Iss := RandNext And $7FFFFFFF;
          X^.SndUna := X^.Iss; X^.SndNxt := X^.Iss + 1;
          X^.SndWnd := Win;
          X^.CPid := L^.CPid; X^.CUid := L^.CUid; X^.CGid := L^.CGid;
          TcpSeg(X, TF_SYN Or TF_ACK, X^.Iss, 0, 0, False);
          X^.RtoAt := Jiffies + TcpRto;
        End;
        Exit;
      End;
    End;
    TcpReset(Src, Dst, A, Len);
    Exit;
  End;
  If (Fl And TF_RST) <> 0 Then
  Begin
    If S^.TState = TcpSynSent Then S^.Err := ECONNREFUSED
    Else If S^.TState <> TcpTimeWait Then S^.Err := ECONNRESET;
    S^.TState := TcpClosed;
    S^.PeerGone := 1;
    TcpWake(S);
    TcpFreeIfDone(S);
    Exit;
  End;
  If S^.TState = TcpSynSent Then
  Begin
    If ((Fl And (TF_SYN Or TF_ACK)) = (TF_SYN Or TF_ACK)) And (Ack = S^.Iss + 1)
       Then
    Begin
      S^.RcvNxt := Seq + 1;
      S^.SndUna := Ack;
      S^.SndWnd := Win;
      S^.TState := TcpEstab;
      S^.State := SsConn;
      S^.RtoAt := 0; S^.Retries := 0;
      TcpAckNow(S);
      TcpWake(S);
    End;
    Exit;
  End;
  If S^.TState = TcpSynRcvd Then
  Begin
    If ((Fl And TF_ACK) <> 0) And (Ack = S^.Iss + 1) Then
    Begin
      S^.TState := TcpEstab;
      S^.State := SsConn;
      S^.SndUna := Ack;
      S^.SndWnd := Win;
      S^.RtoAt := 0; S^.Retries := 0;
      L := S^.Parent;
      If (L <> Nil) And (L^.State = SsListen) And (L^.Closed = 0)
         And (L^.NBacklog < 16) Then
      Begin
        L^.Backlog[L^.NBacklog] := S;
        Inc(L^.NBacklog);
        WakeUp(LongInt(L));
      End
      Else
      Begin
        TcpSeg(S, TF_RST, S^.SndNxt, 0, 0, False);
        S^.TState := TcpClosed; S^.Closed := 1;
        TcpFreeIfDone(S);
        Exit;
      End;
    End
    Else If (Fl And TF_SYN) <> 0 Then
      TcpSeg(S, TF_SYN Or TF_ACK, S^.Iss, 0, 0, False);
    If S^.TState <> TcpEstab Then Exit;
  End;
  { ACK : faire avancer SndUna }
  If ((Fl And TF_ACK) <> 0) And (Ack - S^.SndUna > 0) And (S^.SndNxt - Ack >= 0)
     Then
  Begin
    Acked := Ack - S^.SndUna;
    If (S^.FinSent <> 0) And (Ack = S^.SndNxt) Then
    Begin
      Dec(Acked);
      S^.FinAcked := 1;
    End;
    If Acked > S^.SLen Then Acked := S^.SLen;
    S^.SHead := (S^.SHead + Acked) Mod SockBufSz;
    Dec(S^.SLen, Acked);
    S^.SndUna := Ack;
    S^.Retries := 0;
    If S^.SndNxt = S^.SndUna Then S^.RtoAt := 0
    Else S^.RtoAt := Jiffies + TcpRto;
    TcpWake(S);
  End;
  If (Fl And TF_ACK) <> 0 Then S^.SndWnd := Win;
  { etats de fermeture }
  If S^.FinAcked <> 0 Then
  Begin
    If S^.TState = TcpFinWait1 Then S^.TState := TcpFinWait2
    Else If S^.TState = TcpClosing Then
    Begin
      S^.TState := TcpTimeWait; S^.RtoAt := Jiffies + 200;
    End
    Else If S^.TState = TcpLastAck Then
    Begin
      S^.TState := TcpClosed;
      S^.PeerGone := 1;
      TcpWake(S);
      TcpFreeIfDone(S);
      Exit;
    End;
  End;
  { donnees recues dans l'ordre }
  If (Dl > 0) And (Seq = S^.RcvNxt) Then
  Begin
    If S^.Closed <> 0 Then
    Begin
      S^.RcvNxt := S^.RcvNxt + Dl;       { socket fermee : tout jeter }
      TcpAckNow(S);
    End
    Else
    Begin
      Free := SockBufSz - S^.BLen;
      N := Dl;
      If N > Free Then N := Free;
      If N > 0 Then
      Begin
        Tail := (S^.BHead + S^.BLen) Mod SockBufSz;
        I := SockBufSz - Tail;
        If I > N Then I := N;
        MemCopy(S^.Buf + Tail, Data, I);
        If N > I Then MemCopy(S^.Buf, Data + I, N - I);
        Inc(S^.BLen, N);
        S^.RcvNxt := S^.RcvNxt + N;
        TcpWake(S);
      End;
      TcpAckNow(S);
    End;
  End
  Else If (Dl > 0) Then TcpAckNow(S);       { hors sequence : ACK en double }
  If ((Fl And TF_FIN) <> 0) And (Seq + Dl = S^.RcvNxt) Then
  Begin
    Inc(S^.RcvNxt);
    S^.PeerWrDone := 1;
    TcpAckNow(S);
    If S^.TState = TcpEstab Then S^.TState := TcpCloseWait
    Else If S^.TState = TcpFinWait1 Then S^.TState := TcpClosing
    Else If S^.TState = TcpFinWait2 Then
    Begin
      S^.TState := TcpTimeWait; S^.RtoAt := Jiffies + 200;
    End;
    TcpWake(S);
  End;
  TcpOutput(S);
End;

{ Temporisations TCP : retransmission, TIME_WAIT (appele a chaque tick) }
Procedure TcpTimer;
Var I : LongInt; S : PSock;
Begin
  For I := 0 To MaxSocks - 1 Do
  Begin
    S := @Socks[I];
    If (S^.State <> SsFree) And (S^.Net <> 0) And (S^.RtoAt <> 0)
       And (Jiffies - S^.RtoAt >= 0) Then
    Begin
      Inc(S^.Retries);
      If S^.TState = TcpTimeWait Then
      Begin
        S^.TState := TcpClosed;
        S^.RtoAt := 0;
        TcpFreeIfDone(S);
      End
      Else If S^.Retries > 6 Then
      Begin
        S^.Err := ETIMEDOUT;
        S^.TState := TcpClosed;
        S^.PeerGone := 1;
        S^.RtoAt := 0;
        TcpWake(S);
        TcpFreeIfDone(S);
      End
      Else
      Begin
        S^.RtoAt := Jiffies + (TcpRto Shl S^.Retries);
        If S^.TState = TcpSynSent Then
          TcpSeg(S, TF_SYN, S^.Iss, 0, 0, False)
        Else If S^.TState = TcpSynRcvd Then
          TcpSeg(S, TF_SYN Or TF_ACK, S^.Iss, 0, 0, False)
        Else
        Begin
          { go-back-N : tout renvoyer depuis SndUna }
          S^.SndNxt := S^.SndUna;
          If S^.FinSent <> 0 Then S^.FinSent := 0;
          TcpOutput(S);
        End;
      End;
    End;
  End;
End;

{ ---- Fonctions appelees par la couche des sockets ---- }

{ Demarrer une connexion TCP vers S^.RAddr:S^.RPort (appel systeme) }
Function TcpConnectStart(S : PSock) : LongInt;
Var R : LongInt;
Begin
  TcpConnectStart := -ENETUNREACH;
  If (RouteIf(S^.RAddr) < 0) Or (SrcFor(S^.RAddr) = 0) Then Exit;
  S^.LAddr := SrcFor(S^.RAddr);
  If S^.Bound = 0 Then
  Begin
    S^.LPort := AutoPort(SOCK_STREAM);
    S^.Bound := 1;
  End;
  If Not SockAllocBuf(S) Then
  Begin
    TcpConnectStart := -ENOMEM;
    Exit;
  End;
  S^.SBuf := AllocPages(OrderFor(SockBufSz));
  If S^.SBuf = 0 Then
  Begin
    TcpConnectStart := -ENOMEM;
    Exit;
  End;
  S^.Net := 1;
  S^.Iss := RandNext And $7FFFFFFF;
  S^.SndUna := S^.Iss; S^.SndNxt := S^.Iss + 1;
  S^.TState := TcpSynSent;
  S^.SndWnd := 1024;
  S^.RtoAt := Jiffies + TcpRto;
  S^.Err := 0;
  R := TcpSeg(S, TF_SYN, S^.Iss, 0, 0, True);
  If R <> 0 Then
  Begin
    S^.TState := TcpClosed;
    S^.RtoAt := 0;
    TcpConnectStart := R;
    Exit;
  End;
  TcpConnectStart := 0;
End;

{ Fermeture d'une socket TCP reseau par l'application }
Procedure TcpClose(S : PSock);
Var I, N : LongInt; X : PSock;
Begin
  S^.Closed := 1;
  If S^.State = SsListen Then
  Begin
    { connexions en cours d'etablissement : abandonnees }
    For I := 0 To MaxSocks - 1 Do
    Begin
      X := @Socks[I];
      If (X^.State <> SsFree) And (X^.Parent = S) And (X^.TState = TcpSynRcvd)
         Then
      Begin
        X^.TState := TcpClosed; X^.Closed := 1;
        TcpFreeIfDone(X);
      End;
    End;
    Exit;
  End;
  Case S^.TState Of
    TcpEstab, TcpCloseWait :
      Begin
        S^.FinQueued := 1;
        TcpOutput(S);
      End;
    TcpSynSent, TcpSynRcvd, TcpListen :
      Begin
        S^.TState := TcpClosed;
        S^.RtoAt := 0;
      End;
  End;
  N := 0;
  TcpFreeIfDone(S);
End;

Procedure TcpShutWr(S : PSock);
Begin
  S^.FinQueued := 1;
  TcpOutput(S);
End;

{ Ecriture dans le tampon d'emission d'une socket TCP reseau }
Function NetStreamWrite(S : PSock; Buf, Cnt, Flags : LongInt) : LongInt;
Var Done, N, Tail, First : LongInt;
Begin
  If (S^.TState <> TcpEstab) And (S^.TState <> TcpCloseWait) Then
  Begin
    If S^.Err <> 0 Then
    Begin
      NetStreamWrite := -S^.Err;
      S^.Err := 0;
    End
    Else If S^.TState = TcpSynSent Then NetStreamWrite := -ENOTCONN
    Else
    Begin
      If (Flags And MSG_NOSIGNAL) = 0 Then SendSig(Cur, SIGPIPE);
      NetStreamWrite := -EPIPE;
    End;
    Exit;
  End;
  Done := 0;
  While Done < Cnt Do
  Begin
    If (S^.PeerGone <> 0) Or (S^.ShutWr <> 0) Or (S^.FinQueued <> 0) Then
    Begin
      If (Flags And MSG_NOSIGNAL) = 0 Then SendSig(Cur, SIGPIPE);
      If Done > 0 Then NetStreamWrite := Done Else NetStreamWrite := -EPIPE;
      Exit;
    End;
    N := SockBufSz - S^.SLen;
    If N > Cnt - Done Then N := Cnt - Done;
    If N <= 0 Then
    Begin
      If ((S^.Flags Or Flags) And (O_NONBLOCK Or MSG_DONTWAIT)) <> 0 Then
      Begin
        If Done > 0 Then NetStreamWrite := Done Else NetStreamWrite := -EAGAIN;
        Exit;
      End;
      If SleepOn(LongInt(S), 0, True) = WakeSignal Then
      Begin
        If Done > 0 Then NetStreamWrite := Done
        Else NetStreamWrite := -ERESTARTSYS;
        Exit;
      End;
    End
    Else
    Begin
      Tail := (S^.SHead + S^.SLen) Mod SockBufSz;
      First := SockBufSz - Tail;
      If First > N Then First := N;
      MemCopy(S^.SBuf + Tail, Buf + Done, First);
      If N > First Then MemCopy(S^.SBuf, Buf + Done + First, N - First);
      Inc(S^.SLen, N);
      Done := Done + N;
      TcpOutput(S);
    End;
  End;
  NetStreamWrite := Done;
End;

{ Echo ICMP vers un hote distant (sockets ICMP) }
Function NetIcmpSend(S : PSock; Buf, Cnt, Dst : LongInt) : LongInt;
Var P : LongInt; R : LongInt;
Begin
  If Cnt < 8 Then
  Begin
    NetIcmpSend := -EINVAL;
    Exit;
  End;
  P := KMalloc(Cnt);
  If P = 0 Then
  Begin
    NetIcmpSend := -ENOMEM;
    Exit;
  End;
  MemCopy(P, Buf, Cnt);
  S^.IcmpId := Be16(P + 4);
  PutBe16(P + 2, 0);
  PutBe16(P + 2, NetCsum(P, Cnt));
  R := IpOutput(Dst, 1, P, Cnt, True);
  KFree(P);
  If R = 0 Then NetIcmpSend := Cnt Else NetIcmpSend := R;
End;

{ ioctl d'interfaces (SIOCGIFxxx, SIOCSIFxxx, routes) des sockets }

{ Numero d'interface d'apres le nom dans ifreq : 1 lo, 2 eth0, 0 inconnue }
Function IfIndex(Req : LongInt) : LongInt;
Var K : LongInt;
Begin
  IfIndex := 0;
  If (Mem[0:Req] = 108) And (Mem[0:Req + 1] = 111) And (Mem[0:Req + 2] = 0)
      Then IfIndex := 1
  Else If NetPresent And (Mem[0:Req] = 101) And (Mem[0:Req + 1] = 116)
      And (Mem[0:Req + 2] = 104) And (Mem[0:Req + 3] = 48)
      And (Mem[0:Req + 4] = 0) Then IfIndex := 2
  Else
    For K := 0 To TunMax - 1 Do
      If (TunUsed[K] <> 0)
         And (MemCmp(Req, LongInt(@TunNm[K * 16]), 16) = 0) Then
        IfIndex := 3 + K;
End;

Procedure PutIfAddr(Req, Addr : LongInt);
Begin
  MemFill(Req + 16, 0, 24);
  MemW[0:Req + 16] := AF_INET;
  PutBe32(Req + 20, Addr);
End;

{ ioctl d'interface (ifreq) pour tun/tap numero K }
Function TunIfIoctl(Cmd, Arg, K : LongInt) : LongInt;
Var I : LongInt;
Begin
  TunIfIoctl := 0;
  Case Cmd Of
    $8913 :
      Begin
        If TunMode[K] = 1 Then I := $1002 Else I := $1010;
        If TunUp[K] <> 0 Then I := I Or $41;
        If TunMode[K] = 2 Then I := I Or $80;
        MemW[0:Arg + 16] := I;
      End;
    $8914 :
      Begin
        If Not Capable(12) Then TunIfIoctl := -EPERM
        Else TunUp[K] := MemW[0:Arg + 16] And 1;
      End;
    $8915 : PutIfAddr(Arg, TunIp[K]);
    $8916 :
      Begin
        If Not Capable(12) Then TunIfIoctl := -EPERM
        Else
        Begin
          TunIp[K] := Be32(Arg + 20);
          If TunMask[K] = 0 Then TunMask[K] := LongInt($FFFFFF00);
        End;
      End;
    $8919 : PutIfAddr(Arg, TunIp[K] Or Not TunMask[K]);
    $891B : PutIfAddr(Arg, TunMask[K]);
    $891C :
      Begin
        If Not Capable(12) Then TunIfIoctl := -EPERM
        Else TunMask[K] := Be32(Arg + 20);
      End;
    $8921 : MemL[0:Arg + 16] := NetMtu;
    $8942 : MemL[0:Arg + 16] := 1000;
    $8918 : PutIfAddr(Arg, 0);
    $8927 :
      Begin
        MemFill(Arg + 16, 0, 24);
        If TunMode[K] = 1 Then
        Begin
          MemW[0:Arg + 16] := 1;
          MemCopy(Arg + 18, LongInt(@TunMac[K * 6]), 6);
        End
        Else MemW[0:Arg + 16] := 65534;
      End;
    $8933 : MemL[0:Arg + 16] := 3 + K;
  End;
End;

Function NetIoctl(Cmd, Arg : LongInt) : LongInt;
Var Ix, N, Buf, I, Len : LongInt;
Begin
  NetIoctl := -ENOTTY;
  Case Cmd Of
    $8912 :                                      { SIOCGIFCONF }
      Begin
        If Not EnsureUser(Arg, 8, True) Then
        Begin
          NetIoctl := -EFAULT;
          Exit;
        End;
        Buf := MemL[0:Arg + 4];
        Len := MemL[0:Arg];
        N := 0;
        If Not EnsureUser(Buf, Len, True) Then
        Begin
          NetIoctl := -EFAULT;
          Exit;
        End;
        If Len >= 40 Then
        Begin
          MemFill(Buf, 0, 40);
          Mem[0:Buf] := 108; Mem[0:Buf + 1] := 111;
          PutIfAddr(Buf, $7F000001);
          N := 1;
        End;
        If NetPresent And (Len >= 80) Then
        Begin
          MemFill(Buf + 40, 0, 40);
          Mem[0:Buf + 40] := 101; Mem[0:Buf + 41] := 116;
          Mem[0:Buf + 42] := 104; Mem[0:Buf + 43] := 48;
          PutIfAddr(Buf + 40, NicIp);
          N := 2;
        End;
        MemL[0:Arg] := N * 40;
        NetIoctl := 0;
      End;
    $890B, $890C :                               { SIOCADDRT, SIOCDELRT }
      Begin
        If Cur^.Euid <> 0 Then
        Begin
          NetIoctl := -EPERM;
          Exit;
        End;
        If Not EnsureUser(Arg, 56, False) Then
        Begin
          NetIoctl := -EFAULT;
          Exit;
        End;
        If Cmd = $890C Then
        Begin
          NicGw := 0;
          NetIoctl := 0;
        End
        Else If (Be32(Arg + 8) = 0) And ((MemW[0:Arg + 52] And 2) <> 0) Then
        Begin
          NicGw := Be32(Arg + 24);
          NetIoctl := 0;
        End
        Else NetIoctl := 0;
      End;
    $8910, $8913, $8914, $8915, $8916, $8919, $891B, $891C, $8921, $8922,
    $8927, $8933, $891D, $8942, $8918, $8917, $8970, $8971 :
      Begin
        If Not EnsureUser(Arg, 40, True) Then
        Begin
          NetIoctl := -EFAULT;
          Exit;
        End;
        If Cmd = $8910 Then                      { SIOCGIFNAME }
        Begin
          Ix := MemL[0:Arg + 16];
          If Ix = 1 Then
          Begin
            MemFill(Arg, 0, 16);
            Mem[0:Arg] := 108; Mem[0:Arg + 1] := 111;
            NetIoctl := 0;
          End
          Else If (Ix = 2) And NetPresent Then
          Begin
            MemFill(Arg, 0, 16);
            Mem[0:Arg] := 101; Mem[0:Arg + 1] := 116;
            Mem[0:Arg + 2] := 104; Mem[0:Arg + 3] := 48;
            NetIoctl := 0;
          End
          Else If (Ix >= 3) And (Ix < 3 + TunMax)
                  And (TunUsed[Ix - 3] <> 0) Then
          Begin
            MemFill(Arg, 0, 16);
            MemCopy(Arg, LongInt(@TunNm[(Ix - 3) * 16]), 16);
            NetIoctl := 0;
          End
          Else NetIoctl := -ENODEV;
          Exit;
        End;
        Ix := IfIndex(Arg);
        If Ix = 0 Then
        Begin
          NetIoctl := -ENODEV;
          Exit;
        End;
        If Ix >= 3 Then
        Begin
          NetIoctl := TunIfIoctl(Cmd, Arg, Ix - 3);
          Exit;
        End;
        NetIoctl := 0;
        Case Cmd Of
          $8913 :
            Begin
              If Ix = 1 Then MemW[0:Arg + 16] := $49
              Else If NicUp Then MemW[0:Arg + 16] := $1043
              Else MemW[0:Arg + 16] := $1002;
            End;
          $8914 :
            Begin
              If Cur^.Euid <> 0 Then NetIoctl := -EPERM
              Else If Ix = 2 Then NicUp := (MemW[0:Arg + 16] And 1) <> 0;
            End;
          $8915 : If Ix = 1 Then PutIfAddr(Arg, $7F000001)
                  Else PutIfAddr(Arg, NicIp);
          $8916 :
            Begin
              If Cur^.Euid <> 0 Then NetIoctl := -EPERM
              Else If Ix = 2 Then NicIp := Be32(Arg + 20);
            End;
          $8919 : If Ix = 1 Then PutIfAddr(Arg, 0)
                  Else PutIfAddr(Arg, NicIp Or Not NicMask);
          $891B : If Ix = 1 Then PutIfAddr(Arg, LongInt($FF000000))
                  Else PutIfAddr(Arg, NicMask);
          $891C :
            Begin
              If Cur^.Euid <> 0 Then NetIoctl := -EPERM
              Else If Ix = 2 Then NicMask := Be32(Arg + 20);
            End;
          $8921 : If Ix = 1 Then MemL[0:Arg + 16] := 65536
                  Else MemL[0:Arg + 16] := NetMtu;
          $8922, $8917, $8971 : ;
          $891D : MemL[0:Arg + 16] := 0;
          $8942 : MemL[0:Arg + 16] := 1000;
          $8918 : PutIfAddr(Arg, 0);
          $8970 : MemFill(Arg + 16, 0, 24);
          $8927 :
            Begin
              MemFill(Arg + 16, 0, 24);
              If Ix = 2 Then
              Begin
                MemW[0:Arg + 16] := 1;
                For I := 0 To 5 Do Mem[0:Arg + 18 + I] := NicMac[I];
              End
              Else MemW[0:Arg + 16] := 772;
            End;
          $8933 : MemL[0:Arg + 16] := Ix;
        End;
      End;
  End;
End;

{ Appele a chaque tick : reception de secours et temporisations }
Procedure NetTick;
Begin
  If Not NetPresent Then Exit;
  NicPoll;
  TcpTimer;
End;

Procedure NetInit;
Var S : String; I, V, K : LongInt;
Begin
  NfDefault;
  NicInit;
  If Not NetPresent Then Exit;
  NicIp := $0A00020F;                 { 10.0.2.15 }
  NicMask := LongInt($FFFFFF00);
  NicGw := $0A000202;                 { 10.0.2.2 }
  S := CmdGet('ip');
  If S <> '' Then
  Begin
    { ip=a.b.c.d[:passerelle[:masque]] }
    V := 0; K := 0;
    For I := 1 To Length(S) + 1 Do
      If (I > Length(S)) Or (S[I] = '.') Or (S[I] = ':') Then
      Begin
        If K < 4 Then NicIp := (NicIp And Not ($FF Shl ((3 - K) * 8)))
            Or (V Shl ((3 - K) * 8));
        Inc(K); V := 0;
        If (I <= Length(S)) And (S[I] = ':') Then Break;
      End
      Else If (S[I] >= '0') And (S[I] <= '9') Then V := V * 10 + Ord(S[I]) - 48;
  End;
  IrqEnable(NicIrq);
  If NicKind = 3 Then KLog('reseau : e1000 memoire ' + HexStr(NicIo, 8)
      + ' irq ' + IntStr(NicIrq) + ' mac ' + HexStr(NicMac[0], 2) + ':'
      + HexStr(NicMac[1], 2) + ':' + HexStr(NicMac[2], 2) + ':'
      + HexStr(NicMac[3], 2) + ':' + HexStr(NicMac[4], 2) + ':'
      + HexStr(NicMac[5], 2))
  Else If NicKind = 4 Then KLog('reseau : PCnet e/s ' + HexStr(NicIo, 4)
      + ' irq ' + IntStr(NicIrq) + ' mac ' + HexStr(NicMac[0], 2) + ':'
      + HexStr(NicMac[1], 2) + ':' + HexStr(NicMac[2], 2) + ':'
      + HexStr(NicMac[3], 2) + ':' + HexStr(NicMac[4], 2) + ':'
      + HexStr(NicMac[5], 2))
  Else If NicKind = 2 Then KLog('reseau : virtio-net e/s ' + HexStr(NicIo, 4)
      + ' irq ' + IntStr(NicIrq) + ' mac ' + HexStr(NicMac[0], 2) + ':'
      + HexStr(NicMac[1], 2) + ':' + HexStr(NicMac[2], 2) + ':'
      + HexStr(NicMac[3], 2) + ':' + HexStr(NicMac[4], 2) + ':'
      + HexStr(NicMac[5], 2))
  Else KLog('reseau : RTL8139 e/s ' + HexStr(NicIo, 4) + ' irq '
      + IntStr(NicIrq)
      + ' mac ' + HexStr(NicMac[0], 2) + ':' + HexStr(NicMac[1], 2) + ':'
      + HexStr(NicMac[2], 2) + ':' + HexStr(NicMac[3], 2) + ':'
      + HexStr(NicMac[4], 2) + ':' + HexStr(NicMac[5], 2));
End;

{ ==================================================================== }
{ Partie 25 - Framebuffer (carte Bochs/QEMU "std VGA", /dev/fb0)       }
{ ==================================================================== }
{ (placee avant la partie 23) }

{ Active avec fb=LxH sur la ligne de commande (ex. fb=1024x768) : le mode
  graphique 32 bits est programme par les registres VBE de la carte Bochs
  (ports 1CEh/1CFh), la memoire video (BAR 0 du peripherique PCI 1234:1111)
  est mappee dans le noyau en F8000000h. /dev/fb0 (29:0) : read, write,
  lseek et ioctl FBIOGET_FSCREENINFO/VSCREENINFO ; pas de mmap. La console
  texte VGA n'est plus visible (la console serie reste utilisable). }

Const
  FbVirt = $F8000000;

Var
  FbOn, FbGfx : Boolean;         { FbGfx : mode graphique programme }
  FbW, FbH, FbLine, FbSize, FbPhys : LongInt;
  FbVW, FbVH, FbBpp, FbVram, FbXOff, FbYOff : LongInt;
  FbPal : Array[0..767] Of Byte;
  FbSaveMem, FbSaved : LongInt;      { texte VGA (polices) sauve avant le
                                       premier mode graphique }
  FbSaveDac : Array[0..191] Of Byte;
  FbFOps : Array[0..15] Of LongInt;

Procedure BgaWrite(Idx, V : LongInt);
Begin
  PortW[$1CE] := Idx;
  PortW[$1CF] := V;
End;

Function BgaRead(Idx : LongInt) : LongInt;
Begin
  PortW[$1CE] := Idx;
  BgaRead := PortW[$1CF];
End;

{ Avant le premier mode graphique : sauver les 256 premiers Ko de la memoire
  video (plans du mode texte : texte et polices, que le mode lineaire ecrase)
  et la palette du DAC (entrees 0 a 63) }
Procedure FbSaveText;
Var I : LongInt;
Begin
  If FbSaved <> 0 Then Exit;
  FbSaved := 1;
  FbSaveMem := AllocPages(6);
  If FbSaveMem <> 0 Then MemCopy(FbSaveMem, FbVirt, 262144);
  Port[$3C7] := 0;
  For I := 0 To 191 Do FbSaveDac[I] := Port[$3C9];
End;

{ Mode acceptable ? (profondeurs 8, 16, 24, 32 ; tient dans la memoire video) }
Function FbCheck(X, Y, VX, VY, B : LongInt) : LongInt;
Begin
  FbCheck := -EINVAL;
  If (B <> 8) And (B <> 16) And (B <> 24) And (B <> 32) Then Exit;
  If (X < 320) Or (X > 2560) Or (Y < 200) Or (Y > 1600) Then Exit;
  If (VX < X) Or (VY < Y) Or (VX > 4096) Then Exit;
  If VX * (B Shr 3) * VY > FbVram Then Exit;
  FbCheck := 0;
End;

{ Programme le mode (sans effacer ? : l'ecran est efface) ; 0 ou -errno }
Function FbSetMode(X, Y, VX, VY, B : LongInt) : LongInt;
Var R : LongInt;
Begin
  R := FbCheck(X, Y, VX, VY, B);
  FbSetMode := R;
  If R <> 0 Then Exit;
  FbSaveText;
  BgaWrite(4, 0);
  BgaWrite(1, X);
  BgaWrite(2, Y);
  BgaWrite(3, B);
  BgaWrite(4, $41);
  If (BgaRead(1) <> X) Or (BgaRead(2) <> Y) Or ((BgaRead(4) And 1) = 0) Then
  Begin
    { la carte n'a pas pris le mode (autre implementation de VBE) : texte }
    FbGfx := True;
    FbTextMode;                      { registres VGA du mode texte }
    FbSetMode := -ENODEV;
    Exit;
  End;
  { largeur / hauteur virtuelles : apres l'activation (QEMU ignore les
    valeurs ecrites avant) ; ecrites seulement si elles different }
  If VX <> X Then BgaWrite(6, VX);
  If VY <> Y Then BgaWrite(7, VY);
  FbW := X; FbH := Y; FbVW := VX; FbVH := VY; FbBpp := B;
  FbLine := VX * (B Shr 3);
  FbSize := FbLine * VY;
  FbXOff := 0; FbYOff := 0;
  FbGfx := True;
  MemFill(FbVirt, 0, FbSize);
  FbSetMode := 0;
End;

Function FbPan(X, Y : LongInt) : LongInt;
Begin
  FbPan := -EINVAL;
  If (X < 0) Or (Y < 0) Or (X + FbW > FbVW) Or (Y + FbH > FbVH) Then Exit;
  BgaWrite(8, X);
  BgaWrite(9, Y);
  FbXOff := X; FbYOff := Y;
  FbPan := 0;
End;

{ fb_var_screeninfo : 160 octets }
Procedure FbFillVar(Arg : LongInt);
Begin
  MemFill(Arg, 0, 160);
  MemL[0:Arg] := FbW;                    { xres, yres }
  MemL[0:Arg + 4] := FbH;
  MemL[0:Arg + 8] := FbVW;               { virtuelle }
  MemL[0:Arg + 12] := FbVH;
  MemL[0:Arg + 16] := FbXOff;            { decalages d'affichage }
  MemL[0:Arg + 20] := FbYOff;
  MemL[0:Arg + 24] := FbBpp;             { bits_per_pixel }
  Case FbBpp Of
    8 :
      Begin
        MemL[0:Arg + 36] := 8; MemL[0:Arg + 48] := 8; MemL[0:Arg + 60] := 8;
      End;
    16 :
      Begin
        MemL[0:Arg + 32] := 11; MemL[0:Arg + 36] := 5;
        MemL[0:Arg + 44] := 5; MemL[0:Arg + 48] := 6;
        MemL[0:Arg + 56] := 0; MemL[0:Arg + 60] := 5;
      End;
  Else
    MemL[0:Arg + 32] := 16; MemL[0:Arg + 36] := 8;
    MemL[0:Arg + 44] := 8; MemL[0:Arg + 48] := 8;
    MemL[0:Arg + 56] := 0; MemL[0:Arg + 60] := 8;
    If FbBpp = 32 Then
    Begin
      MemL[0:Arg + 68] := 24; MemL[0:Arg + 72] := 8;
    End;
  End;
  MemL[0:Arg + 88] := LongInt($FFFFFFFF);    { hauteur, largeur (mm) }
  MemL[0:Arg + 92] := LongInt($FFFFFFFF);
End;

Function FbRead(F : PFile; Buf, Cnt : LongInt) : LongInt;
Var N : LongInt;
Begin
  If F^.Pos >= FbSize Then
  Begin
    FbRead := 0;
    Exit;
  End;
  N := FbSize - F^.Pos;
  If N > Cnt Then N := Cnt;
  MemCopy(Buf, FbVirt + F^.Pos, N);
  F^.Pos := F^.Pos + N;
  FbRead := N;
End;

Function FbWrite(F : PFile; Buf, Cnt : LongInt) : LongInt;
Var N : LongInt;
Begin
  If F^.Pos >= FbSize Then
  Begin
    FbWrite := -ENOSPC;
    Exit;
  End;
  N := FbSize - F^.Pos;
  If N > Cnt Then N := Cnt;
  MemCopy(FbVirt + F^.Pos, Buf, N);
  F^.Pos := F^.Pos + N;
  FbWrite := N;
End;

Function FbLseek(F : PFile; Off, Whence : LongInt) : LongInt;
Var P : LongInt;
Begin
  Case Whence Of
    0 : P := Off;
    1 : P := F^.Pos + Off;
    2 : P := FbSize + Off;
  Else
    Begin
      FbLseek := -EINVAL;
      Exit;
    End;
  End;
  If (P < 0) Or (P > FbSize) Then
  Begin
    FbLseek := -EINVAL;
    Exit;
  End;
  F^.Pos := P;
  FbLseek := P;
End;

Function FbIoctl(F : PFile; Cmd, Arg : LongInt) : LongInt;
Var Id : String; R, X, Y, B, VX, VY, Act, I, N, Start, Lp : LongInt;
Begin
  FbIoctl := -ENOTTY;
  Case Cmd Of
    $4600 :                                  { FBIOGET_VSCREENINFO }
      Begin
        If Not EnsureUser(Arg, 160, True) Then
        Begin
          FbIoctl := -EFAULT;
          Exit;
        End;
        FbFillVar(Arg);
        FbIoctl := 0;
      End;
    $4601, $4606 :                           { FBIOPUT_VSCREENINFO, FBIOPAN }
      Begin
        If Not EnsureUser(Arg, 160, True) Then
        Begin
          FbIoctl := -EFAULT;
          Exit;
        End;
        X := MemL[0:Arg]; Y := MemL[0:Arg + 4];
        VX := MemL[0:Arg + 8]; VY := MemL[0:Arg + 12];
        B := MemL[0:Arg + 24];
        Act := MemL[0:Arg + 84] And $F;
        If Cmd = $4606 Then
        Begin
          R := FbPan(MemL[0:Arg + 16], MemL[0:Arg + 20]);
          If R = 0 Then FbFillVar(Arg);
          FbIoctl := R;
          Exit;
        End;
        If VX < X Then VX := X;
        If VY < Y Then VY := Y;
        If B = 0 Then B := FbBpp;
        R := FbCheck(X, Y, VX, VY, B);
        If R <> 0 Then
        Begin
          FbIoctl := R;
          Exit;
        End;
        If Act <> 2 Then              { FB_ACTIVATE_TEST : seulement verifier }
        Begin
          R := FbSetMode(X, Y, VX, VY, B);
          If R <> 0 Then
          Begin
            FbIoctl := R;
            Exit;
          End;
          If (MemL[0:Arg + 16] <> 0) Or (MemL[0:Arg + 20] <> 0) Then
            FbPan(MemL[0:Arg + 16], MemL[0:Arg + 20]);
        End;
        FbFillVar(Arg);
        FbIoctl := 0;
      End;
    $4611 : FbIoctl := 0;                    { FBIOBLANK : sans effet }
    $4602 :                                  { FBIOGET_FSCREENINFO }
      Begin
        If Not EnsureUser(Arg, 68, True) Then
        Begin
          FbIoctl := -EFAULT;
          Exit;
        End;
        MemFill(Arg, 0, 68);
        Id := 'BOCHS VBE';
        MemCopy(Arg, LongInt(@Id) + 1, Length(Id));
        MemL[0:Arg + 16] := FbPhys;          { smem_start }
        MemL[0:Arg + 20] := FbSize;          { smem_len }
        MemL[0:Arg + 24] := 0;               { FB_TYPE_PACKED_PIXELS }
        If FbBpp = 8 Then MemL[0:Arg + 32] := 3  { PSEUDOCOLOR }
        Else MemL[0:Arg + 32] := 2;          { TRUECOLOR }
        MemW[0:Arg + 36] := 1;               { xpanstep, ypanstep }
        MemW[0:Arg + 38] := 1;
        MemL[0:Arg + 48] := FbLine;          { line_length }
        FbIoctl := 0;
      End;
    $4604, $4605 :                           { FBIOGETCMAP, FBIOPUTCMAP }
      Begin
        { struct fb_cmap : start, len, red, green, blue, transp }
        If Not EnsureUser(Arg, 24, False) Then
        Begin
          FbIoctl := -EFAULT;
          Exit;
        End;
        Start := MemL[0:Arg]; N := MemL[0:Arg + 4];
        If (Start < 0) Or (N < 0) Or (Start + N > 256) Then
        Begin
          FbIoctl := -EINVAL;
          Exit;
        End;
        For I := 0 To N - 1 Do
        Begin
          For Lp := 0 To 2 Do
          Begin
            X := MemL[0:Arg + 8 + Lp * 4];
            If X <> 0 Then
            Begin
              If Not EnsureUser(X + I * 2, 2, Cmd = $4604) Then
              Begin
                FbIoctl := -EFAULT;
                Exit;
              End;
              If Cmd = $4604 Then MemW[0:X + I * 2] := FbPal[(Start + I) * 3
                  + Lp] Shl 8
              Else
              Begin
                FbPal[(Start + I) * 3 + Lp] := MemW[0:X + I * 2] Shr 8;
              End;
            End;
          End;
          If (Cmd = $4605) And (FbBpp = 8) Then
          Begin
            Port[$3C8] := Start + I;
            Port[$3C9] := FbPal[(Start + I) * 3] Shr 2;
            Port[$3C9] := FbPal[(Start + I) * 3 + 1] Shr 2;
            Port[$3C9] := FbPal[(Start + I) * 3 + 2] Shr 2;
          End;
        End;
        FbIoctl := 0;
      End;
  End;
End;

{ Registres VGA du mode texte 3 (80x25, 720x400) }
Const
  VgaSeq : Array[0..4] Of Byte = ($03, $00, $03, $00, $02);
  VgaCrt : Array[0..24] Of Byte = ($5F, $4F, $50, $82, $55, $81, $BF, $1F, 0,
      $4F, $0D, $0E, 0, 0, 0, 0, $9C, $8E, $8F, $28, $1F, $96, $B9, $A3,
      $FF);
  VgaGc : Array[0..8] Of Byte = (0, 0, 0, 0, 0, $10, $0E, 0, $FF);
  VgaAc : Array[0..20] Of Byte = (0, 1, 2, 3, 4, 5, $14, 7, $38, $39, $3A,
      $3B, $3C, $3D, $3E, $3F, $0C, 0, $0F, $08, 0);

{ KD_TEXT : retour au mode texte VGA (registres, memoire, palette) }
Procedure FbTextMode;
Var I : LongInt;
Begin
  If FbOn And FbGfx Then
  Begin
    BgaWrite(4, 0);
    FbGfx := False;
    Port[$3C2] := $67;
    Port[$3C4] := 0; Port[$3C5] := 1;
    For I := 1 To 4 Do
    Begin
      Port[$3C4] := I;
      Port[$3C5] := VgaSeq[I];
    End;
    Port[$3C4] := 0; Port[$3C5] := 3;
    Port[$3D4] := $11;
    Port[$3D5] := Port[$3D5] And $7F;
    For I := 0 To 24 Do
    Begin
      Port[$3D4] := I;
      Port[$3D5] := VgaCrt[I];
    End;
    For I := 0 To 8 Do
    Begin
      Port[$3CE] := I;
      Port[$3CF] := VgaGc[I];
    End;
    I := Port[$3DA];
    For I := 0 To 20 Do
    Begin
      Port[$3C0] := I;
      Port[$3C0] := VgaAc[I];
    End;
    Port[$3C0] := $20;
    If FbSaveMem <> 0 Then MemCopy(FbVirt, FbSaveMem, 262144);
    Port[$3C8] := 0;
    For I := 0 To 191 Do Port[$3C9] := FbSaveDac[I];
    VcShow(ActiveVc);
  End;
End;

Procedure FbInit;
Var S : String; P, D, I, Bar, Pt, Pages, Nt, T, W0, H0, B0, V, Cmd0 : LongInt;
Begin
  FbOn := False;
  FbGfx := False;
  W0 := 0; H0 := 0; B0 := 32;
  S := CmdGet('fb');
  If S <> '' Then
  Begin
    { fb=LxH ou fb=LxHxP (profondeur 8, 16, 24 ou 32) }
    P := Pos('x', S);
    If P = 0 Then Exit;
    W0 := StrVal(Copy(S, 1, P - 1));
    S := Copy(S, P + 1, 20);
    P := Pos('x', S);
    If P > 0 Then
    Begin
      B0 := StrVal(Copy(S, P + 1, 5));
      S := Copy(S, 1, P - 1);
    End;
    H0 := StrVal(S);
  End
  Else
  Begin
    { vga=NNN (numeros de mode VESA de Linux) }
    S := CmdGet('vga');
    If S <> '' Then
    Begin
      If Copy(S, 1, 2) = '0x' Then
      Begin
        V := 0;
        For I := 3 To Length(S) Do
          If (S[I] >= '0') And (S[I] <= '9') Then V := V * 16 + Ord(S[I]) - 48
          Else If (UpCase(S[I]) >= 'A') And (UpCase(S[I]) <= 'F') Then
            V := V * 16 + Ord(UpCase(S[I])) - 55;
      End
      Else V := StrVal(S);
      Case V Of
        $311 : Begin W0 := 640;  H0 := 480;  B0 := 16; End;
        $312 : Begin W0 := 640;  H0 := 480;  B0 := 32; End;
        $314 : Begin W0 := 800;  H0 := 600;  B0 := 16; End;
        $315 : Begin W0 := 800;  H0 := 600;  B0 := 32; End;
        $317 : Begin W0 := 1024; H0 := 768;  B0 := 16; End;
        $318 : Begin W0 := 1024; H0 := 768;  B0 := 32; End;
        $31A : Begin W0 := 1280; H0 := 1024; B0 := 16; End;
        $31B : Begin W0 := 1280; H0 := 1024; B0 := 32; End;
        $301 : Begin W0 := 640;  H0 := 480;  B0 := 8;  End;
        $303 : Begin W0 := 800;  H0 := 600;  B0 := 8;  End;
        $305 : Begin W0 := 1024; H0 := 768;  B0 := 8;  End;
        $307 : Begin W0 := 1280; H0 := 1024; B0 := 8;  End;
      End;
    End;
  End;
  D := -1;
  For I := 0 To 31 Do
    If (PciRead(0, I, 0, 0) = LongInt($11111234))      { Bochs }
       Or (PciRead(0, I, 0, 0) = LongInt($BEEF80EE)) Then D := I;  { VBox }
  If (D < 0) Or (BgaRead(0) < $B0C0) Then
  Begin
    If W0 > 0 Then KLog('framebuffer : carte Bochs/QEMU VGA absente');
    Exit;
  End;
  Bar := PciRead(0, D, 0, $10) And LongInt($FFFFFFF0);
  If Bar = 0 Then Exit;
  PciWrite(0, D, 0, 4, (PciRead(0, D, 0, 4) And $FFFF) Or 2);
  { memoire video : taille du BAR 0, mesuree decodage coupe (comme PciScan) ;
    16 Mo au plus mappes ; fbmem=N (Mo) pour la forcer }
  Cmd0 := PciRead(0, D, 0, 4);
  PciWrite(0, D, 0, 4, Cmd0 And Not 7);
  Pt := PciRead(0, D, 0, $10);
  PciWrite(0, D, 0, $10, -1);
  FbVram := PciRead(0, D, 0, $10) And LongInt($FFFFFFF0);
  PciWrite(0, D, 0, $10, Pt);
  PciWrite(0, D, 0, 4, Cmd0);
  If (FbVram = 0) Or (FbVram = LongInt($FFFFFFF0)) Then FbVram := 16777216
  Else FbVram := (Not FbVram) + 1;
  If FbVram > 16777216 Then FbVram := 16777216;
  If FbVram < 1048576 Then FbVram := 4194304;
  If CmdGet('fbmem') <> '' Then FbVram := StrVal(CmdGet('fbmem')) * 1048576;
  FbPhys := Bar;
  { /dev/fb0 est toujours disponible ; le mode graphique n'est programme
    qu'avec fb=/vga= ou un FBIOPUT_VSCREENINFO. Fenetre : jusqu'a 16 Mo }
  Pages := FbVram Shr 12;
  Nt := (Pages + 1023) Shr 10;
  For T := 0 To Nt - 1 Do
  Begin
    Pt := AllocZeroPage;
    If Pt = 0 Then
    Begin
      KLog('framebuffer : memoire insuffisante');
      Exit;
    End;
    MemL[0:MasterPd + (992 + T) * 4] := V2P(Pt) Or $13;
    For I := 0 To 1023 Do
      If T * 1024 + I < Pages Then
        MemL[0:Pt + I * 4] := (Bar + (T * 1024 + I) * 4096) Or $13;
  End;
  FlushTlb;
  FbW := 640; FbH := 480; FbVW := 640; FbVH := 480; FbBpp := 32;
  FbLine := 640 * 4; FbSize := FbLine * 480;
  If W0 > 0 Then
  Begin
    If FbSetMode(W0, H0, W0, H0, B0) <> 0 Then
    Begin
      KLog('framebuffer : mode refuse');
      Exit;
    End;
  End;
  MemFill(LongInt(@FbFOps[0]), 0, SizeOf(FbFOps));
  FbFOps[FoRead] := LongInt(@FbRead);
  FbFOps[FoWrite] := LongInt(@FbWrite);
  FbFOps[FoLlseek] := LongInt(@FbLseek);
  FbFOps[FoIoctl] := LongInt(@FbIoctl);
  ChrOps[29] := LongInt(@FbFOps[0]);
  FbOn := True;
  KLog('framebuffer : ' + IntStr(FbW) + 'x' + IntStr(FbH) + 'x'
      + IntStr(FbBpp) + ' en ' + HexStr(FbPhys, 8) + ', memoire video '
      + IntStr(FbVram Shr 10) + ' Ko');
End;

{ ==================================================================== }
{ Partie 23 - iso9660 (CD-ROM, lecture seule, Rock Ridge simplifie)    }
{ ==================================================================== }
{ (placee avant la partie 16) }

{ Systeme de fichiers iso9660 sur un peripherique bloc (disque ATAPI
  /dev/hdc ou fichier image sur une partition). Numero d'inode = adresse
  de l'enregistrement de repertoire (bloc * 2048 + decalage), ce qui permet
  de relire un inode sans table. Extensions Rock Ridge reconnues : NM (nom
  long), PX (mode, liens, uid, gid), SL (lien symbolique). Pas de Joliet,
  de fichiers entrelaces ni de multi-sessions. }

Const
  IsoBs = 2048;
  IsoMagic = $9660;

Type
  PIsoSb = ^TIsoSb;
  TIsoSb = Record
    Dev, VolBlocks, RootIno : LongInt;
  End;

Var
  IsoIOps, IsoDirFOps, IsoFileFOps, IsoLnkIOps, IsoSOps :
      Array[0..15] Of LongInt;

Function IsoLe32(A : LongInt) : LongInt;
Begin
  IsoLe32 := MemL[0:A];
End;

{ Copier l'enregistrement d'inode Ino dans Rec (256 octets) ; 0 ou -errno }
Function IsoGetRec(Sb : PSuper; Ino, Rec : LongInt) : LongInt;
Var B : PBuf; X : PIsoSb; Len : LongInt;
Begin
  X := Pointer(Sb^.Priv);
  B := BRead(X^.Dev, Ino Div IsoBs, IsoBs);
  If B = Nil Then
  Begin
    IsoGetRec := -EIO;
    Exit;
  End;
  Len := Mem[0:B^.Data + (Ino Mod IsoBs)];
  If (Len < 34) Or ((Ino Mod IsoBs) + Len > IsoBs) Then
  Begin
    BRelease(B);
    IsoGetRec := -EIO;
    Exit;
  End;
  MemFill(Rec, 0, 256);
  MemCopy(Rec, B^.Data + (Ino Mod IsoBs), Len);
  BRelease(B);
  IsoGetRec := 0;
End;

{ Debut de la zone "utilisation systeme" (Rock Ridge) d'un enregistrement }
Function IsoSuStart(Rec : LongInt) : LongInt;
Var Su : LongInt;
Begin
  Su := 33 + Mem[0:Rec + 32];
  If (Su And 1) <> 0 Then Inc(Su);
  IsoSuStart := Su;
End;

{ Chercher l'entree SUSP de signature (C1, C2) ; retourne son adresse ou 0 }
Function IsoFindSu(Rec, C1, C2 : LongInt) : LongInt;
Var Su, Len, Tot : LongInt;
Begin
  IsoFindSu := 0;
  Tot := Mem[0:Rec];
  Su := IsoSuStart(Rec);
  While Su + 4 <= Tot Do
  Begin
    Len := Mem[0:Rec + Su + 2];
    If Len < 4 Then Exit;
    If (Mem[0:Rec + Su] = C1) And (Mem[0:Rec + Su + 1] = C2) Then
    Begin
      IsoFindSu := Rec + Su;
      Exit;
    End;
    Su := Su + Len;
  End;
End;

{ Nom de l'enregistrement : Rock Ridge NM sinon nom iso9660 en minuscules }
Procedure IsoName(Rec : LongInt; Var Nm : String);
Var Su, Len, Tot, I, N, C : LongInt;
Begin
  Nm := '';
  N := Mem[0:Rec + 32];
  If (N = 1) And (Mem[0:Rec + 33] = 0) Then
  Begin
    Nm := '.';
    Exit;
  End;
  If (N = 1) And (Mem[0:Rec + 33] = 1) Then
  Begin
    Nm := '..';
    Exit;
  End;
  Tot := Mem[0:Rec];
  Su := IsoSuStart(Rec);
  While Su + 4 <= Tot Do
  Begin
    Len := Mem[0:Rec + Su + 2];
    If Len < 4 Then Break;
    If (Mem[0:Rec + Su] = 78) And (Mem[0:Rec + Su + 1] = 77) Then
      For I := 5 To Len - 1 Do Nm := Nm + Chr(Mem[0:Rec + Su + I]);
    Su := Su + Len;
  End;
  If Nm <> '' Then Exit;
  For I := 0 To N - 1 Do
  Begin
    C := Mem[0:Rec + 33 + I];
    If C = 59 Then Break;                       { ";" : numero de version }
    If (C >= 65) And (C <= 90) Then C := C + 32;
    Nm := Nm + Chr(C);
  End;
  If (Length(Nm) > 0) And (Nm[Length(Nm)] = '.') Then
    Delete(Nm, Length(Nm), 1);
End;

{ Date iso9660 (7 octets) en secondes Unix }
Function IsoTime(A : LongInt) : LongInt;
Begin
  IsoTime := DaysFromCivil(Mem[0:A] + 1900, Mem[0:A + 1], Mem[0:A + 2]) * 86400
      + Mem[0:A + 3] * 3600 + Mem[0:A + 4] * 60 + Mem[0:A + 5];
End;

Function IsoReadInode(I : PInode) : LongInt;
Var Rec : Array[0..255] Of Byte; R, Fl, Px, Sl, T : LongInt;
    A, BL, BH : LongInt;
Begin
  A := LongInt(@Rec[0]);
  R := IsoGetRec(I^.Sb, I^.Ino, A);
  If R <> 0 Then
  Begin
    IsoReadInode := R;
    Exit;
  End;
  Fl := Rec[25];
  I^.Priv := IsoLe32(A + 2);
  I^.Priv2 := I^.Ino;
  I^.Size := IsoLe32(A + 10);
  BL := I^.Size; BH := 0;
  U64AddU(BL, BH, 511);
  I^.Blocks := U64ShrL(BL, BH, 9);
  T := IsoTime(A + 18);
  I^.Atime := T; I^.Mtime := T; I^.Ctime := T;
  I^.Uid := 0; I^.Gid := 0;
  I^.Nlink := 1;
  If (Fl And 2) <> 0 Then
  Begin
    I^.Mode := S_IFDIR Or $16D;
    I^.Nlink := 2;
  End
  Else I^.Mode := S_IFREG Or $124;
  Px := IsoFindSu(A, 80, 88);                  { "PX" }
  If Px <> 0 Then
  Begin
    I^.Mode := IsoLe32(Px + 4);
    I^.Nlink := IsoLe32(Px + 12);
    I^.Uid := IsoLe32(Px + 20);
    I^.Gid := IsoLe32(Px + 28);
  End;
  Sl := IsoFindSu(A, 83, 76);                  { "SL" }
  If (Sl <> 0) And ((I^.Mode And S_IFMT) <> S_IFLNK) Then
    I^.Mode := S_IFLNK Or $1FF;
  If (I^.Mode And S_IFMT) = S_IFDIR Then
  Begin
    I^.IOps := LongInt(@IsoIOps[0]);
    I^.FOps := LongInt(@IsoDirFOps[0]);
  End
  Else If (I^.Mode And S_IFMT) = S_IFLNK Then I^.IOps := LongInt(@IsoLnkIOps[0])
  Else
  Begin
    I^.IOps := 0;
    I^.FOps := LongInt(@IsoFileFOps[0]);
  End;
  IsoReadInode := 0;
End;

{ Lien symbolique Rock Ridge : composants SL concatenes }
Function IsoReadlink(I : PInode; Buf, Size : LongInt) : LongInt;
Var Rec : Array[0..255] Of Byte; A, Su, Len, Tot, P, Cf, Cl, K, N : LongInt;
    S : String; First : Boolean;
Begin
  A := LongInt(@Rec[0]);
  If IsoGetRec(I^.Sb, I^.Priv2, A) <> 0 Then
  Begin
    IsoReadlink := -EIO;
    Exit;
  End;
  S := '';
  First := True;
  Tot := Rec[0];
  Su := IsoSuStart(A);
  While Su + 4 <= Tot Do
  Begin
    Len := Rec[Su + 2];
    If Len < 4 Then Break;
    If (Rec[Su] = 83) And (Rec[Su + 1] = 76) Then
    Begin
      P := Su + 5;
      While P + 2 <= Su + Len Do
      Begin
        Cf := Rec[P]; Cl := Rec[P + 1];
        If (Cf And 8) <> 0 Then S := '/'
        Else
        Begin
          If (Not First) And (Length(S) > 0) And (S[Length(S)] <> '/') Then
            S := S + '/';
          If (Cf And 2) <> 0 Then S := S + '.'
          Else If (Cf And 4) <> 0 Then S := S + '..'
          Else For K := 0 To Cl - 1 Do S := S + Chr(Rec[P + 2 + K]);
        End;
        First := False;
        P := P + 2 + Cl;
      End;
    End;
    Su := Su + Len;
  End;
  N := Length(S);
  If N > Size Then N := Size;
  MemCopy(Buf, LongInt(@S) + 1, N);
  IsoReadlink := N;
End;

Function IsoLookup(Dir : PInode; Var Nm : String; Var Res : PInode) : LongInt;
Var X : PIsoSb; Pos, Blk, Off, Len, R : LongInt; B : PBuf;
    Rec : Array[0..255] Of Byte;
    Cn, Want : String; I : PInode;
Begin
  X := Pointer(Dir^.Sb^.Priv);
  Want := Nm;
  For R := 1 To Length(Want) Do
    If (Want[R] >= 'A') And (Want[R] <= 'Z') Then
      Want[R] := Chr(Ord(Want[R]) + 32);
  Pos := 0;
  While Pos < Dir^.Size Do
  Begin
    Blk := Pos Div IsoBs;
    Off := Pos Mod IsoBs;
    B := BRead(X^.Dev, Dir^.Priv + Blk, IsoBs);
    If B = Nil Then
    Begin
      IsoLookup := -EIO;
      Exit;
    End;
    Len := Mem[0:B^.Data + Off];
    If Len = 0 Then
    Begin
      BRelease(B);
      Pos := (Blk + 1) * IsoBs;
      Continue;
    End;
    If (Len < 34) Or (Off + Len > IsoBs) Then
    Begin
      BRelease(B);
      IsoLookup := -EIO;
      Exit;
    End;
    MemFill(LongInt(@Rec[0]), 0, 256);
    MemCopy(LongInt(@Rec[0]), B^.Data + Off, Len);
    BRelease(B);
    IsoName(LongInt(@Rec[0]), Cn);
    For R := 1 To Length(Cn) Do
      If (Cn[R] >= 'A') And (Cn[R] <= 'Z') Then Cn[R] := Chr(Ord(Cn[R]) + 32);
    If (Cn = Want) And (Cn <> '.') And (Cn <> '..') Then
    Begin
      I := IGet(Dir^.Sb, (Dir^.Priv + Blk) * IsoBs + Off);
      If I = Nil Then
      Begin
        IsoLookup := -EIO;
        Exit;
      End;
      Res := I;
      IsoLookup := 0;
      Exit;
    End;
    Pos := Pos + Len;
  End;
  IsoLookup := -ENOENT;
End;

Function IsoReaddir(F : PFile; Var Ino : LongInt; Var Nm : String;
    Var DType : LongInt) : LongInt;
Var D : PInode; X : PIsoSb; Blk, Off, Len, Mode : LongInt; B : PBuf;
    Rec : Array[0..255] Of Byte; A, Px : LongInt;
Begin
  D := F^.Inode;
  X := Pointer(D^.Sb^.Priv);
  IsoReaddir := 0;
  While F^.Pos < D^.Size Do
  Begin
    Blk := F^.Pos Div IsoBs;
    Off := F^.Pos Mod IsoBs;
    B := BRead(X^.Dev, D^.Priv + Blk, IsoBs);
    If B = Nil Then
    Begin
      IsoReaddir := -EIO;
      Exit;
    End;
    Len := Mem[0:B^.Data + Off];
    If Len = 0 Then
    Begin
      BRelease(B);
      F^.Pos := (Blk + 1) * IsoBs;
      Continue;
    End;
    If (Len < 34) Or (Off + Len > IsoBs) Then
    Begin
      BRelease(B);
      IsoReaddir := -EIO;
      Exit;
    End;
    A := LongInt(@Rec[0]);
    MemFill(A, 0, 256);
    MemCopy(A, B^.Data + Off, Len);
    BRelease(B);
    F^.Pos := F^.Pos + Len;
    IsoName(A, Nm);
    Ino := (D^.Priv + Blk) * IsoBs + Off;
    If Nm = '.' Then Ino := D^.Ino;
    If (Rec[25] And 2) <> 0 Then DType := DT_DIR Else DType := DT_REG;
    Px := IsoFindSu(A, 80, 88);
    If Px <> 0 Then
    Begin
      Mode := IsoLe32(Px + 4) And S_IFMT;
      If Mode = S_IFLNK Then DType := DT_LNK
      Else If Mode = S_IFCHR Then DType := DT_CHR
      Else If Mode = S_IFBLK Then DType := DT_BLK
      Else If Mode = S_IFIFO Then DType := DT_FIFO;
    End;
    If IsoFindSu(A, 83, 76) <> 0 Then DType := DT_LNK;
    IsoReaddir := 1;
    Exit;
  End;
End;

Function IsoRead(F : PFile; Buf, Cnt : LongInt) : LongInt;
Var I : PInode; X : PIsoSb; N, Done, Blk, Off, Chunk, RL, RH : LongInt;
    B : PBuf;
Begin
  I := F^.Inode;
  X := Pointer(I^.Sb^.Priv);
  { taille 32 bits non signee (fichiers jusqu'a 4 Go - 1) }
  If U64Le(I^.Size, 0, F^.Pos, F^.PosHi) Then
  Begin
    IsoRead := 0;
    Exit;
  End;
  RL := I^.Size; RH := 0;
  U64Sub(RL, RH, F^.Pos, F^.PosHi);
  If (RH <> 0) Or Not ULt(RL, Cnt) Then N := Cnt Else N := RL;
  Done := 0;
  While Done < N Do
  Begin
    Blk := U64ShrL(F^.Pos, F^.PosHi, 11);
    Off := F^.Pos And (IsoBs - 1);
    Chunk := IsoBs - Off;
    If Chunk > N - Done Then Chunk := N - Done;
    B := BRead(X^.Dev, I^.Priv + Blk, IsoBs);
    If B = Nil Then
    Begin
      If Done = 0 Then IsoRead := -EIO Else IsoRead := Done;
      Exit;
    End;
    MemCopy(Buf + Done, B^.Data + Off, Chunk);
    BRelease(B);
    Done := Done + Chunk;
    U64AddU(F^.Pos, F^.PosHi, Chunk);
  End;
  IsoRead := Done;
End;

Procedure IsoStatfs(Sb : PSuper; Buf : LongInt);
Var X : PIsoSb;
Begin
  X := Pointer(Sb^.Priv);
  MemFill(Buf, 0, 32);
  MemL[0:Buf] := IsoBs;
  MemL[0:Buf + 4] := X^.VolBlocks;
  MemL[0:Buf + 24] := 255;
  MemL[0:Buf + 28] := IsoMagic;
End;

Procedure IsoClear(I : PInode);
Begin
End;

Procedure IsoUmount(Sb : PSuper);
Begin
  If Sb^.Priv <> 0 Then KFree(Sb^.Priv);
  Sb^.Priv := 0;
End;

Function IsoMount(Sb : PSuper; Var DevName : String; Flags,
    Data : LongInt) : LongInt;
Var Dev, K, Blk : LongInt; B : PBuf; X : PIsoSb; Ino : PInode; D : PDentry;
    Found : Boolean;
Begin
  IsoMount := -EINVAL;
  Dev := ExResolveDev(DevName);
  If Dev = 0 Then
  Begin
    IsoMount := -ENOTBLK;
    Exit;
  End;
  If BlkSectors(Dev) = 0 Then
  Begin
    IsoMount := -ENXIO;
    Exit;
  End;
  For K := 0 To MaxSupers - 1 Do
    If (Supers[K] <> Nil) And (Supers[K] <> Sb) And (Supers[K]^.Dev = Dev) Then
    Begin
      IsoMount := -EBUSY;
      Exit;
    End;
  Found := False;
  Blk := 16;
  B := Nil;
  While Blk < 32 Do
  Begin
    B := BRead(Dev, Blk, IsoBs);
    If B = Nil Then
    Begin
      IsoMount := -EIO;
      Exit;
    End;
    If (Mem[0:B^.Data + 1] = 67) And (Mem[0:B^.Data + 2] = 68)
       And (Mem[0:B^.Data + 3] = 48) And (Mem[0:B^.Data + 4] = 48)
       And (Mem[0:B^.Data + 5] = 49) Then
    Begin
      If Mem[0:B^.Data] = 1 Then
      Begin
        Found := True;
        Break;
      End;
      If Mem[0:B^.Data] = 255 Then
      Begin
        BRelease(B);
        Break;
      End;
    End
    Else
    Begin
      BRelease(B);
      Break;
    End;
    BRelease(B);
    Inc(Blk);
  End;
  If Not Found Then Exit;
  If MemW[0:B^.Data + 128] <> IsoBs Then
  Begin
    BRelease(B);
    Exit;
  End;
  X := Pointer(KMallocZ(SizeOf(TIsoSb)));
  If X = Nil Then
  Begin
    BRelease(B);
    IsoMount := -ENOMEM;
    Exit;
  End;
  X^.Dev := Dev;
  X^.VolBlocks := MemL[0:B^.Data + 80];
  X^.RootIno := Blk * IsoBs + 156;
  BRelease(B);
  Sb^.Priv := LongInt(X);
  Sb^.Dev := Dev;
  Sb^.BlockSize := IsoBs;
  Sb^.LargeFiles := 1;
  Sb^.Flags := Flags Or MS_RDONLY;
  Sb^.SOps := LongInt(@IsoSOps[0]);
  Ino := IGet(Sb, X^.RootIno);
  If Ino = Nil Then
  Begin
    KFree(LongInt(X));
    Sb^.Priv := 0;
    IsoMount := -EIO;
    Exit;
  End;
  Ino^.Mode := S_IFDIR Or $16D;
  D := DentryNew(Nil, '', Ino, Sb);
  If D = Nil Then
  Begin
    InodePut(LongInt(Ino));
    InodePurgeSb(Sb);
    KFree(LongInt(X));
    Sb^.Priv := 0;
    IsoMount := -ENOMEM;
    Exit;
  End;
  Sb^.Root := D;
  IsoMount := 0;
End;

Procedure InitIso;
Begin
  MemFill(LongInt(@IsoIOps[0]), 0, SizeOf(IsoIOps));
  IsoIOps[IoLookup] := LongInt(@IsoLookup);
  MemFill(LongInt(@IsoLnkIOps[0]), 0, SizeOf(IsoLnkIOps));
  IsoLnkIOps[IoReadlink] := LongInt(@IsoReadlink);
  MemFill(LongInt(@IsoDirFOps[0]), 0, SizeOf(IsoDirFOps));
  IsoDirFOps[FoReaddir] := LongInt(@IsoReaddir);
  MemFill(LongInt(@IsoFileFOps[0]), 0, SizeOf(IsoFileFOps));
  IsoFileFOps[FoRead] := LongInt(@IsoRead);
  MemFill(LongInt(@IsoSOps[0]), 0, SizeOf(IsoSOps));
  IsoSOps[SoReadInode] := LongInt(@IsoReadInode);
  IsoSOps[SoStatfs] := LongInt(@IsoStatfs);
  IsoSOps[SoUmount] := LongInt(@IsoUmount);
  IsoSOps[SoClearInode] := LongInt(@IsoClear);
  RegisterFs('iso9660', LongInt(@IsoMount));
End;

{ ==================================================================== }
{ Partie 20 - Cache de pages des mappages partages de fichiers        }
{ ==================================================================== }
{ (placee avant la partie 16) }

{ MAP_SHARED d'un fichier : les pages sont partagees entre tous les
  processus qui mappent le meme fichier (une page par couple inode/page de
  fichier, tenue dans ce tableau tant qu'elle est mappee). Les ecritures
  par mappage sont recopiees dans le fichier : avant tout read() et toute
  lecture du noyau sur l'inode (ShmSyncCheck), par msync, sync, a la
  fermeture du dernier mappage ; les write() sur le fichier mettent a jour
  les pages en cache (ShmUpdate). Si le tableau est plein, le mappage
  retombe sur une copie privee de la page. }

Const
  MaxShm = 1024;

Type
  TShmEnt = Record
    Ino, Idx, Page, Dirty : LongInt;
  End;

Var
  Shm      : Array[0..MaxShm - 1] Of TShmEnt;

Function ShmFind(Ino, Idx : LongInt) : LongInt;
Var I : LongInt;
Begin
  ShmFind := -1;
  For I := 0 To MaxShm - 1 Do
    If (Shm[I].Ino = Ino) And (Shm[I].Idx = Idx) And (Ino <> 0) Then
    Begin
      ShmFind := I;
      Exit;
    End;
End;

{ Ecrire le contenu d'une page dans le fichier (sans depasser sa taille) }
Procedure ShmWriteBack(I : LongInt);
Var Ino : PInode; N : LongInt;
Begin
  Ino := Pointer(Shm[I].Ino);
  N := Ino^.Size - Shm[I].Idx * PageSize;
  If N > PageSize Then N := PageSize;
  If N > 0 Then InodeWriteAt(Shm[I].Ino, Shm[I].Page, Shm[I].Idx * PageSize, N);
End;

Function ShmGetPage(Ino, Idx : LongInt; Writable : Boolean) : LongInt;
Var I, K, Pg, N : LongInt; In_ : PInode;
Begin
  ShmGetPage := 0;
  I := ShmFind(Ino, Idx);
  If I >= 0 Then
  Begin
    If Writable Then Shm[I].Dirty := 1;
    ShmGetPage := Shm[I].Page;
    Exit;
  End;
  K := -1;
  For I := 0 To MaxShm - 1 Do
    If Shm[I].Ino = 0 Then
    Begin
      K := I;
      Break;
    End;
  If K < 0 Then Exit;
  Pg := AllocZeroPage;
  If Pg = 0 Then Exit;
  In_ := Pointer(Ino);
  N := In_^.Size - Idx * PageSize;
  If N > PageSize Then N := PageSize;
  If N > 0 Then InodeReadAtRaw(Ino, Pg, Idx * PageSize, N);
  InodeRef(Ino);
  Shm[K].Ino := Ino; Shm[K].Idx := Idx; Shm[K].Page := Pg;
  If Writable Then Shm[K].Dirty := 1 Else Shm[K].Dirty := 0;
  Inc(ShmCount);
  ShmGetPage := Pg;
End;

Procedure ShmSyncInode(Ino : LongInt);
Var I : LongInt;
Begin
  For I := 0 To MaxShm - 1 Do
    If (Shm[I].Ino = Ino) And (Shm[I].Dirty <> 0) Then ShmWriteBack(I);
End;

Procedure ShmSyncAll;
Var I : LongInt;
Begin
  If ShmCount = 0 Then Exit;
  For I := 0 To MaxShm - 1 Do
    If (Shm[I].Ino <> 0) And (Shm[I].Dirty <> 0) Then ShmWriteBack(I);
End;

{ Un mappage partage disparait : ecrire et liberer les pages que plus
  personne ne mappe }
Procedure ShmDropVma(V : PVma);
Var I, First, Last : LongInt;
Begin
  If ShmCount = 0 Then Exit;
  First := V^.Off Div PageSize;
  Last := First + ((V^.Fin - V^.Start) Shr 12) - 1;
  For I := 0 To MaxShm - 1 Do
    If (Shm[I].Ino = V^.Ino) And (Shm[I].Idx >= First)
        And (Shm[I].Idx <= Last) Then
      If PageRef(Shm[I].Page) <= 1 Then
      Begin
        If Shm[I].Dirty <> 0 Then ShmWriteBack(I);
        PagePut(Shm[I].Page);
        InodePut(Shm[I].Ino);
        Shm[I].Ino := 0;
        Dec(ShmCount);
      End;
End;

{ Un write() a modifie le fichier : mettre a jour les pages en cache }
Procedure ShmUpdate(Ino, Pos, Buf, Cnt : LongInt);
Var I, Lo, Hi, S, E : LongInt;
Begin
  For I := 0 To MaxShm - 1 Do
    If Shm[I].Ino = Ino Then
    Begin
      Lo := Shm[I].Idx * PageSize;
      Hi := Lo + PageSize;
      S := Pos;
      If S < Lo Then S := Lo;
      E := Pos + Cnt;
      If E > Hi Then E := Hi;
      If E > S Then MemCopy(Shm[I].Page + (S - Lo), Buf + (S - Pos), E - S);
    End;
End;

Function SysMsync(Addr, Len, Flags : LongInt) : LongInt;
Begin
  ShmSyncAll;
  SysMsync := 0;
End;

{ ==================================================================== }
{ Partie 21 - eventfd, timerfd, epoll, inotify                        }
{ ==================================================================== }
{ (placee avant la partie 16) }

Function FdPollMask(Fd, Events : LongInt) : LongInt; Forward;

Const
  EFD_SEMAPHORE = 1;
  EPOLLIN = 1; EPOLLOUT = 4; EPOLLERR = 8; EPOLLHUP = $10;
  EPOLLONESHOT = $40000000; EPOLLET = -2147483647 - 1;
  MaxEpollEnt = 64;

Type
  PEvfd = ^TEvfd;
  TEvfd = Record
    Cnt, Sem : LongInt;
  End;

  PTfd = ^TTfd;
  TTfd = Record
    Next, Interval, Expired : LongInt;      { en ticks (HZ) }
  End;

  PEpoll = ^TEpoll;
  TEpoll = Record
    N : LongInt;
    Fd, Events, D0, D1, Last, Dis : Array[0..MaxEpollEnt - 1] Of LongInt;
    Fl : Array[0..MaxEpollEnt - 1] Of LongInt;
  End;

Var
  EvfdOps, TfdOps, EpollOps, InoOps : Array[0..15] Of LongInt;

{ Fichier anonyme (inode a part, disparait a la fermeture) }
Function AnonFile(Ops, Priv, Fl : LongInt) : PFile;
Var I : PInode; D : PDentry; F : PFile;
Begin
  AnonFile := Nil;
  I := NewInode(PipeSb, S_IFREG Or $180);
  If I = Nil Then Exit;
  I^.Nlink := 0;
  D := DentryNew(Nil, '', I, PipeSb);
  If D = Nil Then
  Begin
    InodePut(LongInt(I));
    Exit;
  End;
  F := FileNew(D, O_RDWR Or (Fl And O_NONBLOCK));
  If F = Nil Then
  Begin
    DentryPut(LongInt(D));
    Exit;
  End;
  F^.FOps := Ops;
  F^.Priv := Priv;
  AnonFile := F;
End;

Function AnonFd(F : PFile; Fl : LongInt) : LongInt;
Var R : LongInt;
Begin
  If F = Nil Then
  Begin
    AnonFd := -ENFILE;
    Exit;
  End;
  R := FdInstall(F, 0, (Fl And O_CLOEXEC) <> 0);
  If R < 0 Then FilePut(LongInt(F));
  AnonFd := R;
End;

{ ---- eventfd ---- }

Function SysEventfd2(Init, Fl : LongInt) : LongInt;
Var E : PEvfd; F : PFile;
Begin
  E := Pointer(KMallocZ(SizeOf(TEvfd)));
  If E = Nil Then
  Begin
    SysEventfd2 := -ENOMEM;
    Exit;
  End;
  E^.Cnt := Init And $7FFFFFFF;
  If (Fl And EFD_SEMAPHORE) <> 0 Then E^.Sem := 1;
  F := AnonFile(LongInt(@EvfdOps[0]), LongInt(E), Fl);
  If F = Nil Then KFree(LongInt(E));
  SysEventfd2 := AnonFd(F, Fl);
End;

Function SysEventfd(Init : LongInt) : LongInt;
Begin
  SysEventfd := SysEventfd2(Init, 0);
End;

Function EvfdRead(F : PFile; Buf, Cnt : LongInt) : LongInt;
Var E : PEvfd; V : LongInt;
Begin
  E := Pointer(F^.Priv);
  If Cnt < 8 Then
  Begin
    EvfdRead := -EINVAL;
    Exit;
  End;
  While E^.Cnt = 0 Do
  Begin
    If (F^.Flags And O_NONBLOCK) <> 0 Then
    Begin
      EvfdRead := -EAGAIN;
      Exit;
    End;
    If SleepOn(LongInt(E), 0, True) = WakeSignal Then
    Begin
      EvfdRead := -ERESTARTSYS;
      Exit;
    End;
  End;
  If E^.Sem <> 0 Then V := 1 Else V := E^.Cnt;
  Dec(E^.Cnt, V);
  MemL[0:Buf] := V;
  MemL[0:Buf + 4] := 0;
  WakeUp(LongInt(E));
  EvfdRead := 8;
End;

Function EvfdWrite(F : PFile; Buf, Cnt : LongInt) : LongInt;
Var E : PEvfd; V : LongInt;
Begin
  E := Pointer(F^.Priv);
  If Cnt < 8 Then
  Begin
    EvfdWrite := -EINVAL;
    Exit;
  End;
  V := MemL[0:Buf];
  If (MemL[0:Buf + 4] <> 0) Or (V < 0) Or (V = $7FFFFFFF) Then
  Begin
    EvfdWrite := -EINVAL;
    Exit;
  End;
  While E^.Cnt > $7FFFFFFE - V Do
  Begin
    If (F^.Flags And O_NONBLOCK) <> 0 Then
    Begin
      EvfdWrite := -EAGAIN;
      Exit;
    End;
    If SleepOn(LongInt(E), 0, True) = WakeSignal Then
    Begin
      EvfdWrite := -ERESTARTSYS;
      Exit;
    End;
  End;
  Inc(E^.Cnt, V);
  WakeUp(LongInt(E));
  EvfdWrite := 8;
End;

Function EvfdPoll(F : PFile; Ev : LongInt) : LongInt;
Var E : PEvfd; R : LongInt;
Begin
  E := Pointer(F^.Priv);
  R := 0;
  If E^.Cnt > 0 Then R := POLLIN;
  If E^.Cnt < $7FFFFFFE Then R := R Or POLLOUT;
  EvfdPoll := R;
End;

Procedure EvfdRelease(F : PFile);
Begin
  KFree(F^.Priv);
End;

{ ---- timerfd ---- }

Function SysTimerfdCreate(Clk, Fl : LongInt) : LongInt;
Var T : PTfd; F : PFile;
Begin
  If (Clk <> 0) And (Clk <> 1) And (Clk <> 7) And (Clk <> 8) Then
  Begin
    SysTimerfdCreate := -EINVAL;
    Exit;
  End;
  T := Pointer(KMallocZ(SizeOf(TTfd)));
  If T = Nil Then
  Begin
    SysTimerfdCreate := -ENOMEM;
    Exit;
  End;
  F := AnonFile(LongInt(@TfdOps[0]), LongInt(T), Fl);
  If F = Nil Then KFree(LongInt(T));
  SysTimerfdCreate := AnonFd(F, Fl);
End;

{ Ticks de duree d'une struct timespec (secondes, nanosecondes) }
Function TsTicks(P : LongInt) : LongInt;
Begin
  TsTicks := MemL[0:P] * HZ + (MemL[0:P + 4] + 10000000 - 1) Div 10000000;
End;

Procedure TfdUpdate(T : PTfd);
Var N : LongInt;
Begin
  If (T^.Next = 0) Or (Jiffies - T^.Next < 0) Then Exit;
  If T^.Interval > 0 Then
  Begin
    N := 1 + (Jiffies - T^.Next) Div T^.Interval;
    Inc(T^.Expired, N);
    T^.Next := T^.Next + N * T^.Interval;
  End
  Else
  Begin
    Inc(T^.Expired);
    T^.Next := 0;
  End;
End;

Function SysTimerfdSettime(Fd, Flags, NewP, OldP : LongInt) : LongInt;
Var F : PFile; T : PTfd; V, Rem : LongInt;
Begin
  F := FdGet(Fd);
  If (F = Nil) Or (F^.FOps <> LongInt(@TfdOps[0])) Then
  Begin
    If F = Nil Then SysTimerfdSettime := -EBADF
    Else SysTimerfdSettime := -EINVAL;
    Exit;
  End;
  If Not EnsureUser(NewP, 16, False) Then
  Begin
    SysTimerfdSettime := -EFAULT;
    Exit;
  End;
  T := Pointer(F^.Priv);
  TfdUpdate(T);
  If OldP <> 0 Then
    If EnsureUser(OldP, 16, True) Then
    Begin
      MemFill(OldP, 0, 16);
      Rem := T^.Next - Jiffies;
      If (T^.Next = 0) Or (Rem < 0) Then Rem := 0;
      MemL[0:OldP] := T^.Interval Div HZ;
      MemL[0:OldP + 4] := (T^.Interval Mod HZ) * 10000000;
      MemL[0:OldP + 8] := Rem Div HZ;
      MemL[0:OldP + 12] := (Rem Mod HZ) * 10000000;
    End;
  T^.Interval := TsTicks(NewP);
  V := TsTicks(NewP + 8);
  T^.Expired := 0;
  If V = 0 Then T^.Next := 0
  Else
  Begin
    If (Flags And 1) <> 0 Then
    Begin
      V := V - XTime * HZ;                 { instant absolu : relatif }
      If V < 1 Then V := 1;
    End;
    T^.Next := Jiffies + V;
  End;
  WakeUp(LongInt(T));
  SysTimerfdSettime := 0;
End;

Function SysTimerfdGettime(Fd, CurP : LongInt) : LongInt;
Var F : PFile; T : PTfd; Rem : LongInt;
Begin
  F := FdGet(Fd);
  If (F = Nil) Or (F^.FOps <> LongInt(@TfdOps[0])) Then
  Begin
    If F = Nil Then SysTimerfdGettime := -EBADF
    Else SysTimerfdGettime := -EINVAL;
    Exit;
  End;
  If Not EnsureUser(CurP, 16, True) Then
  Begin
    SysTimerfdGettime := -EFAULT;
    Exit;
  End;
  T := Pointer(F^.Priv);
  TfdUpdate(T);
  Rem := T^.Next - Jiffies;
  If (T^.Next = 0) Or (Rem < 0) Then Rem := 0;
  MemFill(CurP, 0, 16);
  MemL[0:CurP] := T^.Interval Div HZ;
  MemL[0:CurP + 4] := (T^.Interval Mod HZ) * 10000000;
  MemL[0:CurP + 8] := Rem Div HZ;
  MemL[0:CurP + 12] := (Rem Mod HZ) * 10000000;
  SysTimerfdGettime := 0;
End;

Function TfdRead(F : PFile; Buf, Cnt : LongInt) : LongInt;
Var T : PTfd;
Begin
  T := Pointer(F^.Priv);
  If Cnt < 8 Then
  Begin
    TfdRead := -EINVAL;
    Exit;
  End;
  While True Do
  Begin
    TfdUpdate(T);
    If T^.Expired > 0 Then Break;
    If (F^.Flags And O_NONBLOCK) <> 0 Then
    Begin
      TfdRead := -EAGAIN;
      Exit;
    End;
    If T^.Next = 0 Then
    Begin
      If SleepOn(LongInt(T), 0, True) = WakeSignal Then
      Begin
        TfdRead := -ERESTARTSYS;
        Exit;
      End;
    End
    Else If SleepTicks(1) = WakeSignal Then
    Begin
      TfdRead := -ERESTARTSYS;
      Exit;
    End;
  End;
  MemL[0:Buf] := T^.Expired;
  MemL[0:Buf + 4] := 0;
  T^.Expired := 0;
  TfdRead := 8;
End;

Function TfdPoll(F : PFile; Ev : LongInt) : LongInt;
Var T : PTfd;
Begin
  T := Pointer(F^.Priv);
  TfdUpdate(T);
  If T^.Expired > 0 Then TfdPoll := POLLIN Else TfdPoll := 0;
End;

{ ---- epoll ---- }

Function SysEpollCreate1(Fl : LongInt) : LongInt;
Var E : PEpoll; F : PFile;
Begin
  E := Pointer(KMallocZ(SizeOf(TEpoll)));
  If E = Nil Then
  Begin
    SysEpollCreate1 := -ENOMEM;
    Exit;
  End;
  F := AnonFile(LongInt(@EpollOps[0]), LongInt(E), 0);
  If F = Nil Then KFree(LongInt(E));
  SysEpollCreate1 := AnonFd(F, Fl);
End;

Function SysEpollCreate(Size : LongInt) : LongInt;
Begin
  If Size <= 0 Then SysEpollCreate := -EINVAL
  Else SysEpollCreate := SysEpollCreate1(0);
End;

Function EpFind(E : PEpoll; Fd : LongInt) : LongInt;
Var I : LongInt;
Begin
  EpFind := -1;
  For I := 0 To E^.N - 1 Do
    If E^.Fd[I] = Fd Then
    Begin
      EpFind := I;
      Exit;
    End;
End;

Procedure EpDel(E : PEpoll; I : LongInt);
Var K : LongInt;
Begin
  For K := I To E^.N - 2 Do
  Begin
    E^.Fd[K] := E^.Fd[K + 1]; E^.Events[K] := E^.Events[K + 1];
    E^.D0[K] := E^.D0[K + 1]; E^.D1[K] := E^.D1[K + 1];
    E^.Last[K] := E^.Last[K + 1]; E^.Dis[K] := E^.Dis[K + 1];
  End;
  Dec(E^.N);
End;

Function SysEpollCtl(Epfd, Op, Fd, Ev : LongInt) : LongInt;
Var F, Tf : PFile; E : PEpoll; I : LongInt;
Begin
  F := FdGet(Epfd);
  Tf := FdGet(Fd);
  If (F = Nil) Or (Tf = Nil) Then
  Begin
    SysEpollCtl := -EBADF;
    Exit;
  End;
  If (F^.FOps <> LongInt(@EpollOps[0])) Or (Epfd = Fd) Then
  Begin
    SysEpollCtl := -EINVAL;
    Exit;
  End;
  E := Pointer(F^.Priv);
  I := EpFind(E, Fd);
  Case Op Of
    1 :                                          { EPOLL_CTL_ADD }
      Begin
        If I >= 0 Then
        Begin
          SysEpollCtl := -EEXIST;
          Exit;
        End;
        If E^.N >= MaxEpollEnt Then
        Begin
          SysEpollCtl := -ENOMEM;
          Exit;
        End;
        If Not EnsureUser(Ev, 12, False) Then
        Begin
          SysEpollCtl := -EFAULT;
          Exit;
        End;
        I := E^.N;
        Inc(E^.N);
        E^.Fd[I] := Fd; E^.Events[I] := MemL[0:Ev];
        E^.D0[I] := MemL[0:Ev + 4]; E^.D1[I] := MemL[0:Ev + 8];
        E^.Last[I] := 0; E^.Dis[I] := 0; E^.Fl[I] := LongInt(Tf);
        SysEpollCtl := 0;
      End;
    2 :                                          { EPOLL_CTL_DEL }
      Begin
        If I < 0 Then
        Begin
          SysEpollCtl := -ENOENT;
          Exit;
        End;
        EpDel(E, I);
        SysEpollCtl := 0;
      End;
    3 :                                          { EPOLL_CTL_MOD }
      Begin
        If I < 0 Then
        Begin
          SysEpollCtl := -ENOENT;
          Exit;
        End;
        If Not EnsureUser(Ev, 12, False) Then
        Begin
          SysEpollCtl := -EFAULT;
          Exit;
        End;
        E^.Events[I] := MemL[0:Ev];
        E^.D0[I] := MemL[0:Ev + 4]; E^.D1[I] := MemL[0:Ev + 8];
        E^.Dis[I] := 0; E^.Last[I] := 0;
        SysEpollCtl := 0;
      End;
  Else
    SysEpollCtl := -EINVAL;
  End;
End;

Function SysEpollWait(Epfd, Evs, Max, Timeout : LongInt) : LongInt;
Var F : PFile; E : PEpoll; I, N, Deadline, M, Ev, New : LongInt;
Begin
  F := FdGet(Epfd);
  If F = Nil Then
  Begin
    SysEpollWait := -EBADF;
    Exit;
  End;
  If (F^.FOps <> LongInt(@EpollOps[0])) Or (Max <= 0) Then
  Begin
    SysEpollWait := -EINVAL;
    Exit;
  End;
  If Not EnsureUser(Evs, Max * 12, True) Then
  Begin
    SysEpollWait := -EFAULT;
    Exit;
  End;
  E := Pointer(F^.Priv);
  If Timeout < 0 Then Deadline := 0
  Else Deadline := Jiffies + (Timeout * HZ + 999) Div 1000;
  While True Do
  Begin
    N := 0;
    I := 0;
    While (I < E^.N) And (N < Max) Do
    Begin
      If LongInt(FdGet(E^.Fd[I])) <> E^.Fl[I] Then
      Begin
        EpDel(E, I);                      { descripteur ferme }
        Continue;
      End;
      If E^.Dis[I] = 0 Then
      Begin
        Ev := E^.Events[I] Or POLLERR Or POLLHUP;
        M := FdPollMask(E^.Fd[I], Ev) And Ev;
        New := M;
        If (E^.Events[I] And EPOLLET) <> 0 Then
        Begin
          New := M And Not E^.Last[I];
          E^.Last[I] := M;
        End;
        If New <> 0 Then
        Begin
          MemL[0:Evs + N * 12] := New;
          MemL[0:Evs + N * 12 + 4] := E^.D0[I];
          MemL[0:Evs + N * 12 + 8] := E^.D1[I];
          Inc(N);
          If (E^.Events[I] And EPOLLONESHOT) <> 0 Then E^.Dis[I] := 1;
        End;
      End;
      Inc(I);
    End;
    If (N > 0) Or (Timeout = 0) Then
    Begin
      SysEpollWait := N;
      Exit;
    End;
    If (Timeout > 0) And (Jiffies - Deadline >= 0) Then
    Begin
      SysEpollWait := 0;
      Exit;
    End;
    If SleepTicks(1) = WakeSignal Then
    Begin
      SysEpollWait := -EINTR;
      Exit;
    End;
  End;
End;

Function SysEpollPwait(Epfd, Evs, Max, Timeout, Mask : LongInt) : LongInt;
Begin
  SysEpollPwait := SysEpollWait(Epfd, Evs, Max, Timeout);
End;

Function EpollPoll(F : PFile; Ev : LongInt) : LongInt;
Var E : PEpoll; I, M, E2 : LongInt;
Begin
  E := Pointer(F^.Priv);
  EpollPoll := 0;
  For I := 0 To E^.N - 1 Do
  Begin
    E2 := E^.Events[I] Or POLLERR Or POLLHUP;
    M := FdPollMask(E^.Fd[I], E2) And E2;
    If M <> 0 Then
    Begin
      EpollPoll := POLLIN;
      Exit;
    End;
  End;
End;

Procedure EpollRelease(F : PFile);
Begin
  KFree(F^.Priv);
End;

{ ---- inotify ---- }

Function SysInotifyInit1(Fl : LongInt) : LongInt;
Var X : PInoInst; K : LongInt; F : PFile;
Begin
  X := Nil;
  For K := 0 To MaxInoInst - 1 Do
    If InoInst[K] = Nil Then
    Begin
      X := Pointer(KMallocZ(SizeOf(TInoInst)));
      If X = Nil Then
      Begin
        SysInotifyInit1 := -ENOMEM;
        Exit;
      End;
      X^.Q := AllocPages(OrderFor(InoQSize));
      If X^.Q = 0 Then
      Begin
        KFree(LongInt(X));
        SysInotifyInit1 := -ENOMEM;
        Exit;
      End;
      X^.NextWd := 1;
      InoInst[K] := X;
      Break;
    End;
  If X = Nil Then
  Begin
    SysInotifyInit1 := -EMFILE;
    Exit;
  End;
  F := AnonFile(LongInt(@InoOps[0]), LongInt(X), Fl);
  If F = Nil Then
  Begin
    For K := 0 To MaxInoInst - 1 Do
      If InoInst[K] = X Then InoInst[K] := Nil;
    FreePages(X^.Q, OrderFor(InoQSize));
    KFree(LongInt(X));
  End;
  SysInotifyInit1 := AnonFd(F, Fl);
End;

Function SysInotifyInit : LongInt;
Begin
  SysInotifyInit := SysInotifyInit1(0);
End;

Function SysInotifyAddWatch(Fd, PathA, Mask : LongInt) : LongInt;
Var F : PFile; X : PInoInst; P : String; D : PDentry; R, J, Wd : LongInt;
    I : PInode;
Begin
  F := FdGet(Fd);
  If (F = Nil) Or (F^.FOps <> LongInt(@InoOps[0])) Then
  Begin
    If F = Nil Then SysInotifyAddWatch := -EBADF
    Else SysInotifyAddWatch := -EINVAL;
    Exit;
  End;
  R := GetUserStr(PathA, P);
  If R < 0 Then
  Begin
    SysInotifyAddWatch := R;
    Exit;
  End;
  If (Mask And $FFF) = 0 Then
  Begin
    SysInotifyAddWatch := -EINVAL;
    Exit;
  End;
  R := PathWalk(P, (Mask And $2000000) = 0, D);
  If R <> 0 Then
  Begin
    SysInotifyAddWatch := R;
    Exit;
  End;
  I := D^.Inode;
  X := Pointer(F^.Priv);
  For J := 0 To X^.NWatch - 1 Do
    If X^.WIno[J] = I Then
    Begin
      If (Mask And $20000000) <> 0 Then X^.WMask[J] := X^.WMask[J] Or Mask
      Else X^.WMask[J] := Mask;
      SysInotifyAddWatch := X^.WWd[J];
      DentryPut(LongInt(D));
      Exit;
    End;
  If X^.NWatch >= MaxWatch Then
  Begin
    DentryPut(LongInt(D));
    SysInotifyAddWatch := -ENOSPC;
    Exit;
  End;
  Wd := X^.NextWd;
  Inc(X^.NextWd);
  J := X^.NWatch;
  Inc(X^.NWatch);
  Inc(I^.Count);
  X^.WIno[J] := I; X^.WMask[J] := Mask And $FFF; X^.WWd[J] := Wd;
  Inc(InoWatches);
  DentryPut(LongInt(D));
  SysInotifyAddWatch := Wd;
End;

Function SysInotifyRmWatch(Fd, Wd : LongInt) : LongInt;
Var F : PFile; X : PInoInst; J, K : LongInt;
Begin
  F := FdGet(Fd);
  If (F = Nil) Or (F^.FOps <> LongInt(@InoOps[0])) Then
  Begin
    If F = Nil Then SysInotifyRmWatch := -EBADF
    Else SysInotifyRmWatch := -EINVAL;
    Exit;
  End;
  X := Pointer(F^.Priv);
  For J := 0 To X^.NWatch - 1 Do
    If X^.WWd[J] = Wd Then
    Begin
      InodePut(LongInt(X^.WIno[J]));
      For K := J To X^.NWatch - 2 Do
      Begin
        X^.WIno[K] := X^.WIno[K + 1]; X^.WMask[K] := X^.WMask[K + 1];
        X^.WWd[K] := X^.WWd[K + 1];
      End;
      Dec(X^.NWatch);
      Dec(InoWatches);
      InoQueue(X, Wd, $8000, 0, '');
      SysInotifyRmWatch := 0;
      Exit;
    End;
  SysInotifyRmWatch := -EINVAL;
End;

Function InoRead(F : PFile; Buf, Cnt : LongInt) : LongInt;
Var X : PInoInst; Done, L, I : LongInt;
Begin
  X := Pointer(F^.Priv);
  While X^.QLen = 0 Do
  Begin
    If (F^.Flags And O_NONBLOCK) <> 0 Then
    Begin
      InoRead := -EAGAIN;
      Exit;
    End;
    If SleepOn(LongInt(X), 0, True) = WakeSignal Then
    Begin
      InoRead := -ERESTARTSYS;
      Exit;
    End;
  End;
  Done := 0;
  While X^.QLen > 0 Do
  Begin
    L := 16 + (Mem[0:X^.Q + ((X^.QHead + 12) Mod InoQSize)]
        Or (Mem[0:X^.Q + ((X^.QHead + 13) Mod InoQSize)] Shl 8));
    If Done + L > Cnt Then
    Begin
      If Done = 0 Then InoRead := -EINVAL Else InoRead := Done;
      Exit;
    End;
    For I := 0 To L - 1 Do
      Mem[0:Buf + Done + I] := Mem[0:X^.Q + ((X^.QHead + I) Mod InoQSize)];
    Done := Done + L;
    X^.QHead := (X^.QHead + L) Mod InoQSize;
    Dec(X^.QLen, L);
  End;
  InoRead := Done;
End;

Function InoPoll(F : PFile; Ev : LongInt) : LongInt;
Var X : PInoInst;
Begin
  X := Pointer(F^.Priv);
  If X^.QLen > 0 Then InoPoll := POLLIN Else InoPoll := 0;
End;

Function InoIoctl(F : PFile; Cmd, Arg : LongInt) : LongInt;
Var X : PInoInst;
Begin
  X := Pointer(F^.Priv);
  If Cmd = $541B Then InoIoctl := PutUserL(Arg, X^.QLen)
  Else InoIoctl := -ENOTTY;
End;

Procedure InoRelease(F : PFile);
Var X : PInoInst; J, K : LongInt;
Begin
  X := Pointer(F^.Priv);
  For J := 0 To X^.NWatch - 1 Do
  Begin
    InodePut(LongInt(X^.WIno[J]));
    Dec(InoWatches);
  End;
  For K := 0 To MaxInoInst - 1 Do
    If InoInst[K] = X Then InoInst[K] := Nil;
  FreePages(X^.Q, OrderFor(InoQSize));
  KFree(LongInt(X));
End;

Procedure InitEvents;
Var I : LongInt;
Begin
  For I := 0 To MaxInoInst - 1 Do InoInst[I] := Nil;
  InoWatches := 0;
  MemFill(LongInt(@EvfdOps[0]), 0, SizeOf(EvfdOps));
  EvfdOps[FoRead] := LongInt(@EvfdRead);
  EvfdOps[FoWrite] := LongInt(@EvfdWrite);
  EvfdOps[FoPoll] := LongInt(@EvfdPoll);
  EvfdOps[FoRelease] := LongInt(@EvfdRelease);
  MemFill(LongInt(@TfdOps[0]), 0, SizeOf(TfdOps));
  TfdOps[FoRead] := LongInt(@TfdRead);
  TfdOps[FoPoll] := LongInt(@TfdPoll);
  TfdOps[FoRelease] := LongInt(@EvfdRelease);
  MemFill(LongInt(@EpollOps[0]), 0, SizeOf(EpollOps));
  EpollOps[FoPoll] := LongInt(@EpollPoll);
  EpollOps[FoRelease] := LongInt(@EpollRelease);
  MemFill(LongInt(@InoOps[0]), 0, SizeOf(InoOps));
  InoOps[FoRead] := LongInt(@InoRead);
  InoOps[FoPoll] := LongInt(@InoPoll);
  InoOps[FoIoctl] := LongInt(@InoIoctl);
  InoOps[FoRelease] := LongInt(@InoRelease);
End;

{ ==================================================================== }
{ Partie 24 - FAT12/16/32 et vfat (noms longs) en lecture/ecriture      }
{ ==================================================================== }
{ (placee avant la partie 16) }

{ Systeme de fichiers FAT sur un peripherique bloc. Noms longs (LFN,
  UTF-8 <-> UCS-2), noms courts avec indicateurs de casse NT, repertoires
  qui grandissent (sauf la racine FAT12/16), chaines de clusters, allocation
  a partir d'un repere, troncature, renommage entre repertoires, attributs
  (lecture seule), horodatage. Pas de liens durs ni symboliques, ni de
  mknod (EPERM). Les inodes ne sont pas relisibles a partir de leur numero :
  ils restent en cache jusqu'au demontage (identifies par l'entree de
  repertoire). Options : ro, rw, umask=NNN, uid=N, gid=N. }

Const
  FatEntSz  = 32;
  FatAttrRo = 1; FatAttrHid = 2; FatAttrSys = 4; FatAttrVol = 8;
  FatAttrDir = $10; FatAttrArc = $20; FatAttrLfn = $0F;
  FatMagic  = $4D44;

Type
  PFatSb = ^TFatSb;
  TFatSb = Record
    Dev, Typ, Bps, Spc, ClusBytes, Rsvd, NFats, FatSz, RootEnts : LongInt;
    FatStart, RootStart, DataStart, Clusters, RootClus, FsInfo : LongInt;
    Free, Hint, Umask, Uid, Gid, NextSyn : LongInt;
    DCDir, DCIdx, DCClus : LongInt;      { cache du dernier acces repertoire }
    ClusBits : LongInt;                  { log2 de ClusBytes }
  End;

  PFatIno = ^TFatIno;
  TFatIno = Record
    First, Parent, Idx, NLfn, Attr, CurIdx, CurClus : LongInt;
  End;

Var
  FatDirIOps, FatFileIOps, FatDirFOps, FatFileFOps, FatSOps :
      Array[0..15] Of LongInt;
  FatQ, FatU : Array[0..259] Of LongInt;   { tampons de noms (UCS) }

Function FatOf(Sb : PSuper) : PFatSb;
Begin
  FatOf := Pointer(Sb^.Priv);
End;

Function FatInoOf(I : PInode) : PFatIno;
Begin
  FatInoOf := Pointer(I^.Priv);
End;

{ ---- Table d'allocation ---- }

Function FatBuf(X : PFatSb; Sec : LongInt) : PBuf;
Begin
  FatBuf := BRead(X^.Dev, Sec, X^.Bps);
End;

{ Valeur de l'entree du cluster N (borne : >= fin de chaine -> $0FFFFFF8) }
Function FatGet(X : PFatSb; N : LongInt) : LongInt;
Var Off, Sec, V : LongInt; B, B2 : PBuf;
Begin
  FatGet := -1;
  If (N < 2) Or (N >= X^.Clusters + 2) Then Exit;
  If X^.Typ = 12 Then
  Begin
    Off := N + (N Shr 1);
    Sec := X^.FatStart + Off Div X^.Bps;
    B := FatBuf(X, Sec);
    If B = Nil Then Exit;
    V := Mem[0:B^.Data + (Off Mod X^.Bps)];
    If (Off Mod X^.Bps) = X^.Bps - 1 Then
    Begin
      B2 := FatBuf(X, Sec + 1);
      If B2 = Nil Then
      Begin
        BRelease(B);
        Exit;
      End;
      V := V Or (Mem[0:B2^.Data] Shl 8);
      BRelease(B2);
    End
    Else V := V Or (Mem[0:B^.Data + (Off Mod X^.Bps) + 1] Shl 8);
    BRelease(B);
    If (N And 1) <> 0 Then V := V Shr 4 Else V := V And $FFF;
    If V >= $FF8 Then V := $0FFFFFF8;
    FatGet := V;
    Exit;
  End;
  If X^.Typ = 16 Then
  Begin
    Off := N * 2;
    B := FatBuf(X, X^.FatStart + Off Div X^.Bps);
    If B = Nil Then Exit;
    V := MemW[0:B^.Data + (Off Mod X^.Bps)];
    BRelease(B);
    If V >= $FFF8 Then V := $0FFFFFF8;
    FatGet := V;
    Exit;
  End;
  Off := N * 4;
  B := FatBuf(X, X^.FatStart + Off Div X^.Bps);
  If B = Nil Then Exit;
  V := MemL[0:B^.Data + (Off Mod X^.Bps)] And $0FFFFFFF;
  BRelease(B);
  If V >= $0FFFFFF8 Then V := $0FFFFFF8;
  FatGet := V;
End;

{ Ecrire l'entree N dans toutes les copies de la FAT }
Procedure FatSet(X : PFatSb; N, V : LongInt);
Var Off, Sec, K, Old : LongInt; B, B2 : PBuf;
Begin
  For K := 0 To X^.NFats - 1 Do
  Begin
    If X^.Typ = 12 Then
    Begin
      Off := N + (N Shr 1);
      Sec := X^.FatStart + K * X^.FatSz + Off Div X^.Bps;
      B := FatBuf(X, Sec);
      If B = Nil Then Continue;
      If (Off Mod X^.Bps) = X^.Bps - 1 Then
      Begin
        B2 := FatBuf(X, Sec + 1);
        If B2 = Nil Then
        Begin
          BRelease(B);
          Continue;
        End;
        If (N And 1) <> 0 Then
        Begin
          Mem[0:B^.Data + X^.Bps - 1] := (Mem[0:B^.Data + X^.Bps - 1] And $0F)
              Or ((V And $F) Shl 4);
          Mem[0:B2^.Data] := (V Shr 4) And $FF;
        End
        Else
        Begin
          Mem[0:B^.Data + X^.Bps - 1] := V And $FF;
          Mem[0:B2^.Data] := (Mem[0:B2^.Data] And $F0) Or ((V Shr 8) And $F);
        End;
        BDirty(B2);
        BRelease(B2);
      End
      Else
      Begin
        Off := Off Mod X^.Bps;
        If (N And 1) <> 0 Then
        Begin
          Mem[0:B^.Data + Off] := (Mem[0:B^.Data + Off] And $0F)
              Or ((V And $F) Shl 4);
          Mem[0:B^.Data + Off + 1] := (V Shr 4) And $FF;
        End
        Else
        Begin
          Mem[0:B^.Data + Off] := V And $FF;
          Mem[0:B^.Data + Off + 1] := (Mem[0:B^.Data + Off + 1] And $F0)
              Or ((V Shr 8) And $F);
        End;
      End;
      BDirty(B);
      BRelease(B);
    End
    Else If X^.Typ = 16 Then
    Begin
      Off := N * 2;
      B := FatBuf(X, X^.FatStart + K * X^.FatSz + Off Div X^.Bps);
      If B = Nil Then Continue;
      If V >= $0FFFFFF8 Then V := $FFFF;
      MemW[0:B^.Data + (Off Mod X^.Bps)] := V;
      BDirty(B);
      BRelease(B);
    End
    Else
    Begin
      Off := N * 4;
      B := FatBuf(X, X^.FatStart + K * X^.FatSz + Off Div X^.Bps);
      If B = Nil Then Continue;
      Old := MemL[0:B^.Data + (Off Mod X^.Bps)] And Not $0FFFFFFF;
      MemL[0:B^.Data + (Off Mod X^.Bps)] := Old Or (V And $0FFFFFFF);
      BDirty(B);
      BRelease(B);
    End;
  End;
End;

{ Valeur ecrite pour "fin de chaine" selon le type }
Function FatEoc(X : PFatSb) : LongInt;
Begin
  If X^.Typ = 12 Then FatEoc := $FFF
  Else If X^.Typ = 16 Then FatEoc := $FFFF
  Else FatEoc := $0FFFFFFF;
End;

Function FatSecOfClus(X : PFatSb; C : LongInt) : LongInt;
Begin
  FatSecOfClus := X^.DataStart + (C - 2) * X^.Spc;
End;

{ Allouer un cluster libre (marque fin de chaine), cherche a partir du
  repere ; remplit de zeros si Zero }
Function FatAlloc(X : PFatSb; Zero : Boolean; Var Clus : LongInt) : LongInt;
Var N, C, S, V, Sec : LongInt; B : PBuf;
Begin
  FatAlloc := -ENOSPC;
  Clus := 0;
  For N := 0 To X^.Clusters - 1 Do
  Begin
    C := X^.Hint + N;
    If C >= X^.Clusters + 2 Then C := C - X^.Clusters;
    If C < 2 Then C := 2;
    V := FatGet(X, C);
    If V = 0 Then
    Begin
      FatSet(X, C, FatEoc(X));
      X^.Hint := C + 1;
      If X^.Hint >= X^.Clusters + 2 Then X^.Hint := 2;
      If X^.Free > 0 Then Dec(X^.Free);
      If Zero Then
        For S := 0 To X^.Spc - 1 Do
        Begin
          Sec := FatSecOfClus(X, C) + S;
          B := BGetBlk(X^.Dev, Sec, X^.Bps);
          If B <> Nil Then
          Begin
            MemFill(B^.Data, 0, X^.Bps);
            BDirty(B);
            BRelease(B);
          End;
        End;
      Clus := C;
      FatAlloc := 0;
      Exit;
    End;
  End;
End;

{ Liberer toute la chaine commencant au cluster First }
Procedure FatFreeChain(X : PFatSb; First : LongInt);
Var C, Nx, N : LongInt;
Begin
  C := First;
  N := 0;
  X^.DCDir := -1;
  While (C >= 2) And (C < X^.Clusters + 2) And (N < X^.Clusters + 2) Do
  Begin
    Nx := FatGet(X, C);
    FatSet(X, C, 0);
    If X^.Free >= 0 Then Inc(X^.Free);
    If (Nx = $0FFFFFF8) Or (Nx <= 0) Then Break;
    C := Nx;
    Inc(N);
  End;
End;

{ ---- Repertoires : acces aux entrees de 32 octets ---- }

{ Secteur et decalage de l'entree Idx du repertoire de premier cluster Dk
  (0 : racine fixe FAT12/16) ; 0 ou 1 (hors du repertoire) ou -errno }
Function DirLoc(X : PFatSb; Dk, Idx : LongInt; Var Sec, Off : LongInt)
    : LongInt;
Var Pos, Ci, C, Start, K, Nx : LongInt;
Begin
  Pos := Idx * FatEntSz;
  If (Dk = 0) And (X^.Typ <> 32) Then
  Begin
    If Idx >= X^.RootEnts Then
    Begin
      DirLoc := 1;
      Exit;
    End;
    Sec := X^.RootStart + Pos Div X^.Bps;
    Off := Pos Mod X^.Bps;
    DirLoc := 0;
    Exit;
  End;
  Ci := Pos Div X^.ClusBytes;
  If (X^.DCDir = Dk) And (X^.DCIdx <= Ci) And (X^.DCClus >= 2) Then
  Begin
    C := X^.DCClus;
    Start := X^.DCIdx;
  End
  Else
  Begin
    C := Dk;
    Start := 0;
  End;
  For K := Start + 1 To Ci Do
  Begin
    Nx := FatGet(X, C);
    If Nx < 0 Then
    Begin
      DirLoc := -EIO;
      Exit;
    End;
    If Nx = $0FFFFFF8 Then
    Begin
      DirLoc := 1;
      Exit;
    End;
    C := Nx;
  End;
  X^.DCDir := Dk; X^.DCIdx := Ci; X^.DCClus := C;
  Sec := FatSecOfClus(X, C) + (Pos Mod X^.ClusBytes) Div X^.Bps;
  Off := Pos Mod X^.Bps;
  DirLoc := 0;
End;

Function DirRead(X : PFatSb; Dk, Idx, Dst : LongInt) : LongInt;
Var R, Sec, Off : LongInt; B : PBuf;
Begin
  R := DirLoc(X, Dk, Idx, Sec, Off);
  If R <> 0 Then
  Begin
    DirRead := R;
    Exit;
  End;
  B := FatBuf(X, Sec);
  If B = Nil Then
  Begin
    DirRead := -EIO;
    Exit;
  End;
  MemCopy(Dst, B^.Data + Off, FatEntSz);
  BRelease(B);
  DirRead := 0;
End;

Function DirWrite(X : PFatSb; Dk, Idx, Src : LongInt) : LongInt;
Var R, Sec, Off : LongInt; B : PBuf;
Begin
  R := DirLoc(X, Dk, Idx, Sec, Off);
  If R <> 0 Then
  Begin
    DirWrite := R;
    Exit;
  End;
  B := FatBuf(X, Sec);
  If B = Nil Then
  Begin
    DirWrite := -EIO;
    Exit;
  End;
  MemCopy(B^.Data + Off, Src, FatEntSz);
  BDirty(B);
  BRelease(B);
  DirWrite := 0;
End;

{ Ajouter un cluster (nul) a la fin du repertoire Dk ; 0 ou -errno }
Function DirGrow(X : PFatSb; Dk : LongInt) : LongInt;
Var C, Nx, N, R : LongInt;
Begin
  If (Dk = 0) And (X^.Typ <> 32) Then
  Begin
    DirGrow := -ENOSPC;
    Exit;
  End;
  C := Dk;
  N := 0;
  While N < X^.Clusters + 2 Do
  Begin
    Nx := FatGet(X, C);
    If Nx < 0 Then
    Begin
      DirGrow := -EIO;
      Exit;
    End;
    If Nx = $0FFFFFF8 Then Break;
    C := Nx;
    Inc(N);
  End;
  R := FatAlloc(X, True, Nx);
  If R <> 0 Then
  Begin
    DirGrow := R;
    Exit;
  End;
  FatSet(X, C, Nx);
  DirGrow := 0;
End;

{ ---- Noms ---- }

Function FatUpper(C : LongInt) : LongInt;
Begin
  If (C >= 97) And (C <= 122) Then FatUpper := C - 32 Else FatUpper := C;
End;

Function FatLower(C : LongInt) : LongInt;
Begin
  If (C >= 65) And (C <= 90) Then FatLower := C + 32 Else FatLower := C;
End;

{ Somme de controle d'un nom court (11 octets a l'adresse A) }
Function FatSum(A : LongInt) : LongInt;
Var I, S : LongInt;
Begin
  S := 0;
  For I := 0 To 10 Do
    S := (((S And 1) Shl 7) Or ((S And $FE) Shr 1)) + Mem[0:A + I];
  FatSum := S And $FF;
End;

{ Octets UTF-8 -> mots UCS-2 (Dst : tableau de LongInt) ; retourne le nombre }
Function Utf8ToUcs(Const S : String; Dst : LongInt) : LongInt;
Var I, N, C, L : LongInt;
Begin
  I := 1;
  N := 0;
  While I <= Length(S) Do
  Begin
    C := Ord(S[I]);
    If C < $80 Then L := 1
    Else If (C And $E0) = $C0 Then
    Begin
      If I + 1 > Length(S) Then Break;
      C := ((C And $1F) Shl 6) Or (Ord(S[I + 1]) And $3F);
      L := 2;
    End
    Else
    Begin
      If I + 2 > Length(S) Then Break;
      C := ((C And $0F) Shl 12) Or ((Ord(S[I + 1]) And $3F) Shl 6)
          Or (Ord(S[I + 2]) And $3F);
      L := 3;
    End;
    MemL[0:Dst + N * 4] := C;
    Inc(N);
    I := I + L;
    If N >= 255 Then Break;
  End;
  Utf8ToUcs := N;
End;

Procedure UcsToUtf8(Src, N : LongInt; Var S : String);
Var I, C : LongInt;
Begin
  S := '';
  For I := 0 To N - 1 Do
  Begin
    C := MemL[0:Src + I * 4];
    If C < $80 Then S := S + Chr(C)
    Else If C < $800 Then
      S := S + Chr($C0 Or (C Shr 6)) + Chr($80 Or (C And $3F))
    Else S := S + Chr($E0 Or (C Shr 12)) + Chr($80 Or ((C Shr 6) And $3F))
        + Chr($80 Or (C And $3F));
  End;
End;

{ Comparaison insensible a la casse de deux suites UCS (ASCII seulement) }
Function UcsEq(A, Na, B, Nb : LongInt) : Boolean;
Var I, X, Y : LongInt;
Begin
  UcsEq := False;
  If Na <> Nb Then Exit;
  For I := 0 To Na - 1 Do
  Begin
    X := MemL[0:A + I * 4]; Y := MemL[0:B + I * 4];
    If (X < 128) And (Y < 128) Then
    Begin
      If FatUpper(X) <> FatUpper(Y) Then Exit;
    End
    Else If X <> Y Then Exit;
  End;
  UcsEq := True;
End;

{ Nom court d'une entree (8.3 avec indicateurs de casse NT) }
Procedure FatShortStr(Ent : LongInt; Var S : String);
Var I, C : LongInt;
Begin
  S := '';
  For I := 0 To 7 Do
  Begin
    C := Mem[0:Ent + I];
    If C = 32 Then Break;
    If (Mem[0:Ent + 12] And 8) <> 0 Then C := FatLower(C);
    If (I = 0) And (C = 5) Then C := $E5;
    S := S + Chr(C);
  End;
  If Mem[0:Ent + 8] <> 32 Then
  Begin
    S := S + '.';
    For I := 8 To 10 Do
    Begin
      C := Mem[0:Ent + I];
      If C = 32 Then Break;
      If (Mem[0:Ent + 12] And 16) <> 0 Then C := FatLower(C);
      S := S + Chr(C);
    End;
  End;
End;

{ Lecture sequentielle des entrees d'un repertoire avec assemblage des noms
  longs. Idx : prochain indice a lire (avance). Retourne 0 si une entree
  utile a ete lue (Ent : 32 octets de l'entree courte ; Name : son nom ;
  Start : indice de la premiere entree du groupe ; EntIdx : indice de
  l'entree courte), 1 en fin de repertoire, <0 en cas d'erreur }
Function DirNext(X : PFatSb; Dk : LongInt; Var Idx : LongInt; Ent : LongInt;
    Var Name : String; Var Start, EntIdx : LongInt;
    Ucs : LongInt; Var Nucs : LongInt) : LongInt;
Var R, Ord_, I, Sum, K, Seq, At, C, Lfn : LongInt; Have : Boolean;
Begin
  Have := False;
  Lfn := 0;
  Sum := 0;
  Nucs := 0;
  While True Do
  Begin
    R := DirRead(X, Dk, Idx, Ent);
    If R <> 0 Then
    Begin
      DirNext := R;
      Exit;
    End;
    C := Mem[0:Ent];
    If C = 0 Then
    Begin
      DirNext := 1;
      Exit;
    End;
    If C = $E5 Then
    Begin
      Have := False;
      Inc(Idx);
      Continue;
    End;
    If (Mem[0:Ent + 11] And $3F) = FatAttrLfn Then
    Begin
      Ord_ := C;
      Seq := Ord_ And $1F;
      If (Ord_ And $40) <> 0 Then
      Begin
        Have := True;
        Start := Idx;
        Lfn := Seq;
        Sum := Mem[0:Ent + 13];
        Nucs := 0;
        For I := 0 To 259 Do MemL[0:Ucs + I * 4] := 0;
      End;
      If Have And (Seq >= 1) And (Seq <= 20) And (Mem[0:Ent + 13] = Sum) Then
      Begin
        At := (Seq - 1) * 13;
        For K := 0 To 4 Do
          MemL[0:Ucs + (At + K) * 4] := MemW[0:Ent + 1 + K * 2];
        For K := 0 To 5 Do
          MemL[0:Ucs + (At + 5 + K) * 4] := MemW[0:Ent + 14 + K * 2];
        For K := 0 To 1 Do
          MemL[0:Ucs + (At + 11 + K) * 4] := MemW[0:Ent + 28 + K * 2];
      End
      Else Have := False;
      Inc(Idx);
      Continue;
    End;
    { entree courte }
    If (Mem[0:Ent + 11] And FatAttrVol) <> 0 Then
    Begin
      Have := False;
      Inc(Idx);
      Continue;
    End;
    If (C = 46) And ((Mem[0:Ent + 1] = 32) Or ((Mem[0:Ent + 1] = 46)
        And (Mem[0:Ent + 2] = 32))) Then
    Begin
      Have := False;
      Inc(Idx);
      Continue;
    End;
    EntIdx := Idx;
    If Have And (FatSum(Ent) = Sum) And (Idx - Start = Lfn) Then
    Begin
      Nucs := 0;
      While (Nucs < Lfn * 13) And (MemL[0:Ucs + Nucs * 4] <> 0)
          And (MemL[0:Ucs + Nucs * 4] <> $FFFF) Do Inc(Nucs);
      UcsToUtf8(Ucs, Nucs, Name);
    End
    Else
    Begin
      Start := Idx;
      FatShortStr(Ent, Name);
      Nucs := Utf8ToUcs(Name, Ucs);
    End;
    Inc(Idx);
    DirNext := 0;
    Exit;
  End;
End;

{ Nom courte pour Nm ; Lossy : le nom ne tient pas tel quel (noms longs
  necessaires) ; Sh recoit 11 octets, Nt les indicateurs de casse }
Procedure FatShortName(Const Nm : String; Sh : LongInt; Var Lossy : Boolean;
    Var Nt : LongInt);
Var Dot, I, C, Nb, Ne, LowB, UpB, LowE, UpE : LongInt; Base, Ext : String;
Begin
  Lossy := False;
  Nt := 0;
  MemFill(Sh, 32, 11);
  Dot := 0;
  For I := Length(Nm) DownTo 1 Do
    If Nm[I] = '.' Then
    Begin
      Dot := I;
      Break;
    End;
  If (Dot = 1) Or (Dot = Length(Nm)) Then Dot := 0;
  If Dot > 0 Then
  Begin
    Base := Copy(Nm, 1, Dot - 1);
    Ext := Copy(Nm, Dot + 1, 255);
  End
  Else
  Begin
    Base := Nm;
    Ext := '';
  End;
  Nb := 0; Ne := 0; LowB := 0; UpB := 0; LowE := 0; UpE := 0;
  For I := 1 To Length(Base) Do
  Begin
    C := Ord(Base[I]);
    If (C = 32) Or (C = 46) Then
    Begin
      Lossy := True;
      Continue;
    End;
    If (C >= 97) And (C <= 122) Then Inc(LowB)
    Else If (C >= 65) And (C <= 90) Then Inc(UpB);
    If C >= 128 Then
    Begin
      Lossy := True;
      C := 95;
    End
    Else If (C < 32) Or (Pos(Chr(C), '"*+,/:;<=>?[\]|') > 0) Then
    Begin
      Lossy := True;
      C := 95;
    End;
    If Nb < 8 Then
    Begin
      Mem[0:Sh + Nb] := FatUpper(C);
      Inc(Nb);
    End
    Else Lossy := True;
  End;
  For I := 1 To Length(Ext) Do
  Begin
    C := Ord(Ext[I]);
    If (C >= 97) And (C <= 122) Then Inc(LowE)
    Else If (C >= 65) And (C <= 90) Then Inc(UpE);
    If (C >= 128) Or (C = 32) Or (C < 32)
       Or (Pos(Chr(C), '"*+,/:;<=>?[\]|.') > 0)
    Then
    Begin
      Lossy := True;
      C := 95;
    End;
    If Ne < 3 Then
    Begin
      Mem[0:Sh + 8 + Ne] := FatUpper(C);
      Inc(Ne);
    End
    Else Lossy := True;
  End;
  If Nb = 0 Then
  Begin
    Lossy := True;
    Mem[0:Sh] := 95;
  End;
  If (LowB > 0) And (UpB > 0) Then Lossy := True;
  If (LowE > 0) And (UpE > 0) Then Lossy := True;
  If Not Lossy Then
  Begin
    If (LowB > 0) And (UpB = 0) Then Nt := Nt Or 8;
    If (LowE > 0) And (UpE = 0) Then Nt := Nt Or 16;
  End;
  If Mem[0:Sh] = $E5 Then Mem[0:Sh] := 5;
End;

{ ---- Heure : FAT (heure locale, vue ici comme UTC) <-> secondes Unix ---- }

Function FatDays(Y, M, D : LongInt) : LongInt;
Var Yy, Era, Yoe, Doy, Doe, Mp : LongInt;
Begin
  If M <= 2 Then Yy := Y - 1 Else Yy := Y;
  Era := Yy Div 400;
  Yoe := Yy - Era * 400;
  If M > 2 Then Mp := M - 3 Else Mp := M + 9;
  Doy := (153 * Mp + 2) Div 5 + D - 1;
  Doe := Yoe * 365 + Yoe Div 4 - Yoe Div 100 + Doy;
  FatDays := Era * 146097 + Doe - 719468;
End;

Function FatToUnix(Dt, Tm : LongInt) : LongInt;
Var Y, M, D : LongInt;
Begin
  Y := 1980 + ((Dt Shr 9) And 127);
  M := (Dt Shr 5) And 15;
  D := Dt And 31;
  If M < 1 Then M := 1;
  If M > 12 Then M := 12;
  If D < 1 Then D := 1;
  FatToUnix := FatDays(Y, M, D) * 86400 + ((Tm Shr 11) And 31) * 3600
      + ((Tm Shr 5) And 63) * 60 + (Tm And 31) * 2;
End;

Procedure UnixToFat(T : LongInt; Var Dt, Tm : LongInt);
Var Y, M, D, Dd, Rm : LongInt;
Begin
  If T < 315532800 Then T := 315532800;
  Dd := T Div 86400;
  Rm := T Mod 86400;
  CivilFromDays(Dd, Y, M, D);
  If Y > 2107 Then
  Begin
    Y := 2107; M := 12; D := 31;
  End;
  Dt := ((Y - 1980) Shl 9) Or (M Shl 5) Or D;
  Tm := ((Rm Div 3600) Shl 11) Or (((Rm Mod 3600) Div 60) Shl 5)
      Or ((Rm Mod 60) Div 2);
End;

{ ---- Inodes ---- }

Function FatModeOf(X : PFatSb; Attr : LongInt) : LongInt;
Var M : LongInt;
Begin
  M := $1FF And Not X^.Umask;
  If (Attr And FatAttrRo) <> 0 Then M := M And Not $92;
  If (Attr And FatAttrDir) <> 0 Then FatModeOf := S_IFDIR Or M
  Else FatModeOf := S_IFREG Or M;
End;

Procedure FatSetOps(I : PInode);
Begin
  If (I^.Mode And S_IFMT) = S_IFDIR Then
  Begin
    I^.IOps := LongInt(@FatDirIOps[0]);
    I^.FOps := LongInt(@FatDirFOps[0]);
  End
  Else
  Begin
    I^.IOps := LongInt(@FatFileIOps[0]);
    I^.FOps := LongInt(@FatFileFOps[0]);
  End;
End;

Function FatChainLen(X : PFatSb; First : LongInt) : LongInt;
Var C, N, Nx : LongInt;
Begin
  N := 0;
  C := First;
  While (C >= 2) And (N <= X^.Clusters) Do
  Begin
    Inc(N);
    Nx := FatGet(X, C);
    If (Nx < 2) Or (Nx = $0FFFFFF8) Then Break;
    C := Nx;
  End;
  FatChainLen := N;
End;

{ Blocs de 512 octets occupes par un fichier de Size octets (non signe) }
Function FatBlocksOf(X : PFatSb; Size : LongInt) : LongInt;
Var L, H : LongInt;
Begin
  L := Size; H := 0;
  U64AddU(L, H, X^.ClusBytes - 1);
  FatBlocksOf := U64ShrL(L, H, X^.ClusBits) * (X^.ClusBytes Div 512);
End;

{ Inode de l'entree (Dk, Idx) : en cache ou cree a partir de l'entree Ent }
Function FatGetIno(Sb : PSuper; Dk, Idx, NLfn, Ent : LongInt;
    Var Res : PInode) : LongInt;
Var X : PFatSb; I : PInode; P : PFatIno; Attr, First : LongInt;
Begin
  X := FatOf(Sb);
  I := InodeAll;
  While I <> Nil Do
  Begin
    If I^.Sb = Sb Then
    Begin
      P := FatInoOf(I);
      If (P <> Nil) And (P^.Parent = Dk) And (P^.Idx = Idx) Then
      Begin
        Inc(I^.Count);
        Res := I;
        FatGetIno := 0;
        Exit;
      End;
    End;
    I := I^.Next;
  End;
  Attr := Mem[0:Ent + 11];
  I := NewInode(Sb, FatModeOf(X, Attr));
  If I = Nil Then
  Begin
    FatGetIno := -ENOMEM;
    Exit;
  End;
  P := Pointer(KMallocZ(SizeOf(TFatIno)));
  If P = Nil Then
  Begin
    I^.Nlink := 0;
    InodePut(LongInt(I));
    FatGetIno := -ENOMEM;
    Exit;
  End;
  First := MemW[0:Ent + 26];
  If X^.Typ = 32 Then First := First Or (MemW[0:Ent + 20] Shl 16);
  P^.First := First; P^.Parent := Dk; P^.Idx := Idx; P^.NLfn := NLfn;
  P^.Attr := Attr; P^.CurClus := 0; P^.CurIdx := 0;
  I^.Priv := LongInt(P);
  I^.Uid := X^.Uid; I^.Gid := X^.Gid;
  I^.Mtime := FatToUnix(MemW[0:Ent + 24], MemW[0:Ent + 22]);
  I^.Atime := FatToUnix(MemW[0:Ent + 18], 0);
  I^.Ctime := FatToUnix(MemW[0:Ent + 16], MemW[0:Ent + 14]);
  I^.Nlink := 1;
  If (Attr And FatAttrDir) <> 0 Then
  Begin
    I^.Nlink := 2;
    I^.Size := FatChainLen(X, First) * X^.ClusBytes;
  End
  Else
    I^.Size := MemL[0:Ent + 28];       { 32 bits non signe (jusqu'a 4 Go - 1) }
  I^.SizeHi := 0;
  I^.Blocks := FatBlocksOf(X, I^.Size);
  FatSetOps(I);
  Res := I;
  FatGetIno := 0;
End;

{ Ecrire l'entree de repertoire de l'inode (attributs, cluster, taille,
  dates) }
Function FatWriteInode(I : PInode) : LongInt;
Var X : PFatSb; P : PFatIno; Ent : Array[0..31] Of Byte;
    A, R, Attr, Dt, Tm : LongInt;
Begin
  FatWriteInode := 0;
  I^.Dirty := 0;
  P := FatInoOf(I);
  If (P = Nil) Or (P^.Parent < 0) Then Exit;
  X := FatOf(I^.Sb);
  If X = Nil Then Exit;
  A := LongInt(@Ent[0]);
  R := DirRead(X, P^.Parent, P^.Idx, A);
  If R <> 0 Then
  Begin
    FatWriteInode := R;
    Exit;
  End;
  Attr := Mem[0:A + 11] And Not FatAttrRo;
  If (I^.Mode And $92) = 0 Then Attr := Attr Or FatAttrRo;
  If (I^.Mode And S_IFMT) <> S_IFDIR Then Attr := Attr Or FatAttrArc;
  Mem[0:A + 11] := Attr;
  P^.Attr := Attr;
  MemW[0:A + 26] := P^.First And $FFFF;
  If X^.Typ = 32 Then MemW[0:A + 20] := (P^.First Shr 16) And $FFFF;
  If (I^.Mode And S_IFMT) = S_IFDIR Then MemL[0:A + 28] := 0
  Else MemL[0:A + 28] := I^.Size;
  UnixToFat(I^.Mtime, Dt, Tm);
  MemW[0:A + 24] := Dt;
  MemW[0:A + 22] := Tm;
  UnixToFat(I^.Atime, Dt, Tm);
  MemW[0:A + 18] := Dt;
  FatWriteInode := DirWrite(X, P^.Parent, P^.Idx, A);
End;

{ Dernier acces a l'inode : liberer les clusters s'il est supprime }
Procedure FatPutInode(I : PInode);
Var P : PFatIno; X : PFatSb;
Begin
  P := FatInoOf(I);
  If P = Nil Then Exit;
  X := FatOf(I^.Sb);
  If (I^.Nlink <= 0) And (P^.First >= 2) And (X <> Nil) Then
    FatFreeChain(X, P^.First);
  KFree(LongInt(P));
  I^.Priv := 0;
End;

{ ---- Recherche et noms ---- }

Function StrEqCi(Const A, B : String) : Boolean;
Var I : LongInt;
Begin
  StrEqCi := False;
  If Length(A) <> Length(B) Then Exit;
  For I := 1 To Length(A) Do
    If FatUpper(Ord(A[I])) <> FatUpper(Ord(B[I])) Then Exit;
  StrEqCi := True;
End;

Function FatDirOf(I : PInode) : LongInt;
Begin
  FatDirOf := FatInoOf(I)^.First;
End;

{ Chercher Nm dans le repertoire Dk ; 0 (Ent = entree courte, Start/EntIdx),
  -ENOENT ou erreur }
Function FatFind(X : PFatSb; Dk : LongInt; Var Nm : String; Ent : LongInt;
    Var Start, EntIdx : LongInt) : LongInt;
Var Idx, R, Nq, Nu : LongInt; S, Sh : String;
Begin
  Nq := Utf8ToUcs(Nm, LongInt(@FatQ[0]));
  Idx := 0;
  While True Do
  Begin
    R := DirNext(X, Dk, Idx, Ent, S, Start, EntIdx, LongInt(@FatU[0]), Nu);
    If R <> 0 Then
    Begin
      If R = 1 Then FatFind := -ENOENT Else FatFind := R;
      Exit;
    End;
    If UcsEq(LongInt(@FatQ[0]), Nq, LongInt(@FatU[0]), Nu) Then
    Begin
      FatFind := 0;
      Exit;
    End;
    If EntIdx <> Start Then
    Begin
      FatShortStr(Ent, Sh);
      If StrEqCi(Sh, Nm) Then
      Begin
        FatFind := 0;
        Exit;
      End;
    End;
  End;
End;

Function FatCheckName(Const Nm : String) : LongInt;
Var I, C, Dots : LongInt;
Begin
  FatCheckName := 0;
  If Length(Nm) = 0 Then
  Begin
    FatCheckName := -EINVAL;
    Exit;
  End;
  If Length(Nm) > 255 Then
  Begin
    FatCheckName := -ENAMETOOLONG;
    Exit;
  End;
  Dots := 0;
  For I := 1 To Length(Nm) Do
  Begin
    C := Ord(Nm[I]);
    If C = 46 Then Inc(Dots);
    If (C < 32) Or (C = 34) Or (C = 42) Or (C = 58) Or (C = 60) Or (C = 62)
       Or (C = 63) Or (C = 92) Or (C = 124) Then
    Begin
      FatCheckName := -EINVAL;
      Exit;
    End;
  End;
  If Dots = Length(Nm) Then FatCheckName := -EINVAL;
End;

{ Un nom court (11 octets a l'adresse Sh) existe-t-il deja dans Dk ? }
Function FatShortExists(X : PFatSb; Dk, Sh : LongInt) : Boolean;
Var Idx, R, C, K, A : LongInt; Ent : Array[0..31] Of Byte; Same : Boolean;
Begin
  FatShortExists := False;
  A := LongInt(@Ent[0]);
  Idx := 0;
  While True Do
  Begin
    R := DirRead(X, Dk, Idx, A);
    If R <> 0 Then Exit;
    C := Mem[0:A];
    If C = 0 Then Exit;
    If (C <> $E5) And ((Mem[0:A + 11] And $3F) <> FatAttrLfn) Then
    Begin
      Same := True;
      For K := 0 To 10 Do
        If Mem[0:A + K] <> Mem[0:Sh + K] Then Same := False;
      If Same Then
      Begin
        FatShortExists := True;
        Exit;
      End;
    End;
    Inc(Idx);
  End;
End;

{ Ajouter une entree (avec noms longs si necessaire) dans Dk ; retourne
  l'indice de l'entree courte et le nombre d'entrees de nom long }
Function FatDirAdd(X : PFatSb; Dk : LongInt; Var Nm : String;
    Attr, First, Size : LongInt; Var EntIdx, NLfn : LongInt) : LongInt;
Var Sh : Array[0..10] Of Byte; Ent : Array[0..31] Of Byte;
    Lossy : Boolean; Nt, Nq, K, Idx, Run, RunStart, R, J, Seq, At, C, Sum,
    Dt, Tm, N, SA, A, Tl, Bl, Q : LongInt; Tail : String;
Begin
  SA := LongInt(@Sh[0]);
  A := LongInt(@Ent[0]);
  Nq := Utf8ToUcs(Nm, LongInt(@FatQ[0]));
  If Nq = 0 Then
  Begin
    FatDirAdd := -EINVAL;
    Exit;
  End;
  FatShortName(Nm, SA, Lossy, Nt);
  K := 0;
  If Lossy Then
  Begin
    K := (Nq + 12) Div 13;
    { nom court unique : BASE~N }
    N := 1;
    Bl := 0;
    While (Bl < 8) And (Sh[Bl] <> 32) Do Inc(Bl);
    While True Do
    Begin
      Tail := '~' + IntStr(N);
      Tl := Length(Tail);
      If Bl > 8 - Tl Then Q := 8 - Tl Else Q := Bl;
      For J := 0 To Tl - 1 Do Sh[Q + J] := Ord(Tail[J + 1]);
      For J := Q + Tl To 7 Do Sh[J] := 32;
      If Not FatShortExists(X, Dk, SA) Then Break;
      Inc(N);
      If N > 999999 Then
      Begin
        FatDirAdd := -ENOSPC;
        Exit;
      End;
    End;
    Nt := 0;
  End
  Else If FatShortExists(X, Dk, SA) Then
  Begin
    FatDirAdd := -EEXIST;
    Exit;
  End;
  { chercher K+1 entrees libres consecutives }
  Idx := 0;
  Run := 0;
  RunStart := 0;
  While Run < K + 1 Do
  Begin
    R := DirRead(X, Dk, Idx, A);
    If R = 1 Then
    Begin
      R := DirGrow(X, Dk);
      If R <> 0 Then
      Begin
        FatDirAdd := R;
        Exit;
      End;
      Continue;
    End;
    If R < 0 Then
    Begin
      FatDirAdd := R;
      Exit;
    End;
    C := Mem[0:A];
    If (C = 0) Or (C = $E5) Then
    Begin
      If Run = 0 Then RunStart := Idx;
      Inc(Run);
    End
    Else Run := 0;
    Inc(Idx);
  End;
  UnixToFat(NowSec, Dt, Tm);
  { entrees de nom long (la plus haute d'abord) }
  Sum := FatSum(SA);
  For J := 0 To K - 1 Do
  Begin
    Seq := K - J;
    MemFill(A, 0, FatEntSz);
    Mem[0:A] := Seq;
    If J = 0 Then Mem[0:A] := Seq Or $40;
    Mem[0:A + 11] := FatAttrLfn;
    Mem[0:A + 13] := Sum;
    At := (Seq - 1) * 13;
    For N := 0 To 12 Do
    Begin
      If At + N < Nq Then C := MemL[0:LongInt(@FatQ[0]) + (At + N) * 4]
      Else If At + N = Nq Then C := 0
      Else C := $FFFF;
      If N < 5 Then MemW[0:A + 1 + N * 2] := C
      Else If N < 11 Then MemW[0:A + 14 + (N - 5) * 2] := C
      Else MemW[0:A + 28 + (N - 11) * 2] := C;
    End;
    R := DirWrite(X, Dk, RunStart + J, A);
    If R <> 0 Then
    Begin
      FatDirAdd := R;
      Exit;
    End;
  End;
  MemFill(A, 0, FatEntSz);
  MemCopy(A, SA, 11);
  Mem[0:A + 11] := Attr;
  Mem[0:A + 12] := Nt;
  MemW[0:A + 14] := Tm;
  MemW[0:A + 16] := Dt;
  MemW[0:A + 18] := Dt;
  If X^.Typ = 32 Then MemW[0:A + 20] := (First Shr 16) And $FFFF;
  MemW[0:A + 22] := Tm;
  MemW[0:A + 24] := Dt;
  MemW[0:A + 26] := First And $FFFF;
  MemL[0:A + 28] := Size;
  R := DirWrite(X, Dk, RunStart + K, A);
  If R <> 0 Then
  Begin
    FatDirAdd := R;
    Exit;
  End;
  EntIdx := RunStart + K;
  NLfn := K;
  FatDirAdd := 0;
End;

{ Marquer comme supprimees les entrees Start..EntIdx }
Function FatDelEntries(X : PFatSb; Dk, Start, EntIdx : LongInt) : LongInt;
Var K, R, A : LongInt; Ent : Array[0..31] Of Byte;
Begin
  A := LongInt(@Ent[0]);
  FatDelEntries := 0;
  For K := Start To EntIdx Do
  Begin
    R := DirRead(X, Dk, K, A);
    If R <> 0 Then
    Begin
      FatDelEntries := R;
      Exit;
    End;
    Mem[0:A] := $E5;
    R := DirWrite(X, Dk, K, A);
    If R <> 0 Then
    Begin
      FatDelEntries := R;
      Exit;
    End;
  End;
End;

{ Repertoire vide (hors "." et "..") ? 0 ou -ENOTEMPTY }
Function FatDirEmpty(X : PFatSb; Dk : LongInt) : LongInt;
Var Idx, R, C, A : LongInt; Ent : Array[0..31] Of Byte;
Begin
  A := LongInt(@Ent[0]);
  Idx := 0;
  While True Do
  Begin
    R := DirRead(X, Dk, Idx, A);
    If R = 1 Then
    Begin
      FatDirEmpty := 0;
      Exit;
    End;
    If R < 0 Then
    Begin
      FatDirEmpty := R;
      Exit;
    End;
    C := Mem[0:A];
    If C = 0 Then
    Begin
      FatDirEmpty := 0;
      Exit;
    End;
    If (C <> $E5) And ((Mem[0:A + 11] And $3F) <> FatAttrLfn)
       And ((Mem[0:A + 11] And FatAttrVol) = 0)
       And Not ((C = 46) And ((Mem[0:A + 1] = 32) Or ((Mem[0:A + 1] = 46)
       And (Mem[0:A + 2] = 32)))) Then
    Begin
      FatDirEmpty := -ENOTEMPTY;
      Exit;
    End;
    Inc(Idx);
  End;
End;

{ ---- Operations sur les repertoires ---- }

Function FatLookup(Dir : PInode; Var Nm : String; Var Res : PInode) : LongInt;
Var X : PFatSb; Ent : Array[0..31] Of Byte; A, R, Start, EI : LongInt;
Begin
  If Length(Nm) > 255 Then
  Begin
    FatLookup := -ENAMETOOLONG;
    Exit;
  End;
  X := FatOf(Dir^.Sb);
  A := LongInt(@Ent[0]);
  R := FatFind(X, FatDirOf(Dir), Nm, A, Start, EI);
  If R <> 0 Then
  Begin
    FatLookup := R;
    Exit;
  End;
  FatLookup := FatGetIno(Dir^.Sb, FatDirOf(Dir), EI, EI - Start, A, Res);
End;

Function FatReaddir(F : PFile; Var Ino : LongInt; Var Nm : String;
    Var DType : LongInt) : LongInt;
Var D : PInode; X : PFatSb; Ent : Array[0..31] Of Byte; Idx, R, Start, EI,
    Nu, A : LongInt;
Begin
  D := F^.Inode;
  X := FatOf(D^.Sb);
  A := LongInt(@Ent[0]);
  If F^.Pos = 0 Then
  Begin
    Ino := D^.Ino; Nm := '.'; DType := DT_DIR;
    F^.Pos := 1;
    FatReaddir := 1;
    Exit;
  End;
  If F^.Pos = 1 Then
  Begin
    Ino := 1; Nm := '..'; DType := DT_DIR;
    F^.Pos := 2;
    FatReaddir := 1;
    Exit;
  End;
  Idx := F^.Pos - 2;
  R := DirNext(X, FatDirOf(D), Idx, A, Nm, Start, EI,
      LongInt(@FatU[0]), Nu);
  If R <> 0 Then
  Begin
    If R = 1 Then FatReaddir := 0 Else FatReaddir := R;
    Exit;
  End;
  F^.Pos := Idx + 2;
  Ino := (FatDirOf(D) Shl 12) Xor (EI + 2);
  If Ino = 0 Then Ino := 1;
  If (Mem[0:A + 11] And FatAttrDir) <> 0 Then DType := DT_DIR
  Else DType := DT_REG;
  FatReaddir := 1;
End;

Function FatCreate(Dir : PInode; Var Nm : String; Mode : LongInt;
    Var Res : PInode) : LongInt;
Var X : PFatSb; Ent : Array[0..31] Of Byte; A, R, Start, EI, NL, Dk : LongInt;
Begin
  X := FatOf(Dir^.Sb);
  A := LongInt(@Ent[0]);
  Dk := FatDirOf(Dir);
  R := FatCheckName(Nm);
  If R <> 0 Then
  Begin
    FatCreate := R;
    Exit;
  End;
  R := FatFind(X, Dk, Nm, A, Start, EI);
  If R = 0 Then
  Begin
    FatCreate := -EEXIST;
    Exit;
  End;
  If R <> -ENOENT Then
  Begin
    FatCreate := R;
    Exit;
  End;
  R := FatDirAdd(X, Dk, Nm, FatAttrArc, 0, 0, EI, NL);
  If R <> 0 Then
  Begin
    FatCreate := R;
    Exit;
  End;
  DirRead(X, Dk, EI, A);
  R := FatGetIno(Dir^.Sb, Dk, EI, NL, A, Res);
  Dir^.Mtime := NowSec; Dir^.Ctime := Dir^.Mtime;
  DentryPurgeSb(Dir^.Sb);
  FatCreate := R;
End;

Function FatMkdir(Dir : PInode; Var Nm : String; Mode : LongInt) : LongInt;
Var X : PFatSb; Ent : Array[0..31] Of Byte; A, R, Start, EI, NL, Dk, C, Par,
    Sec, Dt, Tm, K : LongInt; B : PBuf; I : PInode;
Begin
  X := FatOf(Dir^.Sb);
  A := LongInt(@Ent[0]);
  Dk := FatDirOf(Dir);
  R := FatCheckName(Nm);
  If R <> 0 Then
  Begin
    FatMkdir := R;
    Exit;
  End;
  R := FatFind(X, Dk, Nm, A, Start, EI);
  If R = 0 Then
  Begin
    FatMkdir := -EEXIST;
    Exit;
  End;
  If R <> -ENOENT Then
  Begin
    FatMkdir := R;
    Exit;
  End;
  R := FatAlloc(X, True, C);
  If R <> 0 Then
  Begin
    FatMkdir := R;
    Exit;
  End;
  If FatInoOf(Dir)^.Parent < 0 Then Par := 0 Else Par := Dk;
  Sec := FatSecOfClus(X, C);
  B := FatBuf(X, Sec);
  If B = Nil Then
  Begin
    FatFreeChain(X, C);
    FatMkdir := -EIO;
    Exit;
  End;
  UnixToFat(NowSec, Dt, Tm);
  MemFill(B^.Data, 0, FatEntSz * 2);
  MemFill(B^.Data, 32, 11);
  Mem[0:B^.Data] := 46;
  Mem[0:B^.Data + 11] := FatAttrDir;
  MemW[0:B^.Data + 14] := Tm; MemW[0:B^.Data + 16] := Dt;
  MemW[0:B^.Data + 18] := Dt;
  MemW[0:B^.Data + 22] := Tm; MemW[0:B^.Data + 24] := Dt;
  MemW[0:B^.Data + 26] := C And $FFFF;
  If X^.Typ = 32 Then MemW[0:B^.Data + 20] := (C Shr 16) And $FFFF;
  MemCopy(B^.Data + 32, B^.Data, 32);
  Mem[0:B^.Data + 33] := 46;
  MemW[0:B^.Data + 32 + 26] := Par And $FFFF;
  If X^.Typ = 32 Then MemW[0:B^.Data + 32 + 20] := (Par Shr 16) And $FFFF;
  BDirty(B);
  BRelease(B);
  K := 0;
  R := FatDirAdd(X, Dk, Nm, FatAttrDir, C, 0, EI, NL);
  If R <> 0 Then
  Begin
    FatFreeChain(X, C);
    FatMkdir := R;
    Exit;
  End;
  DirRead(X, Dk, EI, A);
  R := FatGetIno(Dir^.Sb, Dk, EI, NL, A, I);
  If R = 0 Then InodePut(LongInt(I));
  Dir^.Mtime := NowSec; Dir^.Ctime := Dir^.Mtime;
  DentryPurgeSb(Dir^.Sb);
  FatMkdir := R;
End;

Function FatUnlink(Dir : PInode; Var Nm : String; I : PInode) : LongInt;
Var X : PFatSb; P : PFatIno; R : LongInt;
Begin
  X := FatOf(Dir^.Sb);
  P := FatInoOf(I);
  If (P = Nil) Or (P^.Parent < 0) Then
  Begin
    FatUnlink := -ENOENT;
    Exit;
  End;
  R := FatDelEntries(X, P^.Parent, P^.Idx - P^.NLfn, P^.Idx);
  If R <> 0 Then
  Begin
    FatUnlink := R;
    Exit;
  End;
  P^.Parent := -2;
  I^.Nlink := 0;
  I^.Ctime := NowSec;
  Dir^.Mtime := I^.Ctime; Dir^.Ctime := I^.Ctime;
  DentryPurgeSb(Dir^.Sb);
  FatUnlink := 0;
End;

Function FatRmdir(Dir : PInode; Var Nm : String; I : PInode) : LongInt;
Var X : PFatSb; R : LongInt;
Begin
  X := FatOf(Dir^.Sb);
  R := FatDirEmpty(X, FatDirOf(I));
  If R <> 0 Then
  Begin
    FatRmdir := R;
    Exit;
  End;
  FatRmdir := FatUnlink(Dir, Nm, I);
End;

Function FatRename(OD : PInode; Var ON : String; ND : PInode; Var NN : String;
    Dummy : LongInt) : LongInt;
Var X : PFatSb; E1, E2, E3 : Array[0..31] Of Byte; A1, A2, A3, Dk1, Dk2, R,
    S1, I1, S2, I2, NL, EIn, Par, K : LongInt; I, V : PInode;
    IsD, Same : Boolean;
    P, PV : PFatIno; Attr, First, Size : LongInt;
Begin
  X := FatOf(OD^.Sb);
  A1 := LongInt(@E1[0]); A2 := LongInt(@E2[0]); A3 := LongInt(@E3[0]);
  Dk1 := FatDirOf(OD); Dk2 := FatDirOf(ND);
  R := FatCheckName(NN);
  If R <> 0 Then
  Begin
    FatRename := R;
    Exit;
  End;
  R := FatFind(X, Dk1, ON, A1, S1, I1);
  If R <> 0 Then
  Begin
    FatRename := R;
    Exit;
  End;
  R := FatGetIno(OD^.Sb, Dk1, I1, I1 - S1, A1, I);
  If R <> 0 Then
  Begin
    FatRename := R;
    Exit;
  End;
  IsD := IsDir(I);
  V := Nil;
  Same := False;
  R := FatFind(X, Dk2, NN, A2, S2, I2);
  If R = 0 Then
  Begin
    R := FatGetIno(OD^.Sb, Dk2, I2, I2 - S2, A2, V);
    If R <> 0 Then
    Begin
      InodePut(LongInt(I));
      FatRename := R;
      Exit;
    End;
    If V = I Then
    Begin
      InodePut(LongInt(V));
      V := Nil;
      If ON = NN Then
      Begin
        InodePut(LongInt(I));
        FatRename := 0;
        Exit;
      End;
      Same := True;
    End
    Else
    Begin
      R := 0;
      If IsDir(V) And Not IsD Then R := -EISDIR
      Else If IsD And Not IsDir(V) Then R := -ENOTDIR
      Else If IsD Then R := FatDirEmpty(X, FatDirOf(V));
      If R <> 0 Then
      Begin
        InodePut(LongInt(V)); InodePut(LongInt(I));
        FatRename := R;
        Exit;
      End;
    End;
  End
  Else If R <> -ENOENT Then
  Begin
    InodePut(LongInt(I));
    FatRename := R;
    Exit;
  End;
  P := FatInoOf(I);
  Attr := Mem[0:A1 + 11];
  First := P^.First;
  Size := MemL[0:A1 + 28];
  MemCopy(A3, A1, FatEntSz);
  If V <> Nil Then
  Begin
    PV := FatInoOf(V);
    R := FatDelEntries(X, PV^.Parent, PV^.Idx - PV^.NLfn, PV^.Idx);
    PV^.Parent := -2;
    V^.Nlink := 0;
    V^.Ctime := NowSec;
    InodePut(LongInt(V));
  End;
  If Same Then FatDelEntries(X, Dk1, S1, I1);
  R := FatDirAdd(X, Dk2, NN, Attr, First, Size, EIn, NL);
  If R <> 0 Then
  Begin
    InodePut(LongInt(I));
    FatRename := R;
    Exit;
  End;
  { conserver les dates de l'entree d'origine }
  DirRead(X, Dk2, EIn, A2);
  MemCopy(A2 + 13, A3 + 13, 7);
  MemCopy(A2 + 22, A3 + 22, 4);
  DirWrite(X, Dk2, EIn, A2);
  If Not Same Then FatDelEntries(X, Dk1, S1, I1);
  P^.Parent := Dk2;
  P^.Idx := EIn;
  P^.NLfn := NL;
  If IsD And (Dk1 <> Dk2) Then
  Begin
    If FatInoOf(ND)^.Parent < 0 Then Par := 0 Else Par := Dk2;
    If DirRead(X, First, 1, A2) = 0 Then
    Begin
      MemW[0:A2 + 26] := Par And $FFFF;
      If X^.Typ = 32 Then MemW[0:A2 + 20] := (Par Shr 16) And $FFFF;
      DirWrite(X, First, 1, A2);
    End;
  End;
  K := NowSec;
  OD^.Mtime := K; OD^.Ctime := K; ND^.Mtime := K; ND^.Ctime := K;
  I^.Ctime := K;
  InodePut(LongInt(I));
  DentryPurgeSb(OD^.Sb);
  FatRename := 0;
End;

{ ---- Fichiers : chaines de clusters ---- }

{ Cluster d'indice Idx de la chaine de l'inode : 0, 1 (absent), <0 }
Function FatClusAt(I : PInode; Idx : LongInt; Var Clus : LongInt) : LongInt;
Var P : PFatIno; X : PFatSb; C, K, Nx : LongInt;
Begin
  P := FatInoOf(I);
  X := FatOf(I^.Sb);
  If P^.First < 2 Then
  Begin
    FatClusAt := 1;
    Exit;
  End;
  If (P^.CurClus >= 2) And (P^.CurIdx <= Idx) Then
  Begin
    C := P^.CurClus;
    K := P^.CurIdx;
  End
  Else
  Begin
    C := P^.First;
    K := 0;
  End;
  While K < Idx Do
  Begin
    Nx := FatGet(X, C);
    If Nx = $0FFFFFF8 Then
    Begin
      P^.CurClus := C;
      P^.CurIdx := K;
      FatClusAt := 1;
      Exit;
    End;
    If Nx < 2 Then
    Begin
      FatClusAt := -EIO;
      Exit;
    End;
    C := Nx;
    Inc(K);
  End;
  P^.CurClus := C;
  P^.CurIdx := K;
  Clus := C;
  FatClusAt := 0;
End;

{ Idem, en allongeant la chaine (clusters nuls) si Create }
Function FatClusFor(I : PInode; Idx : LongInt; Create : Boolean;
    Var Clus : LongInt) : LongInt;
Var P : PFatIno; X : PFatSb; R, K, C, N : LongInt;
Begin
  R := FatClusAt(I, Idx, Clus);
  If (R <> 1) Or (Not Create) Then
  Begin
    FatClusFor := R;
    Exit;
  End;
  P := FatInoOf(I);
  X := FatOf(I^.Sb);
  If P^.First < 2 Then
  Begin
    R := FatAlloc(X, True, N);
    If R <> 0 Then
    Begin
      FatClusFor := R;
      Exit;
    End;
    P^.First := N;
    K := 0;
    C := N;
  End
  Else
  Begin
    K := P^.CurIdx;
    C := P^.CurClus;
  End;
  While K < Idx Do
  Begin
    R := FatAlloc(X, True, N);
    If R <> 0 Then
    Begin
      P^.CurClus := C;
      P^.CurIdx := K;
      FatClusFor := R;
      Exit;
    End;
    FatSet(X, C, N);
    C := N;
    Inc(K);
  End;
  P^.CurClus := C;
  P^.CurIdx := K;
  Clus := C;
  FatClusFor := 0;
End;

{ SoBmap : secteur du cluster de rang LBlk du fichier I }
Function FatSoBmap(I : PInode; LBlk : LongInt; Var Sector : LongInt) : LongInt;
Var C, R : LongInt;
Begin
  R := FatClusAt(I, LBlk, C);
  If R <> 0 Then
  Begin
    If R = 1 Then FatSoBmap := -EINVAL Else FatSoBmap := R;
    Exit;
  End;
  Sector := FatSecOfClus(FatOf(I^.Sb), C);
  FatSoBmap := 0;
End;

Function FatRead(F : PFile; Buf, Cnt : LongInt) : LongInt;
Var I : PInode; X : PFatSb; N, Done, Idx, OffC, Off, Chunk, Sec, R, C : LongInt;
    RL, RH : LongInt; B : PBuf;
Begin
  I := F^.Inode;
  X := FatOf(I^.Sb);
  If U64Le(I^.Size, 0, F^.Pos, F^.PosHi) Then
  Begin
    FatRead := 0;
    Exit;
  End;
  RL := I^.Size; RH := 0;
  U64Sub(RL, RH, F^.Pos, F^.PosHi);
  If (RH <> 0) Or Not ULt(RL, Cnt) Then N := Cnt Else N := RL;
  Done := 0;
  While Done < N Do
  Begin
    Idx := U64ShrL(F^.Pos, F^.PosHi, X^.ClusBits);
    OffC := F^.Pos And (X^.ClusBytes - 1);
    R := FatClusAt(I, Idx, C);
    If R <> 0 Then
    Begin
      If Done > 0 Then FatRead := Done
      Else If R = 1 Then FatRead := -EIO
      Else FatRead := R;
      Exit;
    End;
    Sec := FatSecOfClus(X, C) + OffC Div X^.Bps;
    Off := OffC Mod X^.Bps;
    Chunk := X^.Bps - Off;
    If Chunk > N - Done Then Chunk := N - Done;
    B := FatBuf(X, Sec);
    If B = Nil Then
    Begin
      If Done > 0 Then FatRead := Done Else FatRead := -EIO;
      Exit;
    End;
    MemCopy(Buf + Done, B^.Data + Off, Chunk);
    BRelease(B);
    Done := Done + Chunk;
    U64AddU(F^.Pos, F^.PosHi, Chunk);
  End;
  I^.Atime := NowSec;
  FatRead := Done;
End;

Function FatWrite(F : PFile; Buf, Cnt : LongInt) : LongInt;
Var I : PInode; X : PFatSb; Done, Idx, OffC, Off, Chunk, Sec, R, C, K,
    Res, LastK : LongInt; B : PBuf;
Begin
  I := F^.Inode;
  X := FatOf(I^.Sb);
  { taille maximale d'un fichier FAT : 4 Go - 1 }
  If (F^.PosHi <> 0) Or (F^.Pos = -1) Then
  Begin
    FatWrite := -EFBIG;
    Exit;
  End;
  If ULt(Not F^.Pos, Cnt) Then Cnt := Not F^.Pos;
  Done := 0;
  Res := 0;
  If ULt(I^.Size, F^.Pos) Then
  Begin
    LastK := U64ShrL(F^.Pos - 1, 0, X^.ClusBits);
    For K := 0 To LastK Do
    Begin
      R := FatClusFor(I, K, True, C);
      If R <> 0 Then
      Begin
        Res := R;
        Break;
      End;
    End;
  End;
  While (Res = 0) And (Done < Cnt) Do
  Begin
    Idx := U64ShrL(F^.Pos, F^.PosHi, X^.ClusBits);
    OffC := F^.Pos And (X^.ClusBytes - 1);
    R := FatClusFor(I, Idx, True, C);
    If R <> 0 Then
    Begin
      Res := R;
      Break;
    End;
    Sec := FatSecOfClus(X, C) + OffC Div X^.Bps;
    Off := OffC Mod X^.Bps;
    Chunk := X^.Bps - Off;
    If Chunk > Cnt - Done Then Chunk := Cnt - Done;
    If Chunk = X^.Bps Then B := BGetBlk(X^.Dev, Sec, X^.Bps)
    Else B := FatBuf(X, Sec);
    If B = Nil Then
    Begin
      Res := -EIO;
      Break;
    End;
    MemCopy(B^.Data + Off, Buf + Done, Chunk);
    BDirty(B);
    BRelease(B);
    Done := Done + Chunk;
    F^.Pos := F^.Pos + Chunk;
    If ULt(I^.Size, F^.Pos) Then I^.Size := F^.Pos;
  End;
  If Done > 0 Then
  Begin
    I^.Mtime := NowSec; I^.Ctime := I^.Mtime;
    I^.Blocks := FatBlocksOf(X, I^.Size);
  End;
  If (Done > 0) Or (I^.Dirty <> 0) Then FatWriteInode(I);
  If Done > 0 Then FatWrite := Done Else FatWrite := Res;
End;

Function FatTruncate(I : PInode; Size : LongInt) : LongInt;
Var X : PFatSb; P : PFatIno; Need, R, C, Nx, Off, S, A0, Sec, NL, NH : LongInt;
    B : PBuf;
Begin
  X := FatOf(I^.Sb);
  P := FatInoOf(I);
  If I^.SizeHi <> 0 Then
  Begin
    FatTruncate := -EFBIG;
    Exit;
  End;
  If Size = 0 Then
  Begin
    If P^.First >= 2 Then FatFreeChain(X, P^.First);
    P^.First := 0;
    P^.CurClus := 0;
  End
  Else
  Begin
    NL := Size; NH := 0;
    U64AddU(NL, NH, X^.ClusBytes - 1);
    Need := U64ShrL(NL, NH, X^.ClusBits);
    R := FatClusFor(I, Need - 1, True, C);
    If R <> 0 Then
    Begin
      FatTruncate := R;
      Exit;
    End;
    Nx := FatGet(X, C);
    If (Nx >= 2) And (Nx <> $0FFFFFF8) Then
    Begin
      FatSet(X, C, FatEoc(X));
      FatFreeChain(X, Nx);
    End;
    { zeros apres la nouvelle fin, dans le dernier cluster }
    Off := Size And (X^.ClusBytes - 1);
    If Off <> 0 Then
    Begin
      For S := Off Div X^.Bps To X^.Spc - 1 Do
      Begin
        Sec := FatSecOfClus(X, C) + S;
        B := FatBuf(X, Sec);
        If B = Nil Then Break;
        If S = Off Div X^.Bps Then A0 := Off Mod X^.Bps Else A0 := 0;
        MemFill(B^.Data + A0, 0, X^.Bps - A0);
        BDirty(B);
        BRelease(B);
      End;
    End;
    P^.CurClus := 0;
  End;
  I^.Blocks := FatBlocksOf(X, Size);
  I^.Mtime := NowSec; I^.Ctime := I^.Mtime;
  FatTruncate := FatWriteInode(I);
End;

Procedure FatSync(Sb : PSuper);
Var X : PFatSb; B : PBuf;
Begin
  X := FatOf(Sb);
  If X = Nil Then Exit;
  If ((Sb^.Flags And MS_RDONLY) = 0) And (X^.Typ = 32) And (X^.FsInfo > 0)
     And (X^.FsInfo < X^.Rsvd) Then
  Begin
    B := FatBuf(X, X^.FsInfo);
    If B <> Nil Then
    Begin
      If (MemL[0:B^.Data] = $41615252) And (MemL[0:B^.Data + 484] = $61417272)
      Then
      Begin
        MemL[0:B^.Data + 488] := X^.Free;
        MemL[0:B^.Data + 492] := X^.Hint;
        BDirty(B);
      End;
      BRelease(B);
    End;
  End;
  BSync(X^.Dev);
End;

Function FatFsync(F : PFile) : LongInt;
Begin
  FatWriteInode(F^.Inode);
  FatSync(F^.Inode^.Sb);
  FatFsync := 0;
End;

Function FatSetattr(I : PInode) : LongInt;
Var P : PFatIno; R : LongInt;
Begin
  P := FatInoOf(I);
  R := FatWriteInode(I);
  If P <> Nil Then I^.Mode := FatModeOf(FatOf(I^.Sb), P^.Attr);
  FatSetattr := R;
End;

Procedure FatUmount(Sb : PSuper);
Var X : PFatSb;
Begin
  X := FatOf(Sb);
  If X = Nil Then Exit;
  FatSync(Sb);
  KFree(LongInt(X));
  Sb^.Priv := 0;
End;

Function FatRemount(Sb : PSuper; NewFlags : LongInt) : LongInt;
Begin
  If ((Sb^.Flags And MS_RDONLY) <> 0) And ((NewFlags And MS_RDONLY) = 0)
     And (Sb^.Used <> 0) Then
  Begin
    FatRemount := -EROFS;
    Exit;
  End;
  If (NewFlags And MS_RDONLY) <> 0 Then FatSync(Sb);
  Sb^.Flags := (Sb^.Flags And Not MS_RDONLY) Or (NewFlags And MS_RDONLY);
  FatRemount := 0;
End;

Procedure FatStatfs(Sb : PSuper; Buf : LongInt);
Var X : PFatSb;
Begin
  X := FatOf(Sb);
  MemL[0:Buf] := X^.ClusBytes;
  MemL[0:Buf + 4] := X^.Clusters;
  MemL[0:Buf + 8] := X^.Free;
  MemL[0:Buf + 12] := X^.Free;
  MemL[0:Buf + 16] := 0;
  MemL[0:Buf + 20] := 0;
  MemL[0:Buf + 24] := 255;
  MemL[0:Buf + 28] := FatMagic;
End;

{ ---- Montage ---- }

Function FatMount(Sb : PSuper; Var DevName : String; Flags,
    Data : LongInt) : LongInt;
Var Dev, K, A, Tot, FatSz, Rds, N, Pos : LongInt; B : PBuf; X : PFatSb;
    Ino : PInode; D : PDentry; Opt, Tok : String; Fb : PBuf; V : LongInt;
Begin
  FatMount := -EINVAL;
  Dev := ExResolveDev(DevName);
  If Dev = 0 Then
  Begin
    FatMount := -ENOTBLK;
    Exit;
  End;
  If BlkSectors(Dev) = 0 Then
  Begin
    FatMount := -ENXIO;
    Exit;
  End;
  For K := 0 To MaxSupers - 1 Do
    If (Supers[K] <> Nil) And (Supers[K] <> Sb) And (Supers[K]^.Dev = Dev) Then
    Begin
      FatMount := -EBUSY;
      Exit;
    End;
  B := BRead(Dev, 0, 512);
  If B = Nil Then
  Begin
    FatMount := -EIO;
    Exit;
  End;
  A := B^.Data;
  If ((Mem[0:A] <> $EB) And (Mem[0:A] <> $E9)) Or (MemW[0:A + 510] <> $AA55)
  Then
  Begin
    BRelease(B);
    Exit;
  End;
  X := Pointer(KMallocZ(SizeOf(TFatSb)));
  If X = Nil Then
  Begin
    BRelease(B);
    FatMount := -ENOMEM;
    Exit;
  End;
  X^.Dev := Dev;
  X^.Bps := MemW[0:A + 11];
  X^.Spc := Mem[0:A + 13];
  X^.Rsvd := MemW[0:A + 14];
  X^.NFats := Mem[0:A + 16];
  X^.RootEnts := MemW[0:A + 17];
  Tot := MemW[0:A + 19];
  If Tot = 0 Then Tot := MemL[0:A + 32];
  FatSz := MemW[0:A + 22];
  If FatSz = 0 Then FatSz := MemL[0:A + 36];
  X^.FatSz := FatSz;
  If (X^.Bps < 512) Or (X^.Bps > 4096) Or ((X^.Bps And (X^.Bps - 1)) <> 0)
     Or (X^.Spc = 0) Or ((X^.Spc And (X^.Spc - 1)) <> 0)
     Or (X^.Bps * X^.Spc > 65536) Or (X^.Rsvd = 0) Or (X^.NFats = 0)
     Or (FatSz = 0) Or (Tot = 0) Then
  Begin
    KLog('fat : secteur de boot incoherent');
    BRelease(B);
    KFree(LongInt(X));
    Exit;
  End;
  X^.ClusBytes := X^.Bps * X^.Spc;
  X^.ClusBits := Log2U(X^.ClusBytes);
  Rds := (X^.RootEnts * 32 + X^.Bps - 1) Div X^.Bps;
  X^.FatStart := X^.Rsvd;
  X^.RootStart := X^.Rsvd + X^.NFats * FatSz;
  X^.DataStart := X^.RootStart + Rds;
  If Tot <= X^.DataStart Then
  Begin
    BRelease(B);
    KFree(LongInt(X));
    Exit;
  End;
  X^.Clusters := (Tot - X^.DataStart) Div X^.Spc;
  If X^.Clusters < 4085 Then X^.Typ := 12
  Else If X^.Clusters < 65525 Then X^.Typ := 16
  Else X^.Typ := 32;
  If X^.Typ = 32 Then
  Begin
    X^.RootClus := MemL[0:A + 44];
    X^.FsInfo := MemW[0:A + 48];
    If (X^.RootClus < 2) Or (X^.RootEnts <> 0) Then
    Begin
      KLog('fat : racine FAT32 invalide');
      BRelease(B);
      KFree(LongInt(X));
      Exit;
    End;
  End
  Else If X^.RootEnts = 0 Then
  Begin
    BRelease(B);
    KFree(LongInt(X));
    Exit;
  End;
  BRelease(B);
  If X^.FatStart + FatSz * X^.NFats > BlkSectors(Dev) Div (X^.Bps Div 512) Then
  Begin
    KLog('fat : peripherique trop petit');
    KFree(LongInt(X));
    Exit;
  End;
  X^.Free := -1;
  X^.Hint := 2;
  X^.DCDir := -1;
  X^.Umask := 18;
  X^.Uid := 0;
  X^.Gid := 0;
  { options : ro, rw, umask=NNN (octal), uid=N, gid=N }
  If Data <> 0 Then
    If GetUserStr(Data, Opt) = 0 Then
    Begin
      Pos := 1;
      While Pos <= Length(Opt) Do
      Begin
        K := Pos;
        While (K <= Length(Opt)) And (Opt[K] <> ',') Do Inc(K);
        Tok := Copy(Opt, Pos, K - Pos);
        If Tok = 'ro' Then Flags := Flags Or MS_RDONLY
        Else If Tok = 'rw' Then Flags := Flags And Not MS_RDONLY
        Else If Copy(Tok, 1, 6) = 'umask=' Then
        Begin
          V := 0;
          For N := 7 To Length(Tok) Do
            V := V * 8 + (Ord(Tok[N]) - 48);
          X^.Umask := V And $1FF;
        End
        Else If Copy(Tok, 1, 4) = 'uid=' Then
          X^.Uid := StrVal(Copy(Tok, 5, 10))
        Else If Copy(Tok, 1, 4) = 'gid=' Then
          X^.Gid := StrVal(Copy(Tok, 5, 10));
        Pos := K + 1;
      End;
    End;
  { nombre de clusters libres : FSInfo (FAT32) ou comptage }
  If (X^.Typ = 32) And (X^.FsInfo > 0) And (X^.FsInfo < X^.Rsvd) Then
  Begin
    Fb := BRead(Dev, X^.FsInfo, X^.Bps);
    If Fb <> Nil Then
    Begin
      If (MemL[0:Fb^.Data] = $41615252) And (MemL[0:Fb^.Data + 484] = $61417272)
         And (MemL[0:Fb^.Data + 488] >= 0)
         And (MemL[0:Fb^.Data + 488] <= X^.Clusters) Then
      Begin
        X^.Free := MemL[0:Fb^.Data + 488];
        V := MemL[0:Fb^.Data + 492];
        If (V >= 2) And (V < X^.Clusters + 2) Then X^.Hint := V;
      End;
      BRelease(Fb);
    End;
  End;
  If X^.Free < 0 Then
  Begin
    X^.Free := 0;
    For K := 2 To X^.Clusters + 1 Do
      If FatGet(X, K) = 0 Then Inc(X^.Free);
  End;
  Sb^.Priv := LongInt(X);
  Sb^.Dev := Dev;
  Sb^.BlockSize := X^.ClusBytes;
  Sb^.LargeFiles := 1;
  Sb^.SOps := LongInt(@FatSOps[0]);
  Sb^.Flags := Flags;
  Sb^.Used := 0;
  Sb^.NextIno := 1;
  Ino := NewInode(Sb, S_IFDIR Or ($1FF And Not X^.Umask));
  If Ino = Nil Then
  Begin
    KFree(LongInt(X));
    Sb^.Priv := 0;
    FatMount := -ENOMEM;
    Exit;
  End;
  Ino^.Priv := KMallocZ(SizeOf(TFatIno));
  If Ino^.Priv = 0 Then
  Begin
    Ino^.Nlink := 0;
    InodePut(LongInt(Ino));
    KFree(LongInt(X));
    Sb^.Priv := 0;
    FatMount := -ENOMEM;
    Exit;
  End;
  FatInoOf(Ino)^.Parent := -1;
  If X^.Typ = 32 Then FatInoOf(Ino)^.First := X^.RootClus
  Else FatInoOf(Ino)^.First := 0;
  Ino^.Uid := X^.Uid; Ino^.Gid := X^.Gid;
  Ino^.Nlink := 2;
  If X^.Typ = 32 Then Ino^.Size := FatChainLen(X, X^.RootClus) * X^.ClusBytes
  Else Ino^.Size := X^.RootEnts * 32;
  FatSetOps(Ino);
  D := DentryNew(Nil, '', Ino, Sb);
  If D = Nil Then
  Begin
    InodePut(LongInt(Ino));
    InodePurgeSb(Sb);
    KFree(LongInt(X));
    Sb^.Priv := 0;
    FatMount := -ENOMEM;
    Exit;
  End;
  Sb^.Root := D;
  FatMount := 0;
End;

Procedure InitFat;
Begin
  MemFill(LongInt(@FatFileIOps[0]), 0, SizeOf(FatFileIOps));
  FatFileIOps[IoTruncate] := LongInt(@FatTruncate);
  FatFileIOps[IoSetattr] := LongInt(@FatSetattr);
  MemFill(LongInt(@FatDirIOps[0]), 0, SizeOf(FatDirIOps));
  FatDirIOps[IoLookup] := LongInt(@FatLookup);
  FatDirIOps[IoCreate] := LongInt(@FatCreate);
  FatDirIOps[IoMkdir] := LongInt(@FatMkdir);
  FatDirIOps[IoUnlink] := LongInt(@FatUnlink);
  FatDirIOps[IoRmdir] := LongInt(@FatRmdir);
  FatDirIOps[IoRename] := LongInt(@FatRename);
  FatDirIOps[IoSetattr] := LongInt(@FatSetattr);
  MemFill(LongInt(@FatFileFOps[0]), 0, SizeOf(FatFileFOps));
  FatFileFOps[FoRead] := LongInt(@FatRead);
  FatFileFOps[FoWrite] := LongInt(@FatWrite);
  FatFileFOps[FoFsync] := LongInt(@FatFsync);
  MemFill(LongInt(@FatDirFOps[0]), 0, SizeOf(FatDirFOps));
  FatDirFOps[FoReaddir] := LongInt(@FatReaddir);
  FatDirFOps[FoFsync] := LongInt(@FatFsync);
  MemFill(LongInt(@FatSOps[0]), 0, SizeOf(FatSOps));
  FatSOps[SoPutInode] := LongInt(@FatPutInode);
  FatSOps[SoWriteInode] := LongInt(@FatWriteInode);
  FatSOps[SoStatfs] := LongInt(@FatStatfs);
  FatSOps[SoSync] := LongInt(@FatSync);
  FatSOps[SoUmount] := LongInt(@FatUmount);
  FatSOps[SoRemount] := LongInt(@FatRemount);
  FatSOps[SoBmap] := LongInt(@FatSoBmap);
  RegisterFs('vfat', LongInt(@FatMount));
  RegisterFs('msdos', LongInt(@FatMount));
  RegisterFs('fat', LongInt(@FatMount));
End;

{ ==================================================================== }
{ Partie 26 - Swap (pagination sur disque des pages anonymes)          }
{ ==================================================================== }
{ (placee avant la partie 16) }

{ swapon(2)/swapoff(2) sur un peripherique bloc prepare par mkswap (version
  1, signature SWAPSPACE2, pages de 4 Ko) ; swap=/dev/hdaN sur la ligne de
  commande l'active au demarrage. Quand les pages libres tombent sous
  SwapLow, SwapReclaim ecrit sur le disque des pages anonymes privees (VMA
  sans fichier, une seule reference, bit "accede" a zero : seconde chance
  par balayage) et remplace leur PTE par un numero de case (bit 9, PTE non
  present). Une faute de page relit la case. Les cases partagees (fork)
  sont comptees ; les pages partagees par copie sur ecriture, les mappages
  de fichiers et la memoire video ne sont jamais ecrits. 128 Mo au plus. }

Var
  SwapMapOrder : LongInt;
  SwapNm : String;
  SwapFile, SwapPrio, SwapMapF, SwapMapFOrder, SwapChunks, SwapChunkSec,
  SwapIno : LongInt;         { swap sur fichier ordinaire (partie 36) }
  ModIrqFn, ModIrqOwn : Array[0..15] Of LongInt;   { IRQ des modules }

{ Numero de secteur (512 octets, sur le peripherique du systeme de
  fichiers) du bloc logique L d'un fichier : 0 ou -errno }
Function SwapBmap(I : PInode; L : LongInt; Var Sector : LongInt) : LongInt;
Var Fn : LongInt;
Begin
  Fn := GetOp(I^.Sb^.SOps, SoBmap);
  If Fn = 0 Then SwapBmap := -EINVAL
  Else SwapBmap := Call3(Fn, LongInt(I), L, LongInt(@Sector));
End;

{ Lecture ou ecriture de la page de la case S (disque ou fichier) }
Function SwapIo(S, Page : LongInt; Write : Boolean) : LongInt;
Var K, R : LongInt;
Begin
  If SwapFile = 0 Then
  Begin
    SwapIo := BlkRW(SwapDev, S * 8, 8, Page, Write);
    Exit;
  End;
  For K := 0 To SwapChunks - 1 Do
  Begin
    R := BlkRW(SwapDev, MemL[0:SwapMapF + (S * SwapChunks + K) * 4],
        SwapChunkSec, Page + K * SwapChunkSec * 512, Write);
    If R <> 0 Then
    Begin
      SwapIo := R;
      Exit;
    End;
  End;
  SwapIo := 0;
End;

Function SwapAlloc : LongInt;
Var N, S : LongInt;
Begin
  SwapAlloc := 0;
  For N := 1 To SwapSlots - 1 Do
  Begin
    S := SwapHint + N - 1;
    If S >= SwapSlots Then S := S - SwapSlots + 1;
    If Mem[0:SwapMapA + S] = 0 Then
    Begin
      Mem[0:SwapMapA + S] := 1;
      SwapHint := S + 1;
      If SwapHint >= SwapSlots Then SwapHint := 1;
      Inc(SwapUsed);
      SwapAlloc := S;
      Exit;
    End;
  End;
End;

Procedure SwapFreeSlot(S : LongInt);
Var C : LongInt;
Begin
  If (S <= 0) Or (S >= SwapSlots) Then Exit;
  C := Mem[0:SwapMapA + S];
  If (C = 0) Or (C >= 250) Then Exit;
  Mem[0:SwapMapA + S] := C - 1;
  If C = 1 Then Dec(SwapUsed);
End;

Procedure SwapDup(S : LongInt);
Var C : LongInt;
Begin
  If (S <= 0) Or (S >= SwapSlots) Then Exit;
  C := Mem[0:SwapMapA + S];
  If (C > 0) And (C < 250) Then Mem[0:SwapMapA + S] := C + 1;
End;

{ Relire la case d'un PTE dans la page Page (virtuelle) ; 0 ou -errno }
Function SwapRead(Pte, Page : LongInt) : LongInt;
Var S : LongInt;
Begin
  S := (Pte Shr 12) And $FFFFF;
  If (S <= 0) Or (S >= SwapSlots) Or (Mem[0:SwapMapA + S] = 0) Then
  Begin
    SwapRead := -EIO;
    Exit;
  End;
  If SwapIo(S, Page, False) <> 0 Then
  Begin
    SwapRead := -EIO;
    Exit;
  End;
  SwapFreeSlot(S);
  SwapRead := 0;
End;

{ Ecrire la page Pg sur le disque ; retourne la case ou 0 }
Function SwapWrite(Pg : LongInt) : LongInt;
Var S : LongInt;
Begin
  S := SwapAlloc;
  SwapWrite := 0;
  If S = 0 Then Exit;
  If SwapIo(S, Pg, True) <> 0 Then
  Begin
    SwapFreeSlot(S);
    Exit;
  End;
  SwapWrite := S;
End;

Procedure SwapReclaim;
Var I, J, Freed, Pass, Va, P, Pte, Pg, S, Idx : LongInt; T : PTask; Mm : PMm;
    V : PVma; Dup, Stop, Remote : Boolean;
Begin
  If (Not SwapOn) Or SwapBusy Or (SwapHold > 0) Then Exit;
  If SwapSkip > 0 Then
  Begin
    Dec(SwapSkip);
    Exit;
  End;
  SwapBusy := True;
  Freed := 0;
  Stop := False;
  For Pass := 1 To 2 Do
  Begin
    If (Pass = 2) And ((Freed > 0) Or Stop) Then Break;
    For I := 0 To MaxTasks - 1 Do
    Begin
      If Stop Then Break;
      Idx := (I + SwapHand) Mod MaxTasks;
      T := @Tasks[Idx];
      If (T^.State = TsFree) Or (T^.Mm = Nil) Then Continue;
      Mm := T^.Mm;
      Remote := MmOnOtherCpu(Mm);
      Dup := False;
      For J := 0 To I - 1 Do
        If (Tasks[(J + SwapHand) Mod MaxTasks].State <> TsFree)
           And (Tasks[(J + SwapHand) Mod MaxTasks].Mm = Mm) Then Dup := True;
      If Dup Then Continue;
      V := Mm^.Vma;
      While (V <> Nil) And Not Stop Do
      Begin
        If (V^.Ino = 0) And ((V^.Flags And (VmPhys Or VmLocked)) = 0) Then
        Begin
          Va := V^.Start;
          While ULt(Va, V^.Fin) And Not Stop Do
          Begin
            P := PtePtr(Mm, Va, False);
            If P = 0 Then
              Va := (Va + $400000) And LongInt($FFC00000)
            Else
            Begin
              Pte := MemL[0:P];
              If ((Pte And 1) <> 0) And ((Pte And PgDevBit) = 0) Then
              Begin
                Pg := P2V(Pte And LongInt($FFFFF000));
                If PageRef(Pg) = 1 Then
                Begin
                  If ((Pte And PgAccessed) <> 0) And (Pass = 1) Then
                    MemL[0:P] := Pte And Not PgAccessed
                  Else
                  Begin
                    { espace charge sur un autre CPU : retirer la page
                      de ses tables et vider sa TLB avant l'ecriture }
                    If Remote Then
                    Begin
                      MemL[0:P] := 0;
                      TlbShoot(Mm);
                    End;
                    S := SwapWrite(Pg);
                    If S = 0 Then
                    Begin
                      If Remote Then MemL[0:P] := Pte;
                      Stop := True;
                    End
                    Else
                    Begin
                      MemL[0:P] := (S Shl 12) Or PgSwapBit;
                      FreePages(Pg, 0);
                      Dec(Mm^.Rss);
                      Inc(Freed);
                      If FreePagesCnt >= SwapHigh Then Stop := True;
                    End;
                  End;
                End;
              End;
              Va := Va + PageSize;
            End;
            If Va = 0 Then Break;
          End;
        End;
        V := V^.Next;
      End;
    End;
  End;
  SwapHand := (SwapHand + 1) Mod MaxTasks;
  FlushTlb;
  If Freed = 0 Then SwapSkip := 100;
  SwapBusy := False;
End;

Function SwapOnDev(Const Nm : String) : LongInt;
Var Dev, Total, Pg, Last, K, N, B, Pages, R, Bs, Chunk, Sec, L, LastL : LongInt;
    Sig : String; D : PDentry; Ip : PInode; Bad : Boolean;
Begin
  If SwapOn Then
  Begin
    SwapOnDev := -EBUSY;
    Exit;
  End;
  Ip := Nil;
  Dev := ExResolveDev(Nm);
  If Dev = 0 Then
  Begin
    { fichier ordinaire (alloue sans trous) }
    R := PathWalk(Nm, True, D);
    If R <> 0 Then
    Begin
      SwapOnDev := R;
      Exit;
    End;
    Ip := D^.Inode;
    If ((Ip^.Mode And S_IFMT) <> S_IFREG) Or (Ip^.Sb^.Dev = 0)
       Or (GetOp(Ip^.Sb^.SOps, SoBmap) = 0) Then
    Begin
      DentryPut(LongInt(D));
      SwapOnDev := -EINVAL;
      Exit;
    End;
    InodeRef(LongInt(Ip));
    DentryPut(LongInt(D));
    Dev := Ip^.Sb^.Dev;
    If U64Big(Ip^.Size, Ip^.SizeHi) Then Total := $7FFFFFFF Div 4096
    Else Total := Ip^.Size Div 4096;
  End
  Else Total := BlkSectors(Dev) Div 8;
  If Total < 10 Then
  Begin
    If Ip <> Nil Then InodePut(LongInt(Ip));
    SwapOnDev := -EINVAL;
    Exit;
  End;
  Pg := AllocPages(0);
  If Pg = 0 Then
  Begin
    If Ip <> Nil Then InodePut(LongInt(Ip));
    SwapOnDev := -ENOMEM;
    Exit;
  End;
  If Ip <> Nil Then
  Begin
    If InodeReadAt(LongInt(Ip), Pg, 0, 4096) <> 4096 Then R := -EIO
    Else R := 0;
  End
  Else R := BlkRW(Dev, 0, 8, Pg, False);
  If R <> 0 Then
  Begin
    FreePages(Pg, 0);
    If Ip <> Nil Then InodePut(LongInt(Ip));
    SwapOnDev := -EIO;
    Exit;
  End;
  Sig := 'SWAPSPACE2';
  For K := 1 To 10 Do
    If Mem[0:Pg + 4085 + K] <> Ord(Sig[K]) Then
    Begin
      FreePages(Pg, 0);
      If Ip <> Nil Then InodePut(LongInt(Ip));
      KLog('swap : signature SWAPSPACE2 absente');
      SwapOnDev := -EINVAL;
      Exit;
    End;
  Last := MemL[0:Pg + 1028];
  If (MemL[0:Pg + 1024] <> 1) Or (Last < 1) Or (Last >= Total) Then
  Begin
    FreePages(Pg, 0);
    If Ip <> Nil Then InodePut(LongInt(Ip));
    KLog('swap : en-tete invalide');
    SwapOnDev := -EINVAL;
    Exit;
  End;
  If Last > 32767 Then Last := 32767;
  { fichier : table des secteurs de chaque morceau de page }
  SwapMapF := 0;
  If Ip <> Nil Then
  Begin
    Bs := Ip^.Sb^.BlockSize;
    If Bs > 4096 Then Chunk := 4096 Else Chunk := Bs;
    If (Chunk < 512) Or ((Chunk And (Chunk - 1)) <> 0) Then
    Begin
      FreePages(Pg, 0);
      InodePut(LongInt(Ip));
      SwapOnDev := -EINVAL;
      Exit;
    End;
    SwapChunks := 4096 Div Chunk;
    SwapChunkSec := Chunk Div 512;
    N := (Last + 1) * SwapChunks * 4;
    SwapMapFOrder := OrderFor(N);
    SwapMapF := AllocPages(SwapMapFOrder);
    If SwapMapF = 0 Then
    Begin
      FreePages(Pg, 0);
      InodePut(LongInt(Ip));
      SwapOnDev := -ENOMEM;
      Exit;
    End;
    Bad := False;
    LastL := -1;
    Sec := 0;
    For K := 0 To (Last + 1) * SwapChunks - 1 Do
    Begin
      L := (K * Chunk) Div Bs;
      If L <> LastL Then
      Begin
        If SwapBmap(Ip, L, Sec) <> 0 Then
        Begin
          Bad := True;
          Break;
        End;
        LastL := L;
      End;
      MemL[0:SwapMapF + K * 4] := Sec + ((K * Chunk) Mod Bs) Div 512;
    End;
    If Bad Then
    Begin
      FreePages(SwapMapF, SwapMapFOrder);
      SwapMapF := 0;
      FreePages(Pg, 0);
      InodePut(LongInt(Ip));
      KLog('swap : le fichier a des trous');
      SwapOnDev := -EINVAL;
      Exit;
    End;
  End;
  Pages := (Last + 1 + 4095) Div 4096;
  SwapMapOrder := 0;
  While (1 Shl SwapMapOrder) < Pages Do Inc(SwapMapOrder);
  SwapMapA := AllocPages(SwapMapOrder);
  If SwapMapA = 0 Then
  Begin
    FreePages(Pg, 0);
    If SwapMapF <> 0 Then FreePages(SwapMapF, SwapMapFOrder);
    SwapMapF := 0;
    If Ip <> Nil Then InodePut(LongInt(Ip));
    SwapOnDev := -ENOMEM;
    Exit;
  End;
  MemFill(SwapMapA, 0, (1 Shl SwapMapOrder) * 4096);
  Mem[0:SwapMapA] := $FF;
  N := MemL[0:Pg + 1032];
  If N > 512 Then N := 512;
  For K := 0 To N - 1 Do
  Begin
    B := MemL[0:Pg + 1036 + K * 4];
    If (B > 0) And (B <= Last) Then Mem[0:SwapMapA + B] := $FF;
  End;
  FreePages(Pg, 0);
  SwapDev := Dev;
  SwapSlots := Last + 1;
  SwapUsed := 0;
  SwapHint := 1;
  SwapSkip := 0;
  SwapLow := 96;
  SwapHigh := 192;
  SwapNm := Nm;
  SwapPrio := -2;
  If Ip <> Nil Then
  Begin
    SwapFile := 1;
    SwapIno := LongInt(Ip);
    Ip^.Xflags := Ip^.Xflags Or $400;     { fichier de swap : non modifiable }
  End
  Else SwapFile := 0;
  SwapHook := LongInt(@SwapReclaim);
  SwapOn := True;
  KLog('swap : ' + Nm + ' ' + IntStr(Last * 4) + ' Ko');
  SwapOnDev := 0;
End;

Function SwapOffAll : LongInt;
Var I, J, Va, P, Pte, New : LongInt; T : PTask; Mm : PMm; V : PVma;
    Dup : Boolean;
Begin
  SwapOffAll := 0;
  For I := 0 To MaxTasks - 1 Do
  Begin
    T := @Tasks[I];
    If (T^.State = TsFree) Or (T^.Mm = Nil) Then Continue;
    Mm := T^.Mm;
    Dup := False;
    For J := 0 To I - 1 Do
      If (Tasks[J].State <> TsFree) And (Tasks[J].Mm = Mm) Then Dup := True;
    If Dup Then Continue;
    V := Mm^.Vma;
    While V <> Nil Do
    Begin
      Va := V^.Start;
      While ULt(Va, V^.Fin) Do
      Begin
        P := PtePtr(Mm, Va, False);
        If P = 0 Then
          Va := (Va + $400000) And LongInt($FFC00000)
        Else
        Begin
          Pte := MemL[0:P];
          If ((Pte And 1) = 0) And ((Pte And PgSwapBit) <> 0) Then
          Begin
            New := AllocPages(0);
            If New = 0 Then
            Begin
              SwapOffAll := -ENOMEM;
              Exit;
            End;
            If SwapRead(Pte, New) <> 0 Then
            Begin
              FreePages(New, 0);
              SwapOffAll := -EIO;
              Exit;
            End;
            MemL[0:P] := V2P(New) Or PteFlags(V^.Prot, True);
            Inc(Mm^.Rss);
          End;
          Va := Va + PageSize;
        End;
        If Va = 0 Then Break;
      End;
      V := V^.Next;
    End;
  End;
  FlushTlb;
End;

Function SysSwapon(PathA, Flags : LongInt) : LongInt;
Var Nm : String; R : LongInt;
Begin
  If Cur^.Euid <> 0 Then
  Begin
    SysSwapon := -EPERM;
    Exit;
  End;
  R := GetUserStr(PathA, Nm);
  If R < 0 Then
  Begin
    SysSwapon := R;
    Exit;
  End;
  R := SwapOnDev(Nm);
  If (R = 0) And ((Flags And $8000) <> 0) Then SwapPrio := Flags And $7FFF;
  SysSwapon := R;
End;

Function SysSwapoff(PathA : LongInt) : LongInt;
Var Nm : String; R : LongInt; Ipw : PInode;
Begin
  If Cur^.Euid <> 0 Then
  Begin
    SysSwapoff := -EPERM;
    Exit;
  End;
  R := GetUserStr(PathA, Nm);
  If R < 0 Then
  Begin
    SysSwapoff := R;
    Exit;
  End;
  If (Not SwapOn) Or ((SwapFile = 0) And (ExResolveDev(Nm) <> SwapDev))
     Or ((SwapFile <> 0) And (Nm <> SwapNm)) Then
  Begin
    SysSwapoff := -EINVAL;
    Exit;
  End;
  SwapBusy := True;
  R := SwapOffAll;
  SwapBusy := False;
  If R <> 0 Then
  Begin
    SysSwapoff := R;
    Exit;
  End;
  SwapOn := False;
  SwapHook := 0;
  If SwapFile <> 0 Then
  Begin
    FreePages(SwapMapF, SwapMapFOrder);
    SwapMapF := 0;
    Ipw := Pointer(SwapIno);
    Ipw^.Xflags := Ipw^.Xflags And Not $400;
    InodePut(SwapIno);
    SwapIno := 0;
    SwapFile := 0;
  End;
  FreePages(SwapMapA, SwapMapOrder);
  SwapMapA := 0;
  SwapSlots := 0;
  SwapUsed := 0;
  SysSwapoff := 0;
End;

