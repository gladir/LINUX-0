{ futex : attente/reveil sur une adresse }
Function SysFutex(UAddr, Op, Val, Timeout, UAddr2 : LongInt) : LongInt;
Var Cmd, V, R, Tmo, I, N : LongInt;
Begin
  Cmd := Op And 127;
  Case Cmd Of
    0, 9 :
      Begin
        If GetUserL(UAddr, V) < 0 Then
        Begin
          SysFutex := -EFAULT;
          Exit;
        End;
        If V <> Val Then
        Begin
          SysFutex := -EAGAIN;
          Exit;
        End;
        Tmo := 0;
        If Timeout <> 0 Then
          If EnsureUser(Timeout, 8, False) Then
          Begin
            If Cmd = 9 Then
            Begin
              { FUTEX_WAIT_BITSET : delai absolu (REALTIME si drapeau 256) }
              If (Op And 256) <> 0 Then
                Tmo := (MemL[0:Timeout] - XTime) * HZ
                    + (MemL[0:Timeout + 4] - XUsec * 1000)
                    Div (1000000000 Div HZ) + 1
              Else
                Tmo := (MemL[0:Timeout] - Jiffies Div HZ) * HZ
                    + (MemL[0:Timeout + 4] - (Jiffies Mod HZ)
                    * (1000000000 Div HZ)) Div (1000000000 Div HZ) + 1;
              If Tmo <= 0 Then
              Begin
                SysFutex := -110;
                Exit;
              End;
            End
            Else
              Tmo := MemL[0:Timeout] * HZ + (MemL[0:Timeout + 4]
                  Div (1000000000 Div HZ)) + 1;
          End;
        R := SleepOn(UAddr, Tmo, True);
        If R = WakeSignal Then SysFutex := -EINTR
        Else If R = WakeTimeout Then SysFutex := -110
        Else SysFutex := 0;
      End;
    1, 10 :
      Begin
        N := 0;
        For I := 0 To MaxTasks - 1 Do
          If (N < Val) And ((Tasks[I].State = TsSleeping) Or (Tasks[I].State
              = TsSleepUn)) And (Tasks[I].WaitChan = UAddr) Then
          Begin
            WakeTask(@Tasks[I], WakeNormal);
            Inc(N);
          End;
        SysFutex := N;
      End;
  Else
    SysFutex := -ENOSYS;
  End;
End;

Function SysGetrandom(Buf, Len, Flags : LongInt) : LongInt;
