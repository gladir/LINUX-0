{ END-EMBED }
{ Installer les programmes embarques dans le tmpfs racine }
Procedure InstallEmbedded;
Var I, L, K, N, Acc, Bits, V, Out, Buf, Line : LongInt; S : String;
Begin
  For I := 0 To EmbCount - 1 Do
  Begin
    Buf := KMalloc(EmbSize[I] + 4);
    If Buf = 0 Then Continue;
    Out := 0; Acc := 0; Bits := 0;
    For L := EmbStart[I] To EmbStart[I + 1] - 1 Do
    Begin
      S := EmbData[L];
      For K := 1 To Length(S) Do
      Begin
        V := B64Val(Ord(S[K]));
        If V >= 0 Then
        Begin
          Acc := (Acc Shl 6) Or V;
          Bits := Bits + 6;
          If Bits >= 8 Then
          Begin
            Bits := Bits - 8;
            If Out < EmbSize[I] Then
            Begin
              Mem[0:Buf + Out] := (Acc Shr Bits) And $FF;
              Inc(Out);
            End;
            Acc := Acc And ((1 Shl Bits) - 1);
          End;
        End;
      End;
    End;
    KWriteFile(EmbPath[I], $1ED, Buf, EmbSize[I]);
    KFree(Buf);
  End;
  Line := 0; N := 0;
End;

{ ---- Racine reelle : root=/dev/hdaN (ext2) ---- }

{ Creer un repertoire de point de montage, meme si le systeme de fichiers
  est monte en lecture seule (le drapeau est leve le temps de la creation) }
Procedure KMkdirForce(Sb : PSuper; Const P : String);
Var Fl : LongInt; D : PDentry;
Begin
  If PathWalk(P, True, D) = 0 Then
  Begin
    DentryPut(LongInt(D));
    Exit;
  End;
  Fl := Sb^.Flags;
  Sb^.Flags := Fl And Not MS_RDONLY;
  KMkdir(P, $1ED);
  Sb^.Flags := Fl;
End;

{ Abandonner un systeme de fichiers monte comme racine (pas de Covered) }
Procedure SbDrop(Sb : PSuper);
Var D : PDentry; Fn : LongInt;
Begin
  Fn := GetOp(Sb^.SOps, SoSync);
  If Fn <> 0 Then Call1(Fn, LongInt(Sb));
  D := Sb^.Root;
  Sb^.Root := Nil;
  DentryPurgeSb(Sb);
  DentryPut(LongInt(D));
  InodePurgeSb(Sb);
  Fn := GetOp(Sb^.SOps, SoUmount);
  If Fn <> 0 Then Call1(Fn, LongInt(Sb));
  If Sb^.Dev <> 0 Then BInvalidate(Sb^.Dev);
  SuperRelease(Sb);
End;

{ Un programme ordinaire existe-t-il a ce chemin ? }
Function IsProg(Const P : String) : Boolean;
Var D : PDentry; R : LongInt;
Begin
  IsProg := False;
  If P = '' Then Exit;
  R := PathWalk(P, True, D);
  If R <> 0 Then
  Begin
    KLog('racine : ' + P + ' : erreur ' + IntStr(-R));
    Exit;
  End;
  If (D^.Inode^.Mode And S_IFMT) = S_IFREG Then IsProg := True;
  DentryPut(LongInt(D));
End;

{ Un programme init existe-t-il (dans la racine courante du processus) ? }
Function FindInit : Boolean;
Begin
  FindInit := IsProg(InitPath) Or IsProg('/sbin/init') Or IsProg('/etc/init')
      Or IsProg('/bin/init') Or IsProg('/bin/sh');
End;

{ Monter root= comme racine : le systeme de fichiers ext2 remplace la racine
  en memoire (type pivot_root), /dev et /proc y sont remontes. Retourne
  Faux (et garde la racine en memoire) si root= est absent, illisible, ou
  si le disque ne contient aucun programme init. }
Function TryRealRoot : Boolean;
Var T, R, Fl, Ci : LongInt; Sb, OldSb : PSuper; Dn, Rf, Tn : String;
    OldRoot, OldPwd : LongInt; D : PDentry;
Begin
  TryRealRoot := False;
  If RootDev = '' Then Exit;
  { type de la racine : rootfstype=... ou essai de ext2, vfat, iso9660,
    minix, cramfs, romfs (partie 38) }
  Rf := CmdGet('rootfstype');
  Dn := RootDev;
  If CmdHas('rw') Then Fl := 0 Else Fl := MS_RDONLY;
  Sb := Nil;
  R := -ENODEV;
  For Ci := 0 To 6 Do
  Begin
    Case Ci Of
      0 : If Rf <> '' Then Tn := Rf Else Tn := 'ext2';
      1 : Tn := 'vfat';
      2 : Tn := 'iso9660';
      3 : Tn := 'minix';
      4 : Tn := 'cramfs';
      5 : Tn := 'romfs';
    Else
      Tn := '';
    End;
    If (Tn = '') Or ((Rf <> '') And (Ci > 0)) Then Break;
    T := FindFsType(Tn);
    If T < 0 Then Continue;
    Sb := SuperNew(T);
    If Sb = Nil Then Exit;
    Sb^.DevName := KMalloc(Length(Dn) + 1);
    MemCopy(Sb^.DevName, LongInt(@Dn), Length(Dn) + 1);
    Sb^.Flags := Fl;
    R := Call4(FsMount[T], LongInt(Sb), LongInt(@Dn), Fl, 0);
    If R = 0 Then
    Begin
      KLog('racine : type ' + Tn);
      Break;
    End;
    SuperRelease(Sb);
    Sb := Nil;
  End;
  If (R <> 0) Or (Sb = Nil) Then
  Begin
    KLog('racine : impossible de monter ' + RootDev + ' (erreur '
        + IntStr(-R) + '), racine en memoire');
    Exit;
  End;
  { basculer la racine du processus 0 (et celle des futurs processus) }
  OldRoot := IdleTask^.Fs^.Root;
  OldPwd := IdleTask^.Fs^.Pwd;
  DentryGet(LongInt(Sb^.Root));
  DentryGet(LongInt(Sb^.Root));
  IdleTask^.Fs^.Root := LongInt(Sb^.Root);
  IdleTask^.Fs^.Pwd := LongInt(Sb^.Root);
  If Not FindInit Then
  Begin
    KLog('racine : aucun programme init sur ' + RootDev
        + ', racine en memoire');
    IdleTask^.Fs^.Root := OldRoot;
    IdleTask^.Fs^.Pwd := OldPwd;
    DentryPut(LongInt(Sb^.Root));
    DentryPut(LongInt(Sb^.Root));
    SbDrop(Sb);
    Exit;
  End;
  { oublier l'ancienne racine en memoire (et ses montages /dev, /proc) }
  OldSb := PDentry(OldRoot)^.Sb;
  If WalkFrom(PDentry(OldRoot), 'dev/pts', True, D) = 0 Then VfsUmountD(D, 0);
  PtsRoot := Nil;
  If WalkFrom(PDentry(OldRoot), 'dev', True, D) = 0 Then VfsUmountD(D, 0);
  If WalkFrom(PDentry(OldRoot), 'proc', True, D) = 0 Then VfsUmountD(D, 0);
  If WalkFrom(PDentry(OldRoot), 'sys', True, D) = 0 Then VfsUmountD(D, 0);
  DentryPut(OldRoot);
  DentryPut(OldPwd);
  DentryPut(LongInt(RootDentry));
  SbDrop(OldSb);
  RootDentry := Sb^.Root;
  KMkdirForce(Sb, '/dev');
  KMkdirForce(Sb, '/proc');
  KMkdirForce(Sb, '/sys');
  VfsMount('devfs', '/dev', 'devtmpfs', 0, 0);
  VfsMount('proc', '/proc', 'proc', 0, 0);
  MakeDevNodes;
  VfsMount('sysfs', '/sys', 'sysfs', 0, 0);
  PopulateSys;
  KMkdir('/dev/pts', $1ED);
  VfsMount('devpts', '/dev/pts', 'devpts', 0, 0);
  If (Sb^.Flags And MS_RDONLY) <> 0 Then
    KLog('racine : ' + RootDev + ' montee en lecture seule')
  Else KLog('racine : ' + RootDev + ' montee en lecture-ecriture');
  TryRealRoot := True;
End;

{ Premier processus : ouvre la console, lance /sbin/init (ou init=) }
Procedure InitThread;
Var Fr, R, I : LongInt; F : PFile; P : String; Tried : Boolean;
Begin
  Cur^.Files := FilesNew;
  Cur^.Fs := FsNew;
  Cur^.Fs^.Root := RootDentry; DentryGet(LongInt(RootDentry));
  Cur^.Fs^.Pwd := RootDentry; DentryGet(LongInt(RootDentry));
  Cur^.Sig := SigNew;
  Cur^.Pgid := Cur^.Pid; Cur^.Sid := Cur^.Pid;
  Cur^.Tty := -1;
  Cur^.Frame := Cur^.KStack + KStackSize - SizeOf(TFrame);
  R := VfsOpen('/dev/console', O_RDWR, 0, F);
  If R = 0 Then
  Begin
    FdInstall(F, 0, False);
    FileGet(LongInt(F)); FdInstall(F, 1, False);
    FileGet(LongInt(F)); FdInstall(F, 2, False);
  End
  Else KLog('init : /dev/console inaccessible (' + IntStr(R) + ')');
  Tried := False;
  P := InitPath;
  If P = '' Then P := '/sbin/init';
  KLog('Lancement de ' + P);
  R := KernelExecve(P, P, 'HOME=/' + #0 + 'TERM=linux');
  If (R <> 0) And (InitPath <> '') Then
  Begin
    KLog('init : ' + P + ' introuvable (' + IntStr(R)
        + '), essai de /sbin/init');
    R := KernelExecve('/sbin/init', '/sbin/init', 'HOME=/');
  End;
  If R <> 0 Then
  Begin
    KLog('init : echec (' + IntStr(R) + ') essai de /bin/sh');
    R := KernelExecve('/bin/sh', '/bin/sh', 'HOME=/');
  End;
  If R <> 0 Then KPanic('Pas de programme init : ' + IntStr(R));
  I := 0;
  If Tried Then I := 1;
  Fr := Cur^.Frame;
  If PreemptOn Then BklRelease;
  JumpToUser(Fr);
End;

{ Fil d'ecriture differee des tampons (bdflush) }
Procedure BdflushMain;
Begin
  BdFlushThread;
End;

Procedure PrintBanner;
Begin
  KLog('LINUX-0 KERNEL32 ' + KVersion
      + ' (i386) : noyau Linux 32 bits ecrit en Pascal');
End;


{ ==================================================================== }
{ Partie 39 (suite) - AF_NETLINK, NETLINK_ROUTE (ip, ifconfig, DHCP)    }
{ ==================================================================== }
{ Socket de controle du reseau : RTM_GETLINK / RTM_GETADDR / RTM_GETROUTE
  (listes completes NLM_F_DUMP, ou un lien par numero ou nom),
  RTM_NEWADDR / RTM_DELADDR (adresse de eth0), RTM_NEWROUTE / RTM_DELROUTE
  (route par defaut), RTM_NEWLINK (IFF_UP, MTU de eth0). Les reponses sont
  placees dans la file de la socket (datagrammes de 3,5 Ko au plus, fin
  NLMSG_DONE). Interfaces : 1 lo, 2 eth0 (si une carte est presente). Pas
  de groupes multicast (RTMGRP_*) : les notifications ne sont pas emises. }

Const
  RTM_NEWLINK = 16; RTM_GETLINK = 18; RTM_NEWADDR = 20; RTM_DELADDR = 21;
  RTM_GETADDR = 22; RTM_NEWROUTE = 24; RTM_DELROUTE = 25; RTM_GETROUTE = 26;

Var
  NlBuf : Array[0..4607] Of Byte;     { reponse en cours de construction }
  NlLen, NlTmp : LongInt;

Function NlB : LongInt;
Begin
  NlB := LongInt(@NlBuf[0]);
End;

Procedure NlAlign;
Begin
  While (NlLen And 3) <> 0 Do
  Begin
    NlBuf[NlLen] := 0;
    Inc(NlLen);
  End;
End;

Function NlMsgBegin(Typ, Flags, Seq, Pid : LongInt) : LongInt;
Var O : LongInt;
Begin
  O := NlLen;
  MemL[0:NlB + O] := 16;
  MemW[0:NlB + O + 4] := Typ;
  MemW[0:NlB + O + 6] := Flags;
  MemL[0:NlB + O + 8] := Seq;
  MemL[0:NlB + O + 12] := Pid;
  NlLen := O + 16;
  NlMsgBegin := O;
End;

Procedure NlMsgEnd(O : LongInt);
Begin
  MemL[0:NlB + O] := NlLen - O;
  NlAlign;
End;

Procedure NlAttr(Typ, Data, Len : LongInt);
Begin
  MemW[0:NlB + NlLen] := Len + 4;
  MemW[0:NlB + NlLen + 2] := Typ;
  NlLen := NlLen + 4;
  If Len > 0 Then MemCopy(NlB + NlLen, Data, Len);
  NlLen := NlLen + Len;
  NlAlign;
End;

Procedure NlAttrU32(Typ, V : LongInt);
Begin
  NlTmp := V;
  NlAttr(Typ, LongInt(@NlTmp), 4);
End;

Procedure NlAttrIp(Typ, Ip : LongInt);
Begin
  NlBuf[NlLen + 4] := (Ip Shr 24) And $FF;
  NlBuf[NlLen + 5] := (Ip Shr 16) And $FF;
  NlBuf[NlLen + 6] := (Ip Shr 8) And $FF;
  NlBuf[NlLen + 7] := Ip And $FF;
  MemW[0:NlB + NlLen] := 8;
  MemW[0:NlB + NlLen + 2] := Typ;
  NlLen := NlLen + 8;
End;

Procedure NlAttrStr(Typ : LongInt; Const Str : String);
Var I : LongInt;
Begin
  MemW[0:NlB + NlLen] := Length(Str) + 5;
  MemW[0:NlB + NlLen + 2] := Typ;
  NlLen := NlLen + 4;
  For I := 1 To Length(Str) Do
  Begin
    NlBuf[NlLen] := Ord(Str[I]);
    Inc(NlLen);
  End;
  NlBuf[NlLen] := 0;
  Inc(NlLen);
  NlAlign;
End;

Procedure NlFlush(S : PSock);
Var M : PMsg;
Begin
  If NlLen > 0 Then M := MsgAdd(S, NlB, NlLen);
  NlLen := 0;
End;

Function NlPrefix(Mask : LongInt) : LongInt;
Var N : LongInt;
Begin
  N := 0;
  While (N < 32) And ((Mask And (LongInt($80000000) Shr N)) <> 0) Do Inc(N);
  NlPrefix := N;
End;

Function NlMaskOf(Pl : LongInt) : LongInt;
Begin
  If Pl <= 0 Then NlMaskOf := 0
  Else If Pl >= 32 Then NlMaskOf := -1
  Else NlMaskOf := -1 Shl (32 - Pl);
End;

Function NlIfExists(Ix : LongInt) : Boolean;
Begin
  NlIfExists := (Ix = 1) Or ((Ix = 2) And NetPresent);
End;

Procedure NlLinkMsg(S : PSock; Ix, Seq, Fl : LongInt);
Var O, Q : LongInt;
Begin
  O := NlMsgBegin(RTM_NEWLINK, Fl, Seq, S^.LPort);
  Q := NlB + NlLen;
  MemFill(Q, 0, 16);
  MemL[0:Q + 4] := Ix;
  MemL[0:Q + 12] := -1;
  If Ix = 1 Then
  Begin
    MemW[0:Q + 2] := 772;
    MemL[0:Q + 8] := $49;
  End
  Else
  Begin
    MemW[0:Q + 2] := 1;
    If NicUp Then MemL[0:Q + 8] := $1043 Else MemL[0:Q + 8] := $1002;
  End;
  NlLen := NlLen + 16;
  If Ix = 1 Then
  Begin
    NlAttrStr(3, 'lo');
    NlAttrU32(13, 0);
    NlBuf[NlLen + 4] := 0;
    NlAttr(16, LongInt(@NlBuf[NlLen + 4]), 1);
    NlAttrU32(4, 65536);
    NlAttrStr(6, 'noqueue');
    MemFill(NlB + NlLen + 4, 0, 6);
    NlAttr(1, NlB + NlLen + 4, 6);
    MemFill(NlB + NlLen + 4, 0, 6);
    NlAttr(2, NlB + NlLen + 4, 6);
  End
  Else
  Begin
    NlAttrStr(3, 'eth0');
    NlAttrU32(13, 1000);
    If NicUp Then NlBuf[NlLen + 4] := 6 Else NlBuf[NlLen + 4] := 2;
    NlAttr(16, NlB + NlLen + 4, 1);
    NlAttrU32(4, NetMtu);
    NlAttrStr(6, 'pfifo_fast');
    MemCopy(NlB + NlLen + 4, LongInt(@NicMac[0]), 6);
    NlAttr(1, NlB + NlLen + 4, 6);
    MemFill(NlB + NlLen + 4, $FF, 6);
    NlAttr(2, NlB + NlLen + 4, 6);
  End;
  NlMsgEnd(O);
  If NlLen > 3500 Then NlFlush(S);
End;

Procedure NlAddrMsg(S : PSock; Ix, Seq, Fl : LongInt);
Var O, Q, Ip, Mask : LongInt;
Begin
  If Ix = 1 Then
  Begin
    Ip := $7F000001;
    Mask := LongInt($FF000000);
  End
  Else
  Begin
    Ip := NicIp;
    Mask := NicMask;
  End;
  O := NlMsgBegin(RTM_NEWADDR, Fl, Seq, S^.LPort);
  Q := NlB + NlLen;
  MemFill(Q, 0, 8);
  Mem[0:Q] := 2;
  Mem[0:Q + 1] := NlPrefix(Mask);
  Mem[0:Q + 2] := $80;
  If Ix = 1 Then Mem[0:Q + 3] := 254;
  MemL[0:Q + 4] := Ix;
  NlLen := NlLen + 8;
  NlAttrIp(1, Ip);
  NlAttrIp(2, Ip);
  If Ix = 1 Then NlAttrStr(3, 'lo')
  Else
  Begin
    NlAttrIp(4, Ip Or Not Mask);
    NlAttrStr(3, 'eth0');
  End;
  NlAttrU32(8, $80);
  NlMsgEnd(O);
  If NlLen > 3500 Then NlFlush(S);
End;

{ Kind 0 : route du reseau de eth0 ; 1 : route par defaut }
Procedure NlRouteMsg(S : PSock; Kind, Seq, Fl : LongInt);
Var O, Q : LongInt;
Begin
  O := NlMsgBegin(RTM_NEWROUTE, Fl, Seq, S^.LPort);
  Q := NlB + NlLen;
  MemFill(Q, 0, 12);
  Mem[0:Q] := 2;
  Mem[0:Q + 4] := 254;
  Mem[0:Q + 7] := 1;
  If Kind = 0 Then
  Begin
    Mem[0:Q + 1] := NlPrefix(NicMask);
    Mem[0:Q + 5] := 2;
    Mem[0:Q + 6] := 253;
  End
  Else Mem[0:Q + 5] := 3;
  NlLen := NlLen + 12;
  NlAttrU32(15, 254);
  If Kind = 0 Then NlAttrIp(1, NicIp And NicMask);
  NlAttrU32(4, 2);
  If Kind = 0 Then NlAttrIp(7, NicIp) Else NlAttrIp(5, NicGw);
  NlMsgEnd(O);
  If NlLen > 3500 Then NlFlush(S);
End;

Procedure NlDone(S : PSock; Seq : LongInt);
Var O : LongInt;
Begin
  O := NlMsgBegin(3, 2, Seq, S^.LPort);
  MemL[0:NlB + NlLen] := 0;
  NlLen := NlLen + 4;
  NlMsgEnd(O);
End;

Procedure NlAck(S : PSock; Req, Err : LongInt);
Var O : LongInt;
Begin
  O := NlMsgBegin(2, 0, MemL[0:Req + 8], S^.LPort);
  MemL[0:NlB + NlLen] := Err;
  MemCopy(NlB + NlLen + 4, Req, 16);
  NlLen := NlLen + 20;
  NlMsgEnd(O);
End;

{ Attribut de type Typ dans [Q, QEnd) : adresse de sa valeur et sa taille }
Function NlFind(Q, QEnd, Typ : LongInt; Var Len : LongInt) : LongInt;
Var L : LongInt;
Begin
  NlFind := 0;
  Len := 0;
  While Q + 4 <= QEnd Do
  Begin
    L := MemW[0:Q];
    If (L < 4) Or (Q + L > QEnd) Then Exit;
    If MemW[0:Q + 2] = Typ Then
    Begin
      NlFind := Q + 4;
      Len := L - 4;
      Exit;
    End;
    Q := Q + ((L + 3) And Not 3);
  End;
End;

Function NlIpAt(P : LongInt) : LongInt;
Begin
  NlIpAt := (Mem[0:P] Shl 24) Or (Mem[0:P + 1] Shl 16) Or (Mem[0:P + 2] Shl 8)
      Or Mem[0:P + 3];
End;

{ Index d'interface designee par un nom (attribut IFLA_IFNAME) ou 0 }
Function NlIfByName(P, L : LongInt) : LongInt;
Begin
  NlIfByName := 0;
  If (L >= 3) And (Mem[0:P] = 108) And (Mem[0:P + 1] = 111)
     And (Mem[0:P + 2] = 0) Then NlIfByName := 1;
  If (L >= 5) And (Mem[0:P] = 101) And (Mem[0:P + 1] = 116)
     And (Mem[0:P + 2] = 104) And (Mem[0:P + 3] = 48) And (Mem[0:P + 4] = 0)
    Then NlIfByName := 2;
End;

Function NlSend(S : PSock; Buf, Cnt : LongInt) : LongInt;
Var P, EndP, Len, Typ, Fl, Seq, Ix, Pl, Err, Q, QEnd, AL, A : LongInt;
    Dump, Reply : Boolean;
Begin
  If Cnt < 16 Then
  Begin
    NlSend := -EINVAL;
    Exit;
  End;
  { Buf est une copie dans le noyau (SysSendto) }
  If S^.Bound = 0 Then
  Begin
    S^.LPort := Cur^.Tgid;
    S^.Bound := 1;
  End;
  P := Buf;
  EndP := Buf + Cnt;
  NlLen := 0;
  While P + 16 <= EndP Do
  Begin
    Len := MemL[0:P];
    If (Len < 16) Or (P + Len > EndP) Then Break;
    Typ := MemW[0:P + 4];
    Fl := MemW[0:P + 6];
    Seq := MemL[0:P + 8];
    Dump := (Fl And $300) = $300;
    Err := 0;
    Reply := False;
    QEnd := P + Len;
    Case Typ Of
      RTM_GETLINK :
        Begin
          Reply := True;
          If Dump Then
          Begin
            NlLinkMsg(S, 1, Seq, 2);
            If NetPresent Then NlLinkMsg(S, 2, Seq, 2);
            NlDone(S, Seq);
          End
          Else
          Begin
            Ix := 0;
            If Len >= 32 Then Ix := MemL[0:P + 20];
            If Len > 32 Then
            Begin
              A := NlFind(P + 32, QEnd, 3, AL);
              If A <> 0 Then Ix := NlIfByName(A, AL);
            End;
            If NlIfExists(Ix) Then NlLinkMsg(S, Ix, Seq, 0)
            Else
            Begin
              Err := -ENODEV;
              Reply := False;
            End;
          End;
        End;
      RTM_GETADDR :
        Begin
          Reply := True;
          If Dump Then
          Begin
            NlAddrMsg(S, 1, Seq, 2);
            If NetPresent And (NicIp <> 0) Then NlAddrMsg(S, 2, Seq, 2);
            NlDone(S, Seq);
          End
          Else
          Begin
            Err := -EOPNOTSUPP;
            Reply := False;
          End;
        End;
      RTM_GETROUTE :
        Begin
          Reply := True;
          If Dump Then
          Begin
            If NetPresent And (NicIp <> 0) Then NlRouteMsg(S, 0, Seq, 2);
            If NetPresent And (NicGw <> 0) Then NlRouteMsg(S, 1, Seq, 2);
            NlDone(S, Seq);
          End
          Else
          Begin
            Err := -EOPNOTSUPP;
            Reply := False;
          End;
        End;
      RTM_NEWADDR, RTM_DELADDR :
        Begin
          If Cur^.Euid <> 0 Then Err := -EPERM
          Else If Len < 24 Then Err := -EINVAL
          Else
          Begin
            Ix := MemL[0:P + 20];
            Pl := Mem[0:P + 17];
            A := NlFind(P + 24, QEnd, 2, AL);
            If A = 0 Then A := NlFind(P + 24, QEnd, 1, AL);
            If (A = 0) Or (AL < 4) Then Err := -EINVAL
            Else If Not NlIfExists(Ix) Then Err := -ENODEV
            Else If Ix = 1 Then Err := -EOPNOTSUPP
            Else If Typ = RTM_NEWADDR Then
            Begin
              If (NicIp <> 0) And ((Fl And $200) <> 0) Then Err := -EEXIST
              Else
              Begin
                NicIp := NlIpAt(A);
                NicMask := NlMaskOf(Pl);
              End;
            End
            Else If (NicIp <> NlIpAt(A)) Or (NicIp = 0) Then
              Err := -EADDRNOTAVAIL
            Else NicIp := 0;
          End;
        End;
      RTM_NEWROUTE, RTM_DELROUTE :
        Begin
          If Cur^.Euid <> 0 Then Err := -EPERM
          Else If Len < 28 Then Err := -EINVAL
          Else
          Begin
            A := NlFind(P + 28, QEnd, 5, AL);
            If (Mem[0:P + 17] = 0) And (Typ = RTM_NEWROUTE) And (A <> 0)
               And (AL >= 4) Then
            Begin
              If NicGw <> 0 Then Err := -EEXIST
              Else NicGw := NlIpAt(A);
            End
            Else If (Mem[0:P + 17] = 0) And (Typ = RTM_DELROUTE) Then
            Begin
              If NicGw = 0 Then Err := -ESRCH Else NicGw := 0;
            End
            Else Err := -EOPNOTSUPP;
          End;
        End;
      RTM_NEWLINK :
        Begin
          If Cur^.Euid <> 0 Then Err := -EPERM
          Else If Len < 32 Then Err := -EINVAL
          Else
          Begin
            Ix := MemL[0:P + 20];
            A := NlFind(P + 32, QEnd, 3, AL);
            If (Ix = 0) And (A <> 0) Then Ix := NlIfByName(A, AL);
            If Not NlIfExists(Ix) Then Err := -ENODEV
            Else
            Begin
              If (Ix = 2) And ((MemL[0:P + 28] And 1) <> 0) Then
                NicUp := (MemL[0:P + 24] And 1) <> 0;
              A := NlFind(P + 32, QEnd, 4, AL);
              If (Ix = 2) And (A <> 0) And (AL >= 4) Then
                If MemL[0:A] <> NetMtu Then Err := -EINVAL;
            End;
          End;
        End;
    Else
      Err := -EOPNOTSUPP;
    End;
    If (Not Reply) And ((Err <> 0) Or ((Fl And 4) <> 0)) Then
      NlAck(S, P, Err)
    Else If Reply And ((Fl And 4) <> 0) And (Not Dump) Then
      NlAck(S, P, 0);
    P := P + ((Len + 3) And Not 3);
  End;
  NlFlush(S);
  NlSend := Cnt;
End;


{ ==================================================================== }
{ Partie 39 (suite) - tueur OOM                                          }
{ ==================================================================== }
{ Quand une page utilisateur ne peut plus etre allouee, la tache dont
  l'espace d'adressage a le plus de pages residentes (hors init, hors
  threads du noyau, hors taches deja condamnees) recoit SIGKILL, avec tous
  les threads de son groupe ; la tache fautive attend alors quelques ticks
  que les pages soient rendues. vm.panic_on_oom = 1 ou 2 : panique du noyau.
  Observable : message du journal "Out of memory: Killed process N (nom)",
  /proc/vmstat (oom_kill), /proc/PID/oom_score (pages residentes). }

Function OomKill : Boolean;
Var I, Best, BestRss, Rss : LongInt; T : PTask; Nm : String; K : LongInt;
Begin
  OomKill := False;
  If SyPanicOom <> 0 Then KPanic('Out of memory (vm.panic_on_oom)');
  Best := -1;
  BestRss := 0;
  For I := 1 To MaxTasks - 1 Do
  Begin
    T := @Tasks[I];
    If (T^.State = TsFree) Or (T^.State = TsZombie) Or (T^.Mm = Nil) Then
      Continue;
    If (T^.Tgid = 1) Or (T^.Tgid <> T^.Pid) Then Continue;
    If SigLoBit(SIGKILL) And T^.Pend[0] <> 0 Then Continue;
    Rss := T^.Mm^.Rss;
    If Rss > BestRss Then
    Begin
      BestRss := Rss;
      Best := I;
    End;
  End;
  If Best < 0 Then Exit;
  T := @Tasks[Best];
  Nm := '';
  For K := 0 To 15 Do
    If (T^.Comm[K] <> 0) And (Length(Nm) < 15) Then Nm := Nm + Chr(T^.Comm[K]);
  KLog('Out of memory: Killed process ' + IntStr(T^.Pid) + ' (' + Nm
      + ') rss ' + IntStr(BestRss * 4) + ' kB');
  Inc(OomKills);
  For I := 1 To MaxTasks - 1 Do
    If (Tasks[I].State <> TsFree) And (Tasks[I].State <> TsZombie)
       And (Tasks[I].Tgid = T^.Tgid) Then SendSig(@Tasks[I], SIGKILL);
  OomKill := True;
End;

{ ==================================================================== }
{ Demarrage du noyau                                                    }
{ ==================================================================== }

Var
  KEndMark : LongInt;        { derniere variable globale : fin de l'image }

Function KernelEnd : LongInt;
Begin
  KernelEnd := LongInt(@KEndMark);
End;

Procedure KMain;
Var T : PTask; I : LongInt;
Begin
  SerialInit;
  InitVcons;
  LogToVc := True;
  PrintBanner;
  ParseMultiboot;
  ComputeRam;
  ParseCmdline;
  KLog('memoire : ' + IntStr(RamTopPhys Div 1048576)
      + ' Mo utilisables, ligne de commande : ' + CmdLine);
  InitMemory;
  KLog('pages libres : ' + IntStr(FreePagesCnt) + ' sur ' + IntStr(NPages));
  InitGdt;
  InitPic;
  InitIdt;
  InitTasks;
  InitSyscalls;
  InitSyscalls2;
  HostName := 'linux0';
  DomainName := '(none)';
  InitNs;
  InitTime;
  InitBlock;
  InitVfs;
  InitTmpfs;
  InitExt2;
  InitIso;
  InitFat;
  InitXattr;
  InitProc;
  InitSysctl;
  InitModules;
  InitDevices;
  InitSockets;
  InitEvents;
  InitLoop;
  InitRoFs;
  PciScan;
  SmpInit;
  NetInit;
  TunInit;
  FbInit;
  MountRoot;
  InitPts;
  MakeTree;
  InitTty;
  KLog('disque IDE : ' + IntStr(Ord(DiskPresent[0]) + Ord(DiskPresent[1])
      + Ord(DiskPresent[2]) + Ord(DiskPresent[3])) +
       ' lecteur(s), ramdisk ' + IntStr(RamSizeKb) + ' Ko');
  If Not InitramfsLoad Then
    If Not TryRealRoot Then InstallEmbedded;
  If CmdGet('swap') <> '' Then SwapOnDev(CmdGet('swap'));
  FpuDetect;
  InitFpu;
  PreemptOn := CmdGet('preempt') <> '0';
  If PreemptOn Then KLog('noyau preemptible (preempt=0 pour le desactiver)');
  T := KernelThread(LongInt(@InitThread));
  If T = Nil Then KPanic('creation de init impossible');
  InitTask := T;
  T^.Pid := 1; T^.Tgid := 1;
  NextPid := 1;
  T^.State := TsRunnable;
  T := KernelThread(LongInt(@BdflushMain));
  If T <> Nil Then
  Begin
    For I := 0 To 15 Do T^.Comm[I] := 0;
    For I := 1 To 7 Do T^.Comm[I - 1] := Ord('bdflush'[I]);
    T^.State := TsSleepUn;
    T^.WakeAt := 0;
    T^.State := TsRunnable;
  End;
  If BootQuiet Then LogToVc := False;
  KLog('demarrage du systeme');
  SmpGo;
  If SmpRun Then IdleLoopSmp;
  { boucle d'inactivite : la tache 0 }
  While True Do
  Begin
    Schedule;
    asm
      sti
      hlt
      cli
    end;
    If PreemptOn And (BklOwner = Nil) Then RunBH;
    If PreemptOn And (Jiffies - IdleDump > 3000) Then
    Begin
      IdleDump := Jiffies;
      If KDebug And (NrTasks > 3) Then DumpTasks;
    End;
  End;
  I := 0;
End;

Begin
End.
