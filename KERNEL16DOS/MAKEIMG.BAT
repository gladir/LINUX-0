@ECHO OFF
REM MAKEIMG.BAT - Construit KERNEL16DOS et ses images sous DOS ou Windows.
REM Necessite TPC (compilateur Turbo Pascal 7) dans le PATH.
REM Depuis le dossier KERNEL16DOS : MAKEIMG
REM Option : MAKEIMG /HD pour produire aussi un disque dur de 32 Mo.
REM (Sous DOS les noms sont limites a 8 caracteres : LINU144A.IMG.)
IF "%1"=="/HD" SET HDOPT=/HD:32
TPC -M MAKER.PAS
IF ERRORLEVEL 1 GOTO ERREUR
MAKER.EXE
IF ERRORLEVEL 1 GOTO ERREUR
COPY IO.SYS SYSTEM\IO.SYS
TPC SH.PAS
IF ERRORLEVEL 1 GOTO ERREUR
IF NOT EXIST SYSTEM\BIN\NUL MD SYSTEM\BIN
COPY SH.EXE SYSTEM\BIN\SH.EXE
COPY TOOLS\INSTALL.PAS INSTALL.PAS
TPC INSTALL.PAS
IF ERRORLEVEL 1 GOTO ERREUR
COPY INSTALL.EXE SYSTEM\BIN\INSTALL.EXE
DEL INSTALL.PAS
CD TOOLS
TPC MAKEDISK.PAS
IF ERRORLEVEL 1 GOTO ERREUR
TPC LSIMG.PAS
MAKEDISK /INF:IMAGE.INF %HDOPT%
IF ERRORLEVEL 1 GOTO ERREUR
REM CD-ROM : demarrage en emulation de disquette 2,88 Mo avec tous les fichiers
IF NOT EXIST ISOTMP\NUL MD ISOTMP
MAKEDISK /INF:IMAGE.INF /FLOPPY:2880 /ISO /OUT:ISOTMP
IF ERRORLEVEL 1 GOTO ERREUR
COPY ISOTMP\LINUX.ISO ..\IMAGE\LINUX.ISO
DEL ISOTMP\*.*
RD ISOTMP
CD ..
ECHO Images creees dans IMAGE
GOTO FIN
:ERREUR
ECHO Erreur de construction
:FIN
