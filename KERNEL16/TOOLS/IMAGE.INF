; IMAGE.INF - manifeste des images disque de LINUX-0 (KERNEL16)
;
; Utilisation (depuis KERNEL16\TOOLS) :
;   MAKEDISK /INF:IMAGE.INF                  disquettes LINUX144A.IMG...
;   MAKEDISK /INF:IMAGE.INF /HD:32 /ISO      + disque dur et CD-ROM
;
; Une ligne = une option de MAKEDISK ("MOT valeur" = "/MOT:valeur").
; Les chemins relatifs sont relatifs au dossier de ce fichier.
; Lignes vides et lignes commencant par ; ou # ignorees.

; Dossier du systeme : IO.SYS (le noyau, 1er fichier, contigu), MSDOS.SYS
; (2e entree de la racine), ETC\... copies a la racine de la
; premiere disquette.
SYSTEM ..\SYSTEM

; Commandes : copiees dans \BIN de chaque disquette (masques facultatifs).
CMDS ..\..\BIN16 *.EXE,*.COM,*.BAT

; Dossier de sortie, prefixe des images, nom de volume et espace libre
; (en Ko) garde sur chaque disquette.
OUT ..\IMAGE
NAME LINUX
LABEL LINUX
FREE 16

; Fichiers supplementaires : ADD source destination dans l'image.
ADD ETC\PROFILE \ETC\PROFILE

; Le shell de KERNEL16 remplace le SH.EXE de BIN16 (le dossier SYSTEM\BIN
; est ignore par la regle precedente : on l'ajoute explicitement).
ADD ..\SYSTEM\BIN\SH.EXE \BIN\SH.EXE

; Dossiers vides.
DIR \TMP
DIR \HOME

; Fichiers qui doivent etre sur la premiere disquette (amorcable) : tout
; le dossier SYSTEM, plus le shell et les commandes de base.
BOOT \ETC\*
BOOT \BIN\SH.EXE
BOOT \BIN\LS.EXE
BOOT \BIN\CAT.EXE
BOOT \BIN\CP.EXE
BOOT \BIN\MV.EXE
BOOT \BIN\RM.EXE
BOOT \BIN\RMDIR.EXE
BOOT \BIN\ECHO.EXE
BOOT \BIN\PWD.EXE
BOOT \BIN\MORE.EXE
BOOT \BIN\DATE.EXE
BOOT \BIN\TOUCH.EXE
BOOT \BIN\GREP.EXE
BOOT \BIN\DF.EXE
BOOT \BIN\FREE.EXE
BOOT \BIN\CLEAR.EXE
BOOT \BIN\HALT.EXE
BOOT \BIN\REBOOT.EXE
BOOT \BIN\VI.EXE

; Programme d'installation sur disque dur (TOOLS\INSTALL.PAS) : MAKEDISK ecrit
; \INSTALL.INF (liste des fichiers par disquette et par composant) sur la
; disquette A. INSTALL.EXE est dans SYSTEM\BIN (donc sur la disquette A).
INSTALL

; Composants de l'installeur : 0 = systeme (IO.SYS, shell, \ETC...), 1 a 6
; ci-dessous (noms 8.3 sans extension), 7 = divers (tout le reste de \BIN).
; 1 Commandes de base
COMP 1 CAT,CP,MV,RM,RMDIR,LS,ECHO,PWD,DATE,DF,FREE,HEAD,TAIL,MORE,TOUCH,CLEAR
COMP 1 HALT,REBOOT,SLEEP,WC,TRUE,FALSE,YES,UNAME,TEE,TREE,STAT,SEQ,CAL,FACTOR
COMP 1 CHMOD,WHICH,ENV,DU,DD,DIRNAME,ID,LOGNAME,UMASK,UNLINK,EXPR,FORMAT,LP
; 2 Traitement de texte
COMP 2 GREP,EGREP,FGREP,SED,AWK,SORT,UNIQ,CUT,TR,PASTE,JOIN,NL,FMT,FOLD,OD,HD
COMP 2 HEXDUMP,REV,TAC,DIFF,CMP,COMM,SDIFF,BDIFF,DIRCMP,SPLIT,CSPLIT,DSPLIT
COMP 2 EXPAND,UNEXPAND,PR,COLUMN,LOOK,PRINTF,STRINGS,DOS2UNIX,TODOS,FROMDOS
COMP 2 ISPELL,MD5SUM,CKSUM,SUM,BASE64,UUENCODE,UUDECODE,ICONV,REPLACE,REPEAT
COMP 2 REF,BANNER,MERGE,GCAL
; 3 Editeurs
COMP 3 VI,ED,RED,NANO,PICO,EMACS,LESS
; 4 Archives et compression
COMP 4 AR,GZIP,GUNZIP,ZCAT,GZEXE,ZFORCE,BZIP2,COMPRESS,PCAT
; 5 Programmation et scripts
COMP 5 MAKE,PERL,PYTHON,BASH,CSH,KSH,BC,DC,LEX,CTAGS,ETAGS,GPERF,CPP,ACLOCAL
COMP 5 H2PH,A2P,S2P,ANSI2KNR,ADDR2LIN,READELF,LDD,MTEST,MKTEMP,MKDIRHIE,GETOPT
COMP 5 GETTEXT,CHECKEQ,CHECKNR,CVS,BFS
; 6 Systeme, utilisateurs et reseau
COMP 6 USERADD,USERDEL,GROUPDEL,GROUPS,CHSH,CRONTAB,IFCONFIG,GETENT,LASTLOG,AC
COMP 6 ACCESS,FALLOCAT,DIRCOLOR,MKMANIFE,HTDIGEST,HTPASSWD,MYISAMCH
